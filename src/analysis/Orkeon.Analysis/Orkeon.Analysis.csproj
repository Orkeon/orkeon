<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Analysis</PackageId>
    <Description>Infrastructure implementations for Orkeon RaggableTree: Tree-sitter parsers, language adapters, dependency graph, and pipeline orchestration.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Analysis;RaggableTree;TreeSitter</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Analysis" />
    <InternalsVisibleTo Include="Orkeon.Analysis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TreeSitter.DotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkeon.Analysis.Abstractions\Orkeon.Analysis.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
  </ItemGroup>

</Project>
