<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Rag</PackageId>
    <Description>Implementations for the Orkeon RAG subsystem: chunking, loaders, retrieval, reranking, ingestion, evaluation, and named-component factories.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;RAG;Retrieval</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Rag" />
    <InternalsVisibleTo Include="Orkeon.Rag.Tests" />
    <InternalsVisibleTo Include="Orkeon.Tools.Rag.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkeon.Rag.Abstractions\Orkeon.Rag.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
  </ItemGroup>

</Project>
