<Application x:Class="Orkeon.Studio.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Index 0 is the theme-switch slot: the tokens dictionary is replaced in place when
           toggling dark/light, so it must stay first and every brush reference in the app
           must go through DynamicResource. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="/Themes/Icons.xaml" />
        <ResourceDictionary Source="/Themes/Studio.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
      <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    <views:LeftIndentConverter x:Key="LeftIndent" />
      <views:StringPresentToVisibilityConverter x:Key="StringPresentToVisibility" />
      <views:CountToVisibilityConverter x:Key="CountToVisibility" />
      <views:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />

    </ResourceDictionary>
  </Application.Resources>
</Application>
