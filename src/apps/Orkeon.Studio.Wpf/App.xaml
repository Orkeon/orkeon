<Application x:Class="Orkeon.Studio.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <Application.Resources>
    <ResourceDictionary>

      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
      <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
      <views:StringPresentToVisibilityConverter x:Key="StringPresentToVisibility" />

      <!-- Shared spacing so every form in both tabs lines up without repeating margins. -->
      <Thickness x:Key="FieldMargin">0,3,0,3</Thickness>
      <Thickness x:Key="SectionMargin">0,0,0,12</Thickness>
      <Thickness x:Key="PanelPadding">10</Thickness>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="0,2,0,6" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
