<!-- The "Importer" screen (design v3): point at a shared team, Studio recognizes it,
     scans it for pasted secrets, and copies it only on your say-so.
     DataContext: ImportTeamViewModel (bound as Import in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ImportTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:launch="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Launch"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <!-- R3: one header; the subtitle explains in novice, names the machinery in expert. -->
    <controls:PageHeader Title="{Binding [Studio.Import.Title], Source={x:Static services:I18n.Instance}}">
      <controls:PageHeader.Style>
        <Style TargetType="controls:PageHeader" BasedOn="{StaticResource {x:Type controls:PageHeader}}">
          <Setter Property="Subtitle" Value="{Binding [Studio.Import.SubNovice], Source={x:Static services:I18n.Instance}}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Subtitle" Value="{Binding [Studio.Import.SubExpert], Source={x:Static services:I18n.Instance}}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </controls:PageHeader.Style>
    </controls:PageHeader>

    <!-- the candidate: the launcher's own picker + detector -->
    <Border Style="{StaticResource Card}" Margin="0,16,0,16">
      <StackPanel>
        <!-- C07 (R10): the path and its two buttons on one 40 px line - the foundation's field and
             button heights, nothing local. -->
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"
                  Command="{Binding Target.BrowseFolderCommand}"
                  Content="{Binding [Studio.Run.Browse], Source={x:Static services:I18n.Instance}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"
                  controls:ButtonIcon.Kind="scan-search" Command="{Binding Target.DetectCommand}"
                  Content="{Binding [Studio.Run.Detect], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource InputMono}" VerticalAlignment="Center"
                   Text="{Binding Target.SelectedPath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- drop zone (audit 04): dashed, centred; files also arrive via the typed path -->
        <Border Margin="0,12,0,0" CornerRadius="10" Padding="22" AllowDrop="True" Drop="OnDropCandidate"
                DragOver="OnDragOverCandidate" Background="{DynamicResource PaperSunkBrush}">
          <Border.BorderBrush>
            <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
              <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource LineStrongBrush}">
                  <GeometryDrawing.Geometry>
                    <GeometryGroup>
                      <RectangleGeometry Rect="0,0,4,1"/>
                      <RectangleGeometry Rect="0,0,1,4"/>
                    </GeometryGroup>
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Border.BorderBrush>
          <Border.BorderThickness>1</Border.BorderThickness>
          <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center"
                     Text="{Binding [Studio.Import.DropHint], Source={x:Static services:I18n.Instance}}"/>
        </Border>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding Target.StatusDisplay}"/>
        <StackPanel Visibility="{Binding Target.NeedsShapeChoice, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningInkBrush}" Text="{Binding Target.YamlLayoutBlockedMessage}"/>
          <ComboBox Style="{StaticResource ComboM}" ItemsSource="{x:Static launch:TargetSelectionViewModel.DirectoryKindChoices}"
                    SelectedItem="{Binding Target.PreferredDirectoryKind}" Margin="0,6,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- recognition report (audit 04/12): what Studio established about the candidate -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding HasRecognitionReport, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                   Text="{Binding [Studio.Import.ReportTitle], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding RecognitionReport}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <controls:LucideIcon Size="14" VerticalAlignment="Top" Margin="0,2,10,0">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon">
                      <Setter Property="Kind" Value="info"/>
                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="ok">
                          <Setter Property="Kind" Value="circle-check"/>
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="warn">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningIconBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
                <StackPanel>
                  <TextBlock Style="{StaticResource Subhead}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Detail}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- pasted-secret warning: keys travel by environment, never inside a shared folder -->
    <controls:Alert Tone="Warning" Margin="0,0,0,16"
                    Title="{Binding [Studio.Import.SecretsTitle], Source={x:Static services:I18n.Instance}}"
                    Message="{Binding [Studio.Import.SecretsBody], Source={x:Static services:I18n.Instance}}"
                    Visibility="{Binding HasSecretWarnings, Converter={StaticResource BooleanToVisibility}}">
      <ItemsControl ItemsSource="{Binding SecretWarnings}" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Style="{StaticResource MonoText}" Margin="0,1" Text="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </controls:Alert>

    <StackPanel Style="{StaticResource ActionRow}" HorizontalAlignment="Left">
      <Button Style="{StaticResource BtnPrimary}" Command="{Binding ImportCommand}" controls:ButtonIcon.Kind="plus"
              Content="{Binding [Studio.Import.Add], Source={x:Static services:I18n.Instance}}"/>
      <!-- VFS-90 D-06: the candidate names folder declarations this machine does not have;
           authorizing them as recorded — under the same ids — is what makes it launchable. -->
      <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding DeclareCopiesCommand}"
              controls:ButtonIcon.Kind="badge-check"
              Visibility="{Binding HasUnknownMounts, Converter={StaticResource BooleanToVisibility}}"
              Content="{Binding [Studio.Import.DeclareCopies], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="OnTestFirst"
              controls:ButtonIcon.Kind="play" IsEnabled="{Binding Target.IsResolved}"
              Content="{Binding [Studio.Import.TestFirst], Source={x:Static services:I18n.Instance}}">
        <Button.Visibility>
          <Binding Path="DataContext.Mode.IsExpert" RelativeSource="{RelativeSource AncestorType=Window}"
                   Converter="{StaticResource BooleanToVisibility}"/>
        </Button.Visibility>
      </Button>
      <TextBlock Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="12,0,0,0"
                 Text="{Binding StatusMessage}"
                 Visibility="{Binding StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>
    </StackPanel>

  </StackPanel>
</UserControl>
