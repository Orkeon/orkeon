<!-- The "Diagnostic" screen (§4.4): runs orkeon doctor (JSON mode) and lists its checks.
     DataContext: DiagnosticViewModel (bound as Config.Diagnostic in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Diag_Title], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,22"
               Text="{Binding [Scr_Diag_SubNovice], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,22"
               Text="{Binding [Scr_Diag_SubExpert], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- summary card: run button + verdict line -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <controls:LucideIcon Kind="stethoscope" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="orkeon doctor"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding RunCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="stethoscope" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Diag_Run], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="10,0,0,0" Click="OnCopyReport"
                  Visibility="{Binding CanCopyReport, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="copy" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Diag_CopyReport], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Summary}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringPresentToVisibility}}"/>
      </StackPanel>
    </Border>

    <!-- checks card -->
    <Border Style="{StaticResource Card}"
            Visibility="{Binding Checks.Count, Converter={StaticResource CountToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12"
                   Text="{Binding [Diag_Checks_Title], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <controls:LucideIcon Size="14" VerticalAlignment="Top" Margin="0,2,10,0">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                      <Setter Property="Kind" Value="circle-help"/>
                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                          <Setter Property="Kind" Value="circle-check"/>
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failure">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
                <StackPanel>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="11.5" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding Name, Mode=OneWay}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding Detail, Mode=OneWay}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
