<!-- The "Diagnostic" screen (§4.4): runs orkeon doctor (JSON mode) and lists its checks.
     DataContext: DiagnosticViewModel (bound as Config.Diagnostic in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <!-- Header (mock §D-3): « Copier le rapport » sits left of « Relancer », both in the header. -->
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Click="OnCopyReport"
                Visibility="{Binding CanCopyReport, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="copy" Size="13" Margin="0,0,7,0"/>
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Diag_CopyReport], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReportCopied}" Value="True">
                      <Setter Property="Text" Value="{Binding [Diag_Copied], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnGhost}" Command="{Binding RunCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="rotate-cw" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Diag_Run], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Diag_Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Diag_SubNovice], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Diag_SubExpert], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
      </StackPanel>
    </DockPanel>

    <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"
               Text="{Binding ErrorMessage}"
               Visibility="{Binding ErrorMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <!-- verdict card (audit 09/20): headline, counts, one action -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" VerticalAlignment="Center"
                Margin="12,0,0,0" Click="OnFixInSettings"
                Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="sliders-horizontal" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Diag_Fix], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding VerdictHeadline}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasIssues}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding VerdictDetail}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- checks card -->
    <Border Style="{StaticResource Card}"
            Visibility="{Binding Checks.Count, Converter={StaticResource CountToVisibility}}">
      <StackPanel>
        <TextBlock Margin="0,0,0,12">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
              <Setter Property="Text" Value="{Binding [Diag_Checks_Title], Source={x:Static services:I18n.Instance}}"/>
              <Style.Triggers>
                <!-- Novice (F-13): plain words, not the tool's name. -->
                <DataTrigger Binding="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Text" Value="{Binding [Diag_Card_Novice], Source={x:Static services:I18n.Instance}}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <controls:LucideIcon Size="14" VerticalAlignment="Top" Margin="0,2,10,0">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                      <Setter Property="Kind" Value="circle-help"/>
                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                          <Setter Property="Kind" Value="circle-check"/>
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failure">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                               Text="{Binding FriendlyName, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource MonoText}" FontSize="10" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Name, Mode=OneWay}"
                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                  <!-- T-30: the CLI's detail is English whatever the UI speaks, so Novice
                       reads the localized sentence and Expert keeps the raw line. -->
                  <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Text="{Binding StatusSentence, Mode=OneWay}"
                             Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Text="{Binding Detail, Mode=OneWay}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                  <!-- llm-config reads the base (file + shell env); a team's named profile
                       is laid over its own launch only, so this check cannot see it. -->
                  <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontStyle="Italic"
                             Text="{Binding [Diag_LlmConfigHint], Source={x:Static services:I18n.Instance}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Name}" Value="llm-config">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
