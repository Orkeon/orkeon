<!-- The card that fills the wait on steps 2 and 3.
     Both stretches used to be blank: the engine worked, sometimes for a minute, and the
     column showed nothing but «Ajouter un agent» and the technical log. There was no way to
     tell a session that is thinking from one that has died.
     It says three things, all already on the stream: WHAT the engine is doing, what the model
     last SAID, and what it has COST — ascending and descending, marked «≈» when the provider
     reported nothing and the runtime had to count for it.
     DataContext: ComposeProgressViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ComposeProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}">
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
    <StackPanel>

      <DockPanel>
        <!-- Turning only while the engine is working. When it is waiting on YOU the title
             says so and nothing spins: a spinner over a question is the oldest lie here. -->
        <controls:LucideIcon DockPanel.Dock="Left" Kind="loader-circle" Size="14" Margin="0,1,10,0"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                             RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}}">
          <controls:LucideIcon.RenderTransform>
            <RotateTransform x:Name="ProgressSpin"/>
          </controls:LucideIcon.RenderTransform>
          <controls:LucideIcon.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="ProgressSpin" Storyboard.TargetProperty="Angle"
                                   From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </controls:LucideIcon.Triggers>
        </controls:LucideIcon>

        <!-- The waiting state gets its own steady glyph: still something, but not motion. -->
        <controls:LucideIcon DockPanel.Dock="Left" Kind="circle-help" Size="14" Margin="0,1,10,0"
                             Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Top"
                             Visibility="{Binding IsWaiting, Converter={StaticResource BooleanToVisibility}}"/>

        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                   TextWrapping="Wrap" Text="{Binding Title}"/>
      </DockPanel>

      <!-- The model's own last words — or the sentence that admits there are none. -->
      <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="24,6,0,0"
                 TextWrapping="Wrap" Text="{Binding Detail}"/>

      <StackPanel Orientation="Horizontal" Margin="24,10,0,0">

        <!-- The figures themselves live in the stepper row above, which is on screen at
             every step. What belongs here is why they carry a «≈»: said in words rather
             than left to a symbol nobody has to decode. -->
        <TextBlock Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding TokensNote}" Margin="0,0,12,0"
                   Visibility="{Binding TokensEstimated, Converter={StaticResource BooleanToVisibility}}"/>

        <!-- What is already acquired. Facts only — a step that produced nothing says nothing. -->
        <ItemsControl ItemsSource="{Binding Facts}" VerticalAlignment="Center"
                      Visibility="{Binding HasFacts, Converter={StaticResource BooleanToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,0,10,0"
                         VerticalAlignment="Center" Text="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
