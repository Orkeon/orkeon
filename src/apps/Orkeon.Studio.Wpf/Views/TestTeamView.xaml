<!-- The expert "Tester" screen (design v3): blank-run validation then a real trial, over a
     dedicated launcher that never touches the history. DataContext: TestTeamViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.TestTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Test_Title], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,22"
               Text="{Binding [Scr_Test_Sub], Source={x:Static services:I18n.Instance}}"/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Test_Team_Label], Source={x:Static services:I18n.Instance}}"/>
        <ComboBox ItemsSource="{Binding TeamChoices}" SelectedItem="{Binding SelectedTeam}"
                  DisplayMemberPath="Name" Width="320" HorizontalAlignment="Left"/>
        <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,6,0,0" Text="{Binding Launcher.Target.SelectedPath}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding Launcher.Target.StatusDisplay}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource BtnGhost}" Command="{Binding Launcher.ValidateCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Test_Validate], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding Launcher.RunCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="play" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Test_Run], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Command="{Binding Launcher.CancelCommand}"
                  Content="{Binding [Run_Cancel], Source={x:Static services:I18n.Instance}}"
                  Visibility="{Binding Launcher.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Launcher.StatusMessage}"
                   Visibility="{Binding Launcher.StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>
      </StackPanel>
    </Border>

    <!-- validation findings -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding Launcher.ValidationMessages.Count, Converter={StaticResource CountToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                   Text="{Binding [Test_Findings], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Launcher.ValidationMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,2"
                         Text="{Binding Display}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- the trial console: always console-navy, in both themes -->
    <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="14" Padding="10" MinHeight="220" MaxHeight="440">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Launcher.Log.Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="6,1"
                         Foreground="{DynamicResource ConsoleFgBrush}" TextWrapping="Wrap" Text="{Binding Text}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

  </StackPanel>
</UserControl>
