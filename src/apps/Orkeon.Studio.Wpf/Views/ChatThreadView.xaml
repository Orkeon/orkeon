<!-- The conversation with the assistant (30/08 mock, ChatThread.dc.html). It does NOT float
     over the screen: it is mounted in the content column and takes its place, so the Novice
     help rail beside it stays readable and clickable. Every dimension here comes from the
     mock; nothing is positioned by a constant width. DataContext: ChatThreadViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ChatThreadView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <UserControl.Resources>

    <!-- The busy hairline. A gradient sweep rather than a moving rectangle: it is the one
         shape that stays right at every panel width, and the mock's rail is 30 % wide. -->
    <Storyboard x:Key="SweepStoryboard" RepeatBehavior="Forever">
      <!-- TargetName IS the TranslateTransform, so the path is its own X. «Transform.X»
           would name a property a TranslateTransform does not have, and WPF resolves a
           storyboard path when it STARTS — an exception the first time the assistant works. -->
      <DoubleAnimation Storyboard.TargetName="SweepBrush" Storyboard.TargetProperty="X"
                       From="-1.2" To="1.2" Duration="0:0:1.6"/>
    </Storyboard>

    <!-- The halo behind the avatar: 0,9 → 1,62 while it fades out. -->
    <Storyboard x:Key="HaloStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="RenderTransform.ScaleX"
                       From="0.9" To="1.62" Duration="0:0:1.9"/>
      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="RenderTransform.ScaleY"
                       From="0.9" To="1.62" Duration="0:0:1.9"/>
      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                       From="0.34" To="0" Duration="0:0:1.33"/>
    </Storyboard>

    <!-- The panel slides in from where the content used to be — 280 ms, ease out, no bounce.
         NO Storyboard.TargetName here, deliberately. This storyboard is begun from a trigger
         that lives in a Style (see Panel below), and a Style has no namescope: WPF resolves
         TargetName when the storyboard STARTS and throws
         «'Slot' name cannot be found in the name scope of 'System.Windows.Style'» at that
         instant. That throw came out of the IsOpen setter, up through StartInterview, and
         into the Task AsyncRelayCommand.Execute discards — so the Compose button answered
         every click with nothing at all. Without a TargetName both animations address the
         styled element itself, which is exactly the Border we want. -->
    <Storyboard x:Key="SlotStoryboard">
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                       From="26" To="0" Duration="0:0:0.28">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.28"/>
    </Storyboard>

    <Style x:Key="ChatDot" TargetType="Ellipse">
      <Setter Property="Width" Value="5"/>
      <Setter Property="Height" Value="5"/>
      <Setter Property="Fill" Value="{DynamicResource MarkBrush}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Opacity" Value="0.26"/>
    </Style>

  </UserControl.Resources>

  <Border x:Name="Panel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1" CornerRadius="14" MaxHeight="640" ClipToBounds="True">
    <Border.RenderTransform>
      <!-- Unnamed on purpose: SlotStoryboard reaches it by property path, not by name. -->
      <TranslateTransform/>
    </Border.RenderTransform>
    <!-- The slot-in plays every time the thread TAKES the column, not once when the control
         is first built: toggling Visibility never raises Loaded again, so an EventTrigger
         there animates the first open and no other. -->
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsOpen}" Value="True">
            <DataTrigger.EnterActions>
              <BeginStoryboard Storyboard="{StaticResource SlotStoryboard}"/>
            </DataTrigger.EnterActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <DockPanel>

      <!-- ── the busy hairline ── -->
      <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource LineFaintBrush}" ClipToBounds="True"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TranslateTransform x:Name="SweepBrush"/>
              </LinearGradientBrush.RelativeTransform>
              <GradientStop Offset="0.00" Color="Transparent"/>
              <GradientStop Offset="0.35" Color="{DynamicResource MarkColor}"/>
              <GradientStop Offset="0.65" Color="{DynamicResource MarkColor}"/>
              <GradientStop Offset="1.00" Color="Transparent"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
          <Rectangle.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard Storyboard="{StaticResource SweepStoryboard}"/>
            </EventTrigger>
          </Rectangle.Triggers>
        </Rectangle>
      </Border>

      <!-- ── header: who is talking, what they are doing, and the two ways out ── -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" Padding="16,13"
              BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,11,0">
            <Ellipse x:Name="Halo" Fill="{DynamicResource MarkBrush}" Opacity="0"
                     RenderTransformOrigin="0.5,0.5"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
              <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard Storyboard="{StaticResource HaloStoryboard}"/>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
            <Border Background="{DynamicResource AccentWeakBrush}" CornerRadius="15">
              <controls:LucideIcon Kind="wand-2" Size="15" Foreground="{DynamicResource MarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>

          <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Command="{Binding CloseCommand}"
                  ToolTip="{Binding [Studio.Chat.Close], Source={x:Static services:I18n.Instance}}">
            <controls:LucideIcon Kind="x" Size="14"/>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Height="28" Padding="11,0" FontSize="12"
                  Margin="0,0,8,0" Command="{Binding StopCommand}"
                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="square" Size="11" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding [Studio.Chat.Stop], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>

          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Studio.Chat.Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,1,0,0"
                       Foreground="{DynamicResource InkFaintBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding Status}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ── « Ce que j'ai retenu » ── -->
      <Button DockPanel.Dock="Top" Style="{StaticResource RecapHeader}" Command="{Binding ToggleRecapCommand}">
        <DockPanel>
          <controls:LucideIcon DockPanel.Dock="Left" Kind="{Binding RecapIcon}" Size="13" Margin="0,0,9,0"
                               Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoText}" FontSize="10.5"
                     VerticalAlignment="Center" Foreground="{DynamicResource InkFaintBrush}"
                     Text="{Binding RecapProgress}"/>
          <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource InkBrush}"
                     Text="{Binding [Studio.Chat.Recap], Source={x:Static services:I18n.Instance}}"/>
        </DockPanel>
      </Button>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
              BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsRecapExpanded, Converter={StaticResource BooleanToVisibility}}">
        <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" Padding="16,13">
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,9">
                  <controls:LucideIcon DockPanel.Dock="Left" Size="13" Margin="0,2,9,0" VerticalAlignment="Top">
                    <controls:LucideIcon.Style>
                      <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                        <Setter Property="Kind" Value="circle-help"/>
                        <Setter Property="Foreground" Value="{DynamicResource LineStrongBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsKnown}" Value="True">
                            <Setter Property="Kind" Value="circle-check"/>
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </controls:LucideIcon.Style>
                  </controls:LucideIcon>
                  <StackPanel>
                    <TextBlock FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Label}"/>
                    <TextBlock FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap" Text="{Binding Value}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKnown}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                              <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- ── the composer, docked bottom so the messages take what is left ── -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}" Padding="16,11,16,13"
              BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,9"
                        Visibility="{Binding IsAsking, Converter={StaticResource BooleanToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource QuickChip}" Content="{Binding Label}"
                        CommandParameter="{Binding Value}"
                        Command="{Binding DataContext.PickChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Height="38" Padding="15,0"
                    Margin="9,0,0,0" VerticalAlignment="Bottom" Command="{Binding SendCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SendLabel}" Margin="0,0,7,0"/>
                <controls:LucideIcon Kind="arrow-right" Size="13" Foreground="{DynamicResource AccentFgBrush}"/>
              </StackPanel>
            </Button>
            <Grid>
              <TextBox x:Name="Composer" Style="{StaticResource Input}" MinHeight="46" TextWrapping="Wrap"
                       AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12.5"
                       Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <!-- Enter sends, Shift+Enter opens a line — the mock's own contract, and
                       the footer says so under the box. -->
                  <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
              </TextBox>
              <!-- The placeholder: the question's own example while one is on the table,
                   the neutral invitation otherwise. WPF has no watermark, and one overlay
                   is cheaper than an attached property nothing else would use. -->
              <TextBlock IsHitTestVisible="False" FontSize="12.5" Margin="12,10,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Placeholder}"
                         Visibility="{Binding Text, ElementName=Composer, Converter={StaticResource StringPresentToVisibility}, ConverterParameter=invert}"/>
            </Grid>
          </DockPanel>

          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Command="{Binding SkipCommand}"
                    Visibility="{Binding IsAsking, Converter={StaticResource BooleanToVisibility}}"
                    Content="{Binding [Studio.Chat.Skip], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10" Foreground="{DynamicResource InkFaintBrush}"
                       Text="{Binding [Studio.Chat.KeyHint], Source={x:Static services:I18n.Instance}}"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- ── the messages ── -->
      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

          <!-- the brief, pinned: what the whole conversation is about -->
          <Border Background="{DynamicResource PaperSunkBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,0,0,13"
                  Visibility="{Binding ShowsBrief, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Command="{Binding CloseCommand}"
                        Foreground="{DynamicResource AccentBrush}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="pencil" Size="11" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding [Studio.Chat.Edit], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Eyebrow}" FontSize="9.5" VerticalAlignment="Center"
                           Text="{Binding [Studio.Chat.YourBrief], Source={x:Static services:I18n.Instance}}"/>
              </DockPanel>
              <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18.5"
                         Foreground="{DynamicResource InkBrush}" Text="{Binding Brief}"/>
              <ItemsControl ItemsSource="{Binding BriefChips}" Margin="0,9,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource BriefChip}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource InkMutedBrush}" Text="{Binding}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- nothing said yet: the primer, which is different on every screen -->
          <DockPanel Margin="0,0,0,13" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                    Margin="0,0,9,0" Background="{DynamicResource AccentWeakBrush}">
              <controls:LucideIcon Kind="wand-2" Size="13" Foreground="{DynamicResource MarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="4,13,13,13" Padding="13,11" HorizontalAlignment="Left">
              <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="18.5"
                         Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Primer}"/>
            </Border>
          </DockPanel>

          <ItemsControl ItemsSource="{Binding Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,13">
                  <!-- the assistant, on the left, with its mark -->
                  <DockPanel Visibility="{Binding IsBot, Converter={StaticResource BooleanToVisibility}}">
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                            Margin="0,0,9,0" Background="{DynamicResource AccentWeakBrush}">
                      <controls:LucideIcon Kind="wand-2" Size="13" Foreground="{DynamicResource MarkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="4,13,13,13" Padding="13,11" HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource SkyBrush}"/>
                          <Style.Triggers>
                            <!-- the closing bubble: the brief is complete, and it reads that way -->
                            <DataTrigger Binding="{Binding IsClosing}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                              <Setter Property="BorderBrush" Value="{DynamicResource SuccessWeakBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource InkBrush}" Text="{Binding Body}"/>
                        <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="18.5"
                                   Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Detail}"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibility}}"/>
                        <TextBlock FontSize="11.5" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="17"
                                   Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Hint}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasHint}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DockPanel>

                  <!-- the user, on the right, no avatar: the corner says who spoke -->
                  <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentWeakBrush}"
                          BorderThickness="1" CornerRadius="13,4,13,13" Padding="13,11" HorizontalAlignment="Right"
                          Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource InkBrush}" Text="{Binding Body}"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- working: three dots and the sentence the user reads, the other register of
               the same beat the mono header line shows -->
          <DockPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"
                    Margin="0,0,9,0" Background="{DynamicResource AccentWeakBrush}">
              <controls:LucideIcon Kind="wand-2" Size="13" Foreground="{DynamicResource MarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="4,13,13,13" Padding="14,10" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0">
                  <Ellipse x:Name="Dot1" Style="{StaticResource ChatDot}"/>
                  <Ellipse x:Name="Dot2" Style="{StaticResource ChatDot}"/>
                  <Ellipse x:Name="Dot3" Style="{StaticResource ChatDot}" Margin="0"/>
                </StackPanel>
                <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Thinking}"/>
              </StackPanel>
              <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                       From="0.26" To="1" Duration="0:0:0.44" AutoReverse="True" BeginTime="0:0:0"/>
                      <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                       From="0.26" To="1" Duration="0:0:0.44" AutoReverse="True" BeginTime="0:0:0.16"/>
                      <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                       From="0.26" To="1" Duration="0:0:0.44" AutoReverse="True" BeginTime="0:0:0.32"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
            </Border>
          </DockPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</UserControl>
