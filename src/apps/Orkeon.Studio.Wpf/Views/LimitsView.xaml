<!-- The "Limites & journaux" settings tab (design v3, expert only): rate limits, the RAG
     index and the logging sections. DataContext: ConfigTabViewModel (bound as Settings.Config).
     Card titles are plain language (T-08); the literal configuration key rides each title's tooltip — technical
     identifiers, identical in every language, hence not routed through I18n. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.LimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Config"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <!-- ══ Two-column grid of the smaller section cards ══ -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- RateLimiting -->
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="gauge" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" ToolTip="RateLimiting"
                     Text="{Binding [Studio.Settings.CardRate], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-10,0,14" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.DefaultsApply], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding RateLimiting.Exists, Converter={StaticResource InverseBooleanToVisibility}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblMaxConcurrent], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.MaxConcurrentRequests, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblGlobalRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.GlobalRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblProviderRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.ProviderRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblAgentRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.AgentRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblQueueLimit], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.QueueLimit, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>

      <!-- Orkeon:Rag -->
      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="database" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" ToolTip="Orkeon:Rag"
                     Text="{Binding [Studio.Settings.CardRag], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-10,0,14" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.DefaultsApply], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding Rag.Exists, Converter={StaticResource InverseBooleanToVisibility}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblRagProfile], Source={x:Static services:I18n.Instance}}"/>
          <ComboBox ItemsSource="{x:Static config:RagSectionViewModel.KnownProfiles}" SelectedItem="{Binding Rag.Profile}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblRagProvider], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding Rag.Provider, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblRagConnection], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource InputMono}" Text="{Binding Rag.ConnectionString, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Margin="0,12,0,0" IsChecked="{Binding Rag.HybridRetrievalEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Studio.Settings.RagHybrid], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding Rag.CorrectiveWebFallbackEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Studio.Settings.RagCorrectiveWebFallback], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding Rag.WebFallbackEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Studio.Settings.RagWebFallback], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0" Text="{Binding Rag.WebFallbackStatus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblCorrectiveMaxIterations], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding Rag.CorrectiveMaxIterations, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>

      <!-- Logging:LogLevel -->
      <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="scroll-text" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" ToolTip="Logging:LogLevel"
                     Text="{Binding [Studio.Settings.CardLogging], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-10,0,14" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.DefaultsApply], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding Logging.Exists, Converter={StaticResource InverseBooleanToVisibility}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblDefaultLevel], Source={x:Static services:I18n.Instance}}"/>
          <ComboBox ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}" SelectedItem="{Binding Logging.DefaultLevel}"/>
          <ItemsControl ItemsSource="{Binding Logging.Categories}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,7">
                  <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                            ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}"
                            SelectedItem="{Binding Level}"/>
                  <TextBox Style="{StaticResource InputMono}" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
            <Button Style="{StaticResource BtnGhost}" Command="{Binding Logging.AddCategoryCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Settings.AddCategory], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnGhost}" Command="{Binding Logging.RemoveCategoryCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Settings.SectionRemove], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- LlmLogging -->
      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="logs" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" ToolTip="LlmLogging"
                     Text="{Binding [Studio.Settings.CardLlmLog], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-10,0,14" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.DefaultsApply], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding LlmLogging.Exists, Converter={StaticResource InverseBooleanToVisibility}}"/>
          <CheckBox IsChecked="{Binding LlmLogging.FullEmbeddingLog}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Studio.Settings.LlmLogFullEmbedding], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding LlmLogging.LogStreamingExchanges}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Studio.Settings.LlmLogStreaming], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Studio.Settings.LblMaxBodyLength], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding LlmLogging.MaxBodyLengthChars, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
</UserControl>
