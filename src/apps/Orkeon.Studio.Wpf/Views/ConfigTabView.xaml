<UserControl x:Class="Orkeon.Studio.Wpf.Views.ConfigTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
             xmlns:config="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Config">

  <DockPanel Margin="{StaticResource PanelPadding}">

    <!-- Toolbar: the file-level actions of §4.3 and the diagnostic of §4.4. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource SectionMargin}">
      <Button Content="New" Command="{Binding NewCommand}" Width="80" Margin="0,0,6,0" />
      <Button Content="Open…" Command="{Binding OpenCommand}" Width="80" Margin="0,0,6,0" />
      <Button Content="Reload" Command="{Binding LoadFromLocationCommand}" Width="80" Margin="0,0,6,0" />
      <Button Content="Validate" Command="{Binding ValidateCommand}" Width="80" Margin="0,0,6,0" />
      <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,18,0" />
      <Button Content="Diagnostic (orkeon doctor)" Command="{Binding Diagnostic.RunCommand}" Width="200" />
    </StackPanel>

    <!-- Status strip: what was loaded or saved, and the validation verdict. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource Hint}" />
      <ListBox ItemsSource="{Binding ValidationMessages}"
               MaxHeight="120"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <TabControl>

      <!-- §4.2 presets, §4.3 save location. -->
      <TabItem Header="Start">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PanelPadding}">
          <StackPanel>

            <TextBlock Style="{StaticResource CardTitle}" Text="Preset" />
            <ComboBox ItemsSource="{x:Static config:PresetSelectionViewModel.Catalog}"
                      SelectedItem="{Binding Presets.SelectedPreset}"
                      DisplayMemberPath="Title"
                      Margin="{StaticResource FieldMargin}" />
            <TextBlock Text="{Binding Presets.Description}" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
            <TextBox Text="{Binding Presets.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Model" />
            <TextBox Text="{Binding Presets.Model, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="API key (leave empty to use the environment variable)" />
            <TextBox Text="{Binding Presets.ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />

            <Button Content="Apply preset" Command="{Binding Presets.ApplyCommand}" Width="140" HorizontalAlignment="Left" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Presets.ErrorMessage}" Style="{StaticResource Hint}"
                       Visibility="{Binding Presets.ErrorMessage, Converter={StaticResource StringPresentToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Presets.Guidance}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Hint}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource CardTitle}" Text="Where the file is saved" Margin="0,18,0,6" />
            <RadioButton Content="Global per-user file" IsChecked="{Binding Location.IsGlobal, Mode=OneWay}"
                         Command="{Binding Location.UseGlobalCommand}" />
            <TextBlock Text="{Binding Location.GlobalPath}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding Location.GlobalPathError}" Style="{StaticResource Hint}"
                       Visibility="{Binding Location.GlobalPathError, Converter={StaticResource StringPresentToVisibility}}" />

            <RadioButton Content="A path I choose" IsChecked="{Binding Location.IsCustom, Mode=OneWay}" Margin="0,6,0,0" />
            <DockPanel Margin="{StaticResource FieldMargin}">
              <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="6,0,0,0" Command="{Binding Location.BrowseCommand}" />
              <TextBox Text="{Binding Location.CustomPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <TextBlock Style="{StaticResource CardTitle}" Text="Which file the runtime will actually load" Margin="0,12,0,6" />
            <ItemsControl ItemsSource="{Binding Location.ResolutionChain}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Hint}">
                    <Run Text="{Binding Order, Mode=OneWay}" />
                    <Run Text=". " />
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" — " />
                    <Run Text="{Binding Description, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- §4.1 typed forms. -->
      <TabItem Header="Sections">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PanelPadding}">
          <StackPanel>

            <TextBlock Style="{StaticResource CardTitle}" Text="Llm" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Model" />
            <TextBox Text="{Binding Llm.Model, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
            <TextBox Text="{Binding Llm.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource Hint}">
              <Run Text="Detected provider (read-only, inferred from the host): " />
              <Run Text="{Binding Llm.DetectedProviderDisplay, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
            <TextBox Text="{Binding Llm.ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Text="{Binding Llm.ApiKeyRecommendation, Mode=OneWay}" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Temperature" />
            <TextBox Text="{Binding Llm.Temperature, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Max tokens" />
            <TextBox Text="{Binding Llm.MaxTokens, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout (seconds)" />
            <TextBox Text="{Binding Llm.TimeoutSeconds, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />

            <!-- §4.2: optional connectivity probe. It reports, it never gates the save. -->
            <Button Content="Test connection" Command="{Binding Llm.TestConnectionCommand}"
                    Width="140" HorizontalAlignment="Left" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Llm.ConnectionTestResult}" Style="{StaticResource Hint}"
                       Visibility="{Binding Llm.ConnectionTestResult, Converter={StaticResource StringPresentToVisibility}}" />

            <TextBlock Style="{StaticResource CardTitle}" Text="RateLimiting" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Max concurrent requests" />
            <TextBox Text="{Binding RateLimiting.MaxConcurrentRequests, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Global requests / minute" />
            <TextBox Text="{Binding RateLimiting.GlobalRequestsPerMinute, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider requests / minute" />
            <TextBox Text="{Binding RateLimiting.ProviderRequestsPerMinute, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Agent requests / minute" />
            <TextBox Text="{Binding RateLimiting.AgentRequestsPerMinute, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Queue limit" />
            <TextBox Text="{Binding RateLimiting.QueueLimit, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />

            <TextBlock Style="{StaticResource CardTitle}" Text="Orkeon:Rag" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Profile" />
            <ComboBox ItemsSource="{x:Static config:RagSectionViewModel.KnownProfiles}"
                      SelectedItem="{Binding Rag.Profile}"
                      Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider" />
            <TextBox Text="{Binding Rag.Provider, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Connection string" />
            <TextBox Text="{Binding Rag.ConnectionString, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMargin}" />
            <CheckBox Content="Hybrid retrieval (BM25 + RRF)" IsChecked="{Binding Rag.HybridRetrievalEnabled}" Margin="{StaticResource FieldMargin}" />
            <CheckBox Content="Corrective web fallback — policy" IsChecked="{Binding Rag.CorrectiveWebFallbackEnabled}" Margin="{StaticResource FieldMargin}" />
            <CheckBox Content="Web fallback — transport" IsChecked="{Binding Rag.WebFallbackEnabled}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Text="{Binding Rag.WebFallbackStatus}" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Corrective max iterations" />
            <TextBox Text="{Binding Rag.CorrectiveMaxIterations, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />

            <TextBlock Style="{StaticResource CardTitle}" Text="Logging:LogLevel" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Default level" />
            <ComboBox ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}"
                      SelectedItem="{Binding Logging.DefaultLevel}"
                      Margin="{StaticResource FieldMargin}" />
            <ItemsControl ItemsSource="{Binding Logging.Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="{StaticResource FieldMargin}">
                    <ComboBox DockPanel.Dock="Right"
                              Width="160"
                              Margin="6,0,0,0"
                              ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}"
                              SelectedItem="{Binding Level}" />
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=LostFocus}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="Add category" Command="{Binding Logging.AddCategoryCommand}" Width="120" Margin="0,0,6,0" />
              <Button Content="Remove" Command="{Binding Logging.RemoveCategoryCommand}" Width="80" />
            </StackPanel>

            <TextBlock Style="{StaticResource CardTitle}" Text="LlmLogging" Margin="0,18,0,6" />
            <CheckBox Content="Log full embedding payloads" IsChecked="{Binding LlmLogging.FullEmbeddingLog}" Margin="{StaticResource FieldMargin}" />
            <CheckBox Content="Log streaming exchanges" IsChecked="{Binding LlmLogging.LogStreamingExchanges}" Margin="{StaticResource FieldMargin}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Max body length (chars)" />
            <TextBox Text="{Binding LlmLogging.MaxBodyLengthChars, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource FieldMargin}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- §4.5 mount editor. -->
      <TabItem Header="Mounts">
        <views:MountsEditorView DataContext="{Binding Mounts}" Margin="{StaticResource PanelPadding}" />
      </TabItem>

      <!-- §4.1 raw view: read-only, so an edit can never bypass the forms and the validation. -->
      <TabItem Header="Raw JSON">
        <TextBox Text="{Binding RawJson, Mode=OneWay}"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
      </TabItem>

      <!-- §4.4 diagnostic. -->
      <TabItem Header="Diagnostic">
        <DockPanel Margin="{StaticResource PanelPadding}">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostic.Summary}" Style="{StaticResource CardTitle}" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding Diagnostic.ErrorMessage}" Style="{StaticResource Hint}"
                     Visibility="{Binding Diagnostic.ErrorMessage, Converter={StaticResource StringPresentToVisibility}}" />
          <ListBox ItemsSource="{Binding Diagnostic.Checks}"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding Glyph, Mode=OneWay}" />
                  <Run Text=" " />
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" — " />
                  <Run Text="{Binding Detail, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>

</UserControl>
