<!-- The "JSON brut" settings tab (design v3, expert only): the settings file itself — where
     it lives, how the runtime resolves it, the file actions, and its read-only mirror.
     DataContext: ConfigTabViewModel (bound as Settings.Config). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.SettingsFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <!-- Lot 11: the last outcome, « Loaded: path » included — the screen's header leaves it here. -->
    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding StatusMessage}"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <!-- file actions -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Button Style="{StaticResource BtnSecondary}" Command="{Binding NewCommand}" Margin="0,0,8,0"
              controls:ButtonIcon.Kind="file-plus-2" Content="{Binding [Studio.Common.New], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource BtnSecondary}" Command="{Binding OpenCommand}" Margin="0,0,8,0"
              controls:ButtonIcon.Kind="folder-open" Content="{Binding [Studio.Common.Open], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource BtnSecondary}" Command="{Binding LoadFromLocationCommand}"
              controls:ButtonIcon.Kind="rotate-cw" Content="{Binding [Studio.Common.Reload], Source={x:Static services:I18n.Instance}}"/>
    </StackPanel>

    <!-- ══ Save location card ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <controls:LucideIcon Kind="hard-drive" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.LocationTitle], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>

        <RadioButton Style="{StaticResource PickRow}" GroupName="Loc" Margin="0,0,0,8"
                     IsChecked="{Binding Location.IsGlobal, Mode=OneWay}" Command="{Binding Location.UseGlobalCommand}">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Eyebrow}" FontSize="13" VerticalAlignment="Center"
                         Text="{Binding [Studio.Settings.Default], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding [Studio.Settings.LocationGlobal], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
            <!-- B06 (R09): the path on one line, cut in the middle, whole in its tooltip. -->
            <controls:MiddleEllipsisText Style="{StaticResource PathText}" Margin="0,3,0,0" HorizontalAlignment="Stretch"
                                         Text="{Binding Location.GlobalPath}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,3,0,0"
                       Text="{Binding Location.GlobalPathError}"
                       Visibility="{Binding Location.GlobalPathError, Converter={StaticResource StringPresentToVisibility}}"/>
          </StackPanel>
        </RadioButton>

        <RadioButton Style="{StaticResource PickRow}" GroupName="Loc" IsChecked="{Binding Location.IsCustom, Mode=OneWay}"
                     Checked="OnCustomLocationChecked">
          <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,7"
                       Text="{Binding [Studio.Settings.Custom], Source={x:Static services:I18n.Instance}}"/>
            <DockPanel MinWidth="520">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" FontSize="13" Margin="8,0,0,0"
                      Command="{Binding Location.BrowseCommand}"
                      Content="{Binding [Studio.Common.Browse], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" FontSize="13"
                       Text="{Binding Location.CustomPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- ══ Resolution chain card ══ -->
    <Border x:Name="ChainCard" Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <controls:LucideIcon Kind="route" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.ChainTitle], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="{Binding [Studio.Settings.Hint], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Location.ResolutionChain}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                        Background="{DynamicResource AccentWeakBrush}" Margin="0,0,13,0">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="{Binding Order}"/>
                </Border>
                <StackPanel>
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{Binding Description}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- where a Save will actually land, so the chain above has a visible anchor -->
        <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="13,9" Margin="0,4,0,0">
          <!-- B06 (R09): the label keeps its width, the path takes the rest and is cut in the middle. -->
          <DockPanel>
            <controls:LucideIcon DockPanel.Dock="Left" Kind="save" Size="13" Foreground="{DynamicResource AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" FontSize="13" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                       Text="{Binding [Studio.Settings.SaveTarget], Source={x:Static services:I18n.Instance}}"/>
            <Grid Margin="8,0,0,0">
              <controls:MiddleEllipsisText Style="{StaticResource PathText}"
                                           Text="{Binding Location.GlobalPath}"
                                           Visibility="{Binding Location.IsGlobal, Converter={StaticResource BooleanToVisibility}}"/>
              <controls:MiddleEllipsisText Style="{StaticResource PathText}"
                                           Text="{Binding Location.CustomPath}"
                                           Visibility="{Binding Location.IsCustom, Converter={StaticResource BooleanToVisibility}}"/>
            </Grid>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ══ Read-only mirror ══ -->
    <views:RawJsonView/>

  </StackPanel>
</UserControl>
