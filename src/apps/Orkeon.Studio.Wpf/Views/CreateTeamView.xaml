<!-- The "Créer une équipe" wizard (design v3): Décrire ▸ Composer ▸ Essayer ▸ Adopter over
     the forge engine. DataContext: CreateTeamViewModel (bound as CreateTeam in MainWindow).
     The engine owns the cycle — every control here sends one of its own gestures. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.CreateTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <!-- The check of a validated step: green on the pill at rest, the accent's own ink on the
         pill of the step on screen (filled with the accent). -->
    <Style x:Key="StepCheck" TargetType="controls:LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The action bar at the end of a step (lot 3): a line above it, the state on the
         left, « Back » and the step's gesture on the right. -->
    <!-- The footer of a step's pane (R14): a faint line above, the pane's state on the left,
         its button on the right. -->
    <Style x:Key="PaneFooter" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource LineFaintBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,12,0,0"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>
    <Style x:Key="WizardActionBar" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,14,0,0"/>
      <Setter Property="Margin" Value="0,16,0,16"/>
    </Style>
    <!-- One fiche of the team's folders (F-01, lot 3; STUDIO-14; refonte lot 10): line 1, the
         rights' icon, the name the agents address (mono), its rights, who addresses it, where
         the folder lies and « Remove »; line 2, the note; a folder still to choose, in the
         warning's weak tint, gets a line 3 with the two answers. -->
    <DataTemplate x:Key="MountRowTemplate">
      <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanChooseFolder}" Value="True">
                <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
              </DataTrigger>
              <!-- Red is for a physical folder genuinely outside the settings'
                   authorized list — never for a root with no folder behind it. -->
              <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto" MaxWidth="380"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Foreground is a Setter, not a local value: a local value beats every style
                 trigger, so the red below would be unreachable. -->
            <controls:LucideIcon Size="16" VerticalAlignment="Center" Margin="0,0,8,0">
              <controls:LucideIcon.Style>
                <Style TargetType="controls:LucideIcon">
                  <Setter Property="Kind" Value="folder-open"/>
                  <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                  <Setter Property="IsTabStop" Value="False"/>
                  <Setter Property="Focusable" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                      <Setter Property="Kind" Value="pencil"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:LucideIcon.Style>
            </controls:LucideIcon>
            <!-- A plain-words title («Your documents») when the row has one, then the name the
                 agents use. Who addresses it is provenance, not permission: the runtime mounts
                 one flat list. -->
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Agents}">
              <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}"/>
              <Run Text="{Binding VirtualPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                   Foreground="{DynamicResource InkBrush}"/>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
              <controls:Badge>
                <controls:Badge.Style>
                  <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                    <Setter Property="Content" Value="{Binding [Studio.Create.RightsRead], Source={x:Static services:I18n.Instance}}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                        <Setter Property="Content" Value="{Binding [Studio.Create.RightsReadWrite], Source={x:Static services:I18n.Instance}}"/>
                        <Setter Property="Tone" Value="Info"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:Badge.Style>
              </controls:Badge>
              <TextBlock FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource InkFaintBrush}"
                         TextTrimming="CharacterEllipsis" Text="{Binding Agents}"
                         Visibility="{Binding HasAgents, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
            <!-- Where the folder lies, on the right: a disk path (mono, cut in the middle),
                 «inside the team: output» in the accent colour, or «to choose». -->
            <controls:MiddleEllipsisText Grid.Column="3" Style="{StaticResource PathText}" Margin="12,0,0,0"
                                         HorizontalAlignment="Right" Text="{Binding Folder}"
                                         Visibility="{Binding IsRealFolder, Converter={StaticResource BooleanToVisibility}}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                        Visibility="{Binding IsInsideTeam, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="folder" Size="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" Text="{Binding Folder}"/>
            </StackPanel>
            <controls:Badge Grid.Column="3" Tone="Warning" HorizontalAlignment="Right" Margin="12,0,0,0"
                            Content="{Binding [Studio.Create.MountToChoose], Source={x:Static services:I18n.Instance}}"
                            Visibility="{Binding IsWriteToChoose, Converter={StaticResource BooleanToVisibility}}"/>
            <!-- A read root with no source folder: what the team will start from instead. -->
            <TextBlock Grid.Column="3" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource WarningBrush}"
                       Text="{Binding [Studio.Create.MountToChooseRead], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding IsReadToChoose, Converter={StaticResource BooleanToVisibility}}"/>
            <!-- Removing a bound folder gives the mount point back to the blueprint; removing a
                 bare implied root drops it, which the banner then explains. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                      Command="{Binding DataContext.RemoveTeamMountCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                      CommandParameter="{Binding MountString}"
                      ToolTip="{Binding [Studio.Create.RemoveFolder], Source={x:Static services:I18n.Instance}}"
                      Visibility="{Binding IsBound, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="x" Size="16" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding [Studio.Create.RemoveShort], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                      Command="{Binding DataContext.RemoveDerivedMountCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                      CommandParameter="{Binding VirtualPath}"
                      ToolTip="{Binding [Studio.Create.RemoveFolder], Source={x:Static services:I18n.Instance}}"
                      Visibility="{Binding IsDroppable, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="x" Size="16" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding [Studio.Create.RemoveShort], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Line 2: the note the step-1 fiche gave the folder. -->
          <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="24,4,0,0" TextTrimming="CharacterEllipsis"
                     Text="{Binding Note}" ToolTip="{Binding Note}"
                     Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibility}}"/>
          <!-- Line 3, a folder still to choose: name the folder, or give it its own inside the
               team, created at adoption and recorded team-relative (STUDIO-14, D-08). -->
          <StackPanel Orientation="Horizontal" Margin="24,8,0,0"
                      Visibility="{Binding CanChooseFolder, Converter={StaticResource BooleanToVisibility}}">
            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0"
                    Command="{Binding DataContext.BindMountCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                    CommandParameter="{Binding VirtualPath}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Create.ChooseFolder], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                    Command="{Binding DataContext.CreateInsideTeamCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                    CommandParameter="{Binding VirtualPath}"
                    Visibility="{Binding CanCreateInsideTeam, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="folder" Size="16" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Create.CreateInsideTeam], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>

    <!-- R3 (lot 3): one header, title and subtitle on the left, the page's two doors on the
         right. The question to the assistant lives in the title bar, the creation's tokens in
         the status bar, the engine build in the technical journal. -->
    <controls:PageHeader Title="{Binding [Studio.Create.Title], Source={x:Static services:I18n.Instance}}"
                         Subtitle="{Binding [Studio.Create.ScreenSub], Source={x:Static services:I18n.Instance}}"
                         Margin="0,0,0,8">
      <StackPanel Style="{StaticResource ActionRow}">
        <!-- STUDIO-14 (D-15): « Open the folder », an Expert door — the working session while
             the team is being made, the adopted team afterwards; the tooltip says which. -->
        <ContentControl Focusable="False" Margin="0,0,8,0"
                        Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                  Command="{Binding OpenFolderCommand}"
                  ToolTip="{Binding OpenFolderTooltip}" ToolTipService.ShowOnDisabled="True"
                  Visibility="{Binding HasShellOpener, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Create.OpenFolder], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
        </ContentControl>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40" Command="{Binding RestartCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="rotate-ccw" Size="16" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Create.Restart], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </controls:PageHeader>
    <!-- The assistant line: which profile drives the composing (the status bar names the
         default profile, not this one). A missing assistant is the gate's to say. -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                Visibility="{Binding HasAssistant, Converter={StaticResource BooleanToVisibility}}">
      <controls:LucideIcon Kind="wand-2" Size="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"
                 Text="{Binding [Studio.Create.AssistantBy], Source={x:Static services:I18n.Instance}}"/>
      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" Margin="4,0,0,0"
                 VerticalAlignment="Center" Text="{Binding Profiles.StudioProfileName}"/>
    </StackPanel>
    <!-- §F.5: «Votre solution est prête.» and friends as a faint line, not raw mono -->
    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" Text="{Binding StatusMessage}"
               TextWrapping="Wrap"/>

    <!-- STUDIO-27 (D-05): an adopted team that is scheduled runs only once the user agrees —
         « Install » asks the engine, which installs it with the system's own scheduler; « Later »
         leaves it installable from its card in My teams. -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            CornerRadius="14" Padding="18,14" MaxWidth="720" HorizontalAlignment="Left" Margin="0,12,0,0"
            DataContext="{Binding ScheduleOffer}"
            Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="circle-help" Size="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0"
                     TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Question}"/>
        </StackPanel>
        <!-- STUDIO-52: what the team's scheduled run cannot follow — the default in place of a setting
             no crew can name, above all —, said before anything is installed. -->
        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"
                   TextWrapping="Wrap" Text="{Binding Notice}"
                   Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding [Studio.Create.ScheduleOfferHint], Source={x:Static services:I18n.Instance}}"/>
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding InstallCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="check" Size="16" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Studio.Create.ScheduleInstallNow], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnSecondary}" Command="{Binding LaterCommand}"
                  Content="{Binding [Studio.Create.ScheduleLater], Source={x:Static services:I18n.Instance}}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- …and what became of it, in one line: installed, left for later, kept — or refused, with
         the command a person can run by hand. -->
    <StackPanel Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding ScheduleOffer}"
                Visibility="{Binding HasOutcome, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Text="{Binding Outcome}"/>
      <StackPanel Visibility="{Binding HasManualCommand, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2"
                   Text="{Binding [Studio.Teams.ScheduleManual], Source={x:Static services:I18n.Instance}}"/>
        <TextBox Style="{StaticResource InputMono}" IsReadOnly="True" TextWrapping="Wrap"
                 Text="{Binding ManualCommand, Mode=OneWay}"/>
      </StackPanel>
    </StackPanel>

    <!-- STUDIO-13: the failure, in BOTH modes (D-01), as a danger alert (R7): the novice
         sentence of the family, the engine's own words folded under « Technical details » —
         never translated (STUDIO-11) — and the ways out under the message. -->
    <controls:Alert Tone="Danger" MaxWidth="720" HorizontalAlignment="Left" Margin="0,14,0,0"
                    Message="{Binding Failure.Headline}" Details="{Binding Failure.Detail}"
                    Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}">
      <WrapPanel>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Click="OnCopyFailureReport"
                Visibility="{Binding CanCopyFailureReport, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="copy" Size="16" Margin="0,0,7,0"/>
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Studio.Create.FailureCopyReport], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FailureReportCopied}" Value="True">
                      <Setter Property="Text" Value="{Binding [Studio.Create.FailureCopied], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding FailureRetryCommand}"
                Visibility="{Binding FailureOffersRetry, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="rotate-cw" Size="16" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Create.FailureRetry], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding OpenDiagnosticCommand}"
                Visibility="{Binding FailureOffersDiagnostic, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="stethoscope" Size="16" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Create.FailureOpenDiagnostic], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}"
                Visibility="{Binding FailureOffersSettings, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="sliders-horizontal" Size="16" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Create.FailureOpenSettings], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </controls:Alert>

    <!-- Before anything: the assistant must have a model — the wizard is gated until then (R7). -->
    <controls:Alert x:Name="AssistantGate" Tone="Warning" MaxWidth="720" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Message="{Binding [Studio.Create.GateTitle], Source={x:Static services:I18n.Instance}}"
                    Visibility="{Binding NeedsAssistant, Converter={StaticResource BooleanToVisibility}}">
      <controls:Alert.Actions>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding OpenSettingsCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="sliders-horizontal" Size="16" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Create.ManageSettings], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </controls:Alert.Actions>
      <StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{Binding [Studio.Create.GateBody], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Profiles.Profiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- audit 02/10: the gate is a radio list (PickRow), not anonymous buttons -->
              <RadioButton Style="{StaticResource PickRow}" GroupName="GateProfile" Margin="0,0,0,7"
                           Command="{Binding DataContext.CreateTeam.PickAssistantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" Text="{Binding Summary}"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:Alert>

    <StackPanel Visibility="{Binding HasAssistant, Converter={StaticResource BooleanToVisibility}}">

      <!-- The stepper (lot 3): a validated step carries a green check, the step on screen is
           filled with the accent, a step already reached opens again; after the steps, the
           session's one state — running, waiting for you, paused with « Resume », or the
           draft saved at a time.
           hrm B08 (R14): the four steps and the state share a WrapPanel, steps first. A
           right-docked state used to be measured first in a DockPanel, so a narrow column
           (the assistant open, 011) gave it the room and cut the steps: « 4 Brouillon
           enregistré… » stood where « Adopter » should. Now the state sits right of the steps
           when the line holds both, and goes below them when it does not; a step is never cut. -->
      <WrapPanel Margin="0,16,0,20" Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
          <Button Style="{StaticResource StepPill}" Command="{Binding GoStep1Command}" Tag="{Binding IsStep1}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsStep1Done, Converter={StaticResource InverseBooleanToVisibility}}"/>
                <controls:LucideIcon Kind="check" Size="16" Style="{StaticResource StepCheck}"
                                     Visibility="{Binding IsStep1Done, Converter={StaticResource BooleanToVisibility}}"/>
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding [Studio.Create.Step1], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <controls:LucideIcon Kind="chevron-right" Size="16" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
          <Button Style="{StaticResource StepPill}" Command="{Binding GoStep2Command}" Tag="{Binding IsStep2}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsStep2Done, Converter={StaticResource InverseBooleanToVisibility}}"/>
                <controls:LucideIcon Kind="check" Size="16" Style="{StaticResource StepCheck}"
                                     Visibility="{Binding IsStep2Done, Converter={StaticResource BooleanToVisibility}}"/>
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding [Studio.Create.Step2], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <controls:LucideIcon Kind="chevron-right" Size="16" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
          <Button Style="{StaticResource StepPill}" Command="{Binding GoStep3Command}" Tag="{Binding IsStep3}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsStep3Done, Converter={StaticResource InverseBooleanToVisibility}}"/>
                <controls:LucideIcon Kind="check" Size="16" Style="{StaticResource StepCheck}"
                                     Visibility="{Binding IsStep3Done, Converter={StaticResource BooleanToVisibility}}"/>
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding [Studio.Create.Step3], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <controls:LucideIcon Kind="chevron-right" Size="16" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
          <Button Style="{StaticResource StepPill}" Command="{Binding GoStep4Command}" Tag="{Binding IsStep4}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                           />
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding [Studio.Create.Step4], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controls:LucideIcon Kind="loader-circle" Size="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                               Visibility="{Binding IsSessionWorking, Converter={StaticResource BooleanToVisibility}}">
            <controls:LucideIcon.RenderTransform>
              <RotateTransform x:Name="EngineSpin"/>
            </controls:LucideIcon.RenderTransform>
            <controls:LucideIcon.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="EngineSpin" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </controls:LucideIcon.Triggers>
          </controls:LucideIcon>
          <controls:LucideIcon Kind="save" Size="16" Foreground="{DynamicResource InkFaintBrush}" Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsDraftSaved, Converter={StaticResource BooleanToVisibility}}"/>
          <!-- R13: during a wait point the label is empty — the status bar names the wait and the
               folders tab carries the amber dot; « Stop » stays alone at the end of the line. -->
          <TextBlock Style="{StaticResource MetaText}" VerticalAlignment="Center" Text="{Binding SessionStateLabel}"
                     Visibility="{Binding HasSessionState, Converter={StaticResource BooleanToVisibility}}"/>
          <!-- The engine build that drives the session: a stale binary must not look like a working one. -->
          <TextBlock Style="{StaticResource MetaText}" Margin="9,0,0,0" VerticalAlignment="Center"
                     Text="{Binding EngineLabel}"
                     Visibility="{Binding HasEngineVersion, Converter={StaticResource BooleanToVisibility}}"/>
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="10,0,0,0"
                  Command="{Binding ResumeHereCommand}" controls:ButtonIcon.Kind="play"
                  Content="{Binding [Studio.Create.Resume], Source={x:Static services:I18n.Instance}}"
                  Visibility="{Binding IsSessionPaused, Converter={StaticResource BooleanToVisibility}}"/>
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="10,0,0,0" Command="{Binding StopCommand}"
                  controls:ButtonIcon.Kind="square"
                  Content="{Binding [Studio.Create.Stop], Source={x:Static services:I18n.Instance}}"
                  Visibility="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel>
      </WrapPanel>

      <!-- Lot 3: past step 1, the need sums up in one grey line under the stepper, with the
           way back to it. -->
      <Border Background="{DynamicResource PaperSunkBrush}" CornerRadius="8" Padding="12,6" Margin="0,-8,0,16"
              Visibility="{Binding IsStep1, Converter={StaticResource InverseBooleanToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="12,0,0,0"
                  Command="{Binding GoStep1Command}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="pencil" Size="16" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Create.Modify], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                     DockPanel.Dock="Left" Text="{Binding [Studio.Create.NeedSummaryLabel], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="6,0"
                     DockPanel.Dock="Left" Text="·"/>
          <TextBlock FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="{Binding NeedSummary}" ToolTip="{Binding Need}"/>
        </DockPanel>
      </Border>

      <!-- T-04: with the conversation closed, its state stays in the flow rather than
           disappearing with it — otherwise the assistant works, or waits, and the screen
           says nothing. It goes away the moment the thread is open: two headers saying the
           same thing is worse than none. -->
      <Border Padding="16,14" Margin="0,0,0,16"
              Visibility="{Binding Chat.IsLive, Converter={StaticResource BooleanToVisibility}}">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Chat.IsAsking}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,13,0"
                  VerticalAlignment="Center" Background="{DynamicResource AccentWeakBrush}">
            <controls:LucideIcon Kind="wand-2" Size="16" Foreground="{DynamicResource MarkBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button DockPanel.Dock="Right" controls:ButtonSize.Height="32" VerticalAlignment="Center"
                  Command="{Binding Chat.OpenCommand}" Content="{Binding Chat.StripAction}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Chat.IsAsking}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding Chat.StripTitle}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,2,0,0"
                       Foreground="{DynamicResource InkFaintBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding Chat.Status}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- The novice help rail (F-10): the step's plain-words explainer on the right;
           questions to the assistant live in each step's notes panel. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- T-07: the conversation takes the CONTENT column, it does not float over the
             screen. The help rail beside it keeps its 300 px and stays readable — an
             overlay, or a panel with a constant width, covers it the moment the window
             is resized. The width comes from the grid; nothing here names one. -->
        <StackPanel Grid.Column="0">
        <!-- The conversation lives in the shell's side panel (refonte R10): the step stays
             on screen while the user talks to the assistant. -->
        <StackPanel>
      <!-- ── STEP 1 : DÉCRIRE ── -->
      <!-- Refonte R14: step 1 in a vertical classeur of three tabs — the need, the team's
           folders, the composition instruction. Each tab carries its state (check, amber dot,
           empty circle) and its subtitle; each pane its own footer. The folders tab exists from
           the start, empty until the composition proposes them; when the engine waits on them
           it opens with the amber dot (R13). The step's action bar stays under the classeur. -->
      <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibility}}">
        <controls:StepTabs Margin="0,0,0,16" SelectedIndex="{Binding Step1TabIndex, Mode=TwoWay}">
          <!-- Under the tabs: the step's help in Novice, nothing in Expert. -->
          <controls:StepTabs.SideContent>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12"
                    Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <controls:LucideIcon Kind="circle-help" Size="16" Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Center"/>
                  <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0"
                             Text="{Binding [Studio.Create.HelpTitle], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="17.5"
                           Text="{Binding [Studio.Create.HelpStep1], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Border>
          </controls:StepTabs.SideContent>

          <!-- ── Need ── -->
          <controls:StepTab Header="{Binding [Studio.Create.TabNeed], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding NeedTabSubtitle}" State="{Binding NeedTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Command="{Binding ShowFoldersTabCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.SeeFolders], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding NeedFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.NeedTitle], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NeedSub], Source={x:Static services:I18n.Instance}}"/>
                <!-- STUDIO-47: files and folders dropped from the explorer land at the caret, quoted;
                     the Preview events take the drop before the TextBox, which refuses files. The
                     screen's main entry: 48 px at the least (R2). -->
                <TextBox x:Name="NeedBox" Style="{StaticResource InputMultiline}" AllowDrop="True" MinHeight="48"
                         PreviewDragEnter="OnNeedDragOver" PreviewDragOver="OnNeedDragOver"
                         PreviewDragLeave="OnNeedDragLeave" PreviewDrop="OnNeedDrop"
                         Text="{Binding Need, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NeedDropHint], Source={x:Static services:I18n.Instance}}"/>
                <!-- Lot 3: one line under the need — « Rephrase » (STUDIO-57) and « Back to my words »,
                     the use cases close to the need (STUDIO-39 D-03, their titles in the tooltip), then
                     the whole catalogue (D-01, D-02, its size read from the CLI). -->
                <WrapPanel Margin="0,8,0,0">
                  <Button Style="{StaticResource BtnAssistant}" controls:ButtonSize.Height="28" Margin="0,0,8,4"
                          Command="{Binding RephraseNeedCommand}"
                          ToolTip="{Binding [Studio.Create.RephraseTip], Source={x:Static services:I18n.Instance}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="sparkles" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.Rephrase], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,8,4"
                          Command="{Binding UndoRephraseCommand}"
                          Content="{Binding [Studio.Create.RephraseUndo], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding CanUndoRephrase, Converter={StaticResource BooleanToVisibility}}"/>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,8,4" VerticalAlignment="Center"
                             Text="{Binding [Studio.Create.Rephrasing], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding IsRephrasing, Converter={StaticResource BooleanToVisibility}}"/>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,8,4"
                          Command="{Binding ShowCloseUseCasesCommand}" ToolTip="{Binding CloseUseCasesTitles}"
                          Visibility="{Binding HasCloseUseCases, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="compass" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding CloseUseCasesLabel}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,8,4"
                          Command="{Binding BrowseUseCasesCommand}"
                          Visibility="{Binding CanBrowseUseCases, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="scan-search" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding BrowseUseCasesLabel}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <!-- STUDIO-39 (D-04): the use case this creation starts from — the chip a chosen card
                     leaves under the need it wrote. Its cross takes the reference away, never the words. -->
                <Border Style="{StaticResource BriefChip}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,0,4,0"
                        Visibility="{Binding HasReferenceUseCase, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="compass" Size="16" Foreground="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Center" Text="{Binding ReferenceUseCaseLabel}"/>
                    <Button Style="{StaticResource IconBtn}" Width="20" Height="20" Margin="6,0,0,0"
                            VerticalAlignment="Center" Command="{Binding RemoveReferenceUseCaseCommand}"
                            ToolTip="{Binding [Studio.Create.GalleryRemoveReference], Source={x:Static services:I18n.Instance}}"
                            AutomationProperties.Name="{Binding [Studio.Create.GalleryRemoveReference], Source={x:Static services:I18n.Instance}}">
                      <controls:LucideIcon Kind="x" Size="16" Foreground="{DynamicResource InkFaintBrush}"/>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- The quick examples as compact chips (lot 3), the whole sentence in the tooltip. -->
                <TextBlock Style="{StaticResource Eyebrow}" Margin="0,16,0,8"
                           Text="{Binding [Studio.Create.Examples], Source={x:Static services:I18n.Instance}}"/>
                <ItemsControl ItemsSource="{Binding Examples}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" MaxWidth="300"
                              Margin="0,0,8,6" ToolTip="{Binding}"
                              Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>

          <!-- ── The team's folders (STUDIO-46) ── -->
          <!-- Between the brief and the plan the forge proposes the folders the need names — or
               the defaults — and waits. Each fiche holds three lines with 104 px labels: the name
               in the team and its rights, the note the assistant follows, and where the folder
               lives. Once confirmed the fiches stay readable, no longer editable: a folder of this
               machine keeps « Change… », and while the engine waits on the drop (« Yes » to the
               fill question) the fiches kept inside the team gain a fourth line, « Files ». -->
          <controls:StepTab Header="{Binding [Studio.Create.TabFolders], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding FoldersTabSubtitle}" State="{Binding FoldersTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}"
                      Visibility="{Binding IsFoldersTabEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
                <DockPanel>
                  <Button x:Name="ConfirmFoldersButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}"
                          Command="{Binding ConfirmFoldersCommand}"
                          Visibility="{Binding IsFoldersStep, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.FoldersConfirm], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
                    </StackPanel>
                  </Button>
                  <!-- STUDIO-57: the drop is done — the engine reads folders.filled and designs the team. -->
                  <Button x:Name="FillContinueButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}"
                          Command="{Binding FillFoldersContinueCommand}"
                          Visibility="{Binding IsFillingFolders, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.FillFoldersContinue], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding FoldersFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.FoldersStepTitle], Source={x:Static services:I18n.Instance}}"/>
                <!-- Before the composition: the pane says when the folders come. -->
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.FoldersTabEmptyBody], Source={x:Static services:I18n.Instance}}"
                           Visibility="{Binding IsFoldersTabEmpty, Converter={StaticResource BooleanToVisibility}}"/>
                <StackPanel Visibility="{Binding IsFoldersTabEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
                  <!-- STUDIO-57: the subtitle says where the list comes from — the request, or the
                       standard proposal when the request named no folder. -->
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,12" TextWrapping="Wrap"
                             Text="{Binding FoldersStepSubtitle}"/>
                  <!-- Tag carries « still editable » to every fiche: once confirmed, only « Change… » and
                       « Open the folder » stay live. -->
                  <ItemsControl ItemsSource="{Binding FolderRows}" Tag="{Binding IsFoldersStep}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="Fiche" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineFaintBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="104"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Line 1: the name in the team, read / read and write, where the row came from. -->
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"
                                       Text="{Binding [Studio.Create.FolderFieldName], Source={x:Static services:I18n.Instance}}"/>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBox Style="{StaticResource Input}" Width="180" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                       AutomationProperties.Name="{Binding [Studio.Create.FolderFieldName], Source={x:Static services:I18n.Instance}}"
                                       IsReadOnly="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Negate}}"
                                       Text="{Binding VirtualPath, UpdateSourceTrigger=PropertyChanged}"/>
                              <!-- STUDIO-57: read, or read and write — the two halves flip the one role;
                                   the active half is the one that cannot be pressed. -->
                              <Border Style="{StaticResource SegmentedGroup}" Height="30" CornerRadius="15" Margin="10,0,0,0"
                                      IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      ToolTip="{Binding [Studio.Create.FolderRoleTip], Source={x:Static services:I18n.Instance}}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                  <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding ToggleRoleCommand}"
                                          Tag="{Binding IsInput}" IsEnabled="{Binding IsInput, Converter={StaticResource Negate}}"
                                          Content="{Binding [Studio.Create.FolderRoleRead], Source={x:Static services:I18n.Instance}}"/>
                                  <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding ToggleRoleCommand}"
                                          Tag="{Binding IsInput, Converter={StaticResource Negate}}" IsEnabled="{Binding IsInput}"
                                          Content="{Binding [Studio.Create.FolderRoleReadWrite], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Border>
                              <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding ShowsDeduced, Converter={StaticResource BooleanToVisibility}}">
                                <controls:LucideIcon Kind="sparkles" Size="14" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource InkFaintBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding [Studio.Create.FolderDeduced], Source={x:Static services:I18n.Instance}}"/>
                              </StackPanel>
                            </WrapPanel>
                            <!-- STUDIO-57: the cross takes the fiche off the list. -->
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" VerticalAlignment="Top"
                                    Command="{Binding RemoveCommand}" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibility}}"
                                    ToolTip="{Binding [Studio.Create.RemoveFolder], Source={x:Static services:I18n.Instance}}"
                                    AutomationProperties.Name="{Binding [Studio.Create.RemoveFolder], Source={x:Static services:I18n.Instance}}">
                              <controls:LucideIcon Kind="x" Size="16" Foreground="{DynamicResource InkMutedBrush}"/>
                            </Button>

                            <!-- Line 2: the note the assistant follows — what the folder holds and how
                                 the team must use it. The forge's words to start with. -->
                            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0"
                                       Text="{Binding [Studio.Create.FolderFieldNote], Source={x:Static services:I18n.Instance}}"/>
                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}">
                              <DockPanel>
                                <controls:LucideIcon DockPanel.Dock="Left" Kind="pencil" Size="14" Margin="10,0,0,0"
                                                     Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource Input}" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" AcceptsReturn="False" IsReadOnly="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Negate}}"
                                         Tag="{Binding [Studio.Create.FolderNotePlaceholder], Source={x:Static services:I18n.Instance}}"
                                         ToolTip="{Binding [Studio.Create.FolderPurposeHint], Source={x:Static services:I18n.Instance}}"
                                         AutomationProperties.Name="{Binding [Studio.Create.FolderFieldNote], Source={x:Static services:I18n.Instance}}"
                                         Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"/>
                              </DockPanel>
                            </Border>

                            <!-- Line 3: where it lives — inside the team, or a folder of this machine,
                                 exclusive (AnswerInsideTeam / AnswerWithDirectory); its state; « Choose… ». -->
                            <TextBlock Grid.Row="2" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0"
                                       Text="{Binding [Studio.Create.FolderLocation], Source={x:Static services:I18n.Instance}}"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                              <Border DockPanel.Dock="Left" Style="{StaticResource SegmentedGroup}" Height="30" CornerRadius="15"
                                      IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                  <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding InsideTeamCommand}"
                                          Tag="{Binding IsInsideTeam}" ToolTipService.ShowOnDisabled="True"
                                          ToolTip="{Binding [Studio.Create.FolderInsideTeamTip], Source={x:Static services:I18n.Instance}}"
                                          Content="{Binding [Studio.Create.FolderInsideTeam], Source={x:Static services:I18n.Instance}}"/>
                                  <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding PickCommand}"
                                          Tag="{Binding IsOnMachine}"
                                          ToolTip="{Binding [Studio.Create.ChooseFolder], Source={x:Static services:I18n.Instance}}"
                                          Content="{Binding [Studio.Create.FolderOnMachine], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Border>
                              <!-- « Choose… »: the fiche's primary while a folder to read is still to choose, a
                                   secondary once the folder of this machine is chosen, absent inside the team. -->
                              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                      Command="{Binding PickCommand}"
                                      ToolTip="{Binding [Studio.Create.ChooseFolder], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding NeedsChoice, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                  <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,7,0"/>
                                  <TextBlock Text="{Binding [Studio.Create.ChooseShort], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Button>
                              <!-- « Change… »: a chosen folder of this machine, still editable once confirmed. -->
                              <Button DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                      controls:ButtonSize.Height="28" Command="{Binding PickCommand}"
                                      ToolTip="{Binding [Studio.Create.ChooseFolder], Source={x:Static services:I18n.Instance}}">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding IsOnMachine}" Value="True"/>
                                          <Condition Binding="{Binding NeedsChoice}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                  <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,7,0"/>
                                  <TextBlock Text="{Binding [Studio.Create.FolderChange], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Button>
                              <!-- The state: the chosen path, the team's own path in mono, or « To choose ». -->
                              <Border Margin="10,0,0,0" Padding="10,5" VerticalAlignment="Center" CornerRadius="8">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource Well}">
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding NeedsChoice}" Value="True"/>
                                          <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <!-- A DockPanel, not a StackPanel: the path needs a finite width to be cut. -->
                                <DockPanel>
                                  <controls:LucideIcon DockPanel.Dock="Left" Kind="folder" Size="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                  <controls:MiddleEllipsisText Style="{StaticResource PathText}" Text="{Binding FolderLabel}"/>
                                </DockPanel>
                              </Border>
                            </DockPanel>

                            <!-- Line 4 (STUDIO-57, the drop): a folder kept inside the team — its file
                                 count, watched while the engine waits, the explorer on it, its path. -->
                            <TextBlock Grid.Row="3" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0"
                                       Text="{Binding [Studio.Create.FolderFieldFiles], Source={x:Static services:I18n.Instance}}"
                                       Visibility="{Binding HasHeld, Converter={StaticResource BooleanToVisibility}}"/>
                            <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" DataContext="{Binding Held}"
                                       Visibility="{Binding DataContext.HasHeld, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}">
                              <TextBlock DockPanel.Dock="Left" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"
                                         Text="{Binding FilesLabel}"/>
                              <Button DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28"
                                      Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}"
                                      ToolTip="{Binding [Studio.Create.FillFoldersOpenTip], Source={x:Static services:I18n.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                  <controls:LucideIcon Kind="folder-open" Size="16" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                  <TextBlock VerticalAlignment="Center"
                                             Text="{Binding [Studio.Create.FillFoldersOpen], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Button>
                              <controls:MiddleEllipsisText Style="{StaticResource PathText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding Directory}" ToolTip="{Binding Directory}"/>
                            </DockPanel>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding NeedsChoice}" Value="True"/>
                              <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Fiche" Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                            <Setter TargetName="Fiche" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                          </MultiDataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- STUDIO-57: one more folder, named and annotated by the user. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" HorizontalAlignment="Left" Margin="0,2,0,0"
                          Command="{Binding AddFolderRowCommand}"
                          Visibility="{Binding IsFoldersStep, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="plus" Size="16" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding [Studio.Create.AddFolder], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                             Foreground="{DynamicResource DangerBrush}" Text="{Binding FoldersProblem}"
                             Visibility="{Binding HasFoldersProblem, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>

          <!-- ── Composition instruction ── -->
          <!-- The field IS the consigne (StepNotesViewModel): typed text is taken as it stands. -->
          <controls:StepTab Header="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding NotesTabSubtitle}" State="{Binding NotesTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Command="{Binding ShowFoldersTabCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="arrow-left" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.BackToFolders], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding NotesFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NotesTabSub], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMultiline}" MinHeight="72"
                         Tag="{Binding [Studio.Create.NotesPlaceholder], Source={x:Static services:I18n.Instance}}"
                         AutomationProperties.Name="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"
                         Text="{Binding ComposeNotes.Consigne, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NotesLeaveEmpty], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>
        </controls:StepTabs>

        <!-- STUDIO-45: the step's action bar (lot 3), outside the classeur: the step's state on
             the left — the wait point while the engine waits on the user (R13) — then « Back »
             (the tab before) and the step's gesture. -->
        <Border Style="{StaticResource WizardActionBar}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="40"
                    Command="{Binding ComposeCommand}"
                    ToolTip="{Binding ComposeTip}" ToolTipService.ShowOnDisabled="True"
                    ToolTipService.IsEnabled="{Binding IsEngineRunning}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding [Studio.Create.Compose], Source={x:Static services:I18n.Instance}}"/>
                <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40" Margin="0,0,8,0"
                    Command="{Binding Step1BackCommand}"
                    Content="{Binding [Studio.Create.Back], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0" Text="{Binding Step1Hint}"/>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ── STEP 2 : COMPOSER ── -->
      <!-- Refonte lot 10 (R14): the step in a classeur of four tabs — the team, its folders,
           the composition instruction, and what the engine did, read only. The team tab opens
           the step; the tab on screen survives a recomposition. A folder still to choose is the
           step's wait point (R13): its tab carries the amber dot and « Try the team » waits. -->
      <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibility}}">
        <controls:StepTabs Margin="0,0,0,16" SelectedIndex="{Binding Step2TabIndex, Mode=TwoWay}">
          <!-- Under the tabs: the step's help in Novice, nothing in Expert. -->
          <controls:StepTabs.SideContent>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12"
                    Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <controls:LucideIcon Kind="circle-help" Size="16" Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Center"/>
                  <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0"
                             Text="{Binding [Studio.Create.HelpTitle], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="17.5"
                           Text="{Binding [Studio.Create.HelpStep2], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Border>
          </controls:StepTabs.SideContent>

          <!-- ── Team ── -->
          <controls:StepTab Header="{Binding [Studio.Create.TabTeam], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding TeamTabSubtitle}" State="{Binding TeamTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}"
                      Visibility="{Binding HasProposal, Converter={StaticResource BooleanToVisibility}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                          Command="{Binding SeeFoldersCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.SeeFolders], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding TeamFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <!-- Between entering step 2 and blueprint.ready, the progress card is the only
                     thing in the pane: that gap is what the owner saw as a frozen screen. Once
                     the team is proposed it leaves; the « Composition » tab tells the rest. -->
                <Border Visibility="{Binding HasProposal, Converter={StaticResource InverseBooleanToVisibility}}">
                  <views:ComposeProgressView DataContext="{Binding Progress}"/>
                </Border>

                <StackPanel Visibility="{Binding HasProposal, Converter={StaticResource BooleanToVisibility}}">
                  <DockPanel>
                    <!-- Expert: Proposal | YAML — the generated definition beside the proposal. -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedGroup}" Height="30" CornerRadius="15"
                            VerticalAlignment="Top" Margin="12,0,0,0">
                      <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                          <Binding Path="DataContext.Mode.IsExpert" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          <Binding Path="HasGeneratedDefinition"/>
                        </MultiBinding>
                      </Border.Visibility>
                      <StackPanel Orientation="Horizontal" Margin="2">
                        <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding ShowProposalViewCommand}"
                                Tag="{Binding IsProposalView}"
                                Content="{Binding [Studio.Create.ViewProposal], Source={x:Static services:I18n.Instance}}"/>
                        <Button Style="{StaticResource SegmentBtnOn}" Command="{Binding ShowYamlViewCommand}"
                                Tag="{Binding IsYamlView}"
                                Content="{Binding [Studio.Create.ViewYaml], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Border>
                    <TextBlock FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"
                               Text="{Binding [Studio.Create.ProposalTitle], Source={x:Static services:I18n.Instance}}"/>
                  </DockPanel>

                  <!-- The proposal: rationale, what the team can do, the agents one line each. -->
                  <StackPanel Visibility="{Binding IsProposalView, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{Binding Rationale}"/>
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding HasTools, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Top" Margin="0,4,8,0"
                                 Text="{Binding [Studio.Create.ToolsLabel], Source={x:Static services:I18n.Instance}}"/>
                      <WrapPanel>
                        <ItemsControl ItemsSource="{Binding VisibleTeamTools}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource ToolChip}" Height="26" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                  <controls:LucideIcon Kind="{Binding Icon}" Size="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"/>
                                  <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding Label}"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,6,6"
                                Command="{Binding ShowAllTeamToolsCommand}" Content="{Binding MoreTeamToolsLabel}"
                                Visibility="{Binding HasHiddenTeamTools, Converter={StaticResource BooleanToVisibility}}"/>
                      </WrapPanel>
                    </DockPanel>

                    <!-- The agents (lot 3, lot 10): a 32 px avatar, the name, the key (Expert), what
                         it does on one line — whole in the tooltip — what it can do, folded after
                         five pills, and « Modify », which opens the agent editor (it keeps
                         « Remove from the team »). -->
                    <ItemsControl ItemsSource="{Binding Agents}" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                                      Background="{DynamicResource AccentWeakBrush}" Margin="0,0,12,0">
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Initial}"/>
                              </Border>
                              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                                      VerticalAlignment="Top" Margin="12,0,0,0"
                                      Command="{Binding EditCommand}"
                                      ToolTip="{Binding [Studio.Create.Wait], Source={x:Static services:I18n.Instance}}"
                                      ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                  <controls:LucideIcon Kind="pencil" Size="16" Margin="0,0,7,0"/>
                                  <TextBlock Text="{Binding [Studio.Create.Modify], Source={x:Static services:I18n.Instance}}"/>
                                </StackPanel>
                              </Button>
                              <StackPanel>
                                <TextBlock Style="{StaticResource ObjectTitle}" FontSize="13.5">
                                  <Run Text="{Binding Name, Mode=OneWay}"/>
                                  <InlineUIContainer BaselineAlignment="Center">
                                    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="6,0,0,0"
                                               Text="{Binding Key}"
                                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                                  </InlineUIContainer>
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" Text="{Binding Role}">
                                  <TextBlock.ToolTip>
                                    <ToolTip>
                                      <TextBlock MaxWidth="420" TextWrapping="Wrap" Text="{Binding Role}"/>
                                    </ToolTip>
                                  </TextBlock.ToolTip>
                                </TextBlock>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasTools, Converter={StaticResource BooleanToVisibility}}">
                                  <TextBlock DockPanel.Dock="Left" FontSize="13" Foreground="{DynamicResource InkFaintBrush}"
                                             VerticalAlignment="Top" Margin="0,4,8,0"
                                             Text="{Binding [Studio.Create.AgentCan], Source={x:Static services:I18n.Instance}}"/>
                                  <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding VisibleTools}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Border Style="{StaticResource ToolChip}" Height="26" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                              <controls:LucideIcon Kind="{Binding Icon}" Size="13" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"/>
                                              <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding Label}"/>
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,6,6"
                                            Command="{Binding ShowAllToolsCommand}" Content="{Binding MoreToolsLabel}"
                                            Visibility="{Binding HasHiddenTools, Converter={StaticResource BooleanToVisibility}}"/>
                                  </WrapPanel>
                                </DockPanel>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Add an agent (F-01) — actionable while the engine waits at its arbitration. -->
                    <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding AddAgentCommand}"
                            ToolTip="{Binding [Studio.Create.Wait], Source={x:Static services:I18n.Instance}}"
                            ToolTipService.ShowOnDisabled="True">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="plus" Size="16" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [Studio.Create.AddAgent], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Expert, the YAML side: what the render wrote, where the session lives. -->
                  <StackPanel Margin="0,10,0,0" Visibility="{Binding IsYamlView, Converter={StaticResource BooleanToVisibility}}">
                    <DockPanel Margin="0,0,0,10">
                      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28"
                              Click="OnCopyDefinition"
                              Visibility="{Binding HasCrewDefinition, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="copy" Size="16" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding [Studio.Run.JournalCopy], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon Kind="braces" Size="16" Foreground="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource CardHeaderTitle}"
                                   Text="{Binding [Studio.Create.FilesTitle], Source={x:Static services:I18n.Instance}}"/>
                        <!-- The short name, mono; the full session path is the tooltip (T-21). -->
                        <TextBlock Style="{StaticResource CardHeaderFile}" MaxWidth="260"
                                   Text="{Binding SessionSlug}" ToolTip="{Binding SessionDirectory}"/>
                      </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Well}" Margin="0,0,0,10"
                            Visibility="{Binding HasCrewDefinition, Converter={StaticResource BooleanToVisibility}}">
                      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <TextBlock Style="{StaticResource MonoText}" FontSize="13" Text="{Binding CrewDefinitionYaml}"/>
                      </ScrollViewer>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Files}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,1" Text="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>

                <!-- validation of the rendered crew -->
                <controls:Alert Tone="Warning" Margin="0,12,0,0"
                                Message="{Binding [Studio.Create.ValidationTitle], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding ValidationErrors.Count, Converter={StaticResource CountToVisibility}}">
                  <ItemsControl ItemsSource="{Binding ValidationErrors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,2" Text="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:Alert>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>

          <!-- ── The team's folders ── -->
          <!-- The future sidecar mounts, editable here: one fiche per mount point; a folder still
               to choose says so on its fiche, the tab's amber dot and the action bar count it. -->
          <controls:StepTab Header="{Binding [Studio.Create.TabFolders], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding Step2FoldersTabSubtitle}" State="{Binding Step2FoldersTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                          Command="{Binding SeeNotesCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.SeeNotes], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding Step2FoldersFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel x:Name="MountFoldersBlock">
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.TeamFolders], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,12"
                           Text="{Binding [Studio.Create.FoldersHint], Source={x:Static services:I18n.Instance}}"/>
                <ItemsControl ItemsSource="{Binding MountRows}" ItemTemplate="{StaticResource MountRowTemplate}"/>
                <WrapPanel Margin="0,4,0,0">
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,4"
                          Command="{Binding AllowFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="plus" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.AllowFolder], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <!-- STUDIO-14 (D-08): every unanswered row at once. Hidden once every row is
                       answered (lot 3). -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,4"
                          Command="{Binding CreateAllInsideTeamCommand}"
                          Visibility="{Binding HasFoldersToChoose, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="folder" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.CreateAllInsideTeam], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <controls:Alert Tone="Danger" Margin="0,8,0,0"
                                Message="{Binding [Studio.Create.UndeclaredLegend], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding HasUndeclaredTeamMounts, Converter={StaticResource BooleanToVisibility}}"/>
                <!-- A dropped agent-addressed root: nothing will back it, and the run would
                     otherwise report success and produce nothing. -->
                <controls:Alert Tone="Danger" Margin="0,8,0,0" Message="{Binding DroppedDerivedWarning}"
                                Visibility="{Binding HasDroppedDerivedRoots, Converter={StaticResource BooleanToVisibility}}">
                  <controls:Alert.Actions>
                    <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                            Command="{Binding RestoreDerivedMountsCommand}"
                            Content="{Binding [Studio.Create.RestoreFolders], Source={x:Static services:I18n.Instance}}"/>
                  </controls:Alert.Actions>
                </controls:Alert>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>

          <!-- ── Composition instruction ── -->
          <!-- The same field as step 1's tab (StepNotesViewModel): it goes with the next
               composition — editing it here recomposes nothing on its own. -->
          <controls:StepTab Header="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding NotesTabSubtitle}" State="{Binding NotesTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                          Command="{Binding SeeCompositionCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [Studio.Create.SeeComposition], Source={x:Static services:I18n.Instance}}"/>
                      <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding NotesFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NotesTabSub], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMultiline}" MinHeight="72"
                         Tag="{Binding [Studio.Create.NotesPlaceholder], Source={x:Static services:I18n.Instance}}"
                         AutomationProperties.Name="{Binding [Studio.Create.NotesCompose], Source={x:Static services:I18n.Instance}}"
                         Text="{Binding ComposeNotes.Consigne, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.NotesLeaveEmpty], Source={x:Static services:I18n.Instance}}"/>
                <controls:Alert Tone="Info" Margin="0,12,0,0"
                                Message="{Binding [Studio.Create.Step2NotesNote], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>

          <!-- ── Composition (read only) ── -->
          <!-- What the engine did for this proposal: its state, the files written, its last
               words, its build, the draft on disk — and, behind a button, the technical journal
               that used to sit under the step. -->
          <controls:StepTab Header="{Binding [Studio.Create.TabComposition], Source={x:Static services:I18n.Instance}}"
                            Subtitle="{Binding CompositionTabSubtitle}" State="{Binding CompositionTabState}">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                          Command="{Binding BackToTeamCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="arrow-left" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.BackToTeam], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                             Margin="0,0,12,0" Text="{Binding CompositionFooter}"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           Text="{Binding [Studio.Create.CompositionTitle], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="{Binding [Studio.Create.CompositionSub], Source={x:Static services:I18n.Instance}}"/>
                <controls:PropertyRow Label="{Binding [Studio.Create.FieldState], Source={x:Static services:I18n.Instance}}">
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding CompositionStateText}"/>
                </controls:PropertyRow>
                <controls:PropertyRow Label="{Binding [Studio.Create.FieldFilesWritten], Source={x:Static services:I18n.Instance}}">
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding CompositionFilesText}"/>
                </controls:PropertyRow>
                <controls:PropertyRow Label="{Binding [Studio.Create.FieldLastExchange], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding HasLastExchange, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextTrimming="CharacterEllipsis"
                             Text="{Binding LastExchange}">
                    <TextBlock.ToolTip>
                      <ToolTip>
                        <TextBlock MaxWidth="480" TextWrapping="Wrap" Text="{Binding LastExchange}"/>
                      </ToolTip>
                    </TextBlock.ToolTip>
                  </TextBlock>
                </controls:PropertyRow>
                <controls:PropertyRow Label="{Binding [Studio.Create.FieldEngine], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding HasEngineVersion, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource MonoText}" FontSize="13" Text="{Binding EngineVersion}"/>
                </controls:PropertyRow>
                <controls:PropertyRow Label="{Binding [Studio.Create.FieldDraft], Source={x:Static services:I18n.Instance}}">
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding CompositionDraftText}"/>
                </controls:PropertyRow>
                <WrapPanel Margin="0,12,0,0">
                  <!-- Expert: the technical journal, folded by default. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,4" Click="OnToggleTech"
                          Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="scroll-text" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.TechTitle], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,4"
                          Command="{Binding OpenFolderCommand}"
                          ToolTip="{Binding OpenFolderTooltip}" ToolTipService.ShowOnDisabled="True"
                          Visibility="{Binding HasShellOpener, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Create.OpenDraft], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <Border Margin="0,8,0,0">
                  <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                      <Binding Path="DataContext.Mode.IsExpert" RelativeSource="{RelativeSource AncestorType=Window}"/>
                      <Binding Path="IsTechOpen"/>
                    </MultiBinding>
                  </Border.Visibility>
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28"
                              Click="OnCopyTechJournal"
                              Visibility="{Binding RawLog.Lines.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="copy" Size="16" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding [Studio.Run.JournalCopy], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <TextBlock Style="{StaticResource CardHeaderMeta}" MaxWidth="300" VerticalAlignment="Center" Text="{Binding SessionSlug}"/>
                    </DockPanel>
                    <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="9" Padding="8" MaxHeight="300">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RawLog.Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="6,1"
                                         Foreground="{DynamicResource ConsoleFgBrush}" TextWrapping="Wrap" Text="{Binding Text}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </controls:StepTab>
        </controls:StepTabs>

        <!-- The action bar (lot 3, lot 10): a dot and the step's sentence — the folders left to
             choose, else that the team can be tried — then « Back », « Adopt without trial » and
             « Try the team → ». The Composer pause stops the engine before the trial (dry mode):
             the trial is THIS click, never a side effect; it waits while a folder is to choose. -->
        <Border Style="{StaticResource WizardActionBar}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Style="{StaticResource ActionRow}">
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40" Command="{Binding GoBackCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="arrow-left" Size="16" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Studio.Create.Back], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40" Margin="8,0,0,0"
                      Command="{Binding AdoptWithoutTrialCommand}"
                      ToolTip="{Binding [Studio.Create.AdoptWithoutTrialTip], Source={x:Static services:I18n.Instance}}"
                      Visibility="{Binding CanTryTeam, Converter={StaticResource BooleanToVisibility}}"
                      Content="{Binding [Studio.Create.AdoptWithoutTrial], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="40" Margin="8,0,0,0"
                      Command="{Binding TryTeamCommand}"
                      ToolTip="{Binding TryTeamTip}" ToolTipService.ShowOnDisabled="True"
                      ToolTipService.IsEnabled="{Binding HasFoldersToChoose}"
                      Visibility="{Binding CanTryTeam, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding [Studio.Create.TryTeam], Source={x:Static services:I18n.Instance}}"/>
                  <controls:LucideIcon Kind="arrow-right" Size="16" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                     Visibility="{Binding HasStep2Hint, Converter={StaticResource BooleanToVisibility}}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStep2HintWarning}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0" Text="{Binding Step2Hint}"/>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ── STEP 3 : ESSAYER ── -->
      <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibility}}">
        <views:ComposeProgressView DataContext="{Binding Progress}"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <!-- hrm D07 (R11): every card of the step opens on a CardTitle, 16/600. -->
              <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                         Text="{Binding [Studio.Create.TryTitle], Source={x:Static services:I18n.Instance}}"/>
              <!-- Animated, like the one on the stepper. A motionless three-quarter arc says
                   nothing — it reads as decoration, which is exactly how it read when the
                   trial had crashed and it was still on screen. -->
              <controls:LucideIcon Kind="loader-circle" Size="16" Foreground="{DynamicResource AccentBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                   Visibility="{Binding TrialInProgress, Converter={StaticResource BooleanToVisibility}}">
                <controls:LucideIcon.RenderTransform>
                  <RotateTransform x:Name="TrialSpin"/>
                </controls:LucideIcon.RenderTransform>
                <controls:LucideIcon.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="TrialSpin" Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </controls:LucideIcon.Triggers>
              </controls:LucideIcon>
            </StackPanel>
            <TextBlock Style="{StaticResource MetaText}" Margin="0,5,0,0"
                       Text="{Binding [Studio.Create.TrySub], Source={x:Static services:I18n.Instance}}"/>
            <!-- STUDIO-14 (§10): under «Created inside the team» the read root is a folder that
                 does not exist before the adoption, so the trial reads the engine's default —
                 said here, with where the documents go afterwards, rather than discovered from
                 a verdict about an empty folder. -->
            <controls:Alert Tone="Warning" Margin="0,10,0,0"
                            Message="{Binding [Studio.Create.TrialInsideTeam], Source={x:Static services:I18n.Instance}}"
                            Visibility="{Binding TrialReadsInsideTeam, Converter={StaticResource BooleanToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Activity}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,3">
                    <!-- The icon follows the outcome. It used to be a hard-coded green check,
                         so a task whose sentence read «failed» still carried a tick. -->
                    <controls:LucideIcon DockPanel.Dock="Left" Size="16"
                                         VerticalAlignment="Top" Margin="0,2,9,0">
                      <controls:LucideIcon.Style>
                        <Style TargetType="controls:LucideIcon">
                          <Setter Property="Kind" Value="ban"/>
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Success}" Value="True">
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </controls:LucideIcon.Style>
                    </controls:LucideIcon>
                    <StackPanel>
                      <TextBlock Style="{StaticResource BodyText}" Text="{Binding Text}"/>
                      <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,1,0,0"
                                 Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Detail}"
                                 Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- verdict -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding HasVerdict, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <!-- Lot 3: the summary sentence first — « 3 of 3 criteria met ». -->
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8"
                       TextWrapping="Wrap" Text="{Binding VerdictSummary}"
                       Visibility="{Binding HasVerdictSummary, Converter={StaticResource BooleanToVisibility}}"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Subhead}" VerticalAlignment="Center"
                         Text="{Binding [Studio.Create.VerdictTitle], Source={x:Static services:I18n.Instance}}"/>
              <!-- R12: the shared Badge, its tone from the engine's verdict. -->
              <controls:Badge Margin="10,0,0,0" VerticalAlignment="Center" Content="{Binding VerdictScore}">
                <controls:Badge.Style>
                  <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                    <Setter Property="Tone" Value="Warning"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VerdictPassing}" Value="True">
                        <Setter Property="Tone" Value="Success"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:Badge.Style>
              </controls:Badge>
            </StackPanel>
            <!-- W-08: what the trial itself cost — tokens, cache hit, wall time -->
            <ItemsControl ItemsSource="{Binding VerdictMetricChips}" Margin="0,11,0,0"
                          Visibility="{Binding HasVerdictMetrics, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource MetricChip}" Margin="0,0,7,4">
                    <TextBlock Style="{StaticResource MetricChipText}" Text="{Binding}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,8"
                       Visibility="{Binding HasMailActions, Converter={StaticResource BooleanToVisibility}}"
                       Text="{Binding [Studio.Create.MailActionsLabel], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding MailActionLines}" Margin="0,0,0,4"
                          Visibility="{Binding HasMailActions, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource MetaText}" Margin="0,2" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,8"
                       Text="{Binding [Studio.Create.ChecklistLabel], Source={x:Static services:I18n.Instance}}"/>
            <!-- Without an LLM judge there is no per-criterion verdict, so every line below
                 reads «?». Honest, and completely opaque unless the card says why. -->
            <TextBlock Style="{StaticResource MetaText}" Margin="0,0,0,8"
                       Visibility="{Binding VerdictIsMechanical, Converter={StaticResource BooleanToVisibility}}"
                       Text="{Binding [Studio.Create.JudgeMechanical], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Checklist}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <controls:LucideIcon DockPanel.Dock="Left" Size="16" VerticalAlignment="Top" Margin="0,1,9,0">
                      <controls:LucideIcon.Style>
                        <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                          <Setter Property="Kind" Value="circle-help"/>
                          <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                          <Style.Triggers>
                            <!-- Lot 3: green check for a criterion met, the barred circle for a
                                 failure (R12). hrm D02: a remark (a finding that blocks nothing)
                                 meets its criterion, so it draws the check too and its text shows
                                 as a sand note under the line; the summary above counts the checks. -->
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFailure}" Value="True">
                              <Setter Property="Kind" Value="ban"/>
                              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRemark}" Value="True">
                              <Setter Property="Kind" Value="triangle-alert"/>
                              <Setter Property="Foreground" Value="{DynamicResource WarningIconBrush}"/>
                            </DataTrigger>
                            <!-- A remark on a criterion: met, the check. A finding that names no
                                 criterion keeps the sand triangle above. -->
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRemark}" Value="True"/>
                                <Condition Binding="{Binding IsCriterion}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </controls:LucideIcon.Style>
                    </controls:LucideIcon>
                    <StackPanel>
                      <TextBlock Style="{StaticResource BodyText}" Text="{Binding Statement}"/>
                      <TextBlock Margin="0,2,0,0" Text="{Binding Detail}"
                                 Visibility="{Binding Detail, Converter={StaticResource StringPresentToVisibility}}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                            <Style.Triggers>
                              <!-- hrm D02: a remark is a sand note, never a mark on the criterion. -->
                              <DataTrigger Binding="{Binding IsRemark}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarningInkBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- What the engine already worked out. «Corriger et réessayer» used to ask the
                 user to invent a correction the judge had computed and put on the wire. -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                         Text="{Binding [Studio.Create.Suggestions], Source={x:Static services:I18n.Instance}}"/>
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <controls:LucideIcon DockPanel.Dock="Left" Kind="wand-2" Size="16"
                                           Foreground="{DynamicResource MarkBrush}"
                                           VerticalAlignment="Top" Margin="0,2,9,0"/>
                      <TextBlock Style="{StaticResource BodyText}" Text="{Binding}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- The arbitration is the assistant's question (refonte R15): it is asked in the
                 panel, its answers as buttons, « Looks good to me » first. -->
          </StackPanel>
        </Border>

        <!-- expert: the engine invocation behind the trial — replayable in a terminal (F-09) -->
        <StackPanel Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                  Visibility="{Binding EngineCommandLine, Converter={StaticResource StringPresentToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                         Text="{Binding [Studio.Create.TrialCommand], Source={x:Static services:I18n.Instance}}"/>
              <Border Style="{StaticResource Well}">
                <TextBlock Style="{StaticResource MonoText}" FontSize="13" TextWrapping="Wrap" Text="{Binding EngineCommandLine}"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <views:StepNotesView DataContext="{Binding TryNotes}"
                             Title="{Binding [Studio.Create.NotesTry], Source={x:Static services:I18n.Instance}}"/>

        <!-- The action bar (lot 3): « Back » to the composition. The verdict's decisions stay
             in the verdict card, next to what they decide. hrm R02/R05: the step's footer, back
             on the left with its arrow. -->
        <Border Style="{StaticResource StepActionFooter}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                    Command="{Binding GoBackCommand}" controls:ButtonIcon.Kind="arrow-left"
                    Content="{Binding [Studio.Create.Back], Source={x:Static services:I18n.Instance}}"/>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ── STEP 4 : ADOPTER ── -->
      <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibility}}">
        <!-- Lot 3: the adoption form leads the step, in one card. R13: the expected card
             carries the accent ring while the team waits to be adopted. -->
        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWaitOnAdopt}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <!-- hrm D07 (R11): the card's title, 16/600. -->
            <TextBlock Style="{StaticResource CardTitle}" TextWrapping="Wrap"
                       Text="{Binding [Studio.Create.AdoptTitle], Source={x:Static services:I18n.Instance}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                       Text="{Binding [Studio.Create.TeamName], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"/>
            <!-- STUDIO-28 (D-06): on a team « Modify » reopened, the name is its title and the
                 re-adoption writes back into the same folder; the folder is renamed from My teams,
                 whose « Rename » carries the session and the schedule along. -->
            <TextBlock Style="{StaticResource MetaText}" Margin="0,6,0,0"
                       Text="{Binding [Studio.Create.RenameHint], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding IsModifyingTeam, Converter={StaticResource BooleanToVisibility}}"/>
            <!-- STUDIO-26 (D-07): the name is already taken in My teams. Said here, under the
                 field, with a free name and the way to the team that holds this one; the
                 engine's own refusal never reaches the screen. -->
            <!-- hrm R07: the two answers ride the alert's Actions slot (right of the text when
                 the alert is wide, below it otherwise). -->
            <controls:Alert Tone="Warning" Margin="0,8,0,0" Message="{Binding AdoptConflict}"
                            Visibility="{Binding HasAdoptConflict, Converter={StaticResource BooleanToVisibility}}">
              <controls:Alert.Actions>
                <StackPanel Style="{StaticResource ActionRow}">
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0"
                          Command="{Binding UseFreeTeamNameCommand}" Content="{Binding UseFreeTeamNameLabel}"/>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                          Command="{Binding OpenConflictingTeamCommand}"
                          Visibility="{Binding CanOpenConflictingTeam, Converter={StaticResource BooleanToVisibility}}"
                          Content="{Binding [Studio.Create.OpenExistingTeam], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </controls:Alert.Actions>
            </controls:Alert>

            <!-- T-22: «Gérer les réglages» rides the LABEL's line. Stacked under the picker
                 it read as a fourth choice among the profiles rather than as the way out
                 to the screen that manages them. -->
            <DockPanel Margin="0,16,0,7">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                      VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" controls:ButtonIcon.Kind="sliders-horizontal"
                      Content="{Binding [Studio.Create.ManageSettings], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"
                         Text="{Binding [Studio.Create.AdoptProfile], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
            <!-- STUDIO-73: checked (D2), the team follows the default elected when a run starts;
                 unchecked, the card below pins one setting. -->
            <CheckBox Margin="0,0,0,8" IsChecked="{Binding AdoptUsesDefaultLlm}"
                      IsEnabled="{Binding Profiles.IsEmpty, Converter={StaticResource Negate}}"
                      Content="{Binding AdoptUseDefaultLlmLabel}"
                      ToolTip="{Binding [Studio.Teams.UseDefaultLlmHint], Source={x:Static services:I18n.Instance}}"/>
            <StackPanel Visibility="{Binding AdoptUsesDefaultLlm, Converter={StaticResource InverseBooleanToVisibility}}">
            <!-- W-07: the selected model profile as a card — «Changer» unfolds the radio
                 rows; no select at all, exactly the mock's shape. The container carries the
                 surface pair of the mock rather than the sunk one (T-22). -->
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="13,11" MaxWidth="480" HorizontalAlignment="Left">
              <DockPanel>
                <controls:LucideIcon DockPanel.Dock="Left" Kind="sparkles" Size="16"
                                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,11,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                        VerticalAlignment="Center" Command="{Binding ToggleAdoptProfilePickerCommand}"
                        Content="{Binding [Studio.Create.AdoptChange], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource Subhead}" Text="{Binding AdoptProfileName}"/>
                  <TextBlock Style="{StaticResource MetaText}" Margin="0,2,0,0" Text="{Binding AdoptProfileSummary}"
                             Visibility="{Binding AdoptProfileSummary, Converter={StaticResource StringPresentToVisibility}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Margin="0,7,0,0" MaxWidth="480" HorizontalAlignment="Left"
                        Visibility="{Binding IsAdoptProfilePickerOpen, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl ItemsSource="{Binding Profiles.Profiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource PickRow}" GroupName="AdoptProfile" Margin="0,0,0,7"
                                 Command="{Binding DataContext.CreateTeam.PickAdoptProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding Name}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                        <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" Text="{Binding Summary}"/>
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7"
                       Text="{Binding [Studio.Create.ScheduleLabel], Source={x:Static services:I18n.Instance}}"/>
            <StackPanel>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched" Margin="0,0,0,7"
                           IsChecked="{Binding IsOnDemand}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Studio.Create.SchedOnDemand], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Studio.Create.SchedOnDemandHint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched" Margin="0,0,0,7"
                           IsChecked="{Binding IsDaily}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Studio.Create.SchedDaily], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Studio.Create.SchedDailyHint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched"
                           IsChecked="{Binding IsHourly}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Studio.Create.SchedHourly], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Studio.Create.SchedHourlyHint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding NeedsScheduleTime, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                         Text="{Binding [Studio.Create.SchedAt], Source={x:Static services:I18n.Instance}}"/>
              <!-- hrm B01 (R09): 76 px less the 12 px paddings cut « 07:00 » to « 07:0 » (022);
                   at least 96, mono, and it grows rather than cut a longer value. -->
              <TextBox Style="{StaticResource InputMono}" MinWidth="96" Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0"
                         Text="{Binding [Studio.Create.SchedLocalTime], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- R13: the other cards step back behind the expected one. -->
        <views:StepNotesView DataContext="{Binding AdoptNotes}" Margin="0,16,0,0"
                             Title="{Binding [Studio.Create.NotesAdopt], Source={x:Static services:I18n.Instance}}">
          <views:StepNotesView.Style>
            <Style TargetType="views:StepNotesView">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWaitOnAdopt, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}" Value="True">
                  <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:StepNotesView.Style>
        </views:StepNotesView>

        <!-- The action bar (lot 3): « Back » and « Adopt the team ». hrm R02/R05: the step's
             footer, back on the left, the one primary of the step on the right. -->
        <Border Style="{StaticResource StepActionFooter}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40"
                    Command="{Binding GoBackCommand}" controls:ButtonIcon.Kind="arrow-left"
                    Content="{Binding [Studio.Create.Back], Source={x:Static services:I18n.Instance}}"/>
            <Button x:Name="AdoptButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="40"
                    Command="{Binding SaveTeamCommand}" controls:ButtonIcon.Kind="save"
                    Content="{Binding [Studio.Create.Save], Source={x:Static services:I18n.Instance}}"/>
          </DockPanel>
        </Border>
      </StackPanel>

        </StackPanel>
        </StackPanel>
        <!-- The Novice help column; the assistant panel takes its place while it is open (R3).
             Step 1 holds its help under its tabs (R14). -->
        <Border Grid.Column="1" Width="300" VerticalAlignment="Top" Margin="16,0,0,16"
                Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18,16">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    <Condition Binding="{Binding Chat.IsOpen}" Value="False"/>
                    <Condition Binding="{Binding IsStep1}" Value="False"/>
                    <Condition Binding="{Binding IsStep2}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <controls:LucideIcon Kind="circle-help" Size="16" Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0"
                         Text="{Binding [Studio.Create.HelpTitle], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Studio.Create.HelpStep1], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                      <Setter Property="Text" Value="{Binding [Studio.Create.HelpStep2], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                      <Setter Property="Text" Value="{Binding [Studio.Create.HelpStep3], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                      <Setter Property="Text" Value="{Binding [Studio.Create.HelpStep4], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- expert: the technical journal, folded by default. Step 2 carries it in its
           « Composition » tab (refonte lot 10), so the card leaves that step. -->
      <Border Margin="0,0,0,16">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                  <Condition Binding="{Binding IsStep2}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" FontSize="13" Click="OnToggleTech">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="eye" Size="16" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding [Studio.Create.TechToggle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" FontSize="13"
                    Margin="0,0,8,0" Click="OnCopyTechJournal"
                    Visibility="{Binding RawLog.Lines.Count, Converter={StaticResource CountToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="copy" Size="16" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding [Studio.Run.JournalCopy], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                         Text="{Binding [Studio.Create.TechTitle], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource CardHeaderMeta}" MaxWidth="300" Text="{Binding SessionSlug}"/>
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="9" Padding="8" Margin="0,12,0,0"
                  MaxHeight="230" Visibility="{Binding IsTechOpen, Converter={StaticResource BooleanToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding RawLog.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="6,1"
                               Foreground="{DynamicResource ConsoleFgBrush}" TextWrapping="Wrap" Text="{Binding Text}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

  </StackPanel>
</UserControl>
