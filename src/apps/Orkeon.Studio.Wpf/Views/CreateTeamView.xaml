<!-- The "Créer une équipe" wizard (design v3): Décrire ▸ Composer ▸ Essayer ▸ Adopter over
     the forge engine. DataContext: CreateTeamViewModel (bound as CreateTeam in MainWindow).
     The engine owns the cycle — every control here sends one of its own gestures. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.CreateTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <!-- a step pill of the stepper -->
    <Style x:Key="StepPill" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="13.5" Padding="13,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- a selectable chip of the step-1 precisions -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="13.5" Padding="12,6">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>

    <!-- header -->
    <DockPanel Margin="0,0,0,4">
      <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" VerticalAlignment="Top"
              Command="{Binding RestartCommand}">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,7,0"/>
          <TextBlock Text="{Binding [Wiz_Restart], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Create_Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Create_SubNovice], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Create_SubExpert], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
        <!-- the assistant line: which profile drives the composing -->
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
          <controls:LucideIcon Kind="wand-2" Size="12" VerticalAlignment="Center">
            <controls:LucideIcon.Style>
              <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NeedsAssistant}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:LucideIcon.Style>
          </controls:LucideIcon>
          <TextBlock Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"
                     Text="{Binding [Wiz_AssistantBy], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding HasAssistant, Converter={StaticResource BooleanToVisibility}}"/>
          <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" Margin="4,0,0,0"
                     VerticalAlignment="Center" Text="{Binding Profiles.StudioProfileName}"
                     Visibility="{Binding HasAssistant, Converter={StaticResource BooleanToVisibility}}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource WarningBrush}"
                     Text="{Binding [Wiz_AssistantMissing], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding NeedsAssistant, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
    <!-- §F.5: «Votre solution est prête.» and friends as a faint 12px line, not raw mono -->
    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" Text="{Binding StatusMessage}"/>

    <!-- before anything: the assistant must have a model — the wizard is gated until then -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
            CornerRadius="14" Padding="20,18" MaxWidth="620" HorizontalAlignment="Left" Margin="0,20,0,0"
            Visibility="{Binding NeedsAssistant, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="triangle-alert" Size="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
          <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0"
                     Text="{Binding [Wiz_Gate_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,12"
                   Text="{Binding [Wiz_Gate_Body], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Profiles.Profiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- audit 02/10: the gate is a radio list (PickRow), not anonymous buttons -->
              <RadioButton Style="{StaticResource PickRow}" GroupName="GateProfile" Margin="0,0,0,7"
                           Command="{Binding DataContext.CreateTeam.PickAssistantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" Text="{Binding Summary}"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,4,0,0"
                Command="{Binding OpenSettingsCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="sliders-horizontal" Size="12" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Wiz_ManageSettings], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <StackPanel Visibility="{Binding HasAssistant, Converter={StaticResource BooleanToVisibility}}">

      <!-- stepper -->
      <StackPanel Orientation="Horizontal" Margin="0,16,0,20">
        <Button Style="{StaticResource StepPill}" Command="{Binding GoStep1Command}" Tag="{Binding IsStep1}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Opacity="0.75" Text="1" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding [Wiz_Step1], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <TextBlock Text="▸" FontSize="12" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
        <Button Style="{StaticResource StepPill}" Command="{Binding GoStep2Command}" Tag="{Binding IsStep2}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Opacity="0.75" Text="2" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding [Wiz_Step2], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <TextBlock Text="▸" FontSize="12" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
        <Button Style="{StaticResource StepPill}" Command="{Binding GoStep3Command}" Tag="{Binding IsStep3}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Opacity="0.75" Text="3" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding [Wiz_Step3], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <TextBlock Text="▸" FontSize="12" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="4,0"/>
        <Button Style="{StaticResource StepPill}" Command="{Binding GoStep4Command}" Tag="{Binding IsStep4}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Opacity="0.75" Text="4" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding [Wiz_Step4], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <controls:LucideIcon Kind="loader-circle" Size="14" Foreground="{DynamicResource AccentBrush}" Margin="14,0,0,0"
                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibility}}">
          <controls:LucideIcon.RenderTransform>
            <RotateTransform x:Name="EngineSpin"/>
          </controls:LucideIcon.RenderTransform>
          <controls:LucideIcon.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="EngineSpin" Storyboard.TargetProperty="Angle"
                                   From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </controls:LucideIcon.Triggers>
        </controls:LucideIcon>
        <Button Style="{StaticResource BtnGhost}" FontSize="12" Margin="10,0,0,0" Command="{Binding StopCommand}"
                Visibility="{Binding IsEngineRunning, Converter={StaticResource BooleanToVisibility}}"
                Content="{Binding [Wiz_Stop], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>

      <!-- the assistant bar: the engine's own turns and arbitrations, on whatever step -->
      <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="12" Padding="14,12" Margin="0,0,0,16"
              Visibility="{Binding HasAssistantPrompt, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <DockPanel>
            <controls:LucideIcon DockPanel.Dock="Left" Kind="wand-2" Size="14" Foreground="{DynamicResource MarkBrush}"
                                 VerticalAlignment="Top" Margin="0,2,10,0"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" LineHeight="19"
                       Text="{Binding AssistantPrompt}"/>
          </DockPanel>
          <DockPanel Margin="24,9,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding ReplyCommand}"
                    Content="{Binding [Wiz_Reply], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- The novice help rail (F-10): the step's plain-words explainer on the right;
           questions to the assistant live in each step's notes panel. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
      <!-- ── STEP 1 : DÉCRIRE ── -->
      <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Wiz_Need_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,12"
                       Text="{Binding [Wiz_Need_Sub], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" MinHeight="84" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Need, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Eyebrow}" Margin="0,16,0,8"
                       Text="{Binding [Wiz_Examples], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Examples}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource BtnGhost}" FontSize="12.5" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Margin="0,0,0,6" Content="{Binding}"
                          Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                          CommandParameter="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- the three questions that shape the team -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Wiz_Precisions_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,14"
                       Text="{Binding [Wiz_Precisions_Sub], Source={x:Static services:I18n.Instance}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Wiz_Q_Freq], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding FrequencyChoices}" Margin="0,4,0,10">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Chip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Wiz_Q_Source], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding SourceChoices}" Margin="0,4,0,10">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Chip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Wiz_Q_Output], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding OutputChoices}" Margin="0,4,0,10">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Chip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Wiz_Outcome_Label], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                       Text="{Binding [Wiz_Outcome_Hint], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" MinHeight="74" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Outcome, UpdateSourceTrigger=PropertyChanged}"/>

            <DockPanel Margin="0,14,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding ComposeCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding [Wiz_Compose], Source={x:Static services:I18n.Instance}}"/>
                  <controls:LucideIcon Kind="arrow-right" Size="13" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
                </StackPanel>
              </Button>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{Binding Step1Hint}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <views:StepNotesView DataContext="{Binding ComposeNotes}"
                             Title="{Binding [Wiz_Notes_Compose], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>

      <!-- ── STEP 2 : COMPOSER ── -->
      <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Wiz_Proposal_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding Rationale}"/>
            <StackPanel Orientation="Horizontal" Margin="0,11,0,0"
                        Visibility="{Binding HasTools, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,7,0"
                         Text="{Binding [Wiz_Tools_Label], Source={x:Static services:I18n.Instance}}"/>
              <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ToolChip}" Margin="0,0,6,4">
                      <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- Dossiers de cette équipe (F-01): the future sidecar mounts, editable here. -->
            <Border BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,12,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,8"
                           Text="{Binding [Wiz_TeamFolders], Source={x:Static services:I18n.Instance}}"/>
                <WrapPanel>
                  <!-- W-04: chips the blueprint implies — read (folder-open) then write
                       (pencil); informative, no ✕ — editing an agent is what changes them. -->
                  <ItemsControl ItemsSource="{Binding DerivedMounts}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource ToolChip}" Margin="0,0,7,7">
                          <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Size="11" Foreground="{DynamicResource InkMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0">
                              <controls:LucideIcon.Style>
                                <Style TargetType="controls:LucideIcon">
                                  <Setter Property="Kind" Value="folder-open"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                                      <Setter Property="Kind" Value="pencil"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </controls:LucideIcon.Style>
                            </controls:LucideIcon>
                            <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding VirtualPath}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding TeamMounts}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource ToolChip}" Margin="0,0,7,7">
                          <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Kind="folder-open" Size="11" Foreground="{DynamicResource InkMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding}"/>
                            <Button Width="16" Height="16" Margin="6,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.RemoveTeamMountCommand, RelativeSource={RelativeSource AncestorType=views:CreateTeamView}}"
                                    CommandParameter="{Binding}">
                              <controls:LucideIcon Kind="x" Size="10" Foreground="{DynamicResource InkFaintBrush}"/>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource ChipAction}" Command="{Binding AllowFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="plus" Size="11" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding [Wiz_AllowFolder], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,7,0,0"
                           Text="{Binding [Wiz_DerivedHint], Source={x:Static services:I18n.Instance}}"
                           Visibility="{Binding HasDerivedMounts, Converter={StaticResource BooleanToVisibility}}"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding [Wiz_FoldersHint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Agents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                          Background="{DynamicResource AccentWeakBrush}" Margin="0,0,14,0">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding Initial}"/>
                  </Border>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" VerticalAlignment="Top"
                          Command="{Binding EditCommand}"
                          ToolTip="{Binding [AgentEd_Wait], Source={x:Static services:I18n.Instance}}"
                          ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="pencil" Size="12" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Wiz_Modify], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Key}"
                                 Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding Role}"/>
                    <WrapPanel Margin="0,9,0,0"
                               Visibility="{Binding HasTools, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock FontSize="11" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Text="{Binding [Wiz_AgentCan], Source={x:Static services:I18n.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource ToolChip}" Margin="0,0,6,4">
                              <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </WrapPanel>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ajouter un agent (F-01) — actionable while the engine waits at its arbitration. -->
        <DockPanel Margin="0,0,0,16" LastChildFill="False">
          <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhost}"
                  Command="{Binding AddAgentCommand}"
                  ToolTip="{Binding [AgentEd_Wait], Source={x:Static services:I18n.Instance}}"
                  ToolTipService.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="plus" Size="12" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Wiz_AddAgent], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <!-- The Composer pause: composing stops the engine before the trial (dry mode);
               the trial is THIS click, never a side effect. -->
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}"
                  Command="{Binding TryTeamCommand}"
                  Visibility="{Binding CanTryTeam, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding [Wiz_TryTeam], Source={x:Static services:I18n.Instance}}"/>
              <controls:LucideIcon Kind="arrow-right" Size="13" Margin="7,0,0,0" Foreground="{DynamicResource AccentFgBrush}"/>
            </StackPanel>
          </Button>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"
                     Text="{Binding [Wiz_Paused_Hint], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding CanTryTeam, Converter={StaticResource BooleanToVisibility}}"/>
        </DockPanel>

        <!-- validation of the rendered crew -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding ValidationErrors.Count, Converter={StaticResource CountToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <controls:LucideIcon Kind="triangle-alert" Size="14" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource CardTitle}" Margin="8,0,0,0"
                         Text="{Binding [Wiz_Validation_Title], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ValidationErrors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,2" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- expert: what the render wrote, where the session lives -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <!-- header recipe (W-05): title + short mono slug on the same centre line,
                 the full session path demoted to a tooltip, action pushed right (W-06). -->
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="11.5" Padding="10,5"
                      Click="OnCopyDefinition"
                      Visibility="{Binding HasCrewDefinition, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="copy" Size="11" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding [Run_Journal_Copy], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:LucideIcon Kind="braces" Size="15" Foreground="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                           Text="{Binding [Wiz_Files_Title], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource CardHeaderMeta}" MaxWidth="260"
                           Text="{Binding SessionSlug}" ToolTip="{Binding SessionDirectory}"/>
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Well}" Margin="0,0,0,10"
                    Visibility="{Binding HasCrewDefinition, Converter={StaticResource BooleanToVisibility}}">
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <TextBlock Style="{StaticResource MonoText}" FontSize="11.5" Text="{Binding CrewDefinitionYaml}"/>
              </ScrollViewer>
            </Border>
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="11" Margin="0,1" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <views:StepNotesView DataContext="{Binding ComposeNotes}"
                             Title="{Binding [Wiz_Notes_Compose], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>

      <!-- ── STEP 3 : ESSAYER ── -->
      <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding [Wiz_Try_Title], Source={x:Static services:I18n.Instance}}"/>
              <controls:LucideIcon Kind="loader-circle" Size="13" Foreground="{DynamicResource AccentBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding RunInProgress, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"
                       Text="{Binding [Wiz_Try_Sub], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Activity}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,3">
                    <controls:LucideIcon DockPanel.Dock="Left" Kind="circle-check" Size="13"
                                         Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- verdict -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding HasVerdict, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding [Wiz_Verdict_Title], Source={x:Static services:I18n.Instance}}"/>
              <Border Margin="10,0,0,0">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VerdictPassing}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding VerdictScore}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VerdictPassing}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </StackPanel>
            <!-- W-08: what the trial itself cost — tokens, cache hit, wall time -->
            <ItemsControl ItemsSource="{Binding VerdictMetricChips}" Margin="0,11,0,0"
                          Visibility="{Binding HasVerdictMetrics, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource MetricChip}" Margin="0,0,7,4">
                    <TextBlock Style="{StaticResource MetricChipText}" Text="{Binding}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,8"
                       Text="{Binding [Wiz_Checklist_Label], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Checklist}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <controls:LucideIcon DockPanel.Dock="Left" Size="14" VerticalAlignment="Top" Margin="0,2,9,0">
                      <controls:LucideIcon.Style>
                        <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                          <Setter Property="Kind" Value="circle-help"/>
                          <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Passed}" Value="False">
                              <Setter Property="Kind" Value="triangle-alert"/>
                              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </controls:LucideIcon.Style>
                    </controls:LucideIcon>
                    <StackPanel>
                      <TextBlock FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding Statement}"/>
                      <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Detail}"
                                 Visibility="{Binding Detail, Converter={StaticResource StringPresentToVisibility}}"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- the arbitration lives HERE, in the verdict card (v3 W-02): «Ça me va»
                 primary, everything else secondary — never navy pills at the top of
                 the page. -->
            <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,14,0,0"
                          Visibility="{Binding DecisionPending, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,8,0" Command="{Binding DecideCommand}" Content="{Binding Label}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Value}" Value="accept">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- expert: the engine invocation behind the trial — replayable in a terminal (F-09) -->
        <StackPanel Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                  Visibility="{Binding EngineCommandLine, Converter={StaticResource StringPresentToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                         Text="{Binding [Wiz_TrialCommand], Source={x:Static services:I18n.Instance}}"/>
              <Border Style="{StaticResource Well}">
                <TextBlock Style="{StaticResource MonoText}" FontSize="11" TextWrapping="Wrap" Text="{Binding EngineCommandLine}"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <views:StepNotesView DataContext="{Binding TryNotes}"
                             Title="{Binding [Wiz_Notes_Try], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>

      <!-- ── STEP 4 : ADOPTER ── -->
      <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding NotSaved, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Wiz_Adopt_Title], Source={x:Static services:I18n.Instance}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                       Text="{Binding [Wiz_TeamName], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7"
                       Text="{Binding [Wiz_AdoptProfile], Source={x:Static services:I18n.Instance}}"/>
            <!-- W-07: the selected model profile as a card — «Changer» unfolds the radio
                 rows; no select at all, exactly the mock's shape. -->
            <Border Background="{DynamicResource PaperSunkBrush}" BorderBrush="{DynamicResource LineFaintBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="13,11" MaxWidth="480" HorizontalAlignment="Left">
              <DockPanel>
                <controls:LucideIcon DockPanel.Dock="Left" Kind="sparkles" Size="15"
                                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,11,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="11.5" Padding="10,5"
                        VerticalAlignment="Center" Command="{Binding ToggleAdoptProfilePickerCommand}"
                        Content="{Binding [Wiz_Adopt_Change], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding AdoptProfileName}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding AdoptProfileSummary}"
                             Visibility="{Binding AdoptProfileSummary, Converter={StaticResource StringPresentToVisibility}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Margin="0,7,0,0" MaxWidth="480" HorizontalAlignment="Left"
                        Visibility="{Binding IsAdoptProfilePickerOpen, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl ItemsSource="{Binding Profiles.Profiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource PickRow}" GroupName="AdoptProfile" Margin="0,0,0,7"
                                 Command="{Binding DataContext.CreateTeam.PickAdoptProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding Name}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" Text="{Binding Summary}"/>
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" FontSize="11.5" Padding="10,5"
                      Command="{Binding OpenSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="sliders-horizontal" Size="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Wiz_ManageSettings], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7"
                       Text="{Binding [Wiz_Schedule_Label], Source={x:Static services:I18n.Instance}}"/>
            <StackPanel>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched" Margin="0,0,0,7"
                           IsChecked="{Binding IsOnDemand}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Wiz_Sched_OnDemand], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Wiz_Sched_OnDemand_Hint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched" Margin="0,0,0,7"
                           IsChecked="{Binding IsDaily}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Wiz_Sched_Daily], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Wiz_Sched_Daily_Hint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Sched"
                           IsChecked="{Binding IsHourly}">
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                             Text="{Binding [Wiz_Sched_Hourly], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0"
                             Text="{Binding [Wiz_Sched_Hourly_Hint], Source={x:Static services:I18n.Instance}}"/>
                </DockPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding NeedsScheduleTime, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                         Text="{Binding [Wiz_Sched_At], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" Width="76" Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                         Text="{Binding [Wiz_Sched_LocalTime], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>

            <views:StepNotesView DataContext="{Binding AdoptNotes}" Margin="0,18,0,0"
                                 Title="{Binding [Wiz_Notes_Adopt], Source={x:Static services:I18n.Instance}}"/>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveTeamCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Wiz_Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsSaved, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="circle-check" Size="18" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0"
                         Text="{Binding [Wiz_Saved_Title], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Wiz_Saved_Path], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="11" Text="{Binding SavedPath}"/>
              <StackPanel Visibility="{Binding HasInstallCommand, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                           Text="{Binding [Wiz_Saved_Install], Source={x:Static services:I18n.Instance}}"/>
                <Border Style="{StaticResource Well}">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource InkBrush}"
                             TextWrapping="Wrap" Text="{Binding InstallCommand}"/>
                </Border>
              </StackPanel>
            </StackPanel>
            <!-- W-09: nothing is frozen — modify (step 2), re-try (step 3), re-adopt
                 the SAME folder. The faint line says so in the user's words. -->
            <TextBlock Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="{Binding [Wiz_Saved_NotFrozen], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding [Wiz_Reopened_Note], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ReopenComposeCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="pencil" Size="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Wiz_Saved_ModifyTeam], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RetryTrialCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="rotate-ccw" Size="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Wiz_Saved_Retry], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BtnGhost}" Command="{Binding RestartCommand}"
                      Content="{Binding [Wiz_CreateAnother], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

        </StackPanel>
        <Border Grid.Column="1" Width="300" VerticalAlignment="Top" Margin="16,0,0,16"
                Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18,16"
                Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <controls:LucideIcon Kind="circle-help" Size="14" Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0"
                         Text="{Binding [Wiz_Help_Title], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Wiz_Help_Step1], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                      <Setter Property="Text" Value="{Binding [Wiz_Help_Step2], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                      <Setter Property="Text" Value="{Binding [Wiz_Help_Step3], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                      <Setter Property="Text" Value="{Binding [Wiz_Help_Step4], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- expert: the technical journal, folded by default -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"
              Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="11.5" Click="OnToggleTech">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="eye" Size="12" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding [Wiz_Tech_Toggle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="11.5"
                    Margin="0,0,8,0" Click="OnCopyTechJournal"
                    Visibility="{Binding RawLog.Lines.Count, Converter={StaticResource CountToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="copy" Size="12" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding [Run_Journal_Copy], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                         Text="{Binding [Wiz_Tech_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource CardHeaderMeta}" MaxWidth="300" Text="{Binding SessionSlug}"/>
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="9" Padding="8" Margin="0,12,0,0"
                  MaxHeight="230" Visibility="{Binding IsTechOpen, Converter={StaticResource BooleanToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding RawLog.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="6,1"
                               Foreground="{DynamicResource ConsoleFgBrush}" TextWrapping="Wrap" Text="{Binding Text}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

  </StackPanel>
</UserControl>
