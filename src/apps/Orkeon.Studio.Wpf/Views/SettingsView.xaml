<!-- The unified "Réglages" screen (refonte lots 5, 9 and 11): a classeur of tabs in four groups, drawn
     as a horizontal bar over the active group's tabs - Models (the AI model, the RAG's model, the
     API keys), Access (allowed folders, tools), Connections (e-mail, cloud storage, MCP),
     Advanced (Studio, limits & index, the file) - each tab with its state under its title. The bar « N unsaved
     changes · Cancel · Save » appears with the first edit, and leaving the screen with edits pending
     asks first. DataContext: SettingsScreenViewModel (Settings). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <!-- header (R3) -->
    <controls:PageHeader Title="{Binding [Studio.Common.Title], Source={x:Static services:I18n.Instance}}">
      <controls:PageHeader.Style>
        <Style TargetType="controls:PageHeader" BasedOn="{StaticResource {x:Type controls:PageHeader}}">
          <Setter Property="Subtitle" Value="{Binding [Studio.Common.SubNovice], Source={x:Static services:I18n.Instance}}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Mode.IsExpert}" Value="True">
              <Setter Property="Subtitle" Value="{Binding [Studio.Common.SubExpert], Source={x:Static services:I18n.Instance}}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </controls:PageHeader.Style>
      <StackPanel Orientation="Horizontal" Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <Button Style="{StaticResource BtnSecondary}" Command="{Binding Config.ValidateCommand}" Margin="0,0,8,0"
                controls:ButtonIcon.Kind="badge-check"
                Content="{Binding [Studio.Common.Validate], Source={x:Static services:I18n.Instance}}"/>
        <!-- Novice saves automatically (audit 07/16); the explicit ending of the cycle is
             the expert's. -->
        <Button Style="{StaticResource BtnPrimary}" Command="{Binding Config.SaveCommand}"
                controls:ButtonIcon.Kind="save"
                Content="{Binding [Studio.Common.Save], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </controls:PageHeader>
    <!-- Lot 11: the outcomes only; « Loaded: path » is said once, in the File section. -->
    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,6,0,0" Text="{Binding Config.HeaderStatusMessage}"
               Visibility="{Binding Config.HeaderStatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <!-- lot 5: leaving with edits pending asks; the three answers sit under the question -->
    <controls:Alert x:Name="LeaveQuestion" Tone="Warning" Margin="0,14,0,0"
                    Message="{Binding [Studio.Settings.LeaveQuestion], Source={x:Static services:I18n.Instance}}"
                    Visibility="{Binding IsAskingToLeave, Converter={StaticResource BooleanToVisibility}}">
      <controls:Alert.Actions>
        <StackPanel Style="{StaticResource ActionRow}">
          <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding SaveAndLeaveCommand}"
                  Content="{Binding [Studio.Settings.LeaveSave], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnDanger}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding DiscardAndLeaveCommand}"
                  Content="{Binding [Studio.Settings.LeaveDiscard], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding StayCommand}"
                  Content="{Binding [Studio.Settings.LeaveStay], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </controls:Alert.Actions>
    </controls:Alert>

    <!-- lot 5: « N unsaved changes · Cancel · Save », from the first edit until it is saved or dropped -->
    <Border x:Name="PendingBar" Margin="0,14,0,0" Padding="14,8" CornerRadius="10"
            Background="{DynamicResource WarningWeakBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
            Visibility="{Binding Config.HasPendingChanges, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0"
                  Command="{Binding Config.DiscardCommand}"
                  Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" Command="{Binding Config.SaveCommand}"
                  Content="{Binding [Studio.Common.Save], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controls:LucideIcon Kind="pencil" Size="16" Margin="0,0,8,0" Foreground="{DynamicResource WarningIconBrush}"/>
          <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarningInkBrush}"
                     Text="{Binding Config.PendingChangesText}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- lot 9: the classeur in groups (R14, grouped variant) — Models · Access · Connections ·
         Advanced, the bar of groups above the column since lot 11. Each tab says its state under its title (SettingsScreenViewModel.Tabs); the
         selected tab is ActiveTab itself, so the Diagnostic's actions still land on a section. -->
    <controls:StepTabs Margin="0,20,0,0" SelectedValuePath="Tag" SelectedValue="{Binding ActiveTab}">
      <controls:StepTab Tag="model" Header="{Binding [Studio.Shell.Model], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding ModelTabSubtitle}" State="{Binding ModelTabState}"
                      Group="{Binding [Studio.Settings.GroupModels], Source={x:Static services:I18n.Instance}}">
        <!-- ══ MODÈLE D'IA ══ -->
        <StackPanel>

          <!-- lot 9: the model Studio itself uses (wizard, verdicts), distinct from the teams'
               models: a property row and its list. The tab's subtitle says when it is missing. -->
          <StackPanel Margin="0,0,0,18">
            <controls:PropertyRow Label="{Binding [Studio.Settings.AssistantRow], Source={x:Static services:I18n.Instance}}">
              <Grid Width="320" HorizontalAlignment="Left">
                <ComboBox ItemsSource="{Binding Profiles.ProfileNames}"
                          SelectedItem="{Binding Profiles.StudioProfileName}"
                          AutomationProperties.Name="{Binding [Studio.Settings.ModelTitle], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{Binding [Studio.Settings.ModelPlaceholder], Source={x:Static services:I18n.Instance}}"
                           Visibility="{Binding Profiles.HasStudioProfile, Converter={StaticResource InverseBooleanToVisibility}}"/>
              </Grid>
            </controls:PropertyRow>
            <TextBlock Style="{StaticResource Hint}" Margin="172,4,0,0" TextWrapping="Wrap"
                       Text="{Binding [Studio.Settings.ModelHintNovice], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="172,4,0,0" TextWrapping="Wrap"
                       Text="{Binding [Studio.Settings.ModelHintExpert], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>

          <!-- the teams' named settings -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <!-- R05: an « add » is a secondary with its +; the screen's one primary is « Save ». -->
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" VerticalAlignment="Top"
                        Command="{Binding Profiles.NewProfileCommand}" controls:ButtonIcon.Kind="plus"
                        Content="{Binding [Studio.Settings.New], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel Margin="0,0,14,0">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="sparkles" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.ProfileTitle], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.HintNovice], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                             Text="{Binding [Studio.Settings.HintExpert], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
              </DockPanel>

              <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                         Text="{Binding [Studio.Settings.ProfileEmpty], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding Profiles.IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>

              <!-- STUDIO-12 C6: a profile file that exists but cannot be read is said out loud —
                   it used to load as the empty set, the same screen as a first run. -->
              <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningBrush}"
                         Text="{Binding Profiles.LoadError}"
                         Visibility="{Binding Profiles.HasLoadError, Converter={StaticResource BooleanToVisibility}}"/>

              <!-- STUDIO-56: a write of the profiles file that failed is said, not swallowed; the
                   settings stay as shown for the session and the next change writes them again. -->
              <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningBrush}"
                         Text="{Binding Profiles.ProfileWriteError}"
                         Visibility="{Binding Profiles.HasProfileWriteError, Converter={StaticResource BooleanToVisibility}}"/>

              <!-- STUDIO-44: a key pasted and saved with its profile is in place for the session, but
                   the user scope refused it; the editor has closed, so the list says so. -->
              <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningBrush}"
                         Text="{Binding Profiles.KeyStoreError}"
                         Visibility="{Binding Profiles.HasKeyStoreError, Converter={StaticResource BooleanToVisibility}}"/>

              <!-- lot 9: one card per model — its name and badges, four label/value rows, and its
                   action bar (R5): the work actions, a rule, « Delete » in the danger tone. -->
              <ItemsControl ItemsSource="{Binding Profiles.Profiles}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- audit 07/16: the border stays quiet even for the default — the badge says it. -->
                    <Border BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="11" Padding="14,12" Margin="0,0,0,8">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                          <Border Style="{StaticResource BadgeRun}" Margin="10,0,0,0"
                                  Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}"
                                       Text="{Binding [Studio.Settings.DefaultBadge], Source={x:Static services:I18n.Instance}}"/>
                          </Border>
                          <Border Style="{StaticResource BadgeNeutral}" Margin="10,0,0,0"
                                  Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Provider}"/>
                          </Border>
                          <Border Style="{StaticResource BadgeSky}" Margin="10,0,0,0"
                                  Visibility="{Binding IsStudio, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}"
                                       Text="{Binding [Studio.Settings.StudioBadge], Source={x:Static services:I18n.Instance}}"/>
                          </Border>
                          <!-- STUDIO-35 (D-04): what the profile's account has left, once this session
                               read it — in the warning tone under its provider's threshold. -->
                          <Border Margin="10,0,0,0" ToolTip="{Binding BalanceTip}"
                                  Visibility="{Binding HasBalance, Converter={StaticResource BooleanToVisibility}}">
                            <Border.Style>
                              <Style TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsBalanceLow}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                              <controls:LucideIcon Kind="wallet" Size="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Balance}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="0,4,0,8" Text="{Binding Summary}"/>
                        <controls:PropertyRow Label="{Binding [Studio.Settings.FieldProvider], Source={x:Static services:I18n.Instance}}">
                          <TextBlock VerticalAlignment="Center" Text="{Binding Provider}"/>
                        </controls:PropertyRow>
                        <!-- D10 (R21): the endpoint URL is the expert's; Novice reads the provider. -->
                        <controls:PropertyRow Label="{Binding [Studio.Settings.FieldEndpoint], Source={x:Static services:I18n.Instance}}"
                                              Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}">
                          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Text" Value="{Binding Endpoint}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Endpoint}" Value="{x:Null}">
                                    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                                    <Setter Property="Text" Value="{Binding [Studio.Settings.EndpointDefault], Source={x:Static services:I18n.Instance}}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </controls:PropertyRow>
                        <!-- STUDIO-48: the name a crew writes to run on this model — the host profile
                             Llm:Profiles:<id> of the settings file —, or why no crew can. -->
                        <!-- D10 (R21): Novice hides the profile id (« profile: studio »); a setting no
                             crew can name still says why, in both modes. -->
                        <controls:PropertyRow Label="{Binding [Studio.Settings.FieldInFile], Source={x:Static services:I18n.Instance}}">
                          <controls:PropertyRow.Style>
                            <Style TargetType="controls:PropertyRow" BasedOn="{StaticResource {x:Type controls:PropertyRow}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHostIdText}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHostIdIssue}" Value="False"/>
                                    <Condition Binding="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=views:SettingsView}}" Value="True"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </controls:PropertyRow.Style>
                          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding HostIdText}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsHostIdIssue}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </controls:PropertyRow>
                        <controls:PropertyRow Label="{Binding [Studio.Settings.UsedBy], Source={x:Static services:I18n.Instance}}">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding [Studio.Settings.UsedByNone], Source={x:Static services:I18n.Instance}}"
                                       Visibility="{Binding IsUsedByTeams, Converter={StaticResource InverseBooleanToVisibility}}"/>
                          <ItemsControl ItemsSource="{Binding UsedByTeams}" Margin="0,3,0,0"
                                        Visibility="{Binding IsUsedByTeams, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,6,3"
                                        MaxWidth="260" ToolTip="{Binding}">
                                  <TextBlock Style="{StaticResource BadgeText}"
                                             TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                            <!-- STUDIO-73: on the elected default, how many of its teams follow it. -->
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding UsedByCountLine}"
                                       Visibility="{Binding UsedByCountLine, Converter={StaticResource StringPresentToVisibility}}"/>
                          </StackPanel>
                        </controls:PropertyRow>
                        <!-- STUDIO-49 (decision 7): a setting that keeps its key in ORKEON_Llm__ApiKey
                             without being the default — every run reads that key as its default's. -->
                        <StackPanel Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}">
                          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                     Foreground="{DynamicResource WarningBrush}" Text="{Binding DefaultKeyVariableWarning}"
                                     Visibility="{Binding HasDefaultKeyVariableWarning, Converter={StaticResource BooleanToVisibility}}"/>
                        </StackPanel>
                        <controls:ActionBar ButtonHeight="32" Margin="0,10,0,0">
                          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding SetDefaultCommand}"
                                  Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibility}}"
                                  controls:ButtonIcon.Kind="badge-check"
                                  Content="{Binding [Studio.Settings.UseDefault], Source={x:Static services:I18n.Instance}}"/>
                          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding EditCommand}"
                                  controls:ButtonIcon.Kind="pencil"
                                  Content="{Binding [Studio.Settings.Edit], Source={x:Static services:I18n.Instance}}"/>
                          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding DuplicateCommand}"
                                  controls:ButtonIcon.Kind="copy"
                                  Content="{Binding [Studio.Settings.Duplicate], Source={x:Static services:I18n.Instance}}"/>
                          <Rectangle Style="{StaticResource ActionBarRule}"/>
                          <!-- R06: removing a model is definitive — it takes the setting out of the
                               profiles file and of the settings file at once, with no « Save » in
                               between —, so it is the danger outline with its trash, at the end of
                               the bar after a rule. -->
                          <Button Style="{StaticResource BtnDanger}" controls:ButtonSize.Height="32" Command="{Binding DeleteCommand}"
                                  controls:ButtonIcon.Kind="trash-2"
                                  Content="{Binding [Studio.Settings.Delete], Source={x:Static services:I18n.Instance}}"/>
                        </controls:ActionBar>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- STUDIO-48: the entries of Llm:Profiles no setting owns, written by hand in the
                   settings file. Read-only: a crew can name them, Studio never changes them. -->
              <StackPanel Margin="0,8,0,0"
                          Visibility="{Binding Profiles.HasHandWrittenProfiles, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <controls:LucideIcon Kind="file-json-2" Size="13" Foreground="{DynamicResource InkFaintBrush}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                             Text="{Binding [Studio.Settings.HandWrittenTitle], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="{Binding [Studio.Settings.HandWrittenHint], Source={x:Static services:I18n.Instance}}"/>
                <ItemsControl ItemsSource="{Binding Profiles.HandWrittenProfiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1" BorderBrush="{DynamicResource LineFaintBrush}" Background="{DynamicResource PaperSunkBrush}"
                              CornerRadius="11" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Id}"/>
                          <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3,0,0" Text="{Binding Summary}"
                                     Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibility}}"/>
                          <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding HostIdText}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </controls:StepTab>
      <controls:StepTab Tag="rag" Header="{Binding [Studio.Settings.RagTab], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding RagTabSubtitle}" State="{Binding RagTabState}"
                      Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <!-- ══ RECHERCHE DOCUMENTAIRE (lot 11, expert) ══ -->
        <StackPanel>
          <!-- STUDIO-48 (GAP-19): the profile the document search calls, Orkeon:Rag:LlmProfile,
               chosen among the host profiles of the model tab. Expert, like the RAG settings of the limits tab. -->
          <!-- B06 (R10): the list under its title and hint, at the medium width — the choice's label
               (« default — the model marked default ») trims with « … » before the chevron. -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="scan-search" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CardTitle}"
                           Text="{Binding [Studio.Settings.RagLlmTitle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.RagLlmHint], Source={x:Static services:I18n.Instance}}"/>
              <ComboBox Style="{StaticResource ComboM}" Margin="0,12,0,0"
                        ItemsSource="{Binding Profiles.RagProfileChoices}"
                        SelectedItem="{Binding Profiles.SelectedRagProfile}"
                        DisplayMemberPath="Label"
                        ToolTip="{Binding Profiles.SelectedRagProfile.Label}"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </controls:StepTab>
      <controls:StepTab Tag="keys" Header="{Binding [Studio.Settings.SecretsTitle], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding KeysTabSubtitle}" State="{Binding KeysTabState}">
        <!-- ══ CLÉS API (lot 11) ══ -->
        <StackPanel>
          <!-- Without a cloud model there is no key to provide: the tab says so. -->
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding KeysTabSubtitle}"
                     Visibility="{Binding Profiles.HasSecrets, Converter={StaticResource InverseBooleanToVisibility}}"/>
          <!-- API keys: one row per environment variable the profiles resolve. The value goes
               straight to the user environment (IApiKeyStore) — it never enters any file. -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                  Visibility="{Binding Profiles.HasSecrets, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <controls:LucideIcon Kind="key" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.SecretsTitle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.Intro], Source={x:Static services:I18n.Instance}}"/>
              <ItemsControl ItemsSource="{Binding Profiles.Secrets}" ItemTemplate="{StaticResource KeyRowTemplate}"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </controls:StepTab>
      <controls:StepTab Tag="folders" Header="{Binding [Studio.Shell.Folders], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding FoldersTabSubtitle}" State="{Binding FoldersTabState}"
                      Group="{Binding [Studio.Settings.GroupAccess], Source={x:Static services:I18n.Instance}}">
        <!-- ══ DOSSIERS AUTORISÉS ══ -->
        <StackPanel>

          <!-- novice: one card per folder + "Autoriser un dossier…" (audit 08/17); the typed
               two-pane form below stays the expert tool. -->
          <StackPanel Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.NoviceTitle], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="{Binding [Studio.Settings.NoviceIntro], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="{Binding [Studio.Settings.NoviceEmpty], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Config.Mounts.Mounts.Count, Converter={StaticResource ZeroToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Config.Mounts.Mounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="12" Padding="15,12" Margin="0,0,0,9" BorderThickness="1"
                          BorderBrush="{DynamicResource LineFaintBrush}" Background="{DynamicResource SurfaceBrush}">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- The rights badge is a toggle (STUDIO-19): the OS folder dialog asks no rights
                             question, so a declared folder lands read-only and this is where it widens. -->
                        <Button VerticalAlignment="Center" Margin="0,0,9,0" Content="{Binding RightsLabel}"
                                ToolTip="{Binding [Studio.Settings.ToggleRights], Source={x:Static services:I18n.Instance}}"
                                Command="{Binding DataContext.Config.Mounts.ToggleRightsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipAction}">
                              <Setter Property="FontSize" Value="13"/>
                              <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                              <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Rights}" Value="ReadWrite">
                                  <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Width="29" Height="29" Padding="0" Style="{StaticResource BtnSecondary}"
                                Command="{Binding DataContext.Config.Mounts.DropMountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <controls:LucideIcon Kind="x" Size="13"/>
                        </Button>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                   Text="{Binding PhysicalPath}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,3,0,0"
                                   Foreground="{DynamicResource InkFaintBrush}">
                          <Run Text="{Binding [Studio.Settings.SeenAs], Source={x:Static services:I18n.Instance}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding VirtualPath}"/>
                        </TextBlock>
                        <!-- VFS-90: the entry's identity — what a team names it by — and a one-click copy
                             for a hand-written crew's mounts: block. -->
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,3,0,0"
                                   Text="{Binding UsedByDisplay, Mode=OneWay}"
                                   Visibility="{Binding IsReferenced, Converter={StaticResource BooleanToVisibility}}"/>
                        <!-- Lot 5: the row's own finding, on the faulty card (icon + text); the entry's
                             id and mount string are Expert's, in the two-pane editor. -->
                        <DockPanel Margin="0,6,0,0" DataContext="{Binding RowProblem}"
                                   Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                          <controls:LucideIcon DockPanel.Dock="Left" Size="13" Margin="0,2,6,0" VerticalAlignment="Top">
                            <controls:LucideIcon.Style>
                              <Style TargetType="controls:LucideIcon">
                                <Setter Property="Kind" Value="triangle-alert"/>
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Kind" Value="circle-x"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </controls:LucideIcon.Style>
                          </controls:LucideIcon>
                          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding FriendlyText}"
                                     Foreground="{DynamicResource InkBrush}"/>
                        </DockPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"
                    Command="{Binding Config.Mounts.AllowFolderCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Settings.Allow], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
            <views:MountsEditorView x:Name="MountsPanel" DataContext="{Binding Config.Mounts}"/>
          </StackPanel>
          <Border Style="{StaticResource Well}" Margin="0,14,0,0" Padding="13,10"
                  Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="MOUNT STRINGS" Margin="0,0,0,5"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="{Binding [Studio.Settings.NoviceEmpty], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Config.Mounts.Mounts.Count, Converter={StaticResource ZeroToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Config.Mounts.Mounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Text="{Binding MountString}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- STUDIO-14 (D-13, P-1): the teams' own folders, read-only, after the declared ones in
               BOTH modes — under the novice list, under the expert editor and its mount strings.
               Created inside each team at adoption and vouched for by that alone, they are never
               written to Orkeon:FileSystem:Mounts; this section says where they are and offers no
               gesture on them — « My teams » › « Change the folders » is where they change. -->
          <Border Style="{StaticResource Well}" Margin="0,14,0,0" Padding="13,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <controls:LucideIcon Kind="folder" Size="11" Foreground="{DynamicResource InkFaintBrush}"
                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                           Text="{Binding [Studio.Settings.TeamFoldersTitle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                         Text="{Binding [Studio.Settings.TeamFoldersIntro], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource Hint}"
                         Text="{Binding [Studio.Settings.TeamFoldersEmpty], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding TeamFolders.Rows.Count, Converter={StaticResource ZeroToVisibility}}"/>
              <ItemsControl ItemsSource="{Binding TeamFolders.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- The line first, the badge last as the fill child, the STUDIO-16 way: one
                         word, bounded, the full rights label in its tooltip — the name never shrinks. -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="13"
                                 Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Label, Mode=OneWay}"/>
                      <Border Style="{StaticResource BadgeOk}" Margin="8,0,0,0" MaxWidth="160"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip="{Binding RightsLabel, Mode=OneWay}">
                        <TextBlock Style="{StaticResource BadgeText}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Text="{Binding RightsBadge, Mode=OneWay}"/>
                      </Border>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </controls:StepTab>
      <controls:StepTab Tag="tools" Header="{Binding [Studio.Shell.Tools], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding ToolsTabSubtitle}">
        <!-- ══ OUTILS (STUDIO-21): the tool keys, the catalogue, the shell allow-list ══ -->
        <views:ToolsView/>
      </controls:StepTab>
      <controls:StepTab Tag="mails" Header="{Binding [Studio.Shell.Mails], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding MailsTabSubtitle}" State="{Binding MailsTabState}"
                      Group="{Binding [Studio.Settings.GroupConnections], Source={x:Static services:I18n.Instance}}">
        <!-- ══ MAILS (STUDIO-67, both modes): the accounts the mail tools use ══ -->
        <views:EmailView DataContext="{Binding Config.Email}"/>
      </controls:StepTab>
      <controls:StepTab Tag="drive" Header="{Binding [Studio.Shell.Drive], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding DriveTabSubtitle}" State="{Binding DriveTabState}">
        <!-- ══ DRIVE (both modes): the Google Drive and OneDrive accounts the drive tools use ══ -->
        <views:DriveView DataContext="{Binding Config.Drive}"/>
      </controls:StepTab>
      <controls:StepTab Tag="mcp" Header="{Binding [Studio.Shell.Mcp], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding McpTabSubtitle}" State="{Binding McpTabState}"
                      Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <!-- ══ MCP (expert, STUDIO-21) ══ -->
        <views:McpView DataContext="{Binding Config.Mcp}"/>
      </controls:StepTab>
      <controls:StepTab Tag="studio" Header="{Binding [Studio.Shell.StudioTab], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding StudioTabSubtitle}"
                      Group="{Binding [Studio.Settings.GroupAdvanced], Source={x:Static services:I18n.Instance}}">
        <!-- ══ STUDIO (STUDIO-35): how Studio itself behaves — the provider balance first ══ -->
        <views:StudioSettingsView/>
      </controls:StepTab>
      <controls:StepTab Tag="limits" Header="{Binding [Studio.Shell.Limits], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding LimitsTabSubtitle}"
                      Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <!-- ══ LIMITES & JOURNAUX (expert) ══ -->
        <views:LimitsView DataContext="{Binding Config}"/>
      </controls:StepTab>
      <controls:StepTab Tag="json" Header="{Binding [Studio.Shell.Json], Source={x:Static services:I18n.Instance}}"
                      Subtitle="{Binding FileTabSubtitle}" State="{Binding FileTabState}"
                      Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <!-- ══ JSON BRUT (expert) ══ -->
        <views:SettingsFileView DataContext="{Binding Config}"/>
      </controls:StepTab>
    </controls:StepTabs>

  </StackPanel>
</UserControl>
