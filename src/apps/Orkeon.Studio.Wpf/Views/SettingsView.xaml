<!-- The unified "Réglages" screen (design v3): one nav entry, six inner tabs — the AI model
     (named profiles + the Studio assistant's own), the authorized folders, the tools (STUDIO-21),
     and the three expert tabs (limits & logs, the MCP servers, the raw file).
     DataContext: SettingsScreenViewModel (Settings). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <!-- the maquette's underlined tab button -->
    <Style x:Key="SettingsTab" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Underline" Padding="2,0,2,7" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>

    <!-- header -->
    <DockPanel Margin="0,0,0,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource BtnGhost}" Command="{Binding Config.ValidateCommand}" Margin="0,0,8,0"
                Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Common.Validate], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <!-- Novice saves automatically (audit 07/16); the explicit ending of the cycle is
             the expert's. -->
        <Button Style="{StaticResource BtnPrimary}" Command="{Binding Config.SaveCommand}"
                Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
            <TextBlock Text="{Binding [Studio.Common.Save], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Studio.Common.Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Studio.Common.SubNovice], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Studio.Common.SubExpert], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,6,0,0" Text="{Binding Config.StatusMessage}"/>

    <!-- tab strip -->
    <StackPanel Orientation="Horizontal" Margin="0,20,0,18">
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowModelCommand}"
              Tag="{Binding IsModelTab}"
              Content="{Binding [Studio.Shell.Model], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowFoldersCommand}"
              Tag="{Binding IsFoldersTab}"
              Content="{Binding [Studio.Shell.Folders], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowToolsCommand}"
              Tag="{Binding IsToolsTab}"
              Content="{Binding [Studio.Shell.Tools], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowLimitsCommand}"
              Tag="{Binding IsLimitsTab}"
              Content="{Binding [Studio.Shell.Limits], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowMcpCommand}"
              Tag="{Binding IsMcpTab}"
              Content="{Binding [Studio.Shell.Mcp], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Style="{StaticResource SettingsTab}" Command="{Binding ShowJsonCommand}"
              Tag="{Binding IsJsonTab}"
              Content="{Binding [Studio.Shell.Json], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
    </StackPanel>

    <!-- ══ MODÈLE D'IA ══ -->
    <StackPanel Visibility="{Binding IsModelTab, Converter={StaticResource BooleanToVisibility}}">

      <!-- the model Studio itself uses (wizard, verdicts) — distinct from the teams' models -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center"
                  Background="{DynamicResource AccentWeakBrush}" Margin="0,0,11,0">
            <controls:LucideIcon Kind="wand-2" Size="15" Foreground="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Grid DockPanel.Dock="Right" Width="210" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding Profiles.ProfileNames}"
                      SelectedItem="{Binding Profiles.StudioProfileName}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="{Binding [Studio.Settings.ModelPlaceholder], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Profiles.HasStudioProfile, Converter={StaticResource InverseBooleanToVisibility}}"/>
          </Grid>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding [Studio.Settings.ModelTitle], Source={x:Static services:I18n.Instance}}"/>
              <controls:LucideIcon Kind="triangle-alert" Size="13" Foreground="{DynamicResource WarningBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding Profiles.HasStudioProfile, Converter={StaticResource InverseBooleanToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="{Binding [Studio.Settings.ModelHintNovice], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="{Binding [Studio.Settings.ModelHintExpert], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- the teams' named settings -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top"
                    Command="{Binding Profiles.NewProfileCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                <TextBlock Text="{Binding [Studio.Settings.New], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <StackPanel Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sparkles" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.ProfileTitle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.HintNovice], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.HintExpert], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
          </DockPanel>

          <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                     Text="{Binding [Studio.Settings.ProfileEmpty], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding Profiles.IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>

          <!-- STUDIO-12 C6: a profile file that exists but cannot be read is said out loud —
               it used to load as the empty set, the same screen as a first run. -->
          <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}"
                     Text="{Binding Profiles.LoadError}"
                     Visibility="{Binding Profiles.HasLoadError, Converter={StaticResource BooleanToVisibility}}"/>

          <ItemsControl ItemsSource="{Binding Profiles.Profiles}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,8">
                  <Border.Style>
                    <!-- audit 07/16: the border stays quiet even for the default —
                         the badge already carries that information. -->
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"/>
                      <Border Style="{StaticResource BadgeRun}" Margin="10,0,0,0"
                              Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}"
                                   Text="{Binding [Studio.Settings.DefaultBadge], Source={x:Static services:I18n.Instance}}"/>
                      </Border>
                      <Border Style="{StaticResource BadgeNeutral}" Margin="10,0,0,0"
                              Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Provider}"/>
                      </Border>
                      <Border Style="{StaticResource BadgeSky}" Margin="10,0,0,0"
                              Visibility="{Binding IsStudio, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}"
                                   Text="{Binding [Studio.Settings.StudioBadge], Source={x:Static services:I18n.Instance}}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" Margin="0,4,0,0" Text="{Binding Summary}"/>
                    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,4,0,0" Text="{Binding Endpoint}"
                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                Visibility="{Binding IsUsedByTeams, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Text="{Binding [Studio.Settings.UsedBy], Source={x:Static services:I18n.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding UsedByTeams}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,6,3"
                                    MaxWidth="260" ToolTip="{Binding}">
                              <TextBlock Style="{StaticResource BadgeText}"
                                         TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                      <Button Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding SetDefaultCommand}" Margin="0,0,7,0"
                              Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibility}}"
                              Content="{Binding [Studio.Settings.UseDefault], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding EditCommand}" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="pencil" Size="12" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding [Studio.Settings.Edit], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding DuplicateCommand}" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="copy" Size="12" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding [Studio.Settings.Duplicate], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding DeleteCommand}"
                              Foreground="{DynamicResource DangerBrush}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="trash-2" Size="12" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding [Studio.Settings.Delete], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- API keys: one row per environment variable the profiles resolve. The value goes
           straight to the user environment (IApiKeyStore) — it never enters any file. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"
              Visibility="{Binding Profiles.HasSecrets, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <controls:LucideIcon Kind="key" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.SecretsTitle], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="{Binding [Studio.Settings.Intro], Source={x:Static services:I18n.Instance}}"/>
          <ItemsControl ItemsSource="{Binding Profiles.Secrets}" ItemTemplate="{StaticResource SecretRowTemplate}"/>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- ══ DOSSIERS AUTORISÉS ══ -->
    <StackPanel Visibility="{Binding IsFoldersTab, Converter={StaticResource BooleanToVisibility}}">

      <!-- novice: one card per folder + "Autoriser un dossier…" (audit 08/17); the typed
           two-pane form below stays the expert tool. -->
      <StackPanel Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.NoviceTitle], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap"
                   Text="{Binding [Studio.Settings.NoviceIntro], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="{Binding [Studio.Settings.NoviceEmpty], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding Config.Mounts.Mounts.Count, Converter={StaticResource ZeroToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Config.Mounts.Mounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="12" Padding="15,12" Margin="0,0,0,9" BorderThickness="1"
                      BorderBrush="{DynamicResource LineFaintBrush}" Background="{DynamicResource SurfaceBrush}">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- The rights badge is a toggle (STUDIO-19): the OS folder dialog asks no rights
                         question, so a declared folder lands read-only and this is where it widens. -->
                    <Button VerticalAlignment="Center" Margin="0,0,9,0" Content="{Binding RightsLabel}"
                            ToolTip="{Binding [Studio.Settings.ToggleRights], Source={x:Static services:I18n.Instance}}"
                            Command="{Binding DataContext.Config.Mounts.ToggleRightsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipAction}">
                          <Setter Property="FontSize" Value="10"/>
                          <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Rights}" Value="ReadWrite">
                              <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Width="29" Height="29" Padding="0" Style="{StaticResource BtnGhost}"
                            Command="{Binding DataContext.Config.Mounts.DropMountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <controls:LucideIcon Kind="x" Size="13"/>
                    </Button>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                               Text="{Binding PhysicalPath}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource InkFaintBrush}">
                      <Run Text="{Binding [Studio.Settings.SeenAs], Source={x:Static services:I18n.Instance}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding VirtualPath}"/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                Command="{Binding Config.Mounts.AllowFolderCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Studio.Settings.Allow], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <views:MountsEditorView x:Name="MountsPanel" DataContext="{Binding Config.Mounts}"/>
      </StackPanel>
      <Border Style="{StaticResource Well}" Margin="0,14,0,0" Padding="13,10"
              Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="MOUNT STRINGS" Margin="0,0,0,5"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="{Binding [Studio.Settings.NoviceEmpty], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding Config.Mounts.Mounts.Count, Converter={StaticResource ZeroToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Config.Mounts.Mounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource MonoText}" FontSize="11" Text="{Binding MountString}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- STUDIO-14 (D-13, P-1): the teams' own folders, read-only, after the declared ones in
           BOTH modes — under the novice list, under the expert editor and its mount strings.
           Created inside each team at adoption and vouched for by that alone, they are never
           written to Orkeon:FileSystem:Mounts; this section says where they are and offers no
           gesture on them — « My teams » › « Change the folders » is where they change. -->
      <Border Style="{StaticResource Well}" Margin="0,14,0,0" Padding="13,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <controls:LucideIcon Kind="folder" Size="11" Foreground="{DynamicResource InkFaintBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                       Text="{Binding [Studio.Settings.TeamFoldersTitle], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                     Text="{Binding [Studio.Settings.TeamFoldersIntro], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="{Binding [Studio.Settings.TeamFoldersEmpty], Source={x:Static services:I18n.Instance}}"
                     Visibility="{Binding TeamFolders.Rows.Count, Converter={StaticResource ZeroToVisibility}}"/>
          <ItemsControl ItemsSource="{Binding TeamFolders.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- The line first, the badge last as the fill child, the STUDIO-16 way: one
                     word, bounded, the full rights label in its tooltip — the name never shrinks. -->
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="11"
                             Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Text="{Binding Label, Mode=OneWay}"/>
                  <Border Style="{StaticResource BadgeOk}" Margin="8,0,0,0" MaxWidth="160"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          ToolTip="{Binding RightsLabel, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BadgeText}" FontSize="9.5" TextTrimming="CharacterEllipsis"
                               Text="{Binding RightsBadge, Mode=OneWay}"/>
                  </Border>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ══ OUTILS (STUDIO-21): the tool keys, the catalogue, the shell allow-list ══ -->
    <views:ToolsView Visibility="{Binding IsToolsTab, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- ══ MCP (expert, STUDIO-21) ══ -->
    <views:McpView DataContext="{Binding Config.Mcp}"
                   Visibility="{Binding DataContext.IsMcpTab, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- ══ LIMITES & JOURNAUX (expert) ══ -->
    <views:LimitsView DataContext="{Binding Config}"
                      Visibility="{Binding DataContext.IsLimitsTab, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- ══ JSON BRUT (expert) ══ -->
    <views:SettingsFileView DataContext="{Binding Config}"
                            Visibility="{Binding DataContext.IsJsonTab, RelativeSource={RelativeSource AncestorType=views:SettingsView}, Converter={StaticResource BooleanToVisibility}}"/>

  </StackPanel>
</UserControl>
