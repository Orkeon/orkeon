<!-- The "History" screen (§5.3): replayable local run history.
     DataContext: LaunchHistoryViewModel (bound as Launch.History in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Hist_Title], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,22"
               Text="{Binding [Scr_Hist_Sub], Source={x:Static services:I18n.Instance}}"/>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding ReplayCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Hist_Replay], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Command="{Binding ReloadCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="rotate-cw" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Hist_Reload], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="10" Padding="14,10" Margin="0,0,0,7"
                            BorderThickness="1" BorderBrush="{DynamicResource LineFaintBrush}"
                            Background="{DynamicResource SurfaceBrush}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                  <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="exit"/><Run Text=" "/><Run Text="{Binding ExitCode, Mode=OneWay}"/>
                  </TextBlock>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                        <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Outcome}" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Outcome}" Value="Cancelled">
                            <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource BadgeText}" FontSize="10" Text="{Binding Outcome, Mode=OneWay}"/>
                  </Border>
                </StackPanel>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MonoText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" Text="{Binding Target, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding StartedAt, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,3,0,0"
                             TextTrimming="CharacterEllipsis" Text="{Binding CommandLine, Mode=OneWay}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
