<!-- The "History" screen (lot 5): a compact table grouped by day (Today, Yesterday, the date), one
     line per run - time, team name, status badge, duration, usage, then the two fixed actions. The
     team and status filters sit in the header. The exact command line and exit code are an Expert
     detail folded under the line (the shared Disclosure, R16). DataContext: LaunchHistoryViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel Grid.IsSharedSizeScope="True">

    <controls:PageHeader Title="{Binding [Studio.History.Title], Source={x:Static services:I18n.Instance}}"
                         Subtitle="{Binding [Studio.History.Sub], Source={x:Static services:I18n.Instance}}">
      <StackPanel Orientation="Horizontal"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
        <ComboBox x:Name="TeamFilter" Style="{StaticResource ComboM}" Margin="0,0,8,0"
                  ItemsSource="{Binding TeamFilters}" SelectedItem="{Binding TeamFilter}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{Binding [Studio.History.AllTeams], Source={x:Static services:I18n.Instance}}"/>
        <ComboBox x:Name="StatusFilter" Style="{StaticResource ComboS}"
                  ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{Binding [Studio.History.AllStatuses], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </controls:PageHeader>

    <!-- C17: the shared empty state, not a grey line; the filtered-out case says so the same way. -->
    <controls:EmptyState Icon="history" Margin="0,32,0,0"
                         Title="{Binding [Studio.History.EmptyTitle], Source={x:Static services:I18n.Instance}}"
                         Text="{Binding [Studio.History.Empty], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>
    <controls:EmptyState Icon="search" Margin="0,32,0,0"
                         Title="{Binding [Studio.History.NoMatch], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding HasNoMatch, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- A02: the list ends 32 px above the scroll's end - the last day's own 18 px plus 14. -->
    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,16,0,14">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,18">
            <!-- the day -->
            <TextBlock Style="{StaticResource Subhead}" Margin="2,0,0,8" Text="{Binding Header}"/>
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineFaintBrush}"
                    Background="{DynamicResource SurfaceBrush}">
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Row" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineFaintBrush}">
                      <StackPanel>
                        <!-- B11: one height for every line (40 px: the 32 px buttons, or two lines of
                             usage); the usage and the actions columns are fixed, the same on every day. -->
                        <Grid MinHeight="40">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistTime"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistStatus"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistDuration"/>
                            <ColumnDefinition Width="254"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistActions"/>
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Style="{StaticResource MetaLine}" Margin="0,0,14,0" TextWrapping="NoWrap"
                                     VerticalAlignment="Center" Text="{Binding TimeText, Mode=OneWay}"/>
                          <!-- the team's own name; the full path is its tooltip -->
                          <TextBlock Grid.Column="1" Style="{StaticResource ObjectTitle}" FontSize="13" TextWrapping="NoWrap"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Text="{Binding TeamName, Mode=OneWay}" ToolTip="{Binding Target}"/>
                          <controls:Badge Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Tone="{Binding BadgeTone, Mode=OneWay}" Content="{Binding StatusText, Mode=OneWay}"
                                          ToolTip="{Binding OutcomeSentence, Mode=OneWay}"/>
                          <TextBlock Grid.Column="3" Style="{StaticResource MetaLine}" Margin="14,0,0,0" MinWidth="64" TextWrapping="NoWrap"
                                     VerticalAlignment="Center" TextAlignment="Right" Text="{Binding DurationText, Mode=OneWay}"/>
                          <!-- B11, R09: the usage parts break only between two « · » parts, never inside a value -->
                          <ItemsControl Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center" Focusable="False"
                                        ItemsSource="{Binding UsageParts, Mode=OneWay}" ToolTip="{Binding UsageText, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Style="{StaticResource MetaLine}" TextWrapping="NoWrap" Margin="0,0,6,0"
                                           Foreground="{DynamicResource InkFaintBrush}" Text="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- the two fixed actions: « Open the result » keeps its slot when the run left
                               none (hidden, not collapsed), so « Replay » never moves (B11). -->
                          <StackPanel Grid.Column="5" Style="{StaticResource ActionRow}" Margin="14,0,0,0" HorizontalAlignment="Right">
                            <Button controls:ButtonSize.Height="32" Margin="0,0,8,0"
                                    controls:ButtonIcon.Kind="folder-open"
                                    Command="{Binding OpenResultCommand}"
                                    Content="{Binding [Studio.History.Result], Source={x:Static services:I18n.Instance}}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResultFolder}" Value="False">
                                      <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                                    controls:ButtonIcon.Kind="rotate-ccw" Command="{Binding ReplayCommand}"
                                    Content="{Binding [Studio.History.Replay], Source={x:Static services:I18n.Instance}}"/>
                          </StackPanel>
                        </Grid>

                        <!-- Expert: the exit code and the exact command line, folded under the line. -->
                        <StackPanel Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                          <controls:Disclosure Margin="0,4,0,0"
                                               Header="{Binding [Studio.Common.TechnicalDetails], Source={x:Static services:I18n.Instance}}">
                            <StackPanel Margin="0,4,0,4">
                              <TextBlock Style="{StaticResource MonoText}" FontSize="12">
                                <Run Text="{Binding [Studio.Run.ExitCodeLabel], Source={x:Static services:I18n.Instance}, Mode=OneWay}"/>
                                <Run Text="{Binding ExitCode, Mode=OneWay}"/>
                              </TextBlock>
                              <!-- the exact command line, as run: a machine value, never translated (R18) -->
                              <controls:TechBlock Margin="0,6,0,0" Text="{Binding CommandLine, Mode=OneWay}"/>
                            </StackPanel>
                          </controls:Disclosure>
                        </StackPanel>

                        <!-- STUDIO-31 (D-07): « Replay » found the team archived and ran nothing. The line
                             asks in place; « Restore » only restores - the next « Replay » runs it. -->
                        <controls:Alert Tone="Warning" Margin="0,8,0,4" Message="{Binding RestoreOffer, Mode=OneWay}"
                                        Visibility="{Binding IsOfferingRestore, Converter={StaticResource BooleanToVisibility}}">
                          <controls:Alert.Actions>
                            <StackPanel Style="{StaticResource ActionRow}">
                              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding RestoreCommand}"
                                      Content="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding DismissRestoreCommand}"
                                      Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                            </StackPanel>
                          </controls:Alert.Actions>
                        </controls:Alert>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <!-- no rule above the first line of a day -->
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                        <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
