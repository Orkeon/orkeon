<!-- The "History" screen (§5.3, audit 06/15): the mock's card list — team name with its one
     status badge (#117), date · duration, and the two per-card actions on the header line. The exact
     command line and exit code are expert detail. DataContext: LaunchHistoryViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <TextBlock Style="{StaticResource H1}" Text="{Binding [Studio.History.Title], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,22"
               Text="{Binding [Studio.History.Sub], Source={x:Static services:I18n.Instance}}"/>


    <!-- T-08: the way in, with the accent dot when the assistant spoke while it was closed. -->
    <Button Style="{StaticResource BtnGhost}" Height="32" Padding="13,0" Margin="0,14,0,0"
            HorizontalAlignment="Left"
            Command="{Binding DataContext.Chat.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            ToolTip="{Binding [Studio.Chat.AskTip], Source={x:Static services:I18n.Instance}}">
      <StackPanel Orientation="Horizontal">
        <controls:LucideIcon Kind="circle-help" Size="13" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding [Studio.Chat.Ask], Source={x:Static services:I18n.Instance}}"/>
        <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                 Fill="{DynamicResource MarkBrush}"
                 Visibility="{Binding DataContext.Chat.HasUnread, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
      </StackPanel>
    </Button>

    <!-- T-07: the conversation, third mount point. Capped at 700 px because this screen's
         content is a single column of cards rather than a content/help pair — the cap is
         the mock's, and it is on the panel, never on what it sits above. -->
    <views:ChatThreadView MaxWidth="700" HorizontalAlignment="Left" Margin="0,16,0,0"
                          DataContext="{Binding DataContext.Chat, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}"/>

    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
               Text="{Binding [Studio.History.Empty], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>

    <ItemsControl ItemsSource="{Binding Entries}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="12" Padding="16,13" Margin="0,0,0,9"
                  BorderThickness="1" BorderBrush="{DynamicResource LineFaintBrush}"
                  Background="{DynamicResource SurfaceBrush}">
            <!-- #117: the content takes the card's width; the two light actions sit on the
                 header line, right-aligned, and the body runs below it. -->
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top"
                      Margin="0,0,13,0" Background="{DynamicResource AccentWeakBrush}">
                <controls:LucideIcon Kind="brain-circuit" Size="16" Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource BtnGhost}" Margin="0,0,7,0" Command="{Binding OpenResultCommand}"
                            Visibility="{Binding HasResultFolder, Converter={StaticResource BooleanToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="folder-open" Size="13" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [Studio.History.Result], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ReplayCommand}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [Studio.History.Replay], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <!-- The team's name wraps, never trimmed; the one status is the badge on its
                       last line — the plain-language sentence is its tooltip, not a second line. -->
                  <TextBlock Style="{StaticResource ObjectTitle}" FontSize="13" ToolTip="{Binding Target}">
                    <Run Text="{Binding TeamName, Mode=OneWay}"/>
                    <InlineUIContainer BaselineAlignment="Center">
                      <Border Margin="8,0,0,0" ToolTip="{Binding OutcomeSentence, Mode=OneWay}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource BadgeFail}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding OutcomeTone}" Value="ok">
                                <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding OutcomeTone}" Value="warn">
                                <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding OutcomeTone}" Value="idle">
                                <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource InkMutedBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock>
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                              <Setter Property="Text" Value="{Binding [Studio.Run.OutcomeFailed], Source={x:Static services:I18n.Instance}}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding OutcomeTone}" Value="ok">
                                  <Setter Property="Text" Value="{Binding [Studio.Run.OutcomeSucceeded], Source={x:Static services:I18n.Instance}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeTone}" Value="warn">
                                  <Setter Property="Text" Value="{Binding [Studio.Run.OutcomeCancelled], Source={x:Static services:I18n.Instance}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeTone}" Value="idle">
                                  <Setter Property="Text" Value="{Binding [Studio.History.OutcomeBadgeNotStarted], Source={x:Static services:I18n.Instance}}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </InlineUIContainer>
                  </TextBlock>
                </DockPanel>

                <!-- date · duration · usage, the metadata line -->
                <TextBlock Style="{StaticResource MetaLine}" Margin="0,4,0,0" Text="{Binding DateLine, Mode=OneWay}"/>

                <!-- Expert: the exit code, then the exact command line at full width, on one line. -->
                <DockPanel Margin="0,4,0,0" Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,0,10,0"
                             Foreground="{DynamicResource InkFaintBrush}">
                    <Run Text="{Binding [Studio.Run.ExitCodeLabel], Source={x:Static services:I18n.Instance}, Mode=OneWay}"/>
                    <Run Text="{Binding ExitCode, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Text="{Binding CommandLine, Mode=OneWay}"
                             ToolTip="{Binding CommandLine, Mode=OneWay}"/>
                </DockPanel>

                <!-- STUDIO-31 (D-07): « Replay » found the team archived and ran nothing. The card
                     asks in place, the way a delete banner does; « Restore » only restores — the
                     next « Replay » runs it. The answers sit under the question, not beside it. -->
                <Border Background="{DynamicResource WarningWeakBrush}" CornerRadius="10" Padding="11,8" Margin="0,8,0,0"
                        Visibility="{Binding IsOfferingRestore, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <DockPanel>
                      <controls:LucideIcon DockPanel.Dock="Left" Kind="archive" Size="14" Margin="0,0,9,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource WarningBrush}" Text="{Binding RestoreOffer, Mode=OneWay}"/>
                    </DockPanel>
                    <WrapPanel Margin="23,8,0,0">
                      <Button Style="{StaticResource BtnGhost}" Margin="0,0,7,0" Command="{Binding RestoreCommand}"
                              Content="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnGhost}" Command="{Binding DismissRestoreCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
