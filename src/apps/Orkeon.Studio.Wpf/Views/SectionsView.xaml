<!-- The "Sections" screen: one card per appsettings section (§4.1 typed forms).
     DataContext: ConfigTabViewModel (bound as Config in MainWindow).
     Card titles are the literal configuration keys (Llm, Orkeon:Rag…) — technical
     identifiers, identical in every language, hence not routed through I18n. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.SectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Config"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource BtnGhost}" Command="{Binding ValidateCommand}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Act_Validate], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
            <TextBlock Text="{Binding [Act_Save], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Sections_Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Sections_Sub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,6,0,22" Text="{Binding StatusMessage}"/>

    <!-- ══ Llm card (full width) ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <controls:LucideIcon Kind="brain-circuit" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="Llm"/>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_Model], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding Llm.Model, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_BaseUrl], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding Llm.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>

        <!-- detected-provider chip: read-only, inferred from the host (§4.1 — no Provider key) -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                     Text="{Binding [Sec_DetectedProvider], Source={x:Static services:I18n.Instance}}"/>
          <Border Style="{StaticResource Well}" Padding="8,3" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource MonoText}" FontSize="11" Text="{Binding Llm.DetectedProviderDisplay, Mode=OneWay}"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="0,12,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_ApiKey], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource InputMono}" Text="{Binding Llm.ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0" Text="{Binding Llm.ApiKeyRecommendation, Mode=OneWay}"/>
        </StackPanel>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_Temperature], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Llm.Temperature, UpdateSourceTrigger=LostFocus}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_MaxTokens], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Llm.MaxTokens, UpdateSourceTrigger=LostFocus}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_TimeoutSeconds], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Llm.TimeoutSeconds, UpdateSourceTrigger=LostFocus}"/>
          </StackPanel>
        </Grid>

        <!-- §4.2: optional connectivity probe. It reports, it never gates the save. -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Style="{StaticResource BtnGhost}" Command="{Binding Llm.TestConnectionCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="plug-zap" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Sec_TestConnection], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                     Text="{Binding Llm.ConnectionTestResult}"
                     Visibility="{Binding Llm.ConnectionTestResult, Converter={StaticResource StringPresentToVisibility}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ Two-column grid of the smaller section cards ══ -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- RateLimiting -->
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="gauge" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="RateLimiting"/>
          </StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_MaxConcurrent], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.MaxConcurrentRequests, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_GlobalRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.GlobalRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_ProviderRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.ProviderRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_AgentRpm], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.AgentRequestsPerMinute, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_QueueLimit], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding RateLimiting.QueueLimit, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>

      <!-- Orkeon:Rag -->
      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="database" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="Orkeon:Rag"/>
          </StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_RagProfile], Source={x:Static services:I18n.Instance}}"/>
          <ComboBox ItemsSource="{x:Static config:RagSectionViewModel.KnownProfiles}" SelectedItem="{Binding Rag.Profile}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_RagProvider], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding Rag.Provider, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_RagConnection], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource InputMono}" Text="{Binding Rag.ConnectionString, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Margin="0,12,0,0" IsChecked="{Binding Rag.HybridRetrievalEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Sec_Rag_Hybrid], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding Rag.CorrectiveWebFallbackEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Sec_Rag_CorrectiveWebFallback], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding Rag.WebFallbackEnabled}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Sec_Rag_WebFallback], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0" Text="{Binding Rag.WebFallbackStatus}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_CorrectiveMaxIterations], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding Rag.CorrectiveMaxIterations, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>

      <!-- Logging:LogLevel -->
      <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="scroll-text" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="Logging:LogLevel"/>
          </StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sec_Lbl_DefaultLevel], Source={x:Static services:I18n.Instance}}"/>
          <ComboBox ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}" SelectedItem="{Binding Logging.DefaultLevel}"/>
          <ItemsControl ItemsSource="{Binding Logging.Categories}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,7">
                  <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                            ItemsSource="{x:Static config:LoggingSectionViewModel.KnownLevels}"
                            SelectedItem="{Binding Level}"/>
                  <TextBox Style="{StaticResource InputMono}" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
            <Button Style="{StaticResource BtnGhost}" Command="{Binding Logging.AddCategoryCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Sec_AddCategory], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnGhost}" Command="{Binding Logging.RemoveCategoryCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Sec_Remove], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- LlmLogging -->
      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:LucideIcon Kind="logs" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="LlmLogging"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding LlmLogging.FullEmbeddingLog}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Sec_LlmLog_FullEmbedding], Source={x:Static services:I18n.Instance}}"/>
          <CheckBox Margin="0,7,0,0" IsChecked="{Binding LlmLogging.LogStreamingExchanges}"
                    Foreground="{DynamicResource InkBrush}"
                    Content="{Binding [Sec_LlmLog_Streaming], Source={x:Static services:I18n.Instance}}"/>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding [Sec_Lbl_MaxBodyLength], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource Input}" Text="{Binding LlmLogging.MaxBodyLengthChars, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
</UserControl>
