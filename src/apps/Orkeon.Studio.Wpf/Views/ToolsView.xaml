<!-- The "Tool catalogue" section of Settings › Access: every tool a run exposes, by family, with
     what each one needs. The keys the tools need and the shell allow-list are sections of their
     own (ToolKeysView, ShellToolsView). DataContext: SettingsScreenViewModel (inherited from SettingsView). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <!-- the catalogue: every tool a run exposes, by family; the ones that need something say what -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <controls:LucideIcon Kind="braces" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Studio.Settings.ToolsTitle], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"
                   Text="{Binding [Studio.Settings.ToolsIntro], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Tools.Families}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,7" Text="{Binding Label}"/>
                <ItemsControl ItemsSource="{Binding Tools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- a tool that needs something wears the accent, so the eye lands on it before reading the lines below -->
                      <Border Margin="0,0,6,6">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource ToolChip}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsSomething}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding Name}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Requirements}" Margin="0,2,0,0"
                              Visibility="{Binding HasRequirements, Converter={StaticResource BooleanToVisibility}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- R09: the tool's name keeps its width, what it needs wraps beside it. -->
                      <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="13" Foreground="{DynamicResource InkBrush}"
                                   VerticalAlignment="Top" Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Top"
                                   TextWrapping="Wrap" Text="{Binding Text}"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{Binding QuietLine}"
                           Visibility="{Binding HasRequirements, Converter={StaticResource InverseBooleanToVisibility}}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
