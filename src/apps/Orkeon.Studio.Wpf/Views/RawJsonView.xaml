<!-- Read-only mirror of the settings file (§4.1), hosted by the "JSON brut" settings tab.
     DataContext: ConfigTabViewModel (bound as Settings.Config). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.RawJsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel>
        <DockPanel Margin="22,14,14,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Click="OnCopy">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="copy" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Settings.Copy], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:LucideIcon Kind="lock" Size="12" Margin="0,0,7,0"/>
            <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                       Text="{Binding [Studio.Settings.RawJsonReadOnly], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </DockPanel>
        <TextBox Text="{Binding RawJson, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                 Background="{DynamicResource PaperSunkBrush}" Foreground="{DynamicResource InkMutedBrush}"
                 FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="22,14,22,18" Margin="0,12,0,0"
                 MaxHeight="420"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
