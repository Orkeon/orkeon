<Window x:Class="Orkeon.Studio.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
        xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
        xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
        Title="Orkeon Studio"
        Height="900" Width="1440" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Display">

  <!-- Custom title bar: the 52px strip is the caption; buttons opt out via IsHitTestVisibleInChrome. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- the settings file can be saved from any screen, not only from Start -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="S" Command="{Binding Config.SaveCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.Style>
      <!-- A maximized WindowChrome window is positioned ~7px offscreen on every side (the OS
           reserves the resize frame); without this compensation the custom title bar and the
           content edges are clipped whenever the window is maximized. -->
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Margin" Value="7"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══════════ TITLE BAR ══════════ -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0,0,0">
        <!-- brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Orkeon mark: 3 dashed arcs + node (assets/orkeon-mark.svg transcribed; WPF dashes are in units of stroke width) -->
          <Viewbox Width="23" Height="23">
            <Grid Width="96" Height="96">
              <Grid.Resources>
                <RotateTransform x:Key="Tilt" Angle="-52" CenterX="48" CenterY="48"/>
              </Grid.Resources>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="16.5" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" Margin="9,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- right cluster -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- EN / FR -->
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999"
                  Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LangEnBtn" Content="EN" Click="OnLangEn" Style="{x:Null}" BorderThickness="0"
                      FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand"/>
              <Button x:Name="LangFrBtn" Content="FR" Click="OnLangFr" Style="{x:Null}" BorderThickness="0"
                      FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource IconBtn}" Click="OnStartTour" Margin="0,0,10,0" VerticalAlignment="Center"
                  ToolTip="{Binding [Tour_Tip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon Kind="circle-help" Size="15"/>
          </Button>
          <Button x:Name="ThemeBtn" Style="{StaticResource IconBtn}" Click="OnToggleTheme" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon x:Name="ThemeIcon" Kind="moon" Size="15"/>
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="12,12,2,12"/>
          <!-- caption buttons -->
          <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize"><controls:LucideIcon Kind="minus" Size="14"/></Button>
            <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeRestore"><controls:LucideIcon Kind="square" Size="11"/></Button>
            <Button Style="{StaticResource CaptionBtnClose}" Click="OnClose"><controls:LucideIcon Kind="x" Size="15"/></Button>
          </StackPanel>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- ══════════ BODY ══════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PaperSunkBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,12">
          <!-- settings-file card (bottom) -->
          <Border x:Name="SettingsCard" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11,10">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding [SettingsFile_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                         Text="{Binding [SettingsFile_Global], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="0,4,0,7"
                         Text="{Binding Config.Location.GlobalPath}"/>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BadgeOk}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource InverseBooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Valid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
                <Border Style="{StaticResource BadgeFail}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Invalid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,0,0,7"
                       Text="{Binding [Grp_Config], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavStart" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sparkles" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Start], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSections" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Sections], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavMounts" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="folder-tree" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Mounts], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavRaw" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="braces" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Raw], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDiag" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="stethoscope" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Diag], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>

            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Grp_Launch], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavRun" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="play" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Run], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="history" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_History], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- CONTENT: one panel per nav item, visibility driven by the RadioButtons -->
      <Grid Grid.Column="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavStart, Converter={StaticResource BooleanToVisibility}}">
          <views:StartView x:Name="StartPanel" MaxWidth="880" DataContext="{Binding Config}"/>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavSections, Converter={StaticResource BooleanToVisibility}}">
          <views:SectionsView MaxWidth="1080" DataContext="{Binding Config}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavMounts, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel MaxWidth="880">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Command="{Binding Config.ValidateCommand}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Act_Validate], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding Config.SaveCommand}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                    <TextBlock Text="{Binding [Act_Save], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Mounts_Title], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                           Text="{Binding [Scr_Mounts_Sub], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,6,0,22" Text="{Binding Config.StatusMessage}"/>
            <views:MountsEditorView x:Name="MountsPanel" DataContext="{Binding Config.Mounts}"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavRaw, Converter={StaticResource BooleanToVisibility}}">
          <views:RawJsonView MaxWidth="880" DataContext="{Binding Config}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavDiag, Converter={StaticResource BooleanToVisibility}}">
          <views:DiagnosticView x:Name="DiagPanel" MaxWidth="880" DataContext="{Binding Config.Diagnostic}"/>
        </ScrollViewer>
        <Grid Visibility="{Binding IsChecked, ElementName=NavRun, Converter={StaticResource BooleanToVisibility}}">
          <views:LaunchTabView x:Name="RunPanel" DataContext="{Binding Launch}" Margin="30,24,30,20"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BooleanToVisibility}}">
          <views:HistoryView MaxWidth="880" DataContext="{Binding Launch.History}"/>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ══════════ GUIDED TOUR (last child = topmost) ══════════ -->
    <controls:TourOverlay x:Name="Tour" Grid.Row="0" Grid.RowSpan="2"/>
  </Grid>
</Window>
