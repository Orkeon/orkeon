<Window x:Class="Orkeon.Studio.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
        xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
        xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
        Title="Orkeon Studio"
        Height="768" Width="1024" MinHeight="768" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

  <!-- Custom title bar: the 52px strip is the caption; buttons opt out via IsHitTestVisibleInChrome. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- the settings file can be saved from any screen, not only from Start -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="S" Command="{Binding Config.SaveCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.Style>
      <!-- A maximized WindowChrome window is positioned ~7px offscreen on every side (the OS
           reserves the resize frame); without this compensation the custom title bar and the
           content edges are clipped whenever the window is maximized. -->
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Margin" Value="7"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══════════ TITLE BAR ══════════ -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0,0,0">
        <!-- brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Orkeon mark: 3 dashed arcs + node (assets/orkeon-mark.svg transcribed; WPF dashes are in units of stroke width) -->
          <Viewbox Width="23" Height="23">
            <!-- The mock rotates the GROUP once around its own center (rotate(-52 48 48));
                 rotating each ring separately around a foreign center is what skewed the mark. -->
            <Grid Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="-52"/>
              </Grid.RenderTransform>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="16.5" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" Margin="9,2,0,0" VerticalAlignment="Center"/>
          <!-- the discreet door to "À propos" (design v3: the "…" next to the brand) -->
          <Button Command="{Binding About.OpenCommand}" Cursor="Hand" Margin="7,0,0,0" VerticalAlignment="Center"
                  ToolTip="{Binding [About_Tip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg" Width="24" Height="24" CornerRadius="7" Background="Transparent">
                  <TextBlock Text="…" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkFaintBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- right cluster -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- global mode switch: the single control that changes how much the app shows -->
          <StackPanel x:Name="ModeSwitch" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"
                       Text="{Binding [Mode_Label], Source={x:Static services:I18n.Instance}}"/>
            <Border Style="{StaticResource SegmentedGroup}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding Mode.SetNoviceCommand}"
                        Content="{Binding [Mode_Novice], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsNovice}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Command="{Binding Mode.SetExpertCommand}"
                        Content="{Binding [Mode_Expert], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsExpert}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- T-14: the language in force is on the button; the menu offers only the
               OTHERS — the current one is already there, and a row that does nothing is
               a row that asks to be clicked. The header line says whether this language
               came from the machine or from a choice, which is the difference a user has
               no other way of seeing. -->
          <Grid VerticalAlignment="Center" Margin="0,0,10,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource LangBtn}" Command="{Binding Language.ToggleMenuCommand}">
              <Button.ToolTip><TextBlock Text="{Binding Language.Tooltip}"/></Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Language.CurrentDisplay}" VerticalAlignment="Center"/>
                <controls:LucideIcon Kind="chevron-down" Size="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                  <controls:LucideIcon.RenderTransform><RotateTransform/></controls:LucideIcon.RenderTransform>
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Language.IsMenuOpen}" Value="True">
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.14"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.14"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
              </StackPanel>
            </Button>
            <Popup IsOpen="{Binding Language.IsMenuOpen, Mode=TwoWay}" StaysOpen="False"
                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-140"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="186"
                      Margin="10,0,10,14" Effect="{DynamicResource ShadowMd}">
                <StackPanel>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Padding="8,5,8,6"
                             Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Language.MenuHeader}"/>
                  <ItemsControl ItemsSource="{Binding Language.Others}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource LangRow}" CommandParameter="{Binding Code}"
                                Command="{Binding DataContext.Language.PickCommand, RelativeSource={RelativeSource AncestorType=Popup}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" FontWeight="SemiBold" Width="20"
                                       Foreground="{DynamicResource AccentBrush}" Text="{Binding Display}"/>
                            <TextBlock FontSize="12.5" Margin="9,0,0,0" Foreground="{DynamicResource InkBrush}"
                                       Text="{Binding Name}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Button Style="{StaticResource IconBtn}" Click="OnStartTour" Margin="0,0,10,0" VerticalAlignment="Center"
                  ToolTip="{Binding [Tour_Tip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon Kind="circle-help" Size="15"/>
          </Button>
          <Button x:Name="ThemeBtn" Style="{StaticResource IconBtn}" Click="OnToggleTheme" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon x:Name="ThemeIcon" Kind="moon" Size="15"/>
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="12,12,2,12"/>
          <!-- caption buttons -->
          <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize"><controls:LucideIcon Kind="minus" Size="14"/></Button>
            <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeRestore"><controls:LucideIcon Kind="square" Size="11"/></Button>
            <Button Style="{StaticResource CaptionBtnClose}" Click="OnClose"><controls:LucideIcon Kind="x" Size="15"/></Button>
          </StackPanel>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- ══════════ BODY ══════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PaperSunkBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,12">
          <!-- settings-file card (bottom) -->
          <!-- novice: a hand; expert: the settings file being edited (design v3 sidebar foot) -->
          <Border x:Name="HelpCard" DockPanel.Dock="Bottom" Background="{DynamicResource SkyBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11"
                  Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="circle-help" Size="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="7,0,0,0"
                           Text="{Binding [Help_Title], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,8"
                         Text="{Binding [Help_Body], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch" Click="OnStartTour"
                      Content="{Binding [Btn_GuidedTour], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Border>
          <Border x:Name="SettingsCard" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11,10"
                  Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding [SettingsFile_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                         Text="{Binding [SettingsFile_Global], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="0,4,0,7"
                         Text="{Binding Config.Location.GlobalPath}"/>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BadgeOk}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource InverseBooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Valid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
                <Border Style="{StaticResource BadgeFail}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Invalid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel>
            <!-- "Résoudre" leads: the new user's door (SPEC-ORKEON-FORGE §12.1, UX study §5) -->
            <StackPanel x:Name="NavGroupTeams">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,0,0,7"
                       Text="{Binding [Grp_Teams], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavCreate" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True"
                         HorizontalContentAlignment="Stretch">
              <!-- T-09: a creation left mid-flight is announced on its own entry — the step
                   counter and an accent dot, pushed right like the team count below. -->
              <DockPanel LastChildFill="False">
                <controls:LucideIcon DockPanel.Dock="Left" Kind="wand-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Text="{Binding [Nav_Create], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding DataContext.CreateTeam.HasDraft, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource InkFaintBrush}"
                             Text="{Binding DataContext.CreateTeam.DraftStepShort, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  <Ellipse Width="6" Height="6" Margin="7,0,0,0" VerticalAlignment="Center"
                           Fill="{DynamicResource MarkBrush}"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>

            <!-- Under the entry, and only from somewhere else: the draft says where it
                 stopped, so leaving the assistant is never the same as forgetting it.
                 On the Créer screen itself it would only repeat what is on screen. -->
            <Button x:Name="DraftNote" Style="{StaticResource DraftNote}" Click="OnResumeDraft">
              <StackPanel>
                <TextBlock FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding DataContext.CreateTeam.DraftTitle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="{Binding DataContext.CreateTeam.DraftLine, RelativeSource={RelativeSource AncestorType=Window}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CreateTeam.IsAssistantWaiting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
              <Button.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                  <Binding Path="DataContext.CreateTeam.HasDraft" RelativeSource="{RelativeSource AncestorType=Window}"/>
                  <Binding Path="IsChecked" ElementName="NavCreate" Converter="{StaticResource Negate}"/>
                </MultiBinding>
              </Button.Visibility>
            </Button>
            <RadioButton x:Name="NavTeams" GroupName="Nav" Style="{StaticResource NavItem}"
                         HorizontalContentAlignment="Stretch">
              <!-- T-10: the counter is pushed to the right edge, mono 10 faint, no chip -->
              <DockPanel LastChildFill="False">
                <controls:LucideIcon DockPanel.Dock="Left" Kind="brain-circuit" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Text="{Binding [Nav_Teams], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"
                           Text="{Binding DataContext.Teams.Count, RelativeSource={RelativeSource AncestorType=Window}}"/>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="NavImport" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="file-json-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Import], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupWork">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Grp_Work], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavTest" GroupName="Nav" Style="{StaticResource NavItem}"
                         Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="badge-check" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Test], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavRun" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="play" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Run], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="history" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_History], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupEnv">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Grp_Env], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Settings], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDiag" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="stethoscope" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Diag], Source={x:Static services:I18n.Instance}}"/>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding DataContext.Config.Diagnostic.HasIssues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- CONTENT: one panel per nav item, visibility driven by the RadioButtons -->
      <Grid Grid.Column="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavCreate, Converter={StaticResource BooleanToVisibility}}">
          <views:CreateTeamView x:Name="CreatePanel" MaxWidth="1000" DataContext="{Binding CreateTeam}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavTeams, Converter={StaticResource BooleanToVisibility}}">
          <views:TeamsView x:Name="TeamsPanel" MaxWidth="1000" DataContext="{Binding Teams}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavImport, Converter={StaticResource BooleanToVisibility}}">
          <views:ImportTeamView MaxWidth="880" DataContext="{Binding Import}"/>
        </ScrollViewer>
        <!-- Tester is a two-column layout with a full-height console (audit 13): its host is
             a Grid, not a ScrollViewer — an infinite vertical measure would collapse the console. -->
        <Grid Visibility="{Binding IsChecked, ElementName=NavTest, Converter={StaticResource BooleanToVisibility}}">
          <views:TestTeamView MaxWidth="1080" Margin="30,24,30,32" DataContext="{Binding Test}"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BooleanToVisibility}}">
          <views:SettingsView x:Name="SettingsPanel" MaxWidth="1000" DataContext="{Binding Settings}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavDiag, Converter={StaticResource BooleanToVisibility}}">
          <views:DiagnosticView x:Name="DiagPanel" MaxWidth="880" DataContext="{Binding Config.Diagnostic}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavRun, Converter={StaticResource BooleanToVisibility}}">
          <views:LaunchTabView x:Name="RunPanel" DataContext="{Binding Launch}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BooleanToVisibility}}">
          <views:HistoryView MaxWidth="880" DataContext="{Binding Launch.History}"/>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ══════════ ÉDITEUR DE RÉGLAGE DE MODÈLE (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnProfileEditorBackdropClick"
          Visibility="{Binding Settings.Profiles.IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.Resources>
        <views:IsEqualConverter x:Key="IsEqual"/>
        <views:ModalBodyHeightConverter x:Key="ModalBodyHeight"/>
        <!-- One provider card: compact title + description, accent border when picked. -->
        <DataTemplate x:Key="ProviderCard">
          <RadioButton GroupName="ProfileProvider" Margin="0,0,7,7" Cursor="Hand"
                       Command="{Binding DataContext.Settings.Profiles.Editor.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                <Binding/>
                <Binding Path="DataContext.Settings.Profiles.Editor.SelectedProvider" RelativeSource="{RelativeSource AncestorType=Window}"/>
              </MultiBinding>
            </RadioButton.IsChecked>
            <RadioButton.Template>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="11,8">
                  <StackPanel>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource InkMutedBrush}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Text="{Binding Description}"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </RadioButton.Template>
          </RadioButton>
        </DataTemplate>
      </Grid.Resources>
      <Border Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding Settings.Profiles.Editor}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModalBodyHeight}}">
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Profile_EditTitle], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                      <Setter Property="Text" Value="{Binding [Profile_NewTitle], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding [Profile_EditSub], Source={x:Static services:I18n.Instance}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                       Text="{Binding [Profile_NameLabel], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                       Text="{Binding [Profile_NameTaken], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding NameCollision, Converter={StaticResource BooleanToVisibility}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [Profile_ProviderLabel], Source={x:Static services:I18n.Instance}}"/>

            <!-- Provider cards, grouped as the v3 rev.2 design: local (keyless), cloud
                 (key required), then the catch-all and the echo fallback. -->
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Medium"
                       Foreground="{DynamicResource InkFaintBrush}" Margin="0,0,0,6"
                       Text="{Binding [Profile_GroupLocal], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding LocalProviders}" ItemTemplate="{StaticResource ProviderCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Medium"
                       Foreground="{DynamicResource InkFaintBrush}" Margin="0,12,0,6"
                       Text="{Binding [Profile_GroupCloud], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding CloudProviders}" ItemTemplate="{StaticResource ProviderCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding OtherProviders}" ItemTemplate="{StaticResource ProviderCard}" Margin="0,7,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- URL/model: pointless without a model; the URL is expert-only except for
                 the catch-all card, where everyone must type it. -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding UrlAlwaysVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_BaseUrl], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_Model], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>

            <!-- pinned temperature & timeout: empty = the engine decides. Some models
                 mandate a temperature (Kimi K3: 1); reasoning models need more than the
                 default 30 s to answer. -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Profile_Lbl_Temperature], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                         Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Profile_Temperature_Hint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Profile_Lbl_Timeout], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                         Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Profile_Timeout_Hint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Grid>

            <!-- API key — novice-visible. The key goes into the user environment, never
                 into a file; the status chip says whether one is already in place. -->
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0"
                    Visibility="{Binding RequiresApiKey, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <controls:LucideIcon Kind="key" Size="14" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                  <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                             Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding KeyBlockTitle}"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarningBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasStoredKey}" Value="True">
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <controls:LucideIcon Size="12" Margin="0,0,6,0" VerticalAlignment="Center">
                      <controls:LucideIcon.Style>
                        <Style TargetType="controls:LucideIcon">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStoredKey}" Value="True">
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </controls:LucideIcon.Style>
                    </controls:LucideIcon>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding KeyStatusText}"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                           Margin="0,7,0,9" Text="{Binding [Profile_KeyExplainer], Source={x:Static services:I18n.Instance}}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="7,0,0,0"
                          Command="{Binding StoreKeyCommand}"
                          Content="{Binding [Profile_KeyStore], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}"
                           ToolTip="{Binding [Profile_KeyPlaceholder], Source={x:Static services:I18n.Instance}}"
                           Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource InkFaintBrush}"
                             Text="{Binding [Profile_KeyNoKeyYet], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                             Foreground="{DynamicResource AccentBrush}" Margin="7,0,0,0"
                             Text="{Binding KeyConsoleUrl}"/>
                </StackPanel>
                <Border Background="{DynamicResource PaperSunkBrush}" BorderBrush="{DynamicResource LineFaintBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,9,0,0"
                        Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource InkFaintBrush}"
                             Text="{Binding [Profile_KeyExpertHint], Source={x:Static services:I18n.Instance}}"/>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding ShowLocalNote, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="circle-check" Size="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" TextWrapping="Wrap"
                         Text="{Binding [Profile_LocalNote], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding ShowNoneNote, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="info" Size="13" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" TextWrapping="Wrap"
                         Text="{Binding [Profile_NoneNote], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                        Visibility="{Binding ShowTestRow, Converter={StaticResource BooleanToVisibility}}">
              <Button Style="{StaticResource BtnGhost}" Command="{Binding TestConnectionCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="plug-zap" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Sec_TestConnection], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                         Text="{Binding ConnectionTestResult}"
                         Visibility="{Binding ConnectionTestResult, Converter={StaticResource StringPresentToVisibility}}"/>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>

          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel LastChildFill="False">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Profile_Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ DOSSIERS DE L'ÉQUIPE (overlay, F-03) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnTeamMountsBackdropClick"
          Visibility="{Binding TeamMounts.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding TeamMounts}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [TeamMounts_Sub], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton IsChecked="{Binding IsChecked}" Cursor="Hand" Margin="0,0,0,8">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="13,11">
                          <DockPanel>
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="5"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}"
                                    Background="{DynamicResource PaperSunkBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                              <controls:LucideIcon x:Name="Tick" Kind="check" Size="11"
                                                   Foreground="{DynamicResource AccentFgBrush}" Visibility="Collapsed"/>
                            </Border>
                            <Border DockPanel.Dock="Right">
                              <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                                  <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                      <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding RightsLabel}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <StackPanel>
                              <TextBlock Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource InkBrush}"
                                         Text="{Binding VirtualPath}"/>
                              <TextBlock x:Name="Disk" FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}" Margin="0,2,0,0"
                                         TextTrimming="CharacterEllipsis" Text="{Binding PhysicalPath}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                          </Trigger>
                          <!-- Not in « Réglages › Dossiers autorisés » — the border says so. -->
                          <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="Disk" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Command="{Binding AddCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="12" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [TeamMounts_AddAnother], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Act_Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,12,0" Text="{Binding Summary}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ ÉDITEUR D'AGENT (overlay, F-01) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAgentEditorBackdropClick"
          Visibility="{Binding CreateTeam.AgentEditor.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding CreateTeam.AgentEditor}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [AgentEd_Sub], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                       Text="{Binding [AgentEd_Name], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                       Text="{Binding [AgentEd_Does], Source={x:Static services:I18n.Instance}}"/>
            <TextBox MinHeight="66" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Text="{Binding WhatItDoes, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [AgentEd_Can], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- toggleable chip — the ONE chip recipe (mono 11.5, pill), plus the
                       on/off and hover states a plain ToolChip border cannot carry -->
                  <Button Command="{Binding ToggleCommand}" Cursor="Hand" Margin="0,0,6,6">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Style="{StaticResource ToolChip}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}">
                          <TextBlock x:Name="Label" FontSize="11.5"
                                     Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" Text="{Binding Tool}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,10,0,0">
              <TextBlock DockPanel.Dock="Left" FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}"
                         MinWidth="132" VerticalAlignment="Center"
                         Text="{Binding [AgentEd_Scope], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="11.5" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Text="{Binding ScopeInfo}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{DynamicResource InkFaintBrush}"
                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis" Text="{Binding KeyLine}"
                       Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding SaveLabel}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Command="{Binding RemoveCommand}"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBooleanToVisibility}}">
                <TextBlock Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding [AgentEd_Remove], Source={x:Static services:I18n.Instance}}"/>
              </Button>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ AJOUTER UN DOSSIER AUTORISÉ (overlay — les deux écrans équipe) ══════════
         Une équipe ne déclare pas un dossier : elle associe un montage déjà déclaré dans
         Réglages › Dossiers autorisés, droits compris. Déclarer reste le geste des Réglages,
         et « Déclarer un nouveau dossier… » enchaîne sur le sélecteur, qui s'empile au-dessus
         de cet overlay — d'où l'ordre : ce Grid AVANT celui du sélecteur. -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAllowedFoldersBackdropClick"
          Visibility="{Binding AllowedFolders.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding AllowedFolders}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [AllowedFolders_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [AllowedFolders_Sub], Source={x:Static services:I18n.Instance}}"/>

            <!-- État vide : les Réglages ne déclarent encore rien. -->
            <Border Background="{DynamicResource PaperSunkBrush}" CornerRadius="11" Padding="14,13" Margin="0,14,0,0"
                    Visibility="{Binding HasRows, Converter={StaticResource InverseBooleanToVisibility}}">
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                         Text="{Binding [AllowedFolders_Empty], Source={x:Static services:I18n.Instance}}"/>
            </Border>

            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                          Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}"
                                  Cursor="Hand" Margin="0,0,0,8">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                  CornerRadius="10" Padding="13,11">
                            <DockPanel>
                              <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="5"
                                      BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}"
                                      Background="{DynamicResource PaperSunkBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <controls:LucideIcon x:Name="Tick" Kind="check" Size="11"
                                                     Foreground="{DynamicResource AccentFgBrush}" Visibility="Collapsed"/>
                              </Border>
                              <!-- Les droits viennent des Réglages et ne se rechoisissent pas ici. -->
                              <Border DockPanel.Dock="Right">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                                    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RightsLabel}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Border>
                              <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Foreground="{DynamicResource InkFaintBrush}" Text="{Binding UnavailableNote}"
                                         Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibility}}"/>
                              <StackPanel>
                                <TextBlock Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding VirtualPath}"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" Text="{Binding PhysicalPath}"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="Row" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                              <Setter TargetName="Row" Property="Opacity" Value="0.62"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- One door, leading to the one screen that declares. -->
            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Command="{Binding DeclareNewCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="12" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [AllowedFolders_Declare], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [AllowedFolders_Confirm], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Summary}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ AUTORISER UN DOSSIER (overlay, F-03 — au-dessus des deux autres) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnFolderPickerBackdropClick"
          Visibility="{Binding FolderPicker.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding FolderPicker}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Picker_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [Picker_Sub], Source={x:Static services:I18n.Instance}}"/>
            <DockPanel Margin="0,14,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding BrowseCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="hard-drive" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Picker_Browse], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <TextBox Style="{StaticResource InputMono}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <Border BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="1" CornerRadius="11"
                    MaxHeight="212" Margin="0,14,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Nodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding PickCommand}" Cursor="Hand">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Row" Background="Transparent"
                                    BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                              <DockPanel Margin="{Binding Indent, Converter={StaticResource LeftIndent}}">
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource InkFaintBrush}"
                                           VerticalAlignment="Center" Text="{Binding Note}"
                                           Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibility}}"/>
                                <controls:LucideIcon DockPanel.Dock="Left" Kind="folder" Size="12"
                                                     Foreground="{DynamicResource InkFaintBrush}" Margin="0,0,9,0"
                                                     VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource MonoText}" FontSize="11.5"
                                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                              </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                              </DataTrigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [Picker_RightsLabel], Source={x:Static services:I18n.Instance}}"/>
            <Button Command="{Binding PickReadOnlyCommand}" Cursor="Hand" Margin="0,0,0,8">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="13,10">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="Dot" Width="15" Height="15" StrokeThickness="1.5"
                               Stroke="{DynamicResource LineStrongBrush}" Fill="{DynamicResource PaperSunkBrush}"
                               VerticalAlignment="Center"/>
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="11,0,0,0"
                                 Text="{Binding [Picker_ReadOnly], Source={x:Static services:I18n.Instance}}"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding [Picker_ReadOnly_Hint], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Dot" Property="StrokeThickness" Value="4.5"/>
                      <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button Command="{Binding PickReadWriteCommand}" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="13,10">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="Dot" Width="15" Height="15" StrokeThickness="1.5"
                               Stroke="{DynamicResource LineStrongBrush}" Fill="{DynamicResource PaperSunkBrush}"
                               VerticalAlignment="Center"/>
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="11,0,0,0"
                                 Text="{Binding [Picker_ReadWrite], Source={x:Static services:I18n.Instance}}"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding [Picker_ReadWrite_Hint], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Dot" Property="StrokeThickness" Value="4.5"/>
                      <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Picker_Confirm], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                          Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock FontSize="11" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"
                           Text="{Binding [Picker_WrittenAs], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="7,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" Text="{Binding MountPreview}"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ À PROPOS (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAboutBackdropClick"
          Visibility="{Binding About.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="20" ClipToBounds="True" Effect="{DynamicResource ShadowLg}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- illustration plate: fixed light background, the artwork is opaque -->
          <Border Grid.Column="0" Background="{DynamicResource IllustrationPanelBrush}" CornerRadius="20,0,0,20">
            <Image Source="/Assets/kama.png" Width="224" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="28,26">
            <TextBlock Style="{StaticResource Eyebrow}"
                       Text="{Binding [About_Eyebrow], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Text="Orkeon Studio" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="11" Margin="0,8,0,0" Text="{Binding About.VersionLine}"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"
                       Text="{Binding [About_Line], Source={x:Static services:I18n.Instance}}"/>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,16,0,0">
              <DockPanel>
                <controls:LucideIcon DockPanel.Dock="Left" Kind="info" Size="15" Foreground="{DynamicResource MarkBrush}"
                                     VerticalAlignment="Top" Margin="0,1,11,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                           Text="{Binding [About_Kama], Source={x:Static services:I18n.Instance}}"/>
              </DockPanel>
            </Border>
            <DockPanel Margin="0,20,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding About.CloseCommand}"
                      Content="{Binding [About_Close], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnGhost}" Click="OnStartTourFromAbout" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="circle-help" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Btn_GuidedTour], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ══════════ DÉMARRAGE (overlay, 5 s, clic pour passer) ══════════ -->
    <Border x:Name="Splash" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PaperBrush}" Cursor="Hand"
            MouseLeftButtonDown="OnSplashClick"
            ToolTip="{Binding [Splash_Skip], Source={x:Static services:I18n.Instance}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{DynamicResource IllustrationPanelBrush}" CornerRadius="28" Padding="34,14,34,0" HorizontalAlignment="Center">
          <Image Source="/Assets/kama.png" Width="280"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
          <Viewbox Width="26" Height="26" VerticalAlignment="Center">
            <Grid Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="-52"/>
              </Grid.RenderTransform>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                     Foreground="{DynamicResource InkBrush}" Margin="11,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" FontSize="12" Margin="11,10,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Width="220" Height="3" CornerRadius="1.5" Background="{DynamicResource LineBrush}" Margin="0,24,0,0">
          <Rectangle Height="3" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" Width="0">
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="220" Duration="0:0:5"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>
        </Border>
        <TextBlock FontSize="12" Foreground="{DynamicResource InkFaintBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Text="{Binding About.VersionLine}"/>
      </StackPanel>
    </Border>

    <!-- ══════════ GUIDED TOUR (last child = topmost) ══════════ -->
    <controls:TourOverlay x:Name="Tour" Grid.Row="0" Grid.RowSpan="2"/>
  </Grid>
</Window>
