<Window x:Class="Orkeon.Studio.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
        xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
        xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
        Title="Orkeon Studio"
        Height="900" Width="1440" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

  <!-- Custom title bar: the 52px strip is the caption; buttons opt out via IsHitTestVisibleInChrome. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- the settings file can be saved from any screen, not only from Start -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="S" Command="{Binding Config.SaveCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.Style>
      <!-- A maximized WindowChrome window is positioned ~7px offscreen on every side (the OS
           reserves the resize frame); without this compensation the custom title bar and the
           content edges are clipped whenever the window is maximized. -->
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Margin" Value="7"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══════════ TITLE BAR ══════════ -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0,0,0">
        <!-- brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Orkeon mark: 3 dashed arcs + node (assets/orkeon-mark.svg transcribed; WPF dashes are in units of stroke width) -->
          <Viewbox Width="23" Height="23">
            <Grid Width="96" Height="96">
              <Grid.Resources>
                <RotateTransform x:Key="Tilt" Angle="-52" CenterX="48" CenterY="48"/>
              </Grid.Resources>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round" RenderTransform="{StaticResource Tilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="16.5" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" Margin="9,2,0,0" VerticalAlignment="Center"/>
          <!-- the discreet door to "À propos" (design v3: the "…" next to the brand) -->
          <Button Command="{Binding About.OpenCommand}" Cursor="Hand" Margin="7,0,0,0" VerticalAlignment="Center"
                  ToolTip="{Binding [About_Tip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg" Width="24" Height="24" CornerRadius="7" Background="Transparent">
                  <TextBlock Text="…" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkFaintBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- right cluster -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- global mode switch: the single control that changes how much the app shows -->
          <StackPanel x:Name="ModeSwitch" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"
                       Text="{Binding [Mode_Label], Source={x:Static services:I18n.Instance}}"/>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999"
                    Background="{DynamicResource SurfaceBrush}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                  <Style x:Key="ModeHalf" TargetType="Button">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="13,6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Button">
                          <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </StackPanel.Resources>
                <Button Command="{Binding Mode.SetNoviceCommand}"
                        Content="{Binding [Mode_Novice], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModeHalf}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsNovice}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Command="{Binding Mode.SetExpertCommand}"
                        Content="{Binding [Mode_Expert], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModeHalf}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsExpert}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- EN / FR -->
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999"
                  Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LangEnBtn" Content="EN" Click="OnLangEn" Style="{x:Null}" BorderThickness="0"
                      FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand"/>
              <Button x:Name="LangFrBtn" Content="FR" Click="OnLangFr" Style="{x:Null}" BorderThickness="0"
                      FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource IconBtn}" Click="OnStartTour" Margin="0,0,10,0" VerticalAlignment="Center"
                  ToolTip="{Binding [Tour_Tip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon Kind="circle-help" Size="15"/>
          </Button>
          <Button x:Name="ThemeBtn" Style="{StaticResource IconBtn}" Click="OnToggleTheme" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon x:Name="ThemeIcon" Kind="moon" Size="15"/>
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="12,12,2,12"/>
          <!-- caption buttons -->
          <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize"><controls:LucideIcon Kind="minus" Size="14"/></Button>
            <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeRestore"><controls:LucideIcon Kind="square" Size="11"/></Button>
            <Button Style="{StaticResource CaptionBtnClose}" Click="OnClose"><controls:LucideIcon Kind="x" Size="15"/></Button>
          </StackPanel>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- ══════════ BODY ══════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PaperSunkBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,12">
          <!-- settings-file card (bottom) -->
          <!-- novice: a hand; expert: the settings file being edited (design v3 sidebar foot) -->
          <Border x:Name="HelpCard" DockPanel.Dock="Bottom" Background="{DynamicResource SkyBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11"
                  Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="circle-help" Size="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="7,0,0,0"
                           Text="{Binding [Help_Title], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,8"
                         Text="{Binding [Help_Body], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch" Click="OnStartTour"
                      Content="{Binding [Btn_GuidedTour], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Border>
          <Border x:Name="SettingsCard" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11,10"
                  Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding [SettingsFile_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0"
                         Text="{Binding [SettingsFile_Global], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="0,4,0,7"
                         Text="{Binding Config.Location.GlobalPath}"/>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BadgeOk}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource InverseBooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Valid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
                <Border Style="{StaticResource BadgeFail}" HorizontalAlignment="Left"
                        Visibility="{Binding Config.HasBlockingErrors, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Style="{StaticResource BadgeText}" FontSize="10"
                             Text="{Binding [Badge_Invalid], Source={x:Static services:I18n.Instance}}"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel>
            <!-- "Résoudre" leads: the new user's door (SPEC-ORKEON-FORGE §12.1, UX study §5) -->
            <StackPanel x:Name="NavGroupTeams">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,0,0,7"
                       Text="{Binding [Grp_Teams], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavCreate" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="wand-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Create], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavTeams" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="brain-circuit" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Teams], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource InkFaintBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding DataContext.Teams.Count, RelativeSource={RelativeSource AncestorType=Window}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavImport" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="file-json-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Import], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupWork">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Grp_Work], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavTest" GroupName="Nav" Style="{StaticResource NavItem}"
                         Visibility="{Binding Mode.IsExpert, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="badge-check" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Test], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavRun" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="play" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Run], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="history" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_History], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupEnv">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Grp_Env], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Settings], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDiag" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="stethoscope" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Nav_Diag], Source={x:Static services:I18n.Instance}}"/>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding DataContext.Config.Diagnostic.HasIssues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- CONTENT: one panel per nav item, visibility driven by the RadioButtons -->
      <Grid Grid.Column="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavCreate, Converter={StaticResource BooleanToVisibility}}">
          <views:CreateTeamView x:Name="CreatePanel" MaxWidth="1000" DataContext="{Binding CreateTeam}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavTeams, Converter={StaticResource BooleanToVisibility}}">
          <views:TeamsView x:Name="TeamsPanel" MaxWidth="1000" DataContext="{Binding Teams}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavImport, Converter={StaticResource BooleanToVisibility}}">
          <views:ImportTeamView MaxWidth="880" DataContext="{Binding Import}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavTest, Converter={StaticResource BooleanToVisibility}}">
          <views:TestTeamView MaxWidth="1000" DataContext="{Binding Test}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BooleanToVisibility}}">
          <views:SettingsView x:Name="SettingsPanel" MaxWidth="1000" DataContext="{Binding Settings}"/>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavDiag, Converter={StaticResource BooleanToVisibility}}">
          <views:DiagnosticView x:Name="DiagPanel" MaxWidth="880" DataContext="{Binding Config.Diagnostic}"/>
        </ScrollViewer>
        <Grid Visibility="{Binding IsChecked, ElementName=NavRun, Converter={StaticResource BooleanToVisibility}}">
          <views:LaunchTabView x:Name="RunPanel" DataContext="{Binding Launch}" Margin="30,24,30,20"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,44"
                      Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BooleanToVisibility}}">
          <views:HistoryView MaxWidth="880" DataContext="{Binding Launch.History}"/>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ══════════ ÉDITEUR DE RÉGLAGE DE MODÈLE (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="#8C09141C" MouseLeftButtonDown="OnProfileEditorBackdropClick"
          Visibility="{Binding Settings.Profiles.IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.Resources>
        <views:IsEqualConverter x:Key="IsEqual"/>
      </Grid.Resources>
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding Settings.Profiles.Editor}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding [Profile_EditTitle], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                      <Setter Property="Text" Value="{Binding [Profile_NewTitle], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding [Profile_EditSub], Source={x:Static services:I18n.Instance}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                       Text="{Binding [Profile_NameLabel], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                       Text="{Binding [Profile_NameTaken], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding NameCollision, Converter={StaticResource BooleanToVisibility}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [Profile_ProviderLabel], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource PickRow}" GroupName="ProfileProvider" Margin="0,0,0,7"
                               Command="{Binding DataContext.Settings.Profiles.Editor.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               CommandParameter="{Binding}">
                    <RadioButton.IsChecked>
                      <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                        <Binding/>
                        <Binding Path="DataContext.Settings.Profiles.Editor.SelectedProvider" RelativeSource="{RelativeSource AncestorType=Window}"/>
                      </MultiBinding>
                    </RadioButton.IsChecked>
                    <DockPanel LastChildFill="False">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" Text="{Binding Description}"/>
                    </DockPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,7,0,0"
                  Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_BaseUrl], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_Model], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Style="{StaticResource BtnGhost}" Command="{Binding TestConnectionCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="plug-zap" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Sec_TestConnection], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                         Text="{Binding ConnectionTestResult}"
                         Visibility="{Binding ConnectionTestResult, Converter={StaticResource StringPresentToVisibility}}"/>
            </StackPanel>
          </StackPanel>

          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel LastChildFill="False">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Profile_Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Btn_Cancel], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ À PROPOS (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="#8C09141C" MouseLeftButtonDown="OnAboutBackdropClick"
          Visibility="{Binding About.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="20" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- illustration plate: fixed light background, the artwork is opaque -->
          <Border Grid.Column="0" Background="#EFF3F3" CornerRadius="20,0,0,20">
            <Image Source="/Assets/kama.png" Width="224" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="28,26">
            <TextBlock Style="{StaticResource Eyebrow}"
                       Text="{Binding [About_Eyebrow], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Text="Orkeon Studio" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="11" Margin="0,8,0,0" Text="{Binding About.VersionLine}"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"
                       Text="{Binding [About_Line], Source={x:Static services:I18n.Instance}}"/>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,16,0,0">
              <DockPanel>
                <controls:LucideIcon DockPanel.Dock="Left" Kind="info" Size="15" Foreground="{DynamicResource MarkBrush}"
                                     VerticalAlignment="Top" Margin="0,1,11,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                           Text="{Binding [About_Kama], Source={x:Static services:I18n.Instance}}"/>
              </DockPanel>
            </Border>
            <DockPanel Margin="0,20,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding About.CloseCommand}"
                      Content="{Binding [About_Close], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnGhost}" Click="OnStartTourFromAbout" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="circle-help" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Btn_GuidedTour], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ══════════ DÉMARRAGE (overlay, 5 s, clic pour passer) ══════════ -->
    <Border x:Name="Splash" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource PaperBrush}" Cursor="Hand"
            MouseLeftButtonDown="OnSplashClick"
            ToolTip="{Binding [Splash_Skip], Source={x:Static services:I18n.Instance}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#EFF3F3" CornerRadius="28" Padding="34,14,34,0" HorizontalAlignment="Center">
          <Image Source="/Assets/kama.png" Width="280"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
          <Viewbox Width="26" Height="26" VerticalAlignment="Center">
            <Grid Width="96" Height="96">
              <Grid.Resources>
                <RotateTransform x:Key="SplashTilt" Angle="-52" CenterX="48" CenterY="48"/>
              </Grid.Resources>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round" RenderTransform="{StaticResource SplashTilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round" RenderTransform="{StaticResource SplashTilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round" RenderTransform="{StaticResource SplashTilt}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                     Foreground="{DynamicResource InkBrush}" Margin="11,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" FontSize="12" Margin="11,10,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Width="220" Height="3" CornerRadius="999" Background="{DynamicResource LineBrush}" Margin="0,24,0,0">
          <Rectangle Height="3" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" Width="0">
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="220" Duration="0:0:5"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>
        </Border>
        <TextBlock FontSize="12" Foreground="{DynamicResource InkFaintBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Text="{Binding About.VersionLine}"/>
      </StackPanel>
    </Border>

    <!-- ══════════ GUIDED TOUR (last child = topmost) ══════════ -->
    <controls:TourOverlay x:Name="Tour" Grid.Row="0" Grid.RowSpan="2"/>
  </Grid>
</Window>
