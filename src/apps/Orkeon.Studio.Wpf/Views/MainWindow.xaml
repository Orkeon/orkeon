<Window x:Class="Orkeon.Studio.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
        xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
        xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
        Title="Orkeon Studio"
        Height="768" Width="1024" MinHeight="768" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

  <!-- Custom title bar: the 52px strip is the caption; buttons opt out via IsHitTestVisibleInChrome. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- the settings file can be saved from any screen, not only from Start -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="S" Command="{Binding Config.SaveCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.Style>
      <!-- A maximized WindowChrome window is positioned ~7px offscreen on every side (the OS
           reserves the resize frame); without this compensation the custom title bar and the
           content edges are clipped whenever the window is maximized. -->
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Margin" Value="7"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <!-- Title bar, body, status bar (STUDIO-34). Every overlay spans the three rows. -->
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ══════════ TITLE BAR ══════════ -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0,0,0">
        <!-- brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Orkeon mark: 3 dashed arcs + node (assets/orkeon-mark.svg transcribed; WPF dashes are in units of stroke width) --><!--
          <Viewbox Width="23" Height="23">
            --><!-- The mock rotates the GROUP once around its own center (rotate(-52 48 48));
                 rotating each ring separately around a foreign center is what skewed the mark. --><!--
            <Grid Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="-52"/>
              </Grid.RenderTransform>
              <Ellipse Width="38" Height="38" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="12.27 4.79" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="62" Height="62" Stroke="{DynamicResource MarkBrush}" StrokeThickness="7"
                       StrokeDashArray="20.03 7.8" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="86" Height="86" Stroke="{DynamicResource MarkBrush}" StrokeThickness="6"
                       StrokeDashArray="32.42 12.62" StrokeDashCap="Round"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="16" Height="16" Fill="{DynamicResource MarkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>-->
          <!-- Icône de l'application (cadrage buste, coins arrondis détourés dans le PNG).
               Source 64 px rendue à 23 : nette jusqu'à ~275 % de mise à l'échelle. -->
          <Image Source="/Assets/orkeon-studio-mark.png" Width="23" Height="23"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 VerticalAlignment="Center"/>
          <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="16.5" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" Margin="9,2,0,0" VerticalAlignment="Center"/>
          <!-- the discreet door to "À propos" (design v3: the "…" next to the brand) -->
          <!-- R04 (A04): every title-bar button is a 32 px ghost — this one included. -->
          <Button Style="{StaticResource IconBtnGhost}" Command="{Binding About.OpenCommand}" Margin="4,0,0,0" VerticalAlignment="Center"
                  ToolTip="{Binding [Studio.Shell.AboutTip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon Kind="ellipsis" Size="16"/>
          </Button>
        </StackPanel>

        <!-- right cluster -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- R12: the way into the assistant's side panel, pressed while it is open; the
               accent dot says the assistant spoke while it was closed. R04 (A04): a Secondary
               (BtnToggle); open, sky ground and AccentInk text — the icon follows the text. -->
          <ToggleButton Style="{StaticResource BtnToggle}" Margin="0,0,14,0" VerticalAlignment="Center"
                        IsChecked="{Binding Chat.IsOpen, Mode=OneWay}" Command="{Binding Chat.ToggleCommand}"
                        AutomationProperties.AutomationId="AskAssistant"
                        AutomationProperties.Name="{Binding [Studio.Shell.AskAssistant], Source={x:Static services:I18n.Instance}}"
                        ToolTip="{Binding [Studio.Chat.AskTip], Source={x:Static services:I18n.Instance}}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="message-circle" Size="16" Margin="0,0,8,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
              <TextBlock Text="{Binding [Studio.Shell.AskAssistant], Source={x:Static services:I18n.Instance}}" VerticalAlignment="Center"/>
              <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                       Fill="{DynamicResource MarkBrush}"
                       Visibility="{Binding Chat.HasUnread, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
          </ToggleButton>
          <!-- global mode switch: the single control that changes how much the app shows -->
          <StackPanel x:Name="ModeSwitch" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"
                       Text="{Binding [Studio.Shell.ModeLabel], Source={x:Static services:I18n.Instance}}"/>
            <Border Style="{StaticResource SegmentedGroup}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding Mode.SetNoviceCommand}"
                        Content="{Binding [Studio.Shell.Novice], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsNovice}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Command="{Binding Mode.SetExpertCommand}"
                        Content="{Binding [Studio.Shell.Expert], Source={x:Static services:I18n.Instance}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.IsExpert}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- T-14: the language in force is on the button; the menu offers only the
               OTHERS — the current one is already there, and a row that does nothing is
               a row that asks to be clicked. The header line says whether this language
               came from the machine or from a choice, which is the difference a user has
               no other way of seeing. -->
          <Grid VerticalAlignment="Center" Margin="0,0,4,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="LanguageButton" Style="{StaticResource BtnTitleBar}" Padding="10,0" Command="{Binding Language.ToggleMenuCommand}">
              <Button.ToolTip><TextBlock Text="{Binding Language.Tooltip}"/></Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource MonoFont}" Text="{Binding Language.CurrentDisplay}" VerticalAlignment="Center"/>
                <controls:LucideIcon Kind="chevron-down" Size="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     RenderTransformOrigin="0.5,0.5">
                  <controls:LucideIcon.RenderTransform><RotateTransform/></controls:LucideIcon.RenderTransform>
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Language.IsMenuOpen}" Value="True">
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.14"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.14"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
              </StackPanel>
            </Button>
            <!-- R04 (A05): the menu opens under «FR», its right edge on the button's
                 (MainWindow.PlaceLanguageMenu) — never under the mode switch. -->
            <Popup x:Name="LanguagePopup" IsOpen="{Binding Language.IsMenuOpen, Mode=TwoWay}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Custom"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="186"
                      Margin="10,0,10,14" Effect="{DynamicResource ShadowMd}">
                <StackPanel>
                  <!-- One sentence-case line in the UI font («Langue choisie · Français»), no mono capitals. -->
                  <TextBlock Style="{StaticResource MetaText}" Padding="8,5,8,6" Text="{Binding Language.MenuHeader}"/>
                  <ItemsControl ItemsSource="{Binding Language.Others}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Anchored on the ItemsControl, not on the Popup: a Popup's child
                             lives in its own visual tree, so walking up to the Popup itself
                             relies on the logical hop. The ItemsControl is an ancestor in the
                             ordinary way and carries the same inherited DataContext. -->
                        <Button Style="{StaticResource LangRow}" CommandParameter="{Binding Code}"
                                Command="{Binding DataContext.Language.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold" Width="20"
                                       Foreground="{DynamicResource AccentBrush}" Text="{Binding Display}"/>
                            <TextBlock FontSize="13" Margin="9,0,0,0" Foreground="{DynamicResource InkBrush}"
                                       Text="{Binding Name}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Button Style="{StaticResource IconBtnGhost}" Click="OnStartTour" Margin="0,0,4,0" VerticalAlignment="Center"
                  ToolTip="{Binding [Studio.Shell.TourTip], Source={x:Static services:I18n.Instance}}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon Kind="circle-help" Size="16"/>
          </Button>
          <Button x:Name="ThemeBtn" Style="{StaticResource IconBtnGhost}" Click="OnToggleTheme" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <controls:LucideIcon x:Name="ThemeIcon" Kind="moon" Size="16"/>
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="12,12,2,12"/>
          <!-- caption buttons -->
          <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize"><controls:LucideIcon Kind="minus" Size="14"/></Button>
            <Button Style="{StaticResource CaptionBtn}" Click="OnMaximizeRestore"><controls:LucideIcon Kind="square" Size="11"/></Button>
            <Button Style="{StaticResource CaptionBtnClose}" Click="OnClose"><controls:LucideIcon Kind="x" Size="15"/></Button>
          </StackPanel>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- ══════════ BODY ══════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PaperSunkBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,12">
          <!-- settings-file card (bottom) -->
          <!-- novice: a hand; expert: the settings file being edited (design v3 sidebar foot) -->
          <Border x:Name="HelpCard" DockPanel.Dock="Bottom" Background="{DynamicResource SkyBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="11"
                  Visibility="{Binding Mode.IsNovice, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="circle-help" Size="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="7,0,0,0"
                           Text="{Binding [Studio.Shell.HelpTitle], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,8"
                         Text="{Binding [Studio.Shell.HelpBody], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Stretch" Click="OnStartTour"
                      Content="{Binding [Studio.Common.GuidedTour], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Border>
          <!-- Only from somewhere else: the draft says where it stopped, so leaving the
               assistant is never the same as forgetting it. On the Créer screen itself it
               would only repeat what is on screen. R13 (A10): a contextual block goes to the
               foot of the nav column — above «Besoin d'aide ?» in Novice — never between two
               entries, so the nav never moves when it comes or goes. -->
          <Button x:Name="DraftNote" DockPanel.Dock="Bottom" Margin="0,8,0,8" Style="{StaticResource DraftNote}" Click="OnResumeDraft">
            <StackPanel>
              <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource AccentBrush}"
                         Text="{Binding DataContext.CreateTeam.DraftTitle, RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                         Text="{Binding DataContext.CreateTeam.DraftLine, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.CreateTeam.IsAssistantWaiting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Button.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                <Binding Path="DataContext.CreateTeam.HasDraft" RelativeSource="{RelativeSource AncestorType=Window}"/>
                <Binding Path="IsChecked" ElementName="NavCreate" Converter="{StaticResource Negate}"/>
              </MultiBinding>
            </Button.Visibility>
          </Button>
          <!-- Lot 5: the former « Settings file » card is the dot on the Settings entry and a line
               of the Diagnostic; the file's path shows once, in Settings > File. -->

          <StackPanel>
            <!-- "Résoudre" leads: the new user's door (SPEC-ORKEON-FORGE §12.1, UX study §5) -->
            <StackPanel x:Name="NavGroupTeams">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,0,0,7"
                       Text="{Binding [Studio.Shell.GroupTeams], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavCreate" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True"
                         HorizontalContentAlignment="Stretch">
              <!-- T-09: a creation left mid-flight is announced on its own entry — the step
                   counter and an accent dot, pushed right like the team count below. -->
              <DockPanel LastChildFill="False">
                <controls:LucideIcon DockPanel.Dock="Left" Kind="wand-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Text="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding DataContext.CreateTeam.HasDraft, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource InkFaintBrush}"
                             Text="{Binding DataContext.CreateTeam.DraftStepShort, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  <Ellipse Width="6" Height="6" Margin="7,0,0,0" VerticalAlignment="Center"
                           Fill="{DynamicResource MarkBrush}"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>

            <RadioButton x:Name="NavTeams" GroupName="Nav" Style="{StaticResource NavItem}"
                         HorizontalContentAlignment="Stretch">
              <!-- T-10: the counter is pushed to the right edge, mono 10 faint, no chip. It counts the
                   ACTIVE teams (STUDIO-32, D-03): neither the screen's search nor its Archives view
                   moves it. -->
              <DockPanel LastChildFill="False">
                <controls:LucideIcon DockPanel.Dock="Left" Kind="brain-circuit" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Text="{Binding [Studio.Shell.NavTeams], Source={x:Static services:I18n.Instance}}"/>
                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"
                           Text="{Binding DataContext.Teams.ActiveCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="NavImport" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="file-json-2" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Studio.Shell.Import], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupWork">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Studio.Shell.Work], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavRun" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="play" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Studio.Shell.Run], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="history" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Studio.Shell.History], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>

            <StackPanel x:Name="NavGroupEnv">
            <TextBlock Style="{StaticResource Eyebrow}" Margin="11,16,0,7"
                       Text="{Binding [Studio.Shell.Env], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Studio.Shell.Settings], Source={x:Static services:I18n.Instance}}"/>
                <!-- the settings file's state: red when it has errors, amber while edits are unsaved -->
                <Ellipse x:Name="SettingsDot" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Fill" Value="{DynamicResource WarningIconBrush}"/>
                      <Setter Property="ToolTip" Value="{Binding Config.PendingChangesText}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Config.HasPendingChanges}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Config.HasBlockingErrors}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                          <Setter Property="ToolTip" Value="{Binding [Studio.Diagnostics.SettingsFileInvalid], Source={x:Static services:I18n.Instance}}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDiag" GroupName="Nav" Style="{StaticResource NavItem}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="stethoscope" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding [Studio.Shell.Diag], Source={x:Static services:I18n.Instance}}"/>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningIconBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding DataContext.Config.Diagnostic.HasIssues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
              </StackPanel>
            </RadioButton>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- CONTENT: one panel per nav item, visibility driven by the RadioButtons; the
           assistant's side panel (420 px) on the right while it is open (refonte R10). -->
      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- R15 (A06, B04, C18): an anchored 420 px panel with its own scroll bar. It docks in
             the Auto column while the content keeps 720 px beside it; narrower, it lays over the
             content, right-aligned and shadowed, instead of squeezing it (PlaceAssistantPanel).
             Closed, it is collapsed: the Auto column reserves nothing. -->
        <views:ChatThreadView x:Name="AssistantPanel" Grid.Column="1" Width="420"
                              AutomationProperties.AutomationId="AssistantPanel"
                              DataContext="{Binding Chat}"
                              Loaded="OnAssistantPanelLoaded"
                              Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}"/>
        <!-- STUDIO-32 (D-02), refonte lot 2: « Archive » asks nothing; its undo is this toast at the
             bottom right of the content, for ten seconds (TeamsViewModel.UndoWindow), over any screen.
             R15 (A09): 16 px above the status bar, 16 px left of the 8 px scroll bar, inside the
             content column (PlaceAssistantPanel keeps the same margins). -->
        <Border x:Name="ArchiveUndoToast" Grid.Column="0" Panel.ZIndex="10" DataContext="{Binding Teams}"
                AutomationProperties.AutomationId="ArchiveUndoToast"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" MaxWidth="440"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,8,6,8"
                Effect="{DynamicResource ShadowMd}"
                Visibility="{Binding HasUndo, Converter={StaticResource BooleanToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtnGhost}" VerticalAlignment="Center"
                    Command="{Binding DismissUndoCommand}" controls:ButtonIcon.Kind="x"
                    ToolTip="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"
                    AutomationProperties.Name="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="12,0,4,0"
                    VerticalAlignment="Center" Command="{Binding UndoCommand}" controls:ButtonIcon.Kind="rotate-ccw"
                    Content="{Binding [Studio.Teams.Undo], Source={x:Static services:I18n.Instance}}"/>
            <controls:LucideIcon DockPanel.Dock="Left" Kind="archive" Size="16" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource InkBrush}" Text="{Binding UndoNotice}"/>
          </DockPanel>
        </Border>
        <!-- R01, R02 (A01, A02): one page column for every screen - 1040 px at most, 85 px after
             the nav's edge (x = 297..1337 at 1440 px), whatever the screen's state: the single
             PageColumn takes its width from the window, never from the content. The scroll area
             runs down to the status bar; the 24 px top and 32 px end margins live INSIDE the
             scrolled content (a ScrollViewer's Padding sits outside the viewport and left a dead
             band above the bar). The right margin only shows below 1440 px. -->
        <Grid Grid.Column="0">
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavCreate, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:CreateTeamView x:Name="CreatePanel" DataContext="{Binding CreateTeam}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavTeams, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:TeamsView x:Name="TeamsPanel" DataContext="{Binding Teams}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavImport, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:ImportTeamView x:Name="ImportPanel" DataContext="{Binding Import}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:SettingsView x:Name="SettingsPanel" DataContext="{Binding Settings}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavDiag, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:DiagnosticView x:Name="DiagPanel" DataContext="{Binding Config.Diagnostic}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavRun, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:RunScreenView x:Name="RunPanel" DataContext="{Binding Run}"/>
          </Grid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BooleanToVisibility}}">
          <Grid Style="{StaticResource PageHost}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource PageColumn}"/></Grid.ColumnDefinitions>
            <views:HistoryView x:Name="HistoryPanel" DataContext="{Binding Launch.History}"/>
          </Grid>
        </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- ══════════ STATUS BAR (STUDIO-34) ══════════ -->
    <!-- What runs, what it spends and the tools at work, without changing screen. One group per
         activity that runs — Run, Test, the assistant — each only while it runs, none hidden, none
         merged (DD-2). At rest the expert reads the default profile; the Balance segment on the
         right says what the provider accounts have left (STUDIO-35). A segment nothing measured is
         absent, never a zero; the novice reads each group's state and meters, the expert everything
         (D-03). A click on a group opens its activity's screen (D-04). DataContext: StatusBarViewModel. -->
    <Border x:Name="StatusStrip" Grid.Row="2" MinHeight="30" DataContext="{Binding StatusBar}"
            Background="{DynamicResource PaperSunkBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <Border.Resources>
        <!-- A group is a flat button: no chrome at rest, the surface under the pointer. -->
        <Style x:Key="StatusGroup" TargetType="Button">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="HorizontalAlignment" Value="Left"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
          <Setter Property="ToolTip" Value="{Binding [Studio.Shell.StatusOpenTip], Source={x:Static services:I18n.Instance}}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,3">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsMouseOver" Value="True"/>
                      <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                  </MultiTrigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <!-- A Balance entry (STUDIO-35): a group's flat button without the group's «open this
             screen» tip — the segment's own tip says what each entry holds and what its click does. -->
        <Style x:Key="StatusBalanceEntry" TargetType="Button" BasedOn="{StaticResource StatusGroup}">
          <Setter Property="Margin" Value="2,0,0,0"/>
          <Setter Property="ToolTip" Value="{x:Null}"/>
        </Style>
        <Style x:Key="StatusGroupLabel" TargetType="TextBlock">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusFigure" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
          <Setter Property="TextWrapping" Value="NoWrap"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The state's dot: accent while it works, warning while it waits on you, then its verdict. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
          <Setter Property="Width" Value="8"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Margin" Value="8,0,5,0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="waiting">
              <Setter Property="Fill" Value="{DynamicResource WarningIconBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="ok">
              <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="fail">
              <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <!-- The state in words; waiting on you is the one state that must catch the eye. -->
        <Style x:Key="StatusState" TargetType="TextBlock">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource WarningInkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <!-- The body of a launcher's group — the Run screen's and the Test screen's alike. -->
        <DataTemplate x:Key="RunGroupBody">
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}"/>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusState}" Text="{Binding StateText}"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0"
                        ToolTip="{Binding [Studio.Create.TokensUp], Source={x:Static services:I18n.Instance}}"
                        ToolTipService.ShowOnDisabled="True"
                        Visibility="{Binding ShowsTokensUp, Converter={StaticResource BooleanToVisibility}}">
              <!-- «~» when Studio or the runtime had to estimate for a provider that reported nothing, as in the assistant's group. -->
              <TextBlock Style="{StaticResource StatusFigure}" Margin="0,0,2,0" Text="~"
                         Foreground="{DynamicResource InkFaintBrush}"
                         Visibility="{Binding TokensEstimated, Converter={StaticResource BooleanToVisibility}}"/>
              <controls:LucideIcon Kind="arrow-up" Size="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkMutedBrush}"/>
              <TextBlock Style="{StaticResource StatusFigure}" Margin="3,0,0,0" Text="{Binding TokensUp}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0"
                        ToolTip="{Binding [Studio.Create.TokensDown], Source={x:Static services:I18n.Instance}}"
                        ToolTipService.ShowOnDisabled="True"
                        Visibility="{Binding ShowsTokensDown, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="arrow-down" Size="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkMutedBrush}"/>
              <TextBlock Style="{StaticResource StatusFigure}" Margin="3,0,0,0" Text="{Binding TokensDown}"/>
            </StackPanel>
            <!-- BR-07: the mode of the call in flight (Stream, Buffer, Buffer (fallback)); nothing before a call. -->
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusFigure}" Margin="8,0,0,0"
                       Foreground="{DynamicResource InkFaintBrush}" Text="{Binding CallModeText}"
                       Visibility="{Binding CallModeText, Converter={StaticResource StringPresentToVisibility}}"/>
            <!-- The expert's segments in one line the bar trims when the window is narrow; the
                 whole of it, the tool and delegation lists written out, on hover. -->
            <TextBlock Style="{StaticResource StatusFigure}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Details}"
                       ToolTip="{Binding DetailsTip}" ToolTipService.ShowOnDisabled="True"
                       Visibility="{Binding ShowsDetails, Converter={StaticResource BooleanToVisibility}}"/>
          </DockPanel>
        </DataTemplate>
      </Border.Resources>

      <!-- R03 (A03): three fixed zones that keep their place even empty - left the default
           model («DeepSeek · deepseek-chat», or «Aucun modèle»), in both modes and while an
           activity runs; centre the activities that run, or wait on the screen shown; right
           the balances. The token scope (BR-14) is chosen in Réglages › Studio. -->
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="200"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"
                    ToolTip="{Binding ProfileTip}">
          <controls:LucideIcon Kind="sparkles" Size="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkFaintBrush}"/>
          <TextBlock Margin="6,0,0,0" Text="{Binding ModelText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource StatusFigure}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasModel}" Value="False">
                    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
                    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Rectangle Grid.Column="1" Width="1" Margin="12,7,12,7" Fill="{DynamicResource LineBrush}"/>

        <!-- The active groups share the width, so a narrow window trims their expert line and
             never pushes a group off the bar. -->
        <UniformGrid Grid.Column="2" Rows="1">
          <Button Style="{StaticResource StatusGroup}" Command="{Binding Launch.OpenCommand}"
                  Visibility="{Binding Launch.IsActive, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusGroupLabel}"
                         Text="{Binding [Studio.Shell.Run], Source={x:Static services:I18n.Instance}}"/>
              <ContentPresenter Content="{Binding Launch}" ContentTemplate="{StaticResource RunGroupBody}"/>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource StatusGroup}" Command="{Binding Test.OpenCommand}"
                  Visibility="{Binding Test.IsActive, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusGroupLabel}"
                         Text="{Binding [Studio.Run.ModeTrial], Source={x:Static services:I18n.Instance}}"/>
              <ContentPresenter Content="{Binding Test}" ContentTemplate="{StaticResource RunGroupBody}"/>
            </DockPanel>
          </Button>
          <!-- R03 (A03): on the bar while it runs; waiting only, on its own screen and step. -->
          <Button Style="{StaticResource StatusGroup}" Command="{Binding Atelier.OpenCommand}"
                  Visibility="{Binding ShowsAtelier, Converter={StaticResource BooleanToVisibility}}">
            <!-- Stage first, then what it spent: the stage is the sentence the card already says. -->
            <DockPanel DataContext="{Binding Atelier}">
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusGroupLabel}"
                         Text="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
              <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}"/>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatusFigure}" Margin="12,0,0,0"
                         Foreground="{DynamicResource InkFaintBrush}" Text="{Binding BudgetLeft}"
                         Visibility="{Binding ShowsBudgetLeft, Converter={StaticResource BooleanToVisibility}}"/>
              <!-- BR-07: the mode of the forge's or rephrase's call in flight or last, as in RunGroupBody. -->
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatusFigure}" Margin="8,0,0,0"
                         Foreground="{DynamicResource InkFaintBrush}" Text="{Binding CallModeText}"
                         Visibility="{Binding CallModeText, Converter={StaticResource StringPresentToVisibility}}"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                          ToolTip="{Binding [Studio.Create.TokensDown], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowsTokensDown, Converter={StaticResource BooleanToVisibility}}">
                <controls:LucideIcon Kind="arrow-down" Size="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource InkMutedBrush}"/>
                <TextBlock Style="{StaticResource StatusFigure}" Margin="3,0,0,0" Text="{Binding TokensDown}"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                          ToolTip="{Binding [Studio.Create.TokensUp], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding ShowsTokensUp, Converter={StaticResource BooleanToVisibility}}">
                <!-- «~» when Studio or the runtime had to estimate for a provider that reported nothing, as on the card. -->
                <TextBlock Style="{StaticResource StatusFigure}" Margin="0,0,2,0" Text="~"
                           Foreground="{DynamicResource InkFaintBrush}"
                           Visibility="{Binding TokensEstimated, Converter={StaticResource BooleanToVisibility}}"/>
                <controls:LucideIcon Kind="arrow-up" Size="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource InkMutedBrush}"/>
                <TextBlock Style="{StaticResource StatusFigure}" Margin="3,0,0,0" Text="{Binding TokensUp}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource StatusState}" Text="{Binding Stage}"/>
            </DockPanel>
          </Button>
        </UniformGrid>

        <Rectangle Grid.Column="3" Width="1" Margin="12,7,0,7" Fill="{DynamicResource LineBrush}"
                   Visibility="{Binding Balance.HasBalance, Converter={StaticResource BooleanToVisibility}}"/>
        <!-- The Balance segment (STUDIO-35): what the covered provider accounts have left, one
             entry per account, in both modes. A click on an entry reads the balances again — or,
             for a provider whose balance only its console shows, opens that console (D-01). An
             amount under its provider's threshold takes the warning tone (D-03), a failed read is
             said quietly, an account not read yet carries the read-again glyph. Per account, with
             the time of each read, on hover. -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                    DataContext="{Binding Balance}" ToolTip="{Binding Detail}"
                    Visibility="{Binding HasBalance, Converter={StaticResource BooleanToVisibility}}">
          <controls:LucideIcon Kind="wallet" Size="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkFaintBrush}"/>
          <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource StatusBalanceEntry}" Command="{Binding ClickCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Figure" Style="{StaticResource StatusFigure}" Text="{Binding Text}"/>
                    <controls:LucideIcon Kind="external-link" Size="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource InkFaintBrush}"
                                         Visibility="{Binding OffersConsole, Converter={StaticResource BooleanToVisibility}}"/>
                    <controls:LucideIcon Kind="rotate-cw" Size="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource InkFaintBrush}"
                                         Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Figure" Property="Foreground" Value="{DynamicResource WarningInkBrush}"/>
                    <Setter TargetName="Figure" Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsFaint}" Value="True">
                    <Setter TargetName="Figure" Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════ ÉDITEUR DE RÉGLAGE DE MODÈLE (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnProfileEditorBackdropClick"
          Visibility="{Binding Settings.Profiles.IsEditorOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.Resources>
        <views:IsEqualConverter x:Key="IsEqual"/>
        <views:ModalBodyHeightConverter x:Key="ModalBodyHeight"/>
        <!-- One provider card: compact title + description, accent border when picked. -->
        <DataTemplate x:Key="ProviderCard">
          <RadioButton GroupName="ProfileProvider" Margin="0,0,7,7" Cursor="Hand"
                       Command="{Binding DataContext.Settings.Profiles.Editor.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                <Binding/>
                <Binding Path="DataContext.Settings.Profiles.Editor.SelectedProvider" RelativeSource="{RelativeSource AncestorType=Window}"/>
              </MultiBinding>
            </RadioButton.IsChecked>
            <RadioButton.Template>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="11,8">
                  <StackPanel>
                    <!-- R09 (B10): a trimmed title or description gives its full text on hover. -->
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding Title}"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip="{Binding Description}"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </RadioButton.Template>
          </RadioButton>
        </DataTemplate>
      </Grid.Resources>
      <Border Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding Settings.Profiles.Editor}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <!-- R15 (C21): the header stays put; only the body below it scrolls, so the scroll bar
               starts under the header and ends above the footer, never on a rounded corner. -->
          <StackPanel Margin="22,20,22,0">
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ModalTitle}">
                  <Setter Property="Text" Value="{Binding [Studio.Settings.EditTitle], Source={x:Static services:I18n.Instance}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                      <Setter Property="Text" Value="{Binding [Studio.Settings.NewTitle], Source={x:Static services:I18n.Instance}}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding [Studio.Settings.EditSub], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,6,0"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModalBodyHeight}}">
          <StackPanel Margin="22,0,16,0">
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="{Binding [Studio.Settings.NameLabel], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                       Text="{Binding [Studio.Settings.NameTaken], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding NameCollision, Converter={StaticResource BooleanToVisibility}}"/>
            <!-- STUDIO-48: the name a crew writes to run on this setting, as the name is typed —
                 or why none can; « default », or an id another setting or the settings file
                 already holds, refuses the save. -->
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding HostIdText}"
                       Visibility="{Binding HostIdText, Converter={StaticResource StringPresentToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHostIdIssue}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                       Text="{Binding HostIdRenamedText}"
                       Visibility="{Binding HostIdRenamedText, Converter={StaticResource StringPresentToVisibility}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [Studio.Settings.ProviderLabel], Source={x:Static services:I18n.Instance}}"/>

            <!-- Provider cards, grouped as the v3 rev.2 design: local (keyless), cloud
                 (key required), then the catch-all and the echo fallback. R15 (C21): every group
                 lays out on the same 3 columns, so the cards line up from one group to the next. -->
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource InkFaintBrush}" Margin="0,0,0,6"
                       Text="{Binding [Studio.Settings.GroupLocal], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding LocalProviders}" ItemTemplate="{StaticResource ProviderCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource InkFaintBrush}" Margin="0,12,0,6"
                       Text="{Binding [Studio.Settings.GroupCloud], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding CloudProviders}" ItemTemplate="{StaticResource ProviderCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding OtherProviders}" ItemTemplate="{StaticResource ProviderCard}" Margin="0,7,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- URL/model: pointless without a model; the URL is expert-only except for
                 the catch-all card, where everyone must type it. -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding UrlAlwaysVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Common.BaseUrl], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="{Binding EndpointReadingLine}"
                           Visibility="{Binding EndpointReadingLine, Converter={StaticResource StringPresentToVisibility}}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Common.Model], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>

            <!-- pinned temperature, response budget & timeout: empty = nothing pinned (no
                 temperature is sent: the model applies its own, GAP-36).
                 Some models mandate a temperature (Kimi K3: 1); an empty response budget is
                 the model's documented maximum (LLM-10) and the hint under the field says what
                 that is for this model; reasoning models need more than the default 30 s to
                 answer (STUDIO-12 C5b). -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.ProfileLblTemperature], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                         Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Settings.TemperatureHint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.ProfileLblMaxTokens], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                         Text="{Binding MaxTokensText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding MaxTokensHint}"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblTimeout], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                         Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding TimeoutHint}"/>
              </StackPanel>
            </Grid>

            <!-- stream idle bound (LLM-12): the longest silence between two lines of a streamed
                 answer. Empty = none; the timeout above bounds the whole call either way. -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblStreamIdle], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" Width="90" HorizontalAlignment="Left"
                       Text="{Binding StreamIdleText, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.StreamIdleHint], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>

            <!-- call mode (BR-05): Auto streams and falls back on a buffered call; Buffer or Stream pins it. -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.CallMode], Source={x:Static services:I18n.Instance}}"/>
              <ComboBox Width="220" HorizontalAlignment="Left"
                        ItemsSource="{Binding CallModeChoices}"
                        SelectedItem="{Binding SelectedCallMode}"
                        DisplayMemberPath="Label"/>
            </StackPanel>

            <!-- thinking (LLM-11): the switch the run of 2026-09-20 had nowhere to live. Provider
                 default lets the model decide (on for Kimi K2.6, DeepSeek V4, GLM); off is the
                 way out of a timeout when the task does not need the reasoning pass; the effort
                 hint is for the models that take one. -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding ShowFields, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.ProfileLblThinking], Source={x:Static services:I18n.Instance}}"/>
                <ComboBox Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding ThinkingChoices}"
                          SelectedItem="{Binding SelectedThinking}"
                          DisplayMemberPath="Label"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding ThinkingHint}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.ProfileLblThinkingEffort], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Width="120" HorizontalAlignment="Left"
                         Text="{Binding ThinkingEffortText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Settings.ProfileThinkingEffortHint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Grid>

            <!-- API key — novice-visible. The key goes into the user environment, never
                 into a file; the status chip says whether one is already in place. -->
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0"
                    Visibility="{Binding RequiresApiKey, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <controls:LucideIcon Kind="key" Size="14" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                  <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                             Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding KeyBlockTitle}"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarningBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasStoredKey}" Value="True">
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <controls:LucideIcon Size="12" Margin="0,0,6,0" VerticalAlignment="Center">
                      <controls:LucideIcon.Style>
                        <Style TargetType="controls:LucideIcon">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStoredKey}" Value="True">
                              <Setter Property="Kind" Value="circle-check"/>
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </controls:LucideIcon.Style>
                    </controls:LucideIcon>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding KeyStatusText}"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                           Margin="0,7,0,9" Text="{Binding [Studio.Settings.KeyExplainer], Source={x:Static services:I18n.Instance}}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="7,0,0,0"
                          Command="{Binding StoreKeyCommand}"
                          Content="{Binding [Studio.Settings.KeyStore], Source={x:Static services:I18n.Instance}}"/>
                  <!-- A key is a secret even in transit (T-31): masked while it is typed or pasted. -->
                  <PasswordBox Style="{StaticResource InputPassword}"
                               ToolTip="{Binding [Studio.Settings.KeyPlaceholder], Source={x:Static services:I18n.Instance}}"
                               views:PasswordBinding.Text="{Binding ApiKeyInput}"/>
                </DockPanel>
                <!-- STUDIO-44: the key is in place for the session even when the user scope refused
                     it; the line says so, and why, instead of a click that seems to do nothing. -->
                <TextBlock FontSize="13" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Margin="0,7,0,0" Text="{Binding KeyStoreError}"
                           Visibility="{Binding KeyStoreError, Converter={StaticResource StringPresentToVisibility}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}"
                             Text="{Binding [Studio.Settings.KeyNoKeyYet], Source={x:Static services:I18n.Instance}}"/>
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13"
                             Foreground="{DynamicResource AccentBrush}" Margin="7,0,0,0"
                             Text="{Binding KeyConsoleUrl}"/>
                </StackPanel>
                <Border Background="{DynamicResource PaperSunkBrush}" BorderBrush="{DynamicResource LineFaintBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,9,0,0"
                        Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkFaintBrush}"
                               Text="{Binding [Studio.Settings.KeyExpertHint], Source={x:Static services:I18n.Instance}}"/>
                    <!-- STUDIO-48: the variable a terminal orkeon run reads this host profile's key from. -->
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"
                               Foreground="{DynamicResource InkFaintBrush}" Text="{Binding HostKeyHint}"
                               Visibility="{Binding HostKeyHint, Converter={StaticResource StringPresentToVisibility}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding ShowLocalNote, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="circle-check" Size="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.LocalNote], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding ShowNoneNote, Converter={StaticResource BooleanToVisibility}}">
              <controls:LucideIcon Kind="info" Size="13" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.NoneNote], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                        Visibility="{Binding ShowTestRow, Converter={StaticResource BooleanToVisibility}}">
              <Button Style="{StaticResource BtnSecondary}" Command="{Binding TestConnectionCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="plug-zap" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Studio.Settings.TestConnection], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <!-- STUDIO-43: the button is disabled while the test runs (its command refuses a
                   second run) and the line says « Testing the connection… »; the verdict names
                   the step, the URL, the time waited and the cause, and wraps when long. -->
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                         MaxWidth="460"
                         Text="{Binding ConnectionTestResult}"
                         Visibility="{Binding ConnectionTestResult, Converter={StaticResource StringPresentToVisibility}}"/>
            </StackPanel>

            <!-- UC-01: the model names a successful test found; a click fills the Model field only. -->
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding HasAvailableModels, Converter={StaticResource BooleanToVisibility}}">
              <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding [Studio.Settings.ModelsFilter], Source={x:Static services:I18n.Instance}}"
                       AutomationProperties.Name="{Binding [Studio.Settings.ModelsFilter], Source={x:Static services:I18n.Instance}}"/>
              <ListBox ItemsSource="{Binding FilteredModels}" MaxHeight="180" Margin="0,6,0,0"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Left"
                            Content="{Binding}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.PickModelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{Binding ModelListNote}"
                       Visibility="{Binding ModelListNote, Converter={StaticResource StringPresentToVisibility}}"/>

            <!-- STUDIO-35 (D-04): the balance line beside « Test » — what the account behind the
                 endpoint and the key has left, read on the click, never the key; where only the
                 vendor's console shows it, a link to that console. The probe's own line, in
                 English (raw evidence), on hover. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding ShowBalanceRow, Converter={StaticResource BooleanToVisibility}}">
              <Button Style="{StaticResource BtnSecondary}" Command="{Binding ReadBalanceCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="wallet" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Studio.Settings.ReadBalance], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="400"
                         Text="{Binding BalanceResult}" ToolTip="{Binding BalanceDetail}"
                         Visibility="{Binding BalanceResult, Converter={StaticResource StringPresentToVisibility}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBalanceLow}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding OpenBalanceConsoleCommand}"
                      Visibility="{Binding BalanceOffersConsole, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="external-link" Size="12" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding [Studio.Settings.BalanceConsole], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>

          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel LastChildFill="False">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Studio.Settings.Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ DOSSIERS DE L'ÉQUIPE (overlay, F-03) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnTeamMountsBackdropClick"
          Visibility="{Binding TeamMounts.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding TeamMounts}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <!-- R11 (D07): the shared 20/600 modal title. R09 (B06): a long team name wraps to a
                 second line, then ends on «…» with the whole title as a tooltip — never cut bare. -->
            <TextBlock Style="{StaticResource ModalTitle}" Text="{Binding Title}" ToolTip="{Binding Title}"
                       TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight" MaxHeight="52"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [Studio.Teams.TeamMountsSub], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton IsChecked="{Binding IsChecked}" Cursor="Hand" Margin="0,0,0,8">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="13,11">
                          <DockPanel>
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="5"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}"
                                    Background="{DynamicResource PaperSunkBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                              <controls:LucideIcon x:Name="Tick" Kind="check" Size="11"
                                                   Foreground="{DynamicResource AccentFgBrush}" Visibility="Collapsed"/>
                            </Border>
                            <!-- One word in the pill, the full label as its tooltip (STUDIO-16): the full
                                 label ate the width and the disk path read as «C:\Users\…\orkeon\…». -->
                            <Border DockPanel.Dock="Right" Margin="12,0,0,0" ToolTip="{Binding RightsLabel}">
                              <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                                  <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                      <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding RightsBadge}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <StackPanel>
                              <!-- The name the agents use, then the tail of the entry's id (VFS-90): two /output
                                   rows are told apart here, not by squinting at a truncated path. -->
                              <TextBlock Style="{StaticResource MonoText}" FontSize="13" Foreground="{DynamicResource InkBrush}">
                                <Run Text="{Binding VirtualPath, Mode=OneWay}"/><Run Text=" · " Foreground="{DynamicResource InkFaintBrush}"/><Run Text="{Binding ShortId, Mode=OneWay}" Foreground="{DynamicResource InkFaintBrush}"/>
                              </TextBlock>
                              <!-- The real folder, whole: wrapped rather than trimmed. -->
                              <TextBlock x:Name="Disk" FontSize="13" Foreground="{DynamicResource InkFaintBrush}" Margin="0,2,0,0"
                                         TextWrapping="Wrap" Text="{Binding PhysicalPath}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                          </Trigger>
                          <!-- Not in « Réglages › Dossiers autorisés » — the border says so. -->
                          <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="Disk" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Command="{Binding AddCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="plus" Size="12" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Teams.AddAnother], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Studio.Common.Save], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,12,0" Text="{Binding Summary}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ ÉDITEUR D'AGENT (overlay, F-01) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAgentEditorBackdropClick"
          Visibility="{Binding CreateTeam.AgentEditor.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding CreateTeam.AgentEditor}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock Style="{StaticResource ModalTitle}" Text="{Binding Title}"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [Studio.Create.AgentEditorSub], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                       Text="{Binding [Studio.Create.Name], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                       Text="{Binding [Studio.Create.Does], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMultiline}"
                     Text="{Binding WhatItDoes, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,7"
                       Text="{Binding [Studio.Create.Can], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- toggleable chip — the ONE chip recipe (mono 11.5, pill), plus the
                       on/off and hover states a plain ToolChip border cannot carry -->
                  <Button Command="{Binding ToggleCommand}" Cursor="Hand" Margin="0,0,6,6">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Style="{StaticResource ToolChip}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}">
                          <TextBlock x:Name="Label" FontSize="13"
                                     Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" Text="{Binding Tool}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,10,0,0">
              <TextBlock DockPanel.Dock="Left" FontSize="13" Foreground="{DynamicResource InkMutedBrush}"
                         MinWidth="132" VerticalAlignment="Center"
                         Text="{Binding [Studio.Create.Scope], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource MonoText}" FontSize="13" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Text="{Binding ScopeInfo}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource MonoText}" FontSize="13" Foreground="{DynamicResource InkFaintBrush}"
                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis" Text="{Binding KeyLine}"
                       Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding SaveLabel}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Command="{Binding RemoveCommand}"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBooleanToVisibility}}">
                <TextBlock Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding [Studio.Create.Remove], Source={x:Static services:I18n.Instance}}"/>
              </Button>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ CAS D'USAGE (panneau latéral, STUDIO-39) ══════════
         The gallery comes in from the right, over the wizard it was opened from: step 1 stays in
         sight on the left, under the scrim, so the need a card fills is never out of view. A click
         on the scrim closes it, like every overlay here.
         R15 (A08): scrim and drawer start under the 52 px title bar (row 1), so the assistant
         button, the mode switch, the language menu and the window buttons stay visible and usable. -->
    <Grid Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnGalleryBackdropClick"
          Visibility="{Binding CreateTeam.Gallery.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="560" HorizontalAlignment="Right" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
              CornerRadius="18,0,0,18" DataContext="{Binding CreateTeam.Gallery}" Effect="{DynamicResource ShadowLg}">
        <views:UseCaseGalleryView/>
      </Border>
    </Grid>

    <!-- ══════════ AJOUTER UN DOSSIER AUTORISÉ (overlay — les deux écrans équipe) ══════════
         Une équipe ne déclare pas un dossier : elle associe un montage déjà déclaré dans
         Réglages › Dossiers autorisés, droits compris. Déclarer reste le geste des Réglages,
         et « Déclarer un nouveau dossier… » enchaîne sur le sélecteur, qui s'empile au-dessus
         de cet overlay — d'où l'ordre : ce Grid AVANT celui du sélecteur. -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAllowedFoldersBackdropClick"
          Visibility="{Binding AllowedFolders.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="18" DataContext="{Binding AllowedFolders}" Effect="{DynamicResource ShadowLg}">
        <StackPanel>
          <StackPanel Margin="22,20,22,0">
            <TextBlock Style="{StaticResource ModalTitle}" Text="{Binding Title}" ToolTip="{Binding Title}"
                       TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight" MaxHeight="52"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                       Margin="0,6,0,0" Text="{Binding [Studio.Settings.AllowedFoldersSub], Source={x:Static services:I18n.Instance}}"/>

            <!-- État vide : les Réglages ne déclarent encore rien. -->
            <Border Background="{DynamicResource PaperSunkBrush}" CornerRadius="11" Padding="14,13" Margin="0,14,0,0"
                    Visibility="{Binding HasRows, Converter={StaticResource InverseBooleanToVisibility}}">
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                         Text="{Binding [Studio.Settings.AllowedFoldersEmpty], Source={x:Static services:I18n.Instance}}"/>
            </Border>

            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                          Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}"
                                  Cursor="Hand" Margin="0,0,0,8">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                  CornerRadius="10" Padding="13,11">
                            <DockPanel>
                              <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="5"
                                      BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}"
                                      Background="{DynamicResource PaperSunkBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <controls:LucideIcon x:Name="Tick" Kind="check" Size="11"
                                                     Foreground="{DynamicResource AccentFgBrush}" Visibility="Collapsed"/>
                              </Border>
                              <!-- Les droits viennent des Réglages et ne se rechoisissent pas ici. One word in
                                   the pill, the full label as its tooltip (STUDIO-16): the full label ate the
                                   width and the disk path read as «C:\Users\…\orkeon\…». -->
                              <Border DockPanel.Dock="Right" Margin="12,0,0,0" ToolTip="{Binding RightsLabel}">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                                    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RightsBadge}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Border>
                              <StackPanel>
                                <!-- The name the agents use, then the tail of the entry's id (VFS-90): two
                                     /output rows are told apart here, not by squinting at a truncated path. -->
                                <TextBlock Style="{StaticResource MonoText}" FontSize="13" Foreground="{DynamicResource InkBrush}">
                                  <Run Text="{Binding VirtualPath, Mode=OneWay}"/><Run Text=" · " Foreground="{DynamicResource InkFaintBrush}"/><Run Text="{Binding ShortId, Mode=OneWay}" Foreground="{DynamicResource InkFaintBrush}"/>
                                </TextBlock>
                                <!-- The real folder, whole: wrapped rather than trimmed. -->
                                <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Text="{Binding PhysicalPath}"/>
                                <!-- Why the row cannot be picked, or that its root is shared: under the path, where
                                     a sentence has room, not beside the pill where it squeezed the path. -->
                                <TextBlock FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkFaintBrush}" Text="{Binding UnavailableNote}"
                                           Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibility}}"/>
                                <TextBlock FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkFaintBrush}" Text="{Binding SharedRootNote}"
                                           Visibility="{Binding HasSharedRootNote, Converter={StaticResource BooleanToVisibility}}"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="Row" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                              <Setter TargetName="Row" Property="Opacity" Value="0.62"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- One door, leading to the one screen that declares. -->
            <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Command="{Binding DeclareNewCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="sliders-horizontal" Size="12" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Studio.Settings.Declare], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,18" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmCommand}">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="check" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                  <TextBlock Text="{Binding [Studio.Settings.AllowedFoldersConfirm], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelCommand}"
                      Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Summary}"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ══════════ À PROPOS (overlay) ══════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnAboutBackdropClick"
          Visibility="{Binding About.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="OnSwallowClick"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="20" ClipToBounds="True" Effect="{DynamicResource ShadowLg}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- illustration plate: fixed light background, the artwork is opaque -->
          <Border Grid.Column="0" CornerRadius="20,0,0,20" ClipToBounds="True">
              <Border.Background>
                  <ImageBrush ImageSource="/Assets/kama_molecule.png" Stretch="UniformToFill"
                              AlignmentX="Center" AlignmentY="Center"/>
              </Border.Background>
          </Border>
          <StackPanel Grid.Column="1" Margin="28,26">
            <TextBlock Style="{StaticResource Eyebrow}"
                       Text="{Binding [Studio.Shell.Eyebrow], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Text="Orkeon Studio" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,8,0,0" Text="{Binding About.VersionLine}"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"
                       Text="{Binding [Studio.Shell.Line], Source={x:Static services:I18n.Instance}}"/>
            <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,16,0,0">
              <DockPanel>
                <controls:LucideIcon DockPanel.Dock="Left" Kind="info" Size="15" Foreground="{DynamicResource MarkBrush}"
                                     VerticalAlignment="Top" Margin="0,1,11,0"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                           Text="{Binding [Studio.Shell.Kama], Source={x:Static services:I18n.Instance}}"/>
              </DockPanel>
            </Border>
            <DockPanel Margin="0,20,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding About.CloseCommand}"
                      Content="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnSecondary}" Click="OnStartTourFromAbout" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Kind="circle-help" Size="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding [Studio.Common.GuidedTour], Source={x:Static services:I18n.Instance}}"/>
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ══════════ DÉMARRAGE (overlay, 5 s, clic pour passer) ══════════ -->
    <Border x:Name="Splash" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource PaperBrush}" Cursor="Hand"
            MouseLeftButtonDown="OnSplashClick"
            ToolTip="{Binding [Studio.Shell.SplashSkip], Source={x:Static services:I18n.Instance}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border CornerRadius="28" ClipToBounds="True" HorizontalAlignment="Center"
                  Effect="{DynamicResource ShadowLg}">
              <Image Source="/Assets/kama_molecule.png" Width="300"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
              <Image Source="/Assets/orkeon-studio-mark.png" Width="26" Height="26"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     VerticalAlignment="Center"/>

              <TextBlock Text="Orkeon" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                     Foreground="{DynamicResource InkBrush}" Margin="11,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" FontSize="13" Margin="11,10,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Width="220" Height="3" CornerRadius="1.5" Background="{DynamicResource LineBrush}" Margin="0,24,0,0">
          <Rectangle x:Name="SplashProgress" Height="3" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" Width="0">
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="220" Duration="0:0:5"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>
        </Border>
        <TextBlock FontSize="13" Foreground="{DynamicResource InkFaintBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Text="{Binding About.VersionLine}"/>
      </StackPanel>
    </Border>

    <!-- ══════════ GUIDED TOUR (last child = topmost) ══════════ -->
    <controls:TourOverlay x:Name="Tour" Grid.Row="0" Grid.RowSpan="3"/>
  </Grid>
</Window>
