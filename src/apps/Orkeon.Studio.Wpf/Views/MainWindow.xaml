<Window x:Class="Orkeon.Studio.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
        Title="Orkeon Studio"
        Height="820"
        Width="1180"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

  <TabControl SelectedIndex="{Binding SelectedTabIndex}">

    <TabItem Header="Configuration">
      <views:ConfigTabView DataContext="{Binding Config}" />
    </TabItem>

    <TabItem Header="Launch">
      <views:LaunchTabView DataContext="{Binding Launch}" />
    </TabItem>

  </TabControl>

</Window>
