<!-- The "Start" screen, fully restyled — the reference implementation the other screens follow.
     DataContext: ConfigTabViewModel (bound as Config in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Config"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <views:IsEqualConverter x:Key="IsEqual"/>
  </UserControl.Resources>
  <StackPanel>

    <!-- header: title + subtitle left, file actions right -->
    <DockPanel Margin="0,0,0,4">
      <StackPanel x:Name="StartActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource BtnGhost}" Command="{Binding NewCommand}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="file-plus-2" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Act_New], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnGhost}" Command="{Binding OpenCommand}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="folder-open" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Act_Open], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnGhost}" Command="{Binding LoadFromLocationCommand}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="rotate-cw" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Act_Reload], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnGhost}" Command="{Binding ValidateCommand}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Act_Validate], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="save" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
            <TextBlock Text="{Binding [Act_Save], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Start_Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Start_Sub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,6,0,22" Text="{Binding StatusMessage}"/>

    <!-- ══ Validation card: verdict + messages from the last Validate/Save ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
            Visibility="{Binding ValidationMessages.Count, Converter={StaticResource CountToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <controls:LucideIcon Kind="badge-check" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Val_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{Binding ValidationSummary}"/>
        <ItemsControl ItemsSource="{Binding ValidationMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <controls:LucideIcon Size="13" VerticalAlignment="Top" Margin="0,2,8,0">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                      <Setter Property="Kind" Value="info"/>
                      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                          <Setter Property="Kind" Value="triangle-alert"/>
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
                <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Text="{Binding Display}"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ══ Preset card ══ -->
    <Border x:Name="PresetCard" Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <controls:LucideIcon Kind="sparkles" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Preset_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="{Binding [Preset_Hint], Source={x:Static services:I18n.Instance}}"/>

        <!-- one PickRow per preset, same catalogue as `orkeon init` -->
        <ItemsControl ItemsSource="{x:Static config:PresetSelectionViewModel.Catalog}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource PickRow}" GroupName="Preset" Margin="0,0,0,7"
                           Checked="OnPresetChecked" Tag="{Binding}">
                <RadioButton.IsChecked>
                  <MultiBinding Converter="{StaticResource IsEqual}" Mode="OneWay">
                    <Binding/>
                    <Binding Path="DataContext.Presets.SelectedPreset"
                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                  </MultiBinding>
                </RadioButton.IsChecked>
                <DockPanel LastChildFill="False">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="8,0,0,0" Text="{Binding Description}"/>
                </DockPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- overrides -->
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_BaseUrl], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding Presets.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_Model], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding Presets.Model, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Lbl_ApiKey], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding Presets.ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                       Text="{Binding [ApiKey_Hint], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding Presets.ApplyCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="wand-2" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Preset_Apply], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                     Margin="12,0,0,0" Text="{Binding Presets.ErrorMessage}"
                     Visibility="{Binding Presets.ErrorMessage, Converter={StaticResource StringPresentToVisibility}}"/>
        </StackPanel>

        <!-- guidance strip (sky tint) -->
        <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="13,10" Margin="0,12,0,0"
                Visibility="{Binding Presets.Guidance.Count, Converter={StaticResource CountToVisibility}}">
          <ItemsControl ItemsSource="{Binding Presets.Guidance}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <controls:LucideIcon Kind="info" Size="13" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Text="{Binding}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Border>

    <!-- ══ Save location card ══ -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <controls:LucideIcon Kind="hard-drive" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Loc_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>

        <RadioButton Style="{StaticResource PickRow}" GroupName="Loc" Margin="0,0,0,8"
                     IsChecked="{Binding Location.IsGlobal, Mode=OneWay}" Command="{Binding Location.UseGlobalCommand}">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Eyebrow}" FontSize="9.5" VerticalAlignment="Center"
                         Text="{Binding [Loc_Default], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding [Loc_Global], Source={x:Static services:I18n.Instance}}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,3,0,0" Text="{Binding Location.GlobalPath}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,3,0,0"
                       Text="{Binding Location.GlobalPathError}"
                       Visibility="{Binding Location.GlobalPathError, Converter={StaticResource StringPresentToVisibility}}"/>
          </StackPanel>
        </RadioButton>

        <RadioButton Style="{StaticResource PickRow}" GroupName="Loc" IsChecked="{Binding Location.IsCustom, Mode=OneWay}">
          <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,7"
                       Text="{Binding [Loc_Custom], Source={x:Static services:I18n.Instance}}"/>
            <DockPanel MinWidth="520">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                      Command="{Binding Location.BrowseCommand}"
                      Content="{Binding [Btn_Browse], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" FontSize="11.5"
                       Text="{Binding Location.CustomPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!-- ══ Resolution chain card ══ -->
    <Border x:Name="ChainCard" Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <controls:LucideIcon Kind="route" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Chain_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="{Binding [Chain_Hint], Source={x:Static services:I18n.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Location.ResolutionChain}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                        Background="{DynamicResource AccentWeakBrush}" Margin="0,0,13,0">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="{Binding Order}"/>
                </Border>
                <StackPanel>
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{Binding Description}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- where a Save will actually land, so the chain above has a visible anchor -->
        <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="13,9" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="save" Size="13" Foreground="{DynamicResource AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"
                       Text="{Binding [Chain_SaveTarget], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Location.GlobalPath}"
                       Visibility="{Binding Location.IsGlobal, Converter={StaticResource BooleanToVisibility}}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Location.CustomPath}"
                       Visibility="{Binding Location.IsCustom, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
