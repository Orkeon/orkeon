<!-- The use-case gallery (STUDIO-39, D-02): the side panel the wizard's step 1 opens over the
     window. A search, the categories, how the team works, two needs of the machine (no web
     access, no third-party key) and, when the need has some, the cases close to it; then one
     card per case — title, problem, a badge for how the team works, «reference only» for the
     cases that can inspire a team but not be imported as they are (D-06). In expert mode the
     other cases also offer «Import as is» (STUDIO-41), whose banner sits above the cards.
     No fallback here (D-05): the catalogue comes from the CLI, and without it the panel shows
     the wizard's own «engine not found» card.
     DataContext: UseCaseGalleryViewModel (CreateTeam.Gallery). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.UseCaseGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <DockPanel>

    <!-- header: the title, what choosing does, and the way out -->
    <DockPanel DockPanel.Dock="Top" Margin="24,22,20,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" VerticalAlignment="Top"
              Command="{Binding CloseCommand}"
              ToolTip="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}">
        <controls:LucideIcon Kind="x" Size="14"/>
      </Button>
      <StackPanel Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="scan-search" Size="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"
                     Text="{Binding [Studio.Create.GalleryTitle], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18.5"
                   Margin="0,6,0,0" Text="{Binding [Studio.Create.GallerySub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>

    <!-- the search and the filters, once there is a catalogue to search -->
    <StackPanel DockPanel.Dock="Top" Margin="24,14,24,0"
                Visibility="{Binding HasCatalog, Converter={StaticResource BooleanToVisibility}}">
      <!-- Tag is the watermark the Input style shows while the box is empty. -->
      <TextBox Style="{StaticResource Input}"
               Tag="{Binding [Studio.Create.GallerySearch], Source={x:Static services:I18n.Instance}}"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>

      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                 Text="{Binding [Studio.Create.GalleryFilterCategory], Source={x:Static services:I18n.Instance}}"/>
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource SelectableChip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,5"
                 Text="{Binding [Studio.Create.GalleryFilterProcess], Source={x:Static services:I18n.Instance}}"/>
      <ItemsControl ItemsSource="{Binding Processes}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource SelectableChip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Margin="0,4,0,0">
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding WithoutWeb}"
                  Content="{Binding [Studio.Create.GalleryNoWeb], Source={x:Static services:I18n.Instance}}"/>
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding WithoutKeys}"
                  Content="{Binding [Studio.Create.GalleryNoKey], Source={x:Static services:I18n.Instance}}"/>
        <!-- The cases the need's suggestions found, best first — what « N close use cases »
             under the need opens the panel on. -->
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding SuggestedOnly}" Content="{Binding SuggestedFilterLabel}"
                  Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibility}}"/>
      </WrapPanel>

      <DockPanel Margin="0,6,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Command="{Binding ClearFiltersCommand}"
                Content="{Binding [Studio.Create.GalleryClearFilters], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{Binding CountLabel}"/>
      </DockPanel>
    </StackPanel>

    <!-- STUDIO-41: « Import as is » — the name already taken (D-05: what holds it, the free name,
         the way to the team holding it), the import under way, its failure, or the team it made
         with the adoption's line and the Import screen's report on the folders. Above the cards,
         so it stays in view however far the list is scrolled. -->
    <Border DockPanel.Dock="Top" Margin="24,12,24,0" CornerRadius="10" Padding="12,10"
            DataContext="{Binding Import}"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" VerticalAlignment="Top" Margin="8,0,0,0"
                Command="{Binding DismissCommand}"
                ToolTip="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}">
          <controls:LucideIcon Kind="x" Size="12"/>
        </Button>
        <StackPanel>
          <StackPanel Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding Conflict}"/>
            <WrapPanel Margin="0,8,0,0">
              <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                      Command="{Binding UseFreeNameCommand}" Content="{Binding UseFreeNameLabel}"/>
              <Button Style="{StaticResource BtnGhost}"
                      Command="{Binding OpenConflictingTeamCommand}"
                      Visibility="{Binding CanOpenConflictingTeam, Converter={StaticResource BooleanToVisibility}}"
                      Content="{Binding [Studio.Create.OpenExistingTeam], Source={x:Static services:I18n.Instance}}"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibility}}">
            <controls:LucideIcon Kind="loader-circle" Size="13" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ImportingLabel}"/>
          </StackPanel>
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding Failure}"
                     Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}"/>
          <StackPanel Visibility="{Binding HasImported, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="circle-check" Size="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                         Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ImportedLine}"/>
            </StackPanel>
            <!-- One line of markup: the whitespace between inlines would render as a space. -->
            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="22,4,0,0">
              <Run FontWeight="SemiBold" Text="{Binding FoldersReport.Title, Mode=OneWay}"/><LineBreak/><Run Text="{Binding FoldersReport.Detail, Mode=OneWay}"/>
            </TextBlock>
            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="22,8,0,0"
                    Command="{Binding OpenTeamsCommand}"
                    Content="{Binding [Studio.Create.GalleryOpenTeams], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- reading the catalogue: a line, no spinner — the read takes a moment, not a wait -->
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="24,16,24,0"
               Text="{Binding [Studio.Create.GalleryLoading], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- D-05: no catalogue, no fallback — the wizard's « engine not found » card (STUDIO-13's
         three zones: the novice sentence, the CLI's own words in mono, the ways out). -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
            BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="24,16,24,0"
            Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="circle-x" Size="16" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
          <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0"
                     TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Failure.Headline}"/>
        </StackPanel>
        <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="9" Padding="10,8" Margin="0,10,0,0" MaxHeight="180"
                Visibility="{Binding Failure.HasDetail, Converter={StaticResource BooleanToVisibility}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource ConsoleFgBrush}" Text="{Binding Failure.Detail}"/>
          </ScrollViewer>
        </Border>
        <WrapPanel Margin="0,12,0,0">
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding RetryCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="rotate-cw" Size="12" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Create.FailureRetry], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding OpenDiagnosticCommand}"
                  Visibility="{Binding FailureOffersDiagnostic, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="stethoscope" Size="12" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Create.FailureOpenDiagnostic], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- nothing kept: say so, and the way back -->
    <StackPanel DockPanel.Dock="Top" Margin="24,18,24,0"
                Visibility="{Binding HasNoMatch, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Style="{StaticResource Hint}" FontSize="12"
                 Text="{Binding [Studio.Create.GalleryEmpty], Source={x:Static services:I18n.Instance}}"/>
      <Button Style="{StaticResource ChipAction}" HorizontalAlignment="Left" Margin="0,8,0,0"
              Command="{Binding ClearFiltersCommand}"
              Content="{Binding [Studio.Create.GalleryClearFilters], Source={x:Static services:I18n.Instance}}"/>
    </StackPanel>

    <!-- the cards -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="24,0,24,20"
                  Visibility="{Binding HasCards, Converter={StaticResource BooleanToVisibility}}">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                  <Button Style="{StaticResource ChipAction}"
                          Command="{Binding ChooseCommand}"
                          Content="{Binding [Studio.Create.GalleryChoose], Source={x:Static services:I18n.Instance}}"/>
                  <!-- STUDIO-41 (D-01, D-03): the expert's shortcut — the case as a team of My
                       teams, ready to run and to modify; never on a reference-only case. -->
                  <Button Style="{StaticResource ChipAction}" Margin="0,6,0,0"
                          Command="{Binding ImportAsIsCommand}"
                          ToolTip="{Binding [Studio.Create.GalleryImportAsIsTip], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding CanImportAsIs, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="arrow-down" Size="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding [Studio.Create.GalleryImportAsIs], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                             Text="{Binding Title}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" LineHeight="18"
                             Margin="0,4,0,0" Text="{Binding Problem}"
                             Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibility}}"/>
                  <WrapPanel Margin="0,9,0,0">
                    <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,6,4">
                      <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ProcessLabel}"/>
                    </Border>
                    <Border Style="{StaticResource BadgeSky}" Margin="0,0,6,4">
                      <TextBlock Style="{StaticResource BadgeText}" Text="{Binding CategoryLabel}"/>
                    </Border>
                    <Border Style="{StaticResource BadgeWarn}" Margin="0,0,6,4"
                            ToolTip="{Binding [Studio.Create.GalleryReferenceOnlyTip], Source={x:Static services:I18n.Instance}}"
                            Visibility="{Binding IsReferenceOnly, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock Style="{StaticResource BadgeText}"
                                 Text="{Binding [Studio.Create.GalleryReferenceOnly], Source={x:Static services:I18n.Instance}}"/>
                    </Border>
                    <!-- expert: the id STUDIO-40 hands the engine, and the process as the engine spells it -->
                    <TextBlock Style="{StaticResource MonoText}" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,4"
                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                      <Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Process, Mode=OneWay}"/>
                    </TextBlock>
                  </WrapPanel>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
