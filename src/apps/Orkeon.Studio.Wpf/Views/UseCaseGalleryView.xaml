<!-- The use-case gallery (STUDIO-39, D-02): the side panel the wizard's step 1 opens over the
     window. A search, the categories, how the team works, two needs of the machine (no web
     access, no third-party key) and, when the need has some, the cases close to it; then one
     card per case — title, problem, a badge for how the team works, «reference only» for the
     cases that can inspire a team but not be imported as they are (D-06). In expert mode the
     other cases also offer «Import as is» (STUDIO-41), whose banner sits above the cards.
     No fallback here (D-05): the catalogue comes from the CLI, and without it the panel shows
     the wizard's own «engine not found» card.
     DataContext: UseCaseGalleryViewModel (CreateTeam.Gallery). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.UseCaseGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <DockPanel>

    <!-- header: the title, what choosing does, and the way out -->
    <DockPanel DockPanel.Dock="Top" Margin="24,22,20,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" VerticalAlignment="Top"
              Command="{Binding CloseCommand}" controls:ButtonIcon.Kind="x"
              ToolTip="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"
              AutomationProperties.Name="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"/>
      <StackPanel Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="scan-search" Size="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <!-- R11: the drawer title is the modal title, 20/600 in the UI font (display is for page titles) -->
          <TextBlock Style="{StaticResource ModalTitle}" Margin="10,0,0,0" VerticalAlignment="Center"
                     Text="{Binding [Studio.Create.GalleryTitle], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource SubTitle}" LineHeight="21"
                   Margin="0,6,0,0" Text="{Binding [Studio.Create.GallerySub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>

    <!-- the search and the filters, once there is a catalogue to search -->
    <StackPanel DockPanel.Dock="Top" Margin="24,14,24,0"
                Visibility="{Binding HasCatalog, Converter={StaticResource BooleanToVisibility}}">
      <!-- Tag is the watermark the Input style shows while the box is empty. -->
      <TextBox Style="{StaticResource Input}"
               Tag="{Binding [Studio.Create.GallerySearch], Source={x:Static services:I18n.Instance}}"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>

      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                 Text="{Binding [Studio.Create.GalleryFilterCategory], Source={x:Static services:I18n.Instance}}"/>
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource SelectableChip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,5"
                 Text="{Binding [Studio.Create.GalleryFilterProcess], Source={x:Static services:I18n.Instance}}"/>
      <ItemsControl ItemsSource="{Binding Processes}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource SelectableChip}" Command="{Binding SelectCommand}" Content="{Binding Label}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Margin="0,4,0,0">
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding WithoutWeb}"
                  Content="{Binding [Studio.Create.GalleryNoWeb], Source={x:Static services:I18n.Instance}}"/>
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding WithoutKeys}"
                  Content="{Binding [Studio.Create.GalleryNoKey], Source={x:Static services:I18n.Instance}}"/>
        <!-- The cases the need's suggestions found, best first — what « N close use cases »
             under the need opens the panel on. -->
        <CheckBox Margin="0,0,16,6" IsChecked="{Binding SuggestedOnly}" Content="{Binding SuggestedFilterLabel}"
                  Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibility}}"/>
      </WrapPanel>

      <DockPanel Margin="0,6,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding ClearFiltersCommand}"
                Content="{Binding [Studio.Create.GalleryClearFilters], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource MetaText}" VerticalAlignment="Center" Text="{Binding CountLabel}"/>
      </DockPanel>
    </StackPanel>

    <!-- STUDIO-41: « Import as is » — the name already taken (D-05: what holds it, the free name,
         the way to the team holding it), the import under way, its failure, or the team it made
         with the adoption's line and the Import screen's report on the folders. Above the cards,
         so it stays in view however far the list is scrolled. R07: one shared Alert per state,
         in its tone — the name taken (warning), the import under way (info), its failure
         (danger), the team made (success); each carries the dismissal after its own buttons. -->
    <StackPanel DockPanel.Dock="Top" Margin="24,12,24,0" DataContext="{Binding Import}"
                Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibility}}">
      <controls:Alert Tone="Warning" Message="{Binding Conflict}"
                      Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibility}}">
        <controls:Alert.Actions>
          <WrapPanel>
            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,8"
                    Command="{Binding UseFreeNameCommand}" Content="{Binding UseFreeNameLabel}"/>
            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,8"
                    Command="{Binding OpenConflictingTeamCommand}"
                    Visibility="{Binding CanOpenConflictingTeam, Converter={StaticResource BooleanToVisibility}}"
                    Content="{Binding [Studio.Create.OpenExistingTeam], Source={x:Static services:I18n.Instance}}"/>
            <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Margin="0,0,0,8" controls:ButtonIcon.Kind="x"
                    Command="{Binding DismissCommand}"
                    Content="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"/>
          </WrapPanel>
        </controls:Alert.Actions>
      </controls:Alert>
      <controls:Alert Tone="Info" Message="{Binding ImportingLabel}"
                      Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibility}}">
        <controls:Alert.Actions>
          <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="x"
                  Command="{Binding DismissCommand}"
                  Content="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"/>
        </controls:Alert.Actions>
      </controls:Alert>
      <controls:Alert Tone="Danger" Message="{Binding Failure}"
                      Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}">
        <controls:Alert.Actions>
          <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="x"
                  Command="{Binding DismissCommand}"
                  Content="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"/>
        </controls:Alert.Actions>
      </controls:Alert>
      <controls:Alert Tone="Success" Message="{Binding ImportedLine}"
                      Visibility="{Binding HasImported, Converter={StaticResource BooleanToVisibility}}">
        <!-- One line of markup: the whitespace between inlines would render as a space. -->
        <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource InkMutedBrush}">
          <Run FontWeight="SemiBold" Text="{Binding FoldersReport.Title, Mode=OneWay}"/><LineBreak/><Run Text="{Binding FoldersReport.Detail, Mode=OneWay}"/>
        </TextBlock>
        <controls:Alert.Actions>
          <StackPanel Style="{StaticResource ActionRow}">
            <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0"
                    Command="{Binding OpenTeamsCommand}"
                    Content="{Binding [Studio.Create.GalleryOpenTeams], Source={x:Static services:I18n.Instance}}"/>
            <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" controls:ButtonIcon.Kind="x"
                    Command="{Binding DismissCommand}"
                    Content="{Binding [Studio.Create.GalleryClose], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </controls:Alert.Actions>
      </controls:Alert>
    </StackPanel>

    <!-- reading the catalogue: a line, no spinner — the read takes a moment, not a wait.
         R17: the line, then the shared grey skeleton, never a coloured block. -->
    <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Style="{StaticResource MetaText}" Text="{Binding [Studio.Create.GalleryLoading], Source={x:Static services:I18n.Instance}}"/>
      <controls:SkeletonLines Margin="0,12,0,0"/>
    </StackPanel>

    <!-- D-05: no catalogue, no fallback — a danger alert (R7, lot 3): the novice sentence
         (« The Orkeon engine cannot be found on this machine »), the CLI's own words folded
         under « Technical details », the ways out. C02 (R07): the shared Alert, its buttons in
         its Actions slot — the drawer is 560 px (< 720), so they sit under the text. -->
    <controls:Alert DockPanel.Dock="Top" Tone="Danger" Margin="24,16,24,0"
                    Message="{Binding Failure.Headline}" Details="{Binding Failure.Detail}"
                    Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}">
      <controls:Alert.Actions>
        <WrapPanel>
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding RetryCommand}"
                  controls:ButtonIcon.Kind="rotate-cw"
                  Content="{Binding [Studio.Create.FailureRetry], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding OpenDiagnosticCommand}"
                  controls:ButtonIcon.Kind="stethoscope"
                  Content="{Binding [Studio.Create.FailureOpenDiagnostic], Source={x:Static services:I18n.Instance}}"
                  Visibility="{Binding FailureOffersDiagnostic, Converter={StaticResource BooleanToVisibility}}"/>
        </WrapPanel>
      </controls:Alert.Actions>
    </controls:Alert>

    <!-- nothing kept: say so, and the way back (R17: the shared empty state) -->
    <controls:EmptyState DockPanel.Dock="Top" Margin="24,18,24,0" Icon="search"
                         Title="{Binding [Studio.Create.GalleryEmpty], Source={x:Static services:I18n.Instance}}"
                         Visibility="{Binding HasNoMatch, Converter={StaticResource BooleanToVisibility}}">
      <controls:EmptyState.Actions>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                Command="{Binding ClearFiltersCommand}"
                Content="{Binding [Studio.Create.GalleryClearFilters], Source={x:Static services:I18n.Instance}}"/>
      </controls:EmptyState.Actions>
    </controls:EmptyState>

    <!-- the cards -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="24,0,24,20"
                  Visibility="{Binding HasCards, Converter={StaticResource BooleanToVisibility}}">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
              <!-- C21 (R15): the actions sit in a fixed 160 px column on the right, so both
                   buttons have the same width on every card whatever their label or the text
                   beside them. R05: «Start from this case» is the card's one primary — the
                   action every mode offers; «Import as is» is its secondary. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                  <!-- R09: a label longer than the column (de) ends in «…», the tooltip gives it whole. -->
                  <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" HorizontalAlignment="Stretch"
                          Command="{Binding ChooseCommand}"
                          ToolTip="{Binding [Studio.Create.GalleryChoose], Source={x:Static services:I18n.Instance}}">
                    <TextBlock TextTrimming="CharacterEllipsis"
                               Text="{Binding [Studio.Create.GalleryChoose], Source={x:Static services:I18n.Instance}}"/>
                  </Button>
                  <!-- STUDIO-41 (D-01, D-03): the expert's shortcut — the case as a team of My
                       teams, ready to run and to modify; never on a reference-only case. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                          Command="{Binding ImportAsIsCommand}" controls:ButtonIcon.Kind="arrow-down"
                          ToolTip="{Binding [Studio.Create.GalleryImportAsIsTip], Source={x:Static services:I18n.Instance}}"
                          Visibility="{Binding CanImportAsIs, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock TextTrimming="CharacterEllipsis"
                               Text="{Binding [Studio.Create.GalleryImportAsIs], Source={x:Static services:I18n.Instance}}"/>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <!-- R11: card title 16/600, the problem as body text; both wrap, never cut (R09) -->
                  <TextBlock Style="{StaticResource CardTitle}" TextWrapping="Wrap" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource InkMutedBrush}"
                             Margin="0,4,0,0" Text="{Binding Problem}"
                             Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibility}}"/>
                  <!-- D09 (R12, R20): the shared Badge — its tinted ground is kept in the dark
                       theme, so the domain tag never turns into bare text. -->
                  <WrapPanel Margin="0,9,0,0">
                    <controls:Badge Tone="Neutral" Margin="0,0,6,4" Content="{Binding ProcessLabel}"/>
                    <controls:Badge Tone="Info" Margin="0,0,6,4" Content="{Binding CategoryLabel}"/>
                    <controls:Badge Tone="Warning" Margin="0,0,6,4"
                                    ToolTip="{Binding [Studio.Create.GalleryReferenceOnlyTip], Source={x:Static services:I18n.Instance}}"
                                    Visibility="{Binding IsReferenceOnly, Converter={StaticResource BooleanToVisibility}}"
                                    Content="{Binding [Studio.Create.GalleryReferenceOnly], Source={x:Static services:I18n.Instance}}"/>
                    <!-- expert: the id STUDIO-40 hands the engine, and the process as the engine spells it -->
                    <TextBlock Style="{StaticResource MonoText}" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,4"
                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                      <Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Process, Mode=OneWay}"/>
                    </TextBlock>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
