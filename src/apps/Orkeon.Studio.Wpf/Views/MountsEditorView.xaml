<UserControl x:Class="Orkeon.Studio.Wpf.Views.MountsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mounts="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Mounts">

  <!-- The §4.5 mount form. The same control serves the appsettings editor and the launcher; only the
       destination of ToRawEntries() differs, so nothing here knows which tab it is in. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{Binding Summary}" />

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button Content="Add" Command="{Binding AddMountCommand}" Width="70" Margin="0,0,6,0" />
        <Button Content="Remove" Command="{Binding RemoveMountCommand}" Width="70" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Mounts}"
               SelectedItem="{Binding SelectedMount}"
               DisplayMemberPath="Display"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling" />
    </DockPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel DataContext="{Binding SelectedMount}">

        <TextBlock Style="{StaticResource Hint}"
                   Visibility="{Binding IsParsed, Converter={StaticResource InverseBooleanToVisibility}}"
                   Text="This entry could not be parsed. It is kept exactly as written so nothing is lost, and reported below." />

        <TextBox Text="{Binding RawText, Mode=OneWay}"
                 IsReadOnly="True"
                 Visibility="{Binding IsParsed, Converter={StaticResource InverseBooleanToVisibility}}" />

        <StackPanel Visibility="{Binding IsParsed, Converter={StaticResource BooleanToVisibility}}">

          <TextBlock Style="{StaticResource FieldLabel}" Text="Physical path (on this machine)" />
          <DockPanel Margin="{StaticResource FieldMargin}">
            <Button DockPanel.Dock="Right"
                    Content="Browse…"
                    Width="90"
                    Margin="6,0,0,0"
                    Command="{Binding DataContext.BrowsePhysicalPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Button DockPanel.Dock="Right"
                    Content="Create folder"
                    Width="110"
                    Margin="6,0,0,0"
                    Command="{Binding DataContext.CreatePhysicalFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBox Text="{Binding PhysicalPath, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Virtual path (what the agents see)" />
          <ComboBox Margin="{StaticResource FieldMargin}"
                    IsEditable="True"
                    ItemsSource="{x:Static mounts:MountEditorViewModel.SuggestedVirtualPaths}"
                    Text="{Binding VirtualPath, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Hint}"
                     Text="Must start with '/' or be a Windows drive path."
                     Visibility="{Binding IsVirtualPathValid, Converter={StaticResource InverseBooleanToVisibility}}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Rights" />
          <ComboBox Margin="{StaticResource FieldMargin}"
                    ItemsSource="{x:Static mounts:MountEditorViewModel.RightsChoices}"
                    SelectedValue="{Binding Rights}"
                    SelectedValuePath="Rights"
                    DisplayMemberPath="Label" />

          <TextBlock Style="{StaticResource CardTitle}" Text="Sub-path rights overrides" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Overrides}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="{StaticResource FieldMargin}">
                  <Button DockPanel.Dock="Right"
                          Content="Remove"
                          Width="70"
                          Margin="6,0,0,0"
                          Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <ComboBox DockPanel.Dock="Right"
                            Width="220"
                            Margin="6,0,0,0"
                            ItemsSource="{x:Static mounts:SubPathOverrideViewModel.RightsChoices}"
                            SelectedValue="{Binding Rights}"
                            SelectedValuePath="Rights"
                            DisplayMemberPath="Label" />
                  <TextBox Text="{Binding RelativePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Add override"
                  Width="120"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  Command="{Binding DataContext.AddOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
