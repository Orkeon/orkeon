<!-- The §4.5 mount form, restyled as a two-pane card. The same control serves the appsettings
     editor and the launcher; only the destination of ToRawEntries() differs, so nothing here
     knows which screen it is in (and it carries no H1 — the host provides the screen header). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.MountsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mounts="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Mounts"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">

  <Border Style="{StaticResource Card}">
    <DockPanel>
      <!-- live verdict: the ViewModel revalidates on every edit -->
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{Binding Summary}"/>
      <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                    Visibility="{Binding GeneralMessages.Count, Converter={StaticResource CountToVisibility}}">
        <ItemsControl ItemsSource="{Binding GeneralMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,1" Text="{Binding FriendlyText}" ToolTip="{Binding Display}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- left pane: mount list + add/remove -->
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Style="{StaticResource BtnSecondary}" Command="{Binding AddMountCommand}" Margin="0,0,8,0"
                  controls:ButtonIcon.Kind="plus"
                  Content="{Binding [Studio.Settings.Add], Source={x:Static services:I18n.Instance}}"/>
          <!-- C01 (R06): a removal from the list holds only until «Save», so it is the neutral
               secondary with ×, never the danger outline. -->
          <Button Style="{StaticResource BtnSecondary}" Command="{Binding RemoveMountCommand}"
                  controls:ButtonIcon.Kind="x"
                  Content="{Binding [Studio.Settings.MountsRemove], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>

        <!-- R17: an empty list says so with the shared empty state. -->
        <controls:EmptyState DockPanel.Dock="Top" IsCompact="True" Icon="folder"
                             Title="{Binding [Studio.Settings.MountsEmptyTitle], Source={x:Static services:I18n.Instance}}"
                             Text="{Binding [Studio.Settings.MountsEmptyText], Source={x:Static services:I18n.Instance}}"
                             Visibility="{Binding Mounts.Count, Converter={StaticResource ZeroToVisibility}}"/>
        <ListBox ItemsSource="{Binding Mounts}" SelectedItem="{Binding SelectedMount}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="9" Padding="10,8" Margin="0,0,0,4"
                            BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- The name FIRST, docked left, the badge LAST as the fill child (STUDIO-16, D-05).
                   The other order stretched the selected row of snap_13: a badge measured first
                   with the 52-character label had its DesiredSize clamped to the whole row
                   (FrameworkElement.MeasureCore: the parent wins when over-constrained), the
                   name was then measured at width 0 and — TextWrapping=Wrap inherited from
                   MonoText — broke «/output» into seven one-character lines, one row seven
                   lines tall with the badge floating in its middle and no name at all. -->
              <StackPanel>
              <DockPanel LastChildFill="True">
                <!-- an unparseable entry keeps its raw text visible instead of a blank, healthy-looking row -->
                <!-- B06 (R09): a path is cut in the middle, the whole of it in the tooltip. -->
                <controls:MiddleEllipsisText DockPanel.Dock="Left">
                  <controls:MiddleEllipsisText.Style>
                    <Style TargetType="{x:Type controls:MiddleEllipsisText}" BasedOn="{StaticResource PathText}">
                      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                      <Setter Property="Text" Value="{Binding VirtualPath, Mode=OneWay}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParsed}" Value="False">
                          <Setter Property="Text" Value="{Binding RawText, Mode=OneWay}"/>
                          <Setter Property="Foreground" Value="{DynamicResource WarningInkBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:MiddleEllipsisText.Style>
                </controls:MiddleEllipsisText>
                <!-- Bounded, the full label in the tooltip: the name never shrinks. C13 (R12): the
                     shared rights pill, «Read only» neutral, every writing right sky. -->
                <Border Margin="6,0,0,0" MaxWidth="160"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="{Binding RightsLabel, Mode=OneWay}"
                        Visibility="{Binding IsParsed, Converter={StaticResource BooleanToVisibility}}">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSky}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Rights}" Value="ReadOnly">
                          <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                          <Setter Property="TextElement.Foreground" Value="{DynamicResource InkMutedBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             Text="{Binding RightsBadge, Mode=OneWay}"/>
                </Border>
              </DockPanel>
              <!-- Lot 5: the row's own finding, on the faulty line (icon + text). -->
              <DockPanel Margin="0,4,0,0" DataContext="{Binding RowProblem}"
                         Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <controls:LucideIcon DockPanel.Dock="Left" Size="12" Margin="0,2,6,0" VerticalAlignment="Top">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon">
                      <Setter Property="Kind" Value="triangle-alert"/>
                      <Setter Property="Foreground" Value="{DynamicResource WarningIconBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                          <Setter Property="Kind" Value="ban"/>
                          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
                <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding FriendlyText}" ToolTip="{Binding Display}"
                           Foreground="{DynamicResource InkMutedBrush}"/>
              </DockPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- T-30: the separator and the form appear WITH a selection, not before one. An
           editor standing open over nothing invites the reading that something is wrong
           with a screen the user has not touched yet. -->
      <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource LineFaintBrush}" HorizontalAlignment="Center"
                 Visibility="{Binding SelectedMount, Converter={StaticResource NullToVisibility}}"/>

      <!-- right pane: editor for the selected mount -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedMount, Converter={StaticResource NullToVisibility}}">
        <StackPanel DataContext="{Binding SelectedMount}">

          <!-- VFS-90: the entry's identity, read-only, with a copy button and the teams naming it. -->
          <DockPanel Margin="0,0,0,7" Visibility="{Binding IsParsed, Converter={StaticResource BooleanToVisibility}}">
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource IconBtnGhost}" controls:ButtonIcon.Kind="copy"
                    ToolTip="{Binding [Studio.Settings.CopyId], Source={x:Static services:I18n.Instance}}"
                    AutomationProperties.Name="{Binding [Studio.Settings.CopyId], Source={x:Static services:I18n.Instance}}"
                    Command="{Binding CopyIdCommand}"/>
            <StackPanel>
              <TextBlock Style="{StaticResource MonoText}" FontSize="13" Foreground="{DynamicResource InkFaintBrush}"
                         Text="{Binding IdDisplay, Mode=OneWay}"/>
              <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{Binding UsedByDisplay, Mode=OneWay}"
                         Visibility="{Binding IsReferenced, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
          </DockPanel>

          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,7"
                     Visibility="{Binding IsParsed, Converter={StaticResource InverseBooleanToVisibility}}"
                     Text="{Binding [Studio.Settings.Unparsed], Source={x:Static services:I18n.Instance}}"/>
          <TextBox Style="{StaticResource InputMono}" Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True"
                   Visibility="{Binding IsParsed, Converter={StaticResource InverseBooleanToVisibility}}"/>

          <StackPanel Visibility="{Binding IsParsed, Converter={StaticResource BooleanToVisibility}}">

            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Studio.Settings.LblPhysical], Source={x:Static services:I18n.Instance}}"/>
            <!-- B06 (R09): the path takes the whole column (it was cut at ~290 px beside its two
                 buttons), its full value in the tooltip; the buttons, same order, go under it. -->
            <TextBox Style="{StaticResource InputMono}" Text="{Binding PhysicalPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding PhysicalPath, Mode=OneWay}" ToolTipService.ShowOnDisabled="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0"
                      Command="{Binding DataContext.CreatePhysicalFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Content="{Binding [Studio.Settings.CreateFolder], Source={x:Static services:I18n.Instance}}"/>
              <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32"
                      Command="{Binding DataContext.BrowsePhysicalPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Content="{Binding [Studio.Common.Browse], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="{Binding [Studio.Settings.LblVirtual], Source={x:Static services:I18n.Instance}}"/>
            <TextBox Style="{StaticResource InputMono}" Text="{Binding VirtualPath, UpdateSourceTrigger=PropertyChanged}"/>
            <ItemsControl ItemsSource="{x:Static mounts:MountEditorViewModel.SuggestedVirtualPaths}" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,6,0"
                          FontFamily="{StaticResource MonoFont}" Tag="{Binding}" Click="OnSuggestVirtualPath"
                          Content="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0"
                       Text="{Binding [Studio.Settings.VirtualInvalid], Source={x:Static services:I18n.Instance}}"
                       Visibility="{Binding IsVirtualPathValid, Converter={StaticResource InverseBooleanToVisibility}}"/>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="{Binding [Studio.Settings.LblRights], Source={x:Static services:I18n.Instance}}"/>
            <!-- C09 (R10): «Rights» is the L combo, the whole column, whatever option is chosen. -->
            <ComboBox Style="{StaticResource ComboL}"
                      ItemsSource="{Binding RightsChoices}"
                      SelectedValue="{Binding Rights}" SelectedValuePath="Rights" DisplayMemberPath="Label"/>

            <TextBlock Style="{StaticResource Subhead}" Margin="0,16,0,7"
                       Text="{Binding [Studio.Settings.OverridesTitle], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Overrides}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,7">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="8,0,0,0"
                            Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" controls:ButtonIcon.Kind="x"
                            ToolTip="{Binding [Studio.Settings.MountsRemove], Source={x:Static services:I18n.Instance}}"
                            AutomationProperties.Name="{Binding [Studio.Settings.MountsRemove], Source={x:Static services:I18n.Instance}}"/>
                    <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboM}" Margin="8,0,0,0"
                              ItemsSource="{Binding RightsChoices}"
                              SelectedValue="{Binding Rights}" SelectedValuePath="Rights" DisplayMemberPath="Label"/>
                    <TextBox Style="{StaticResource InputMono}" Text="{Binding RelativePath, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"
                    Command="{Binding DataContext.AddOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    controls:ButtonIcon.Kind="plus"
                    Content="{Binding [Studio.Settings.AddOverride], Source={x:Static services:I18n.Instance}}"/>

            <!-- mount-string preview: exactly what lands in appsettings / on the command line -->
            <TextBlock Style="{StaticResource Eyebrow}" Margin="0,16,0,6"
                       Text="{Binding [Studio.Settings.Preview], Source={x:Static services:I18n.Instance}}"/>
            <Border Style="{StaticResource Well}">
              <TextBlock Style="{StaticResource MonoText}" FontSize="13" TextWrapping="Wrap"
                         Text="{Binding MountString, Mode=OneWay}"/>
            </Border>

          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </DockPanel>
  </Border>

</UserControl>
