<!-- The per-step "consigne + questions" block (design v3 StepNotes): the field IS the
     consigne, and the collapsible thread is a small conversation with the assistant.
     DataContext: StepNotesViewModel. The Title dependency property names the step. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.StepNotesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <controls:LucideIcon Kind="pencil" Size="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="10,0,0,0"
                   Text="{Binding Title, ElementName=Root}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,12"
                 Text="{Binding [Notes_Sub], Source={x:Static services:I18n.Instance}}"/>

      <!-- the field IS the consigne: typed text is taken as-is, no add step, no list -->
      <TextBox Style="{StaticResource Input}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto"
               Text="{Binding Consigne, UpdateSourceTrigger=PropertyChanged}"/>
      <DockPanel Margin="0,8,0,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding HasConsigne, Converter={StaticResource BooleanToVisibility}}">
          <controls:LucideIcon Kind="circle-check" Size="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource Hint}" Margin="5,0,0,0" VerticalAlignment="Center"
                     Text="{Binding [Notes_Taken], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding ToggleThreadCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="circle-help" Size="13" Margin="0,0,6,0" Foreground="{DynamicResource MarkBrush}"/>
            <TextBlock Text="{Binding [Notes_Ask_Toggle], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
      </DockPanel>

      <!-- questions = a small chat with the assistant; answers change nothing by themselves -->
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12"
              Background="{DynamicResource SkyBrush}" Margin="0,12,0,0"
              Visibility="{Binding IsThreadOpen, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <DockPanel Margin="13,9">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="11" Command="{Binding ClearCommand}"
                    Content="{Binding [Notes_Clear], Source={x:Static services:I18n.Instance}}"/>
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="wand-2" Size="13" Foreground="{DynamicResource MarkBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0"
                         VerticalAlignment="Center" Text="{Binding [Notes_Ask_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource InkFaintBrush}" Margin="7,0,0,0" VerticalAlignment="Center"
                         Text="{Binding [Notes_Ask_Hint], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </DockPanel>
          <Border Height="1" Background="{DynamicResource LineBrush}"/>
          <ScrollViewer MaxHeight="216" VerticalScrollBarVisibility="Auto" Padding="13,12"
                        Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="12,12,3,12" Padding="12,8"
                            HorizontalAlignment="Right" MaxWidth="440">
                      <TextBlock FontSize="12.5" Foreground="{DynamicResource AccentFgBrush}" TextWrapping="Wrap"
                                 Text="{Binding Question}"/>
                    </Border>
                    <DockPanel Margin="0,7,0,0"
                               Visibility="{Binding HasAnswer, Converter={StaticResource BooleanToVisibility}}">
                      <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="999" VerticalAlignment="Top"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="1" Margin="0,2,8,0">
                        <controls:LucideIcon Kind="wand-2" Size="11" Foreground="{DynamicResource MarkBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="1" CornerRadius="3,12,12,12" Padding="12,8" HorizontalAlignment="Left" MaxWidth="470">
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" LineHeight="19"
                                   Text="{Binding Answer}"/>
                      </Border>
                    </DockPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Height="1" Background="{DynamicResource LineBrush}"/>
          <DockPanel Margin="13,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding AskCommand}">
              <controls:LucideIcon Kind="arrow-right" Size="14" Foreground="{DynamicResource AccentFgBrush}"/>
            </Button>
            <TextBox Style="{StaticResource Input}" Text="{Binding QuestionDraft, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AskCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
