<!-- The per-step consigne block (30/08 mock, StepNotes.dc.html). The field IS the consigne:
     typed text is taken as it stands, no add step, no list. The local mini-chat that used to
     live under it is GONE — questions belong to the one conversation, which keeps its history
     across screens instead of starting over in every step. What is left is the field, the
     confirmation, and a count of the messages that conversation holds.
     DataContext: StepNotesViewModel. The Title dependency property names the step. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.StepNotesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <controls:LucideIcon Kind="pencil" Size="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="10,0,0,0"
                   Text="{Binding Title, ElementName=Root}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,12"
                 Text="{Binding [Notes_Sub], Source={x:Static services:I18n.Instance}}"/>

      <!-- the field IS the consigne: typed text is taken as-is, no add step, no list -->
      <TextBox Style="{StaticResource Input}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto"
               Text="{Binding Consigne, UpdateSourceTrigger=PropertyChanged}"/>
      <DockPanel Margin="0,8,0,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding HasConsigne, Converter={StaticResource BooleanToVisibility}}">
          <controls:LucideIcon Kind="circle-check" Size="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource Hint}" Margin="5,0,0,0" VerticalAlignment="Center"
                     Text="{Binding [Notes_Taken], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoText}" FontSize="10"
                   VerticalAlignment="Center" Foreground="{DynamicResource InkFaintBrush}"
                   Text="{Binding MessageCount}"
                   Visibility="{Binding MessageCount, Converter={StaticResource StringPresentToVisibility}}"/>
      </DockPanel>

    </StackPanel>
  </Border>
</UserControl>
