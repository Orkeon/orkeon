<!-- "Mes équipes" (design v3): every adopted team is an autonomous folder — copiable,
     shareable, deletable — plus the wizard sessions still underway, resumable.
     DataContext: TeamsViewModel (bound as Teams in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <DockPanel Margin="0,0,0,22">
      <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top"
              Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
          <TextBlock Text="{Binding [Teams_Create], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Teams_Title], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Scr_Teams_Sub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>

    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,-14,0,10" Text="{Binding StatusMessage}"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <TextBlock Style="{StaticResource Hint}"
               Text="{Binding [Teams_Empty], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"/>

    <ItemsControl ItemsSource="{Binding Teams}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top"
                      Background="{DynamicResource AccentWeakBrush}" Margin="0,0,14,0">
                <controls:LucideIcon Kind="brain-circuit" Size="16" Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding LaunchCommand}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="play" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                    <TextBlock Text="{Binding [Teams_Launch], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <!-- «Modifier» took «Ouvrir»'s visible seat (amended mock, W-09):
                     it reopens the wizard at step 2 on this team. Disabled — with the
                     reason — when no forge session points here (imported team). -->
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding ModifyCommand}"
                        ToolTipService.ShowOnDisabled="True">
                  <Button.ToolTip>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding [Teams_Modify_Tip], Source={x:Static services:I18n.Instance}}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanModify}" Value="False">
                              <Setter Property="Text" Value="{Binding [Teams_Modify_NoSession], Source={x:Static services:I18n.Instance}}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="pencil" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Teams_Modify], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <Button Style="{StaticResource IconBtn}" Command="{Binding OpenCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Teams_Open], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="folder-open" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding TestCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Teams_Test], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="badge-check" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding DuplicateCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Teams_Duplicate], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="copy" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding ExportCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Teams_Export], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="save" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding DeleteCommand}"
                          ToolTip="{Binding [Teams_Delete], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="trash-2" Size="13" Foreground="{DynamicResource DangerBrush}"/>
                  </Button>
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                             MaxWidth="380" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Text="{Binding Name}"/>
                  <Border Margin="10,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                            <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                            <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding BadgeText}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="10,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Slug}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibility}}"/>
                <!-- Dossiers : chips + « Changer les dossiers » (F-02) -->
                <WrapPanel Margin="0,9,0,0">
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [Teams_MountsLabel], Source={x:Static services:I18n.Instance}}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasMounts}" Value="False">
                            <Setter Property="Text" Value="{Binding [Teams_NoMounts], Source={x:Static services:I18n.Instance}}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ItemsControl ItemsSource="{Binding MountChips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,7,4">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ToolChip}">
                              <Style.Triggers>
                                <!-- Not in « Réglages › Dossiers autorisés » — /output and /input
                                     live inside the team itself and are never declared. -->
                                <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Size="11" Foreground="{DynamicResource InkMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0">
                              <controls:LucideIcon.Style>
                                <Style TargetType="controls:LucideIcon">
                                  <Setter Property="Kind" Value="folder-open"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                                      <Setter Property="Kind" Value="pencil"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </controls:LucideIcon.Style>
                            </controls:LucideIcon>
                            <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding Label}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource ChipAction}" Command="{Binding ChangeMountsCommand}" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="folder-tree" Size="11" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding [Teams_ChangeMounts], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <!-- méta : n agents · programmation · dernière exécution · réglage —
                     ONE « · »-joined line, the launcher's recipe (v3 F-02) -->
                <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                           Text="{Binding MetaLine}"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- the wizard sessions still underway -->
    <StackPanel Margin="0,18,0,0"
                Visibility="{Binding HasInProgress, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                 Text="{Binding [Teams_InProgress], Source={x:Static services:I18n.Instance}}"/>
      <ItemsControl ItemsSource="{Binding InProgress}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Command="{Binding ResumeCommand}"
                        Content="{Binding [Teams_Resume], Source={x:Static services:I18n.Instance}}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="10" Margin="0,2,0,0" Text="{Binding State}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

  </StackPanel>
</UserControl>
