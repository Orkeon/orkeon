<!-- "My teams" (design v3): every adopted team is an autonomous folder — copiable,
     shareable, deletable — plus the wizard sessions still underway, resumable. STUDIO-32 keeps
     it readable with many teams: a search, an order, the Archives view, an undo banner after
     « Archive », and the proposal to archive the teams nobody launches any more.
     DataContext: TeamsViewModel (bound as Teams in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <UserControl.Resources>
    <!-- A team's folder (R12, C13): « /docs » in mono, then the shared rights badge — « Lecture seule »
         neutral, « Lecture et écriture » sky. A folder nothing vouches for writes its path in red. -->
    <DataTemplate x:Key="TeamFolderTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
        <controls:LucideIcon Kind="folder" Size="16" VerticalAlignment="Center" Margin="0,0,6,0" IsTabStop="False" Focusable="False">
          <controls:LucideIcon.Style>
            <Style TargetType="controls:LucideIcon">
              <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:LucideIcon.Style>
        </controls:LucideIcon>
        <TextBlock Text="{Binding Path}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource DangerInkBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <controls:Badge Margin="8,0,0,0" VerticalAlignment="Center">
          <controls:Badge.Style>
            <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
              <Setter Property="Tone" Value="Neutral"/>
              <Setter Property="Content" Value="{Binding [Studio.Settings.RightsReadOnly], Source={x:Static services:I18n.Instance}}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                  <Setter Property="Tone" Value="Info"/>
                  <Setter Property="Content" Value="{Binding [Studio.Create.RightsReadWrite], Source={x:Static services:I18n.Instance}}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:Badge.Style>
        </controls:Badge>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- R02 (A02): 32 px after the last block, so nothing ends cut at the bottom of the scroll. -->
  <StackPanel Margin="0,0,0,32">

    <!-- R3: one header — title, subtitle, and the page's two doors on the right. -->
    <controls:PageHeader Title="{Binding [Studio.Teams.ScreenTitle], Source={x:Static services:I18n.Instance}}"
                         Subtitle="{Binding [Studio.Teams.ScreenSub], Source={x:Static services:I18n.Instance}}">
      <StackPanel Style="{StaticResource ActionRow}">
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="40" Command="{Binding ImportCommand}"
                controls:ButtonIcon.Kind="upload"
                Content="{Binding [Studio.Teams.ImportShort], Source={x:Static services:I18n.Instance}}"/>
        <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="40" Margin="8,0,0,0" Command="{Binding CreateCommand}"
                controls:ButtonIcon.Kind="plus"
                Content="{Binding [Studio.Teams.Create], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </controls:PageHeader>

    <!-- R7: the one banner of refusals — what the cards used to repeat each, said once. -->
    <controls:Alert Tone="Warning" IsBanner="True" Margin="0,0,0,14" Message="{Binding RefusedRunsLine}"
                    Visibility="{Binding HasRefusedRuns, Converter={StaticResource BooleanToVisibility}}">
      <controls:Alert.Actions>
        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding SaveSettingsCommand}"
                Content="{Binding [Studio.Teams.SaveSettings], Source={x:Static services:I18n.Instance}}"/>
      </controls:Alert.Actions>
    </controls:Alert>

    <!-- STUDIO-32 (D-01): the search, the order and the Archives toggle — a view over the cards in
         memory: none of them reads the disk again. There as soon as there is a team to find. -->
    <DockPanel Margin="0,-8,0,14"
               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
      <!-- R10 (C07): the field, the order and Archives share one 40 px line. -->
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" controls:ButtonSize.Height="40"
              Command="{Binding ToggleArchivesCommand}" controls:ButtonIcon.Kind="archive" Content="{Binding ArchivesLabel}"
              ToolTip="{Binding [Studio.Teams.ArchivesTip], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding HasArchives, Converter={StaticResource BooleanToVisibility}}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowArchives}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedGroup}" Margin="8,0,0,0"
              Height="40" CornerRadius="14" Padding="2"
              ToolTip="{Binding [Studio.Teams.SortTip], Source={x:Static services:I18n.Instance}}">
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding SortByActivityCommand}"
                  Content="{Binding [Studio.Teams.SortActivity], Source={x:Static services:I18n.Instance}}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSortedByActivity}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Command="{Binding SortByNameCommand}"
                  Content="{Binding [Studio.Teams.SortName], Source={x:Static services:I18n.Instance}}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSortedByName}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
      <!-- Tag is the watermark the Input style shows while the box is empty. -->
      <TextBox Style="{StaticResource Input}" VerticalAlignment="Center"
               Tag="{Binding [Studio.Teams.SearchHint], Source={x:Static services:I18n.Instance}}"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>

    <!-- The Archives view says what an archive is, and how one comes back. -->
    <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,12"
               Text="{Binding [Studio.Teams.ArchivesHint], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding ShowArchives, Converter={StaticResource BooleanToVisibility}}"/>

    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,-4,0,10" Text="{Binding StatusMessage}"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <!-- STUDIO-32 (D-02): « Archive » asks nothing — its undo is the toast the shell shows at the
         bottom right (MainWindow, ArchiveUndoToast), for ten seconds. -->

    <!-- STUDIO-32 (DB-1): the teams nobody launches any more — never a scheduled one, whose runs
         the system makes without Studio, never one whose activity is unknown. It only proposes:
         nothing is archived without the click, which archives exactly the teams named, and « Not
         now » puts it away for the session. Settings › Studio sets the threshold, or turns it off. -->
    <!-- R07 (C02, C22): a suggestion is the info tone — « Archive » secondary, « Not now » ghost; the
         icon sits on the first line of text (the shared Alert). -->
    <controls:Alert Tone="Info" Margin="0,0,0,14" Message="{Binding ArchiveSuggestionLine}"
                    Visibility="{Binding HasArchiveSuggestion, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Style="{StaticResource MetaText}" Text="{Binding ArchiveSuggestionNames}"
                 Visibility="{Binding ArchiveSuggestionNames, Converter={StaticResource StringPresentToVisibility}}"/>
      <controls:Alert.Actions>
        <StackPanel Style="{StaticResource ActionRow}">
          <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding ArchiveSuggestedCommand}"
                  controls:ButtonIcon.Kind="archive"
                  Content="{Binding [Studio.Teams.Archive], Source={x:Static services:I18n.Instance}}"/>
          <Button Style="{StaticResource BtnGhost}" controls:ButtonSize.Height="32" Margin="8,0,0,0" Command="{Binding DismissSuggestionCommand}"
                  Content="{Binding [Studio.Teams.SuggestionLater], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </controls:Alert.Actions>
    </controls:Alert>

    <!-- R17 (C17): the one empty state — icon in a sky circle, title, sentence, two actions. -->
    <Border Style="{StaticResource Card}" Padding="30,18" Margin="0,0,0,10"
            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
      <controls:EmptyState Icon="brain-circuit"
                           Title="{Binding [Studio.Teams.EmptyTitle], Source={x:Static services:I18n.Instance}}"
                           Text="{Binding [Studio.Teams.EmptyBody], Source={x:Static services:I18n.Instance}}">
        <controls:EmptyState.Actions>
          <StackPanel Style="{StaticResource ActionRow}">
            <Button Style="{StaticResource BtnPrimary}" Command="{Binding CreateCommand}" controls:ButtonIcon.Kind="plus"
                    Content="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
            <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding ImportCommand}" controls:ButtonIcon.Kind="upload"
                    Content="{Binding [Studio.Teams.Import], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </controls:EmptyState.Actions>
      </controls:EmptyState>
    </Border>

    <!-- STUDIO-32 (D-04): every team archived — the list is empty, the teams are not: the way on is
         the archives, not the creation. -->
    <Border Style="{StaticResource Card}" Padding="30,18" Margin="0,0,0,10"
            Visibility="{Binding IsAllArchived, Converter={StaticResource BooleanToVisibility}}">
      <controls:EmptyState Icon="archive"
                           Title="{Binding [Studio.Teams.AllArchivedTitle], Source={x:Static services:I18n.Instance}}"
                           Text="{Binding [Studio.Teams.AllArchivedBody], Source={x:Static services:I18n.Instance}}">
        <controls:EmptyState.Actions>
          <StackPanel Style="{StaticResource ActionRow}">
            <Button Style="{StaticResource BtnPrimary}" Command="{Binding ToggleArchivesCommand}" controls:ButtonIcon.Kind="archive"
                    Content="{Binding [Studio.Teams.OpenArchives], Source={x:Static services:I18n.Instance}}"/>
            <Button Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Command="{Binding CreateCommand}" controls:ButtonIcon.Kind="plus"
                    Content="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </controls:EmptyState.Actions>
      </controls:EmptyState>
    </Border>

    <!-- STUDIO-32 (D-04): the search found nothing — said, with the way back. -->
    <Border Style="{StaticResource Card}" Padding="30,18" Margin="0,0,0,10"
            Visibility="{Binding HasNoMatch, Converter={StaticResource BooleanToVisibility}}">
      <controls:EmptyState Icon="scan-search" Title="{Binding NoMatchLine}">
        <controls:EmptyState.Actions>
          <Button Style="{StaticResource BtnSecondary}" Command="{Binding ClearSearchCommand}" controls:ButtonIcon.Kind="x"
                  Content="{Binding [Studio.Teams.ClearSearch], Source={x:Static services:I18n.Instance}}"/>
        </controls:EmptyState.Actions>
      </controls:EmptyState>
    </Border>

    <!-- The cards the screen lists: the active teams or the archives, the search applied, in the
         chosen order (STUDIO-32, D-01). -->
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
            <!-- #117: the content takes the card's whole width; every action lives in the footer
                 bar under it, never in a column beside it. -->
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,14,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsArchived}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <controls:LucideIcon Size="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon">
                      <Setter Property="Kind" Value="brain-circuit"/>
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                          <Setter Property="Kind" Value="archive"/>
                          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
              </Border>
              <StackPanel>
                <!-- The title wraps, never trimmed; the badge rides on its last line and never
                     shrinks (an InlineUIContainer, not a column). One status: this badge. -->
                <!-- R09 (B10): the name is cut at the slug's cap; the tooltip says it whole. -->
                <TextBlock Style="{StaticResource ObjectTitle}" FontSize="16" ToolTip="{Binding NameTip}">
                  <Run Text="{Binding Name, Mode=OneWay}"/>
                  <InlineUIContainer BaselineAlignment="Center">
                    <Border Margin="8,0,0,0">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                          <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                              <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                              <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="muted">
                              <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding BadgeText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding BadgeTone}" Value="muted">
                                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </InlineUIContainer>
                  <InlineUIContainer BaselineAlignment="Center">
                    <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="8,0,0,0"
                               Text="{Binding Slug}"
                               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                  </InlineUIContainer>
                </TextBlock>
                <!-- méta : n agents · programmation · dernière exécution —
                     ONE « · »-joined line, the launcher's recipe (v3 F-02) -->
                <!-- R11 (D06): words in the UI font, meta size and ink — mono is for machine values. -->
                <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0" Text="{Binding MetaLine}"/>
                <!-- STUDIO-73 (D6): the model the team runs on, and « Change the model » on the card — the
                     editor opens in place, like the rename one: the box « Use the default model (X) »,
                     the list of settings, Save and Cancel. An archived team keeps its model. -->
                <controls:PropertyRow Margin="0,12,0,0"
                                      Label="{Binding [Studio.Teams.RowModel], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding HasProfileDisplay, Converter={StaticResource BooleanToVisibility}}">
                  <!-- R19 (D08): the model's own name, as Settings and Run write it; a team that follows the
                       elected default says so with the « par défaut » badge, never « Défaut (X) ». -->
                  <WrapPanel>
                    <TextBlock Text="{Binding ProfileName}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <controls:Badge Tone="Info" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Content="{Binding [Studio.Settings.DefaultBadge], Source={x:Static services:I18n.Instance}}"
                                    Visibility="{Binding FollowsDefaultLlm, Converter={StaticResource BooleanToVisibility}}"/>
                  </WrapPanel>
                  <controls:PropertyRow.Action>
                    <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Command="{Binding ChangeLlmCommand}"
                            Content="{Binding [Studio.Teams.ChangeShort], Source={x:Static services:I18n.Instance}}"
                            ToolTip="{Binding [Studio.Teams.ChangeLlm], Source={x:Static services:I18n.Instance}}"
                            AutomationProperties.Name="{Binding [Studio.Teams.ChangeLlm], Source={x:Static services:I18n.Instance}}"
                            Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibility}}"/>
                  </controls:PropertyRow.Action>
                </controls:PropertyRow>
                <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsChangingLlm, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <CheckBox IsChecked="{Binding EditUsesDefaultLlm}" IsEnabled="{Binding HasLlmProfiles}"
                              Foreground="{DynamicResource InkBrush}" Content="{Binding UseDefaultLlmLabel}"
                              ToolTip="{Binding [Studio.Teams.UseDefaultLlmHint], Source={x:Static services:I18n.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                Visibility="{Binding EditUsesDefaultLlm, Converter={StaticResource InverseBooleanToVisibility}}">
                      <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Text="{Binding [Studio.Teams.PinnedLlm], Source={x:Static services:I18n.Instance}}"/>
                      <ComboBox Width="220" ItemsSource="{Binding LlmProfiles}" SelectedItem="{Binding EditLlmProfile}"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,7,0,0" Command="{Binding ConfigureModelCommand}"
                            Content="{Binding [Studio.Teams.ConfigureModel], Source={x:Static services:I18n.Instance}}"
                            Visibility="{Binding HasLlmProfiles, Converter={StaticResource InverseBooleanToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmLlmCommand}"
                              Content="{Binding [Studio.Common.Save], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" Margin="8,0,0,0"
                              Command="{Binding CancelLlmCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Text="{Binding CrewLlmWarning}"
                           Visibility="{Binding HasCrewLlmWarning, Converter={StaticResource BooleanToVisibility}}"/>
                <!-- The need (STUDIO-16, D-02/D-03), folded to two lines (#117), the whole text
                     unfolded or in the tooltip. -->
                <TextBlock Margin="0,6,0,0" Text="{Binding DescriptionDisplay}" ToolTip="{Binding DescriptionDisplay}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Description2Lines}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True">
                          <Setter Property="MaxHeight" Value="Infinity"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- « Voir plus » / « Voir moins » — only when the folded card hides something. -->
                <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,3,0,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Command="{Binding ToggleDescriptionCommand}"
                        Visibility="{Binding DescriptionOverflows, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [Studio.Teams.ShowMore], Source={x:Static services:I18n.Instance}}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True">
                            <Setter Property="Text" Value="{Binding [Studio.Teams.ShowLess], Source={x:Static services:I18n.Instance}}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <!-- Folders: « /input » and its rights badge, then « Change » (F-02, R6; R12) -->
                <controls:PropertyRow Margin="0,4,0,0"
                                      Label="{Binding [Studio.Teams.RowFolders], Source={x:Static services:I18n.Instance}}">
                  <Grid>
                    <ItemsControl ItemsSource="{Binding MountChips}" ItemTemplate="{StaticResource TeamFolderTemplate}" Focusable="False"
                                  Visibility="{Binding HasMounts, Converter={StaticResource BooleanToVisibility}}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Foreground="{DynamicResource InkMutedBrush}"
                               Text="{Binding [Studio.Teams.NoMountsValue], Source={x:Static services:I18n.Instance}}"
                               Visibility="{Binding HasMounts, Converter={StaticResource InverseBooleanToVisibility}}"/>
                  </Grid>
                  <controls:PropertyRow.Action>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibility}}">
                      <!-- A folder nothing allows: « Allow » opens Settings › Allowed folders; « Change » stays. -->
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="0,0,8,0" Command="{Binding AllowFolderCommand}"
                              Content="{Binding [Studio.Teams.AllowFolder], Source={x:Static services:I18n.Instance}}"
                              Visibility="{Binding HasUndeclaredFolder, Converter={StaticResource BooleanToVisibility}}"/>
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Command="{Binding ChangeMountsCommand}"
                              Content="{Binding [Studio.Teams.ChangeMountsShort], Source={x:Static services:I18n.Instance}}"
                              ToolTip="{Binding [Studio.Teams.ChangeMounts], Source={x:Static services:I18n.Instance}}"
                              AutomationProperties.Name="{Binding [Studio.Teams.ChangeMounts], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </controls:PropertyRow.Action>
                </controls:PropertyRow>
                <!-- No schedule: the row says « Manual », without a button — a schedule is set at the
                     adoption or through « Modify ». -->
                <controls:PropertyRow Margin="0,4,0,0"
                                      Label="{Binding [Studio.Teams.RowSchedule], Source={x:Static services:I18n.Instance}}"
                                      Visibility="{Binding HasScheduleRow, Converter={StaticResource InverseBooleanToVisibility}}">
                  <TextBlock Foreground="{DynamicResource InkMutedBrush}"
                             Text="{Binding [Studio.Teams.ScheduleManualValue], Source={x:Static services:I18n.Instance}}"/>
                </controls:PropertyRow>
                <!-- STUDIO-27 (D-05): where the schedule really stands — what the engine answered,
                     never what the sidecar says — and its two gestures, install and stop. -->
                <StackPanel Margin="0,4,0,0"
                            Visibility="{Binding HasScheduleRow, Converter={StaticResource BooleanToVisibility}}">
                  <controls:PropertyRow Label="{Binding [Studio.Teams.RowSchedule], Source={x:Static services:I18n.Instance}}">
                    <DockPanel>
                    <!-- STUDIO-52: what the scheduled run cannot follow, read against the settings file as
                         saved — an attention icon, its line in the tooltip; the refusals are also the
                         screen's banner. -->
                    <controls:LucideIcon DockPanel.Dock="Right" Kind="triangle-alert" Size="16" Margin="8,0,0,0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"
                                         Background="Transparent" Focusable="True" ToolTip="{Binding ScheduledRunLine}"
                                         AutomationProperties.Name="{Binding ScheduledRunLine}"
                                         Visibility="{Binding HasScheduledRunLine, Converter={StaticResource BooleanToVisibility}}"/>
                    <TextBlock FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding ScheduleStateLine}"
                               Visibility="{Binding HasScheduleStateLine, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Installed">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Absent">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Stale">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    </DockPanel>
                    <controls:PropertyRow.Action>
                      <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Command="{Binding InstallScheduleCommand}"
                                Content="{Binding [Studio.Teams.ScheduleInstall], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding ShowsInstallSchedule, Converter={StaticResource BooleanToVisibility}}"/>
                        <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="28" Margin="8,0,0,0" Command="{Binding StopScheduleCommand}"
                                Content="{Binding [Studio.Teams.ScheduleStop], Source={x:Static services:I18n.Instance}}"
                                Visibility="{Binding ShowsStopSchedule, Converter={StaticResource BooleanToVisibility}}"/>
                      </StackPanel>
                    </controls:PropertyRow.Action>
                  </controls:PropertyRow>
                  <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                             Text="{Binding ScheduleMessage}"
                             Visibility="{Binding HasScheduleMessage, Converter={StaticResource BooleanToVisibility}}"/>
                  <StackPanel Visibility="{Binding HasScheduleManualCommand, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2"
                               Text="{Binding [Studio.Teams.ScheduleManual], Source={x:Static services:I18n.Instance}}"/>
                    <TextBox Style="{StaticResource InputMono}" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding ScheduleManualCommand, Mode=OneWay}"/>
                  </StackPanel>
                </StackPanel>
                <!-- STUDIO-31/32: what an archive or a restore has to say on its card — a refusal (the
                     team busy, the disk), or an offer: « Stop the schedule and archive » (the system
                     would keep running a team nobody sees), « Restore ». Never a refusal in silence. -->
                <controls:Alert Tone="Warning" Margin="0,10,0,0" Message="{Binding ArchiveNotice}"
                                Visibility="{Binding HasArchiveNotice, Converter={StaticResource BooleanToVisibility}}">
                  <controls:TechBlock Text="{Binding ArchiveManualCommand, Mode=OneWay}"
                                      Visibility="{Binding HasArchiveManualCommand, Converter={StaticResource BooleanToVisibility}}"/>
                  <controls:Alert.Actions>
                    <StackPanel Style="{StaticResource ActionRow}">
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding StopScheduleAndArchiveCommand}"
                              controls:ButtonIcon.Kind="square"
                              Content="{Binding [Studio.Teams.StopScheduleAndArchive], Source={x:Static services:I18n.Instance}}"
                              Visibility="{Binding OffersScheduleStop, Converter={StaticResource BooleanToVisibility}}"/>
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="0,0,8,0" Command="{Binding RestoreCommand}"
                              controls:ButtonIcon.Kind="rotate-ccw"
                              Visibility="{Binding OffersRestore, Converter={StaticResource BooleanToVisibility}}"
                              Content="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource IconBtnGhost}" Command="{Binding DismissArchiveNoticeCommand}" controls:ButtonIcon.Kind="x"
                              ToolTip="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"
                              AutomationProperties.Name="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </controls:Alert.Actions>
                </controls:Alert>
              </StackPanel>
            </DockPanel>
            <!-- The footer bar (#117). Faces, never two at once: the active team's actions, the
                 archived team's, or the in-place confirmation / rename editor that replaces them —
                 a MessageBox would take the card off screen to ask about it. -->
            <Border Style="{StaticResource CardFooter}">
              <Grid>
                <!-- R23 (C10, C23): one order in both modes — Launch, Test | Modify, Rename | Open folder,
                     Duplicate | «…». Export, Archive and Delete always live in the «…» menu, Delete last, in
                     red after a rule; Novice hides Open folder, Duplicate and Export, never reorders. -->
                <Grid>
                  <Grid.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                      <Binding Path="IsIdle"/>
                      <Binding Path="IsArchived" Converter="{StaticResource Negate}"/>
                    </MultiBinding>
                  </Grid.Visibility>
                  <!-- R5: one line, one primary; what no longer fits goes to the «…» menu at its end. -->
                  <controls:ActionBar ButtonHeight="32">
                  <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" Command="{Binding LaunchCommand}"
                          ToolTip="{Binding LaunchBlockedReason}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="play" Size="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentFgBrush}"/>
                      <TextBlock Text="{Binding [Studio.Teams.Launch], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding TestCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="flask-conical" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Test], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Rectangle Style="{StaticResource ActionBarRule}"/>
                  <!-- «Modifier» reopens the wizard at step 2 on this team (FORGE-09); disabled,
                       with the reason, only for a team with no YAML crew. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding ModifyCommand}"
                            ToolTip="{Binding ModifyTooltip}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="pencil" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Modify], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <!-- STUDIO-28 (D-07): the folder, the workshop session, the titles and the
                       schedule follow the new name — Modify only retitles. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding RenameCommand}"
                            ToolTip="{Binding [Studio.Teams.RenameTip], Source={x:Static services:I18n.Instance}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="pencil-line" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Rename], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Rectangle Style="{StaticResource ActionBarRule}"/>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding OpenCommand}" Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="folder-open" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Open], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Command="{Binding DuplicateCommand}" Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="copy" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Duplicate], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <!-- The «…» menu: the same buttons, the same commands, offered from the menu. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" controls:ActionBar.InMenu="True"
                          Command="{Binding ExportCommand}" Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="download" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Export], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <!-- STUDIO-32 (D-02): no question — it is undone in one click: the undo banner follows. -->
                  <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" controls:ActionBar.InMenu="True"
                          Command="{Binding ArchiveCommand}"
                          ToolTip="{Binding [Studio.Teams.ArchiveTip], Source={x:Static services:I18n.Instance}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="archive" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Archive], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnDanger}" controls:ButtonSize.Height="32" controls:ActionBar.InMenu="True"
                          Command="{Binding AskDeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="trash-2" Size="16" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Text="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  </controls:ActionBar>
                </Grid>
                <!-- STUDIO-32 (D-02): an archived team offers « Restore » and « Delete », nothing else
                     — neither launched, modified, renamed nor copied until it is back. R06 (C01):
                     « Restore » is the group's one primary, « Delete » the danger outline after a rule. -->
                <controls:ActionBar ButtonHeight="32">
                  <controls:ActionBar.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                      <Binding Path="IsIdle"/>
                      <Binding Path="IsArchived"/>
                    </MultiBinding>
                  </controls:ActionBar.Visibility>
                  <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" Command="{Binding RestoreCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="rotate-ccw" Size="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentFgBrush}"/>
                      <TextBlock Text="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Rectangle Style="{StaticResource ActionBarRule}"/>
                  <Button Style="{StaticResource BtnDanger}" controls:ButtonSize.Height="32" Command="{Binding AskDeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="trash-2" Size="16" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Text="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </controls:ActionBar>
                <!-- R24 (D11): shown, the confirmation is scrolled into view (OnEditorShown). -->
                <Border Background="{DynamicResource DangerWeakBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,6,8,6" IsVisibleChanged="OnEditorShown"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                 TextWrapping="Wrap" Foreground="{DynamicResource DangerInkBrush}"
                                 Text="{Binding DeleteQuestion}"/>
                      <Button Style="{StaticResource BtnDangerSolid}" controls:ButtonSize.Height="32" Command="{Binding ConfirmDeleteCommand}"
                              controls:ButtonIcon.Kind="trash-2"
                              Content="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="8,0,0,0"
                              Command="{Binding CancelDeleteCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </WrapPanel>
                    <!-- STUDIO-27 (D-07): the workshop session rule R links to this team goes with
                         it, unless unticked. A copy is linked to none, so it offers none: deleting
                         a copy never touches its original's session. -->
                    <CheckBox Margin="0,6,0,2" IsChecked="{Binding DeleteSessionToo}"
                              Visibility="{Binding CanDeleteSessionToo, Converter={StaticResource BooleanToVisibility}}"
                              Content="{Binding [Studio.Teams.DeleteSessionToo], Source={x:Static services:I18n.Instance}}"/>
                    <!-- STUDIO-27 (D-06): the schedule is stopped first; when it cannot be, the team
                         stays, and the banner says why and what to run by hand. -->
                    <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerInkBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="{Binding DeleteRefusal}"
                               Visibility="{Binding HasDeleteRefusal, Converter={StaticResource BooleanToVisibility}}"/>
                    <controls:TechBlock Margin="0,4,0,2" Text="{Binding DeleteManualCommand, Mode=OneWay}"
                                        Visibility="{Binding HasDeleteManualCommand, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>
                <!-- STUDIO-28 (D-07): the rename editor, in place of the action row like the delete
                     banner — no MessageBox. A refusal (the team running, under test or open in the
                     assistant, the name taken, the engine's answer) is said under it, and then
                     nothing moved. -->
                <Border Background="{DynamicResource SkyBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,6,8,6" IsVisibleChanged="OnEditorShown"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <!-- R10: one row, every control at 32 px — the field too. -->
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentInkBrush}"
                                 Text="{Binding [Studio.Teams.RenameLabel], Source={x:Static services:I18n.Instance}}"/>
                      <TextBox Style="{StaticResource Input}" Width="220" Height="32" Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/>
                      <Button Style="{StaticResource BtnPrimary}" controls:ButtonSize.Height="32" Margin="8,0,0,0" Command="{Binding ConfirmRenameCommand}"
                              controls:ButtonIcon.Kind="pencil-line"
                              Content="{Binding [Studio.Teams.Rename], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnSecondary}" controls:ButtonSize.Height="32" Margin="8,0,0,0"
                              Command="{Binding CancelRenameCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerInkBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="{Binding RenameRefusal}"
                               Visibility="{Binding HasRenameRefusal, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- the wizard sessions still underway — beside the active teams, not in the Archives view -->
    <StackPanel Margin="0,18,0,0"
                Visibility="{Binding ShowArchives, Converter={StaticResource InverseBooleanToVisibility}}">
      <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                 Text="{Binding [Studio.Teams.InProgress], Source={x:Static services:I18n.Instance}}"/>
      <!-- R17 (C17): nothing underway — the compact empty state, no action. -->
      <controls:EmptyState IsCompact="True" Icon="history" Padding="0,4"
                           Title="{Binding [Studio.Teams.NoSessionsTitle], Source={x:Static services:I18n.Instance}}"
                           Text="{Binding [Studio.Teams.NoSessions], Source={x:Static services:I18n.Instance}}"
                           Visibility="{Binding HasInProgress, Converter={StaticResource InverseBooleanToVisibility}}"/>
      <ItemsControl ItemsSource="{Binding InProgress}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
              <DockPanel>
                <Grid DockPanel.Dock="Right">
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}">
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding ResumeCommand}"
                            Content="{Binding [Studio.Teams.Resume], Source={x:Static services:I18n.Instance}}"/>
                    <Button Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Command="{Binding AskDeleteCommand}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [Studio.Teams.SessionDelete], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Border Background="{DynamicResource DangerWeakBrush}" BorderBrush="{DynamicResource DangerBrush}"
                          BorderThickness="1" CornerRadius="11" Padding="12,6,8,6"
                          Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource DangerBrush}"
                                 Text="{Binding [Studio.Teams.SessionDeleteConfirm], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnDangerSolid}" Margin="8,0,0,0" Command="{Binding ConfirmDeleteCommand}"
                              Content="{Binding [Studio.Teams.SessionDelete], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" Margin="8,0,0,0"
                              Command="{Binding CancelDeleteCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="13" Margin="0,2,0,0" Text="{Binding State}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

  </StackPanel>
</UserControl>
