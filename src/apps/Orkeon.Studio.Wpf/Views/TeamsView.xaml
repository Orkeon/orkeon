<!-- "My teams" (design v3): every adopted team is an autonomous folder — copiable,
     shareable, deletable — plus the wizard sessions still underway, resumable. STUDIO-32 keeps
     it readable with many teams: a search, an order, the Archives view, an undo banner after
     « Archive », and the proposal to archive the teams nobody launches any more.
     DataContext: TeamsViewModel (bound as Teams in MainWindow). -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <DockPanel Margin="0,0,0,22">
      <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top"
              Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
          <TextBlock Text="{Binding [Studio.Teams.Create], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Studio.Teams.ScreenTitle], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
                   Text="{Binding [Studio.Teams.ScreenSub], Source={x:Static services:I18n.Instance}}"/>
      </StackPanel>
    </DockPanel>

    <!-- STUDIO-32 (D-01): the search, the order and the Archives toggle — a view over the cards in
         memory: none of them reads the disk again. There as soon as there is a team to find. -->
    <DockPanel Margin="0,-8,0,14"
               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
      <Button DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
              Command="{Binding ToggleArchivesCommand}"
              ToolTip="{Binding [Studio.Teams.ArchivesTip], Source={x:Static services:I18n.Instance}}"
              Visibility="{Binding HasArchives, Converter={StaticResource BooleanToVisibility}}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowArchives}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="archive" Size="13" Margin="0,0,7,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="{Binding ArchivesLabel}"/>
        </StackPanel>
      </Button>
      <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedGroup}" Margin="10,0,0,0"
              ToolTip="{Binding [Studio.Teams.SortTip], Source={x:Static services:I18n.Instance}}">
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding SortByActivityCommand}"
                  Content="{Binding [Studio.Teams.SortActivity], Source={x:Static services:I18n.Instance}}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSortedByActivity}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Command="{Binding SortByNameCommand}"
                  Content="{Binding [Studio.Teams.SortName], Source={x:Static services:I18n.Instance}}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSortedByName}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
      <!-- Tag is the watermark the Input style shows while the box is empty. -->
      <TextBox Style="{StaticResource Input}" VerticalAlignment="Center"
               Tag="{Binding [Studio.Teams.SearchHint], Source={x:Static services:I18n.Instance}}"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>

    <!-- The Archives view says what an archive is, and how one comes back. -->
    <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,12"
               Text="{Binding [Studio.Teams.ArchivesHint], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding ShowArchives, Converter={StaticResource BooleanToVisibility}}"/>

    <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,-4,0,10" Text="{Binding StatusMessage}"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringPresentToVisibility}}"/>

    <!-- STUDIO-32 (D-02): « Archive » asks nothing — this banner undoes it, for a few seconds, on a
         timer of its own. After « Stop the schedule and archive » it says the schedule stays stopped. -->
    <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="11" Padding="12,6,6,6" Margin="0,0,0,12"
            Visibility="{Binding HasUndo, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="26" Height="26" VerticalAlignment="Center"
                Command="{Binding DismissUndoCommand}"
                ToolTip="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}">
          <controls:LucideIcon Kind="x" Size="11"/>
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Margin="10,0,6,0"
                VerticalAlignment="Center" Command="{Binding UndoCommand}">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="rotate-ccw" Size="12" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding [Studio.Teams.Undo], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <controls:LucideIcon DockPanel.Dock="Left" Kind="archive" Size="14" Margin="0,0,9,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource InkBrush}" Text="{Binding UndoNotice}"/>
      </DockPanel>
    </Border>

    <!-- STUDIO-32 (DB-1): the teams nobody launches any more — never a scheduled one, whose runs
         the system makes without Studio, never one whose activity is unknown. It only proposes:
         nothing is archived without the click, which archives exactly the teams named, and « Not
         now » puts it away for the session. Settings › Studio sets the threshold, or turns it off. -->
    <Border Background="{DynamicResource SandWeakBrush}" BorderBrush="{DynamicResource SandBrush}"
            BorderThickness="1" CornerRadius="11" Padding="12,9,9,9" Margin="0,0,0,12"
            Visibility="{Binding HasArchiveSuggestion, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ArchiveSuggestedCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="archive" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Studio.Teams.Archive], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding DismissSuggestionCommand}"
                  Content="{Binding [Studio.Teams.SuggestionLater], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <controls:LucideIcon DockPanel.Dock="Left" Kind="archive" Size="15" Margin="0,1,10,0"
                             VerticalAlignment="Top" Foreground="{DynamicResource SandBrush}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"
                     Text="{Binding ArchiveSuggestionLine}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     Text="{Binding ArchiveSuggestionNames}" ToolTip="{Binding ArchiveSuggestionNames}"
                     Visibility="{Binding ArchiveSuggestionNames, Converter={StaticResource StringPresentToVisibility}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="30,30,30,30" Margin="0,0,0,10"
            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel HorizontalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                Background="{DynamicResource AccentWeakBrush}">
          <controls:LucideIcon Kind="brain-circuit" Size="19" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock FontSize="14.5" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource InkBrush}"
                   Text="{Binding [Studio.Teams.EmptyTitle], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" FontSize="12.5" MaxWidth="420" Margin="0,6,0,0"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="{Binding [Studio.Teams.EmptyBody], Source={x:Static services:I18n.Instance}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding CreateCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="plus" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding ImportCommand}"
                  Content="{Binding [Studio.Teams.Import], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- STUDIO-32 (D-04): every team archived — the list is empty, the teams are not: the way on is
         the archives, not the creation. -->
    <Border Style="{StaticResource Card}" Padding="30,30,30,30" Margin="0,0,0,10"
            Visibility="{Binding IsAllArchived, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel HorizontalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                Background="{DynamicResource PaperSunkBrush}">
          <controls:LucideIcon Kind="archive" Size="19" Foreground="{DynamicResource InkMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock FontSize="14.5" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource InkBrush}"
                   Text="{Binding [Studio.Teams.AllArchivedTitle], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" FontSize="12.5" MaxWidth="420" Margin="0,6,0,0"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="{Binding [Studio.Teams.AllArchivedBody], Source={x:Static services:I18n.Instance}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
          <Button Style="{StaticResource BtnPrimary}" Command="{Binding ToggleArchivesCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="archive" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Studio.Teams.OpenArchives], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding CreateCommand}"
                  Content="{Binding [Studio.Shell.Create], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- STUDIO-32 (D-04): the search found nothing — said, with the way back. -->
    <StackPanel Orientation="Horizontal" Margin="0,2,0,14"
                Visibility="{Binding HasNoMatch, Converter={StaticResource BooleanToVisibility}}">
      <controls:LucideIcon Kind="scan-search" Size="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="12.5" VerticalAlignment="Center" Text="{Binding NoMatchLine}"/>
      <Button Style="{StaticResource LinkBtn}" Margin="10,0,0,0" VerticalAlignment="Center"
              Foreground="{DynamicResource AccentBrush}" Command="{Binding ClearSearchCommand}"
              Content="{Binding [Studio.Teams.ClearSearch], Source={x:Static services:I18n.Instance}}"/>
    </StackPanel>

    <!-- The cards the screen lists: the active teams or the archives, the search applied, in the
         chosen order (STUDIO-32, D-01). -->
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,14,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsArchived}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <controls:LucideIcon Size="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:LucideIcon.Style>
                    <Style TargetType="controls:LucideIcon">
                      <Setter Property="Kind" Value="brain-circuit"/>
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                          <Setter Property="Kind" Value="archive"/>
                          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:LucideIcon.Style>
                </controls:LucideIcon>
              </Border>
              <!-- Two faces, never both: the action row, or the confirmation that replaces
                   it in place. A MessageBox would take the card off screen to ask about it. -->
              <Grid DockPanel.Dock="Right" VerticalAlignment="Top">
                <!-- an active team's actions -->
                <StackPanel Orientation="Horizontal">
                  <StackPanel.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                      <Binding Path="IsIdle"/>
                      <Binding Path="IsArchived" Converter="{StaticResource Negate}"/>
                    </MultiBinding>
                  </StackPanel.Visibility>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding LaunchCommand}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="play" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                    <TextBlock Text="{Binding [Studio.Teams.Launch], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <!-- «Modifier» took «Ouvrir»'s visible seat (amended mock, W-09):
                     it reopens the wizard at step 2 on this team — through its session, or
                     through a session rebuilt from the team's files when none points here
                     (FORGE-09). Disabled, with the reason, only for a team with no YAML crew. -->
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding ModifyCommand}"
                        ToolTip="{Binding ModifyTooltip}" ToolTipService.ShowOnDisabled="True">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="pencil" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Studio.Teams.Modify], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <!-- STUDIO-28 (D-07): « Rename », a labelled button in both modes like Launch and
                     Modify. The editor takes the row's place; the folder, the workshop session,
                     the titles and the schedule follow the new name — Modify only retitles. -->
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding RenameCommand}"
                        ToolTip="{Binding [Studio.Teams.RenameTip], Source={x:Static services:I18n.Instance}}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="pencil-line" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Studio.Teams.Rename], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <!-- STUDIO-32 (D-02): « Archive », labelled in novice mode, an icon in expert mode. No
                     question — it is undone in one click: the undo banner follows. -->
                <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding ArchiveCommand}"
                        ToolTip="{Binding [Studio.Teams.ArchiveTip], Source={x:Static services:I18n.Instance}}"
                        Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="archive" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Studio.Teams.Archive], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <!-- Novice never sees the icon row, so it needs a delete of its own — until
                     now the gesture simply did not exist outside Expert. -->
                <Button Style="{StaticResource BtnGhostDanger}" Margin="8,0,0,0" Command="{Binding AskDeleteCommand}"
                        Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                  <Button Style="{StaticResource IconBtn}" Command="{Binding OpenCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Studio.Teams.Open], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="folder-open" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding TestCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Studio.Teams.Test], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="badge-check" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding DuplicateCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Studio.Teams.Duplicate], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="copy" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding ExportCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Studio.Teams.Export], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="save" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding ArchiveCommand}" Margin="0,0,6,0"
                          ToolTip="{Binding [Studio.Teams.ArchiveTip], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="archive" Size="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Command="{Binding AskDeleteCommand}"
                          ToolTip="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}">
                    <controls:LucideIcon Kind="trash-2" Size="13" Foreground="{DynamicResource DangerBrush}"/>
                  </Button>
                </StackPanel>
                </StackPanel>
                <!-- STUDIO-32 (D-02): an archived team offers « Restore » and « Delete », nothing else
                     — neither launched, modified, renamed nor copied until it is back. -->
                <StackPanel Orientation="Horizontal">
                  <StackPanel.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                      <Binding Path="IsIdle"/>
                      <Binding Path="IsArchived"/>
                    </MultiBinding>
                  </StackPanel.Visibility>
                  <Button Style="{StaticResource BtnPrimary}" Command="{Binding RestoreCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
                      <TextBlock Text="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource BtnGhostDanger}" Margin="8,0,0,0" Command="{Binding AskDeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                      <TextBlock Text="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <Border Background="{DynamicResource DangerWeakBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="12,6,8,6"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource DangerBrush}"
                                 Text="{Binding [Studio.Teams.DeleteConfirm], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Command="{Binding ConfirmDeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="trash-2" Size="12" Margin="0,0,6,0"
                                               Foreground="{DynamicResource DangerFgBrush}"/>
                          <TextBlock Text="{Binding [Studio.Teams.Delete], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Margin="8,0,0,0"
                              Command="{Binding CancelDeleteCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                    <!-- STUDIO-27 (D-07): the workshop session rule R links to this team goes with
                         it, unless unticked. A copy is linked to none, so it offers none: deleting
                         a copy never touches its original's session. -->
                    <CheckBox Margin="0,6,0,2" IsChecked="{Binding DeleteSessionToo}"
                              Visibility="{Binding CanDeleteSessionToo, Converter={StaticResource BooleanToVisibility}}"
                              Content="{Binding [Studio.Teams.DeleteSessionToo], Source={x:Static services:I18n.Instance}}"/>
                    <!-- STUDIO-27 (D-06): the schedule is stopped first; when it cannot be, the team
                         stays, and the banner says why and what to run by hand. -->
                    <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                               MaxWidth="420" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding DeleteRefusal}"
                               Visibility="{Binding HasDeleteRefusal, Converter={StaticResource BooleanToVisibility}}"/>
                    <TextBox Style="{StaticResource InputMono}" Margin="0,4,0,2" MaxWidth="420" HorizontalAlignment="Left"
                             IsReadOnly="True" TextWrapping="Wrap" Text="{Binding DeleteManualCommand, Mode=OneWay}"
                             Visibility="{Binding HasDeleteManualCommand, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>
                <!-- STUDIO-28 (D-07): the rename editor, in place of the action row like the delete
                     banner — no MessageBox. A refusal (the team running, under test or open in the
                     assistant, the name taken, the engine's answer) is said under it, and then
                     nothing moved. -->
                <Border Background="{DynamicResource AccentWeakBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="12,6,8,6"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Text="{Binding [Studio.Teams.RenameLabel], Source={x:Static services:I18n.Instance}}"/>
                      <TextBox Style="{StaticResource Input}" Width="220" Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/>
                      <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding ConfirmRenameCommand}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="pencil-line" Size="12" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentFgBrush}"/>
                          <TextBlock Text="{Binding [Studio.Teams.Rename], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Margin="8,0,0,0"
                              Command="{Binding CancelRenameCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                               MaxWidth="420" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding RenameRefusal}"
                               Visibility="{Binding HasRenameRefusal, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                             MaxWidth="380" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Text="{Binding Name}"/>
                  <Border Margin="10,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                            <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                            <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding BadgeTone}" Value="muted">
                            <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding BadgeText}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="ok">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeTone}" Value="muted">
                              <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="9.5" Margin="10,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Slug}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
                <!-- The need (STUDIO-16, D-02/D-03): the derived summary folded, the whole text
                     unfolded. WPF has no MaxLines, so the folded block is bounded in height —
                     MaxHeight = 3 x LineHeight, the line height pinned so the bound does not
                     move with the font — with the ellipsis on the third line. -->
                <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                           Text="{Binding DescriptionDisplay}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="False">
                          <Setter Property="MaxHeight" Value="51"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- « Voir plus » / « Voir moins » — only when the folded card hides something. -->
                <Button Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,3,0,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Command="{Binding ToggleDescriptionCommand}"
                        Visibility="{Binding DescriptionOverflows, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [Studio.Teams.ShowMore], Source={x:Static services:I18n.Instance}}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True">
                            <Setter Property="Text" Value="{Binding [Studio.Teams.ShowLess], Source={x:Static services:I18n.Instance}}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <!-- Dossiers : chips + « Changer les dossiers » (F-02) -->
                <WrapPanel Margin="0,9,0,0">
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding [Studio.Teams.MountsLabel], Source={x:Static services:I18n.Instance}}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasMounts}" Value="False">
                            <Setter Property="Text" Value="{Binding [Studio.Teams.NoMounts], Source={x:Static services:I18n.Instance}}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ItemsControl ItemsSource="{Binding MountChips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,7,4">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ToolChip}">
                              <Style.Triggers>
                                <!-- Not in « Réglages › Dossiers autorisés » — /output and /input
                                     live inside the team itself and are never declared. -->
                                <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Size="11" Foreground="{DynamicResource InkMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0">
                              <controls:LucideIcon.Style>
                                <Style TargetType="controls:LucideIcon">
                                  <Setter Property="Kind" Value="folder-open"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                                      <Setter Property="Kind" Value="pencil"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUndeclared}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </controls:LucideIcon.Style>
                            </controls:LucideIcon>
                            <TextBlock Style="{StaticResource ToolChipText}" Text="{Binding Label}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource ChipAction}" Command="{Binding ChangeMountsCommand}" Margin="0,0,0,4"
                          Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="folder-tree" Size="11" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding [Studio.Teams.ChangeMounts], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <!-- méta : n agents · programmation · dernière exécution · réglage —
                     ONE « · »-joined line, the launcher's recipe (v3 F-02) -->
                <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" TextWrapping="Wrap"
                           Text="{Binding MetaLine}"/>
                <!-- STUDIO-27 (D-05): where the schedule really stands — what the engine answered,
                     never what the sidecar says — and its two gestures, install and stop. -->
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding HasScheduleRow, Converter={StaticResource BooleanToVisibility}}">
                  <WrapPanel>
                    <TextBlock FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,4" TextWrapping="Wrap"
                               Text="{Binding ScheduleStateLine}"
                               Visibility="{Binding HasScheduleStateLine, Converter={StaticResource BooleanToVisibility}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Installed">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Absent">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ScheduleState}" Value="Stale">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource ChipAction}" Margin="0,0,7,4" Command="{Binding InstallScheduleCommand}"
                            Visibility="{Binding ShowsInstallSchedule, Converter={StaticResource BooleanToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="play" Size="11" Foreground="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [Studio.Teams.ScheduleInstall], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipAction}" Margin="0,0,0,4" Command="{Binding StopScheduleCommand}"
                            Visibility="{Binding ShowsStopSchedule, Converter={StaticResource BooleanToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="square" Size="11" Foreground="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [Studio.Teams.ScheduleStop], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                             Text="{Binding ScheduleMessage}"
                             Visibility="{Binding HasScheduleMessage, Converter={StaticResource BooleanToVisibility}}"/>
                  <StackPanel Visibility="{Binding HasScheduleManualCommand, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2"
                               Text="{Binding [Studio.Teams.ScheduleManual], Source={x:Static services:I18n.Instance}}"/>
                    <TextBox Style="{StaticResource InputMono}" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding ScheduleManualCommand, Mode=OneWay}"/>
                  </StackPanel>
                </StackPanel>
                <!-- STUDIO-31/32: what an archive or a restore has to say on its card — a refusal (the
                     team busy, the disk), or an offer: « Stop the schedule and archive » (the system
                     would keep running a team nobody sees), « Restore ». Never a refusal in silence. -->
                <Border Margin="0,10,0,0" Background="{DynamicResource WarningWeakBrush}" CornerRadius="10" Padding="12,8,6,8"
                        Visibility="{Binding HasArchiveNotice, Converter={StaticResource BooleanToVisibility}}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="24" Height="24" VerticalAlignment="Top"
                              Command="{Binding DismissArchiveNoticeCommand}"
                              ToolTip="{Binding [Studio.Shell.Close], Source={x:Static services:I18n.Instance}}">
                        <controls:LucideIcon Kind="x" Size="11"/>
                      </Button>
                      <controls:LucideIcon DockPanel.Dock="Left" Kind="archive" Size="13" Margin="0,2,8,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                 Text="{Binding ArchiveNotice}"/>
                    </DockPanel>
                    <WrapPanel>
                      <Button Style="{StaticResource BtnGhost}" Margin="21,8,8,0" Command="{Binding StopScheduleAndArchiveCommand}"
                              Visibility="{Binding OffersScheduleStop, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                          <controls:LucideIcon Kind="square" Size="12" Margin="0,0,7,0"/>
                          <TextBlock Text="{Binding [Studio.Teams.StopScheduleAndArchive], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource BtnGhost}" Margin="21,8,8,0" Command="{Binding RestoreCommand}"
                              Visibility="{Binding OffersRestore, Converter={StaticResource BooleanToVisibility}}"
                              Content="{Binding [Studio.Common.Restore], Source={x:Static services:I18n.Instance}}"/>
                    </WrapPanel>
                    <TextBox Style="{StaticResource InputMono}" Margin="21,6,8,0" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding ArchiveManualCommand, Mode=OneWay}"
                             Visibility="{Binding HasArchiveManualCommand, Converter={StaticResource BooleanToVisibility}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- the wizard sessions still underway — beside the active teams, not in the Archives view -->
    <StackPanel Margin="0,18,0,0"
                Visibility="{Binding ShowArchives, Converter={StaticResource InverseBooleanToVisibility}}">
      <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,8"
                 Text="{Binding [Studio.Teams.InProgress], Source={x:Static services:I18n.Instance}}"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Foreground="{DynamicResource InkFaintBrush}"
                 Text="{Binding [Studio.Teams.NoSessions], Source={x:Static services:I18n.Instance}}"
                 Visibility="{Binding HasInProgress, Converter={StaticResource InverseBooleanToVisibility}}"/>
      <ItemsControl ItemsSource="{Binding InProgress}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
              <DockPanel>
                <Grid DockPanel.Dock="Right">
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}">
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding ResumeCommand}"
                            Content="{Binding [Studio.Teams.Resume], Source={x:Static services:I18n.Instance}}"/>
                    <Button Style="{StaticResource BtnGhostDanger}" Margin="8,0,0,0" Command="{Binding AskDeleteCommand}">
                      <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="trash-2" Size="13" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [Studio.Teams.SessionDelete], Source={x:Static services:I18n.Instance}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Border Background="{DynamicResource DangerWeakBrush}" BorderBrush="{DynamicResource DangerBrush}"
                          BorderThickness="1" CornerRadius="11" Padding="12,6,8,6"
                          Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource DangerBrush}"
                                 Text="{Binding [Studio.Teams.SessionDeleteConfirm], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Command="{Binding ConfirmDeleteCommand}"
                              Content="{Binding [Studio.Teams.SessionDelete], Source={x:Static services:I18n.Instance}}"/>
                      <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Margin="8,0,0,0"
                              Command="{Binding CancelDeleteCommand}"
                              Content="{Binding [Studio.Common.Cancel], Source={x:Static services:I18n.Instance}}"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="10" Margin="0,2,0,0" Text="{Binding State}"
                             Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

  </StackPanel>
</UserControl>
