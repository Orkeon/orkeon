<!-- The "Exécuter" screen (design v3, remediation lot 2): a vertical flow of cards —
     team card (novice-first, one primary button), plain-language progress, folded
     technical journal. The expert machinery (target picker, options, COMMANDE, raw
     validation) lives inside the same flow, never in a side panel.
     DataContext: LaunchTabViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.LaunchTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
             xmlns:launch="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Launch"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">

  <UserControl.Resources>
    <views:VerbosityLabelConverter x:Key="VerbosityLabel"/>
    <!-- collapsible section header (Expander without the Aero chrome) -->
    <Style x:Key="FoldToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="0,6">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="chev" Data="M0,0 L4,4 0,8" Stroke="{DynamicResource InkFaintBrush}"
                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="1,1,8,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chev" Property="Data" Value="M0,0 L4,4 8,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

    <!-- header -->
    <TextBlock Style="{StaticResource H1}" Text="{Binding [Scr_Run_Title], Source={x:Static services:I18n.Instance}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
               Text="{Binding [Scr_Run_SubNovice], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>
    <TextBlock Style="{StaticResource SubTitle}" Margin="0,5,0,0"
               Text="{Binding [Scr_Run_SubExpert], Source={x:Static services:I18n.Instance}}"
               Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"/>

    <!-- CLI missing: a calm, actionable banner — never a raw English block (T-07) -->
    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource WarningBrush}" Margin="0,16,0,0"
            Visibility="{Binding CliBanner, Converter={StaticResource StringPresentToVisibility}}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="12,0,0,0"
                VerticalAlignment="Center" Click="OnOpenDiagnostic">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Kind="stethoscope" Size="13" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding [Nav_Diag], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Kind="triangle-alert" Size="15" Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Text="{Binding CliBanner}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- the locator's raw detail stays expert -->
    <TextBlock Margin="0,6,0,0" Text="{Binding BinaryStatus}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                <Condition Binding="{Binding IsBinaryAvailable}" Value="False"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- ══ Target picker — the machinery, expert only ══ -->
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
            Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <controls:LucideIcon Kind="compass" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Run_Target_Title], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                  Command="{Binding Target.BrowseFolderCommand}"
                  Content="{Binding [Run_Folder], Source={x:Static services:I18n.Instance}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                  Command="{Binding Target.BrowseFileCommand}"
                  Content="{Binding [Run_File], Source={x:Static services:I18n.Instance}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                  Command="{Binding Target.DetectCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="scan-search" Size="13" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Run_Detect], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBox Style="{StaticResource InputMono}" Text="{Binding Target.SelectedPath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding Target.StatusDisplay}"/>

        <StackPanel Visibility="{Binding Target.NeedsShapeChoice, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}" Text="{Binding Target.ErrorMessage}"/>
          <ComboBox ItemsSource="{x:Static launch:TargetSelectionViewModel.DirectoryKindChoices}"
                    SelectedItem="{Binding Target.PreferredDirectoryKind}"
                    Width="280" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Visibility="{Binding Target.NeedsSelection, Converter={StaticResource BooleanToVisibility}}">
          <ListBox ItemsSource="{Binding Target.Candidates}" SelectedItem="{Binding Target.SelectedCandidate}"
                   MaxHeight="120" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
          <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Command="{Binding Target.UseCandidateCommand}"
                  Content="{Binding [Run_UseCandidate], Source={x:Static services:I18n.Instance}}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Hint}" Text="{Binding Target.DirectoryRunNotice}"
                   Visibility="{Binding Target.DirectoryRunNotice, Converter={StaticResource StringPresentToVisibility}}"/>
      </StackPanel>
    </Border>

    <!-- novice empty state (T-12) -->
    <TextBlock FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"
               Text="{Binding [Run_Empty], Source={x:Static services:I18n.Instance}}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding DataContext.Mode.IsNovice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                <Condition Binding="{Binding HasTeamCard}" Value="False"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- ══ Card 1 — the team ══ -->
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
            Visibility="{Binding HasTeamCard, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Padding="17,9"
                  VerticalAlignment="Center" Command="{Binding RunCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="play" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock FontSize="13" Text="{Binding RunButtonLabel}"/>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="0,0,10,0"
                  VerticalAlignment="Center" Click="OnChangeTeam"
                  Content="{Binding [Run_ChangeTeam], Source={x:Static services:I18n.Instance}}"/>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentWeakBrush}"
                    VerticalAlignment="Center">
              <controls:LucideIcon Kind="brain-circuit" Size="16" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                         Text="{Binding TeamHeadline}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0"
                         Text="{Binding TeamMetaLine}"
                         Visibility="{Binding TeamMetaLine, Converter={StaticResource StringPresentToVisibility}}"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <!-- expert machinery inside the same card, per the mock -->
        <StackPanel Visibility="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
          <Border Height="1" Background="{DynamicResource LineFaintBrush}" Margin="0,14,0,14"/>

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"
                         Text="{Binding [Run_Lbl_Verbosity], Source={x:Static services:I18n.Instance}}"/>
              <ComboBox Width="140" ItemsSource="{x:Static launch:LaunchOptionsViewModel.VerbosityChoices}"
                        SelectedItem="{Binding Options.Verbosity}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource VerbosityLabel}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <CheckBox Margin="0,0,18,8" VerticalAlignment="Center"
                      IsChecked="{Binding Options.WatchProgress}"
                      Content="{Binding [Vm_RunProgress_Watch], Source={x:Static services:I18n.Instance}}"/>
            <CheckBox Margin="0,0,18,8" VerticalAlignment="Center"
                      IsChecked="{Binding Options.StreamGeneratedText}"
                      IsEnabled="{Binding Options.CanStreamGeneratedText}"
                      Content="{Binding [Vm_RunProgress_Stream], Source={x:Static services:I18n.Instance}}"/>
            <CheckBox Margin="0,0,0,8" VerticalAlignment="Center"
                      IsChecked="{Binding Options.LlmLogEnabled}"
                      Content="{Binding [Run_LlmLog], Source={x:Static services:I18n.Instance}}"/>
          </WrapPanel>

          <!-- advanced options, folded -->
          <ToggleButton x:Name="AdvancedFold" Style="{StaticResource FoldToggle}">
            <TextBlock FontSize="12" FontWeight="SemiBold"
                       Text="{Binding [Run_Advanced], Source={x:Static services:I18n.Instance}}"/>
          </ToggleButton>
          <StackPanel Margin="13,4,0,4"
                      Visibility="{Binding IsChecked, ElementName=AdvancedFold, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource CardTitle}" FontSize="13" Text="appsettings.json"/>
            <RadioButton Margin="0,8,0,0" GroupName="RunSettings"
                         IsChecked="{Binding Options.IsSettingsAutomatic, Mode=OneWay}"
                         Content="{Binding [Run_Settings_Auto], Source={x:Static services:I18n.Instance}}"/>
            <RadioButton Margin="0,5,0,0" GroupName="RunSettings"
                         IsChecked="{Binding Options.IsSettingsExplicit, Mode=OneWay}"
                         Content="{Binding [Run_Settings_Explicit], Source={x:Static services:I18n.Instance}}"/>
            <DockPanel Margin="0,7,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                      Command="{Binding Options.BrowseSettingsCommand}"
                      Content="{Binding [Btn_Browse], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" Text="{Binding Options.SettingsPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <StackPanel Visibility="{Binding Options.AreVariablesAvailable, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource CardTitle}" FontSize="13" Margin="0,16,0,7"
                         Text="{Binding [Run_Vars_Title], Source={x:Static services:I18n.Instance}}"/>
              <ItemsControl ItemsSource="{Binding Options.Variables}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                      <TextBox DockPanel.Dock="Right" Style="{StaticResource InputMono}" Width="140" Margin="8,0,0,0"
                               Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBox Style="{StaticResource InputMono}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Style="{StaticResource BtnGhost}" FontSize="12" Margin="0,0,8,0" Command="{Binding Options.AddVariableCommand}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="plus" Size="12" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding [Run_Add], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" FontSize="12" Command="{Binding Options.RemoveVariableCommand}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="trash-2" Size="12" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding [Run_Remove], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0"
                         Text="{Binding [Run_Lbl_InitialContext], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource Input}" Text="{Binding Options.InitialContext, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" MinHeight="60" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Visibility="{Binding Options.AreInputsAvailable, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource CardTitle}" FontSize="13" Margin="0,16,0,0"
                         Text="{Binding [Run_Inputs_Title], Source={x:Static services:I18n.Instance}}"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Run_Lbl_InputsJson], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" Text="{Binding Options.InputsJson, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" MinHeight="60" VerticalScrollBarVisibility="Auto"/>
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                         Text="{Binding [Run_Lbl_InputsFile], Source={x:Static services:I18n.Instance}}"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                        Command="{Binding Options.BrowseInputsFileCommand}"
                        Content="{Binding [Btn_Browse], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Options.InputsFilePath, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
            </StackPanel>

            <DockPanel Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" FontSize="12" Margin="8,0,0,0"
                      Command="{Binding Options.BrowseLlmLogPathCommand}"
                      Content="{Binding [Btn_Browse], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Style="{StaticResource InputMono}" Text="{Binding Options.LlmLogPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </StackPanel>

          <!-- launch mounts, folded -->
          <ToggleButton x:Name="MountsFold" Style="{StaticResource FoldToggle}">
            <TextBlock FontSize="12" FontWeight="SemiBold"
                       Text="{Binding [Run_Tab_Mounts], Source={x:Static services:I18n.Instance}}"/>
          </ToggleButton>
          <StackPanel Margin="13,4,0,4"
                      Visibility="{Binding IsChecked, ElementName=MountsFold, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource CardTitle}" FontSize="13"
                       Text="{Binding [Run_SettingsMounts_Title], Source={x:Static services:I18n.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Mounts.SettingsMounts}" Margin="0,7,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource MonoText}" FontSize="11" Margin="0,1" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox Margin="0,12,0,0"
                      IsChecked="{Binding Mounts.AllowExternalMounts}"
                      Content="{Binding [Run_AllowExternal], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource WarningBrush}"
                       Text="{Binding Mounts.ExternalMountsWarning, Mode=OneWay}"/>

            <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" Text="{Binding Mounts.OverrideExplanation, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Mounts.Summary}"/>
            <!-- effective mounts: plain rows (the DataGrid's stock chrome broke T-04) -->
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
              <ItemsControl ItemsSource="{Binding Mounts.EffectiveMounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1">
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}" FontSize="11"
                                 Width="140" Text="{Binding ConfigurationKey}"/>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoText}" FontSize="11"
                                 Width="120" TextAlignment="Right" Text="{Binding OriginDisplay}"/>
                      <TextBlock Style="{StaticResource MonoText}" FontSize="11"
                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Value}"
                                 TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <views:MountsEditorView DataContext="{Binding Mounts.LaunchMounts}" Margin="0,12,0,0"/>
          </StackPanel>

          <!-- the exact command, always visible in expert -->
          <TextBlock Style="{StaticResource Eyebrow}" Margin="0,10,0,5"
                     Text="{Binding [Run_Cmd_Title], Source={x:Static services:I18n.Instance}}"/>
          <Border Style="{StaticResource Well}">
            <TextBlock Style="{StaticResource MonoText}" FontSize="11.5" TextWrapping="Wrap"
                       Text="{Binding CommandLinePreview, Mode=OneWay}"/>
          </Border>

          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding ValidateCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="badge-check" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Run_Validate], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Command="{Binding CancelCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="x" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Run_Cancel], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnGhost}" Command="{Binding ClearLogCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="eraser" Size="13" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding [Run_ClearLog], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>
            </Button>
          </WrapPanel>

          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding ValidationSummary}"/>
          <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ValidationMessages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,1" Text="{Binding FriendlyText}" ToolTip="{Binding Display}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- run verdict + status, both modes -->
        <DockPanel Margin="0,10,0,0" LastChildFill="True">
          <Border DockPanel.Dock="Right" Margin="10,0,0,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Outcome}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Outcome}" Value="Cancelled">
                    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ExitDescription}"/>
          </Border>
          <StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Log.Summary}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- ══ Card 2 — plain-language progress (BUS-06) ══ -->
    <Border Margin="0,14,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Options.WatchProgress}" Value="True"/>
                <Condition Binding="{Binding HasTeamCard}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <Border DockPanel.Dock="Right" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource InkFaintBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RunBadgeTone}" Value="running">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RunBadgeTone}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RunBadgeTone}" Value="fail">
                    <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding RunBadgeText}"/>
          </Border>
          <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                     Text="{Binding RunStateTitle}"/>
        </DockPanel>

        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}"
                     Text="{Binding Progress.CostSummary}"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource InkBrush}"
                     Text="{Binding Progress.Summary}"/>
        </DockPanel>

        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding Progress.HasError, Converter={StaticResource BooleanToVisibility}}"
                   Text="{Binding Progress.LastError}"/>

        <ItemsControl ItemsSource="{Binding Progress.Tasks}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="10,0,0,0"
                           Text="{Binding Duration}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="10,0,0,0"
                           Text="{Binding Tokens}"/>
                <StackPanel Orientation="Horizontal">
                  <controls:LucideIcon Size="13" Margin="0,0,7,0">
                    <controls:LucideIcon.Style>
                      <Style TargetType="controls:LucideIcon">
                        <Setter Property="Kind" Value="circle-x"/>
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Success}" Value="True">
                            <Setter Property="Kind" Value="circle-check"/>
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </controls:LucideIcon.Style>
                  </controls:LucideIcon>
                  <TextBlock FontSize="12" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The text the model is generating (the "stream" option). -->
        <Border Margin="0,10,0,0" Padding="10" CornerRadius="8"
                Background="{DynamicResource ConsoleBgBrush}"
                MaxHeight="160"
                Visibility="{Binding Progress.HasGeneratedText, Converter={StaticResource BooleanToVisibility}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- ConsoleFgBrush, not InkBrush: the console pair travels together. -->
            <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource ConsoleFgBrush}"
                       Text="{Binding Progress.GeneratedText}"/>
          </ScrollViewer>
        </Border>

        <!-- The question the run is waiting on (BUS-04): silence is never consent. -->
        <Border Margin="0,10,0,0" Padding="10" CornerRadius="8"
                Background="{DynamicResource WarningWeakBrush}"
                Visibility="{Binding Progress.IsAsking, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}"
                       Text="{Binding Progress.QuestionPrompt}"/>

            <ItemsControl ItemsSource="{Binding Progress.QuestionChoices}" Margin="0,8,0,0"
                          Visibility="{Binding Progress.IsChoice, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                          Content="{Binding}"
                          CommandParameter="{Binding}"
                          Command="{Binding DataContext.Progress.ChooseCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,8,0,0"
                       Visibility="{Binding Progress.IsChoice, Converter={StaticResource InverseBooleanToVisibility}}">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                      Command="{Binding Progress.AnswerCommand}"
                      Content="{Binding [Vm_RunProgress_Answer], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Text="{Binding Progress.AnswerText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- An agent's send, waiting on this process: the client://studio seat, taken. -->
        <Border Margin="0,10,0,0" Padding="10" CornerRadius="8"
                Background="{DynamicResource AccentWeakBrush}"
                Visibility="{Binding Progress.HasAgentRequest, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Vm_RunProgress_AgentAsks], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource InkMutedBrush}"
                       Text="{Binding Progress.AgentRequestFrom}"/>
            <Border Margin="0,6,0,0" Padding="8" CornerRadius="6"
                    Background="{DynamicResource ConsoleBgBrush}" MaxHeight="120">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ConsoleFgBrush}"
                           Text="{Binding Progress.AgentRequestPayload}"/>
              </ScrollViewer>
            </Border>
            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                      Command="{Binding Progress.ReplyCommand}"
                      Content="{Binding [Vm_RunProgress_Reply], Source={x:Static services:I18n.Instance}}"/>
              <TextBox Text="{Binding Progress.ReplyText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Hub traffic addressed to this process. -->
        <StackPanel Margin="0,10,0,0"
                    Visibility="{Binding Progress.HasHubMessages, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource Hint}"
                     Text="{Binding [Vm_RunProgress_HubMessages], Source={x:Static services:I18n.Instance}}"/>
          <Border Margin="0,4,0,0" Padding="8" CornerRadius="6"
                  Background="{DynamicResource ConsoleBgBrush}" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Progress.HubMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ConsoleFgBrush}"
                               Text="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

        <!-- result row, only once the run finished -->
        <Border Height="1" Background="{DynamicResource LineFaintBrush}" Margin="0,14,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}"/>
        <DockPanel Margin="0,12,0,0"
                   Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center"
                  Command="{Binding OpenResultCommand}"
                  Visibility="{Binding CanOpenResult, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="folder-open" Size="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentFgBrush}"/>
              <TextBlock Text="{Binding [Run_OpenResult], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                     VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExitDescription}"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- ══ Card 3 — the technical journal, demoted not removed ══ -->
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
            Visibility="{Binding HasTeamCard, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <DockPanel>
          <ToggleButton DockPanel.Dock="Right" Style="{StaticResource FoldToggle}"
                        IsChecked="{Binding IsJournalOpen}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="eye" Size="13" Margin="0,0,6,0"/>
              <TextBlock FontSize="11.5">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding [Run_Journal_Show], Source={x:Static services:I18n.Instance}}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsJournalOpen}" Value="True">
                        <Setter Property="Text" Value="{Binding [Run_Journal_Hide], Source={x:Static services:I18n.Instance}}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </ToggleButton>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                       Text="{Binding [Run_Journal_Title], Source={x:Static services:I18n.Instance}}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10" Margin="9,2,0,0"
                       Text="{Binding Log.Lines.Count}"/>
            <TextBlock Style="{StaticResource MonoText}" FontSize="10" Margin="4,2,0,0"
                       Text="{Binding [Run_Lines], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </DockPanel>

        <!-- open when toggled, and always in expert -->
        <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="9" Padding="6" Margin="0,12,0,0"
                MaxHeight="240">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsJournalOpen}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Mode.IsExpert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ListBox ItemsSource="{Binding Log.Lines}"
                   Background="Transparent" BorderThickness="0"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                   Foreground="{DynamicResource ConsoleFgBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Item">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource ConsoleFgBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource ConsoleErrBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
