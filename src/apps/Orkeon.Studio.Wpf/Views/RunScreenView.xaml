<!-- The "Lancer" screen (refonte, lot 4): the former Run and Test screens behind one Essai | Réel
     switch. One header, then the launcher of the mode shown: both launchers live side by side and
     can run at once, the switch only says which one the screen shows. DataContext: RunScreenViewModel. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.RunScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services">
  <StackPanel>

    <!-- R3: one header; the mode switch on the right. -->
    <controls:PageHeader Title="{Binding [Studio.Run.Title], Source={x:Static services:I18n.Instance}}"
                         Subtitle="{Binding [Studio.Run.ScreenSub], Source={x:Static services:I18n.Instance}}">
      <StackPanel Orientation="Horizontal">
      <!-- lot 12: « MODE », mono, before the switch; the header's subtitle says what each one does. -->
      <TextBlock Style="{StaticResource MonoText}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                 Text="{Binding [Studio.Run.ModeLabel], Source={x:Static services:I18n.Instance}}"/>
      <Border Style="{StaticResource SegmentedGroup}"
              ToolTip="{Binding [Studio.Run.ModeHint], Source={x:Static services:I18n.Instance}}">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ModeTrial" Command="{Binding ShowTrialCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTrial}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="flask-conical" Size="16" Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="{Binding [Studio.Run.ModeTrial], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <Button x:Name="ModeReal" Command="{Binding ShowRealCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsReal}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="play" Size="16" Margin="0,0,7,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="{Binding [Studio.Run.ModeReal], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      </StackPanel>
    </controls:PageHeader>

    <views:LaunchTabView x:Name="RealLauncher" DataContext="{Binding Real}"
                         Visibility="{Binding DataContext.IsReal, RelativeSource={RelativeSource AncestorType=views:RunScreenView}, Converter={StaticResource BooleanToVisibility}}"/>
    <views:LaunchTabView x:Name="TrialLauncher" DataContext="{Binding Trial}"
                         Visibility="{Binding DataContext.IsTrial, RelativeSource={RelativeSource AncestorType=views:RunScreenView}, Converter={StaticResource BooleanToVisibility}}"/>
  </StackPanel>
</UserControl>
