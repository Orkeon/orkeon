<!-- The "MCP" settings tab (STUDIO-21, expert only): the switch and one card per MCP server a
     run connects before the team starts. DataContext: McpSectionViewModel (bound as Settings.Config.Mcp).
     The transport values are the runtime's own spelling (Stdio, Sse) and stay untranslated. -->
<UserControl x:Class="Orkeon.Studio.Wpf.Views.McpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:Orkeon.Studio.Wpf.ViewModels.Config"
             xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
             xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
             xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">
  <StackPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" VerticalAlignment="Top"
                  Command="{Binding AddServerCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Kind="plus" Size="12" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding [Studio.Settings.McpAdd], Source={x:Static services:I18n.Instance}}"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:LucideIcon Kind="plug-zap" Size="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource CardTitle}" ToolTip="MCP"
                       Text="{Binding [Studio.Settings.McpTitle], Source={x:Static services:I18n.Instance}}"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                   Text="{Binding [Studio.Settings.McpIntro], Source={x:Static services:I18n.Instance}}"/>
        <CheckBox Margin="0,14,0,0" IsChecked="{Binding Enabled}"
                  Content="{Binding [Studio.Settings.McpEnabled], Source={x:Static services:I18n.Instance}}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                   Text="{Binding [Studio.Settings.McpEmpty], Source={x:Static services:I18n.Instance}}"
                   Visibility="{Binding HasServers, Converter={StaticResource InverseBooleanToVisibility}}"/>
      </StackPanel>
    </Border>

    <!-- one card per server; every field writes in place as it is typed -->
    <ItemsControl ItemsSource="{Binding Servers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhostDanger}" VerticalAlignment="Top"
                        Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=views:McpView}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="trash-2" Size="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding [Studio.Settings.McpRemove], Source={x:Static services:I18n.Instance}}"/>
                  </StackPanel>
                </Button>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                             Text="{Binding [Studio.Settings.McpId], Source={x:Static services:I18n.Instance}}"/>
                  <TextBox Style="{StaticResource InputMono}" MaxWidth="320" HorizontalAlignment="Left"
                           Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </DockPanel>

              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                         Text="{Binding [Studio.Settings.McpTransport], Source={x:Static services:I18n.Instance}}"/>
              <ComboBox MaxWidth="200" HorizontalAlignment="Left"
                        ItemsSource="{x:Static config:McpSectionViewModel.Transports}"
                        SelectedItem="{Binding Transport}"/>

              <StackPanel Visibility="{Binding IsStdio, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                           Text="{Binding [Studio.Settings.McpCommand], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                           Text="{Binding [Studio.Settings.McpArgs], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMultilineMono}" Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                           Text="{Binding [Studio.Settings.McpEnv], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMultilineMono}" Text="{Binding EnvText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Studio.Settings.McpEnvHint], Source={x:Static services:I18n.Instance}}"/>
              </StackPanel>

              <StackPanel Visibility="{Binding IsSse, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                           Text="{Binding [Studio.Settings.McpUrl], Source={x:Static services:I18n.Instance}}"/>
                <TextBox Style="{StaticResource InputMono}" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                          Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibility}}">
                <controls:LucideIcon Kind="triangle-alert" Size="12" Foreground="{DynamicResource DangerBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Text="{Binding Problem}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
