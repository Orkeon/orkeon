<!-- Orkeon Studio — control styles. Requires Tokens.(Light|Dark).xaml + Icons.xaml merged first.
     Every brush is DynamicResource so the theme can be swapped at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls">

  <!-- ══ Fonts (see Fonts/FONTS.md). Absolute pack URIs: a './Fonts/' relative form would
       resolve against THIS dictionary's base (/Themes/), where no font exists, and silently
       fall back to the system faces. ══ -->
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Bricolage Grotesque, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">pack://application:,,,/Fonts/#Hanken Grotesk, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas</FontFamily>

  <!-- ══ Typography ══ -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style x:Key="SubTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <!-- Mono uppercase micro-label. WPF has no text-transform: WRITE THE TEXT UPPERCASE. -->
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ══ Card ══ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Recessed well (code blocks, command preview) -->
  <Style x:Key="Well" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineFaintBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="13,10"/>
  </Style>

  <!-- ══ Buttons ══ -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,7"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}"/>
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 31x31 icon button (title bar: theme, tour) -->
  <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="31"/>
    <Setter Property="Height" Value="31"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
  </Style>
  <!-- 44px-wide window caption button -->
  <Style x:Key="CaptionBtn" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionBtnClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ Sidebar nav item (RadioButton, GroupName="Nav") ══ -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="11,8">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsChecked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ Inputs ══ -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InputMono" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ══ Badge: <Border Style="Badge*"><TextBlock .../></Border> ══ -->
  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="BadgeBase" TargetType="Border">
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="BadgeOk" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style x:Key="BadgeWarn" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style x:Key="BadgeFail" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style x:Key="BadgeRun" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ══ Selectable "pick row" (presets, radio cards) — RadioButton ══ -->
  <Style x:Key="PickRow" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="13,11">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="dot" Width="15" Height="15" StrokeThickness="1.5"
                       Stroke="{DynamicResource LineStrongBrush}" Fill="{DynamicResource PaperSunkBrush}"
                       VerticalAlignment="Center" Margin="0,0,11,0"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter TargetName="dot" Property="StrokeThickness" Value="4.5"/>
              <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ LucideIcon default style ══ -->
  <Style TargetType="{x:Type controls:LucideIcon}">
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <!-- ══ Segmented pill (MODE, EN/FR) — ONE container, flat halves; the active half is
       accent-weak. CornerRadius is bounded to height/2 (the audit's standing WPF rule:
       never a raw 999 on a control). ══ -->
  <Style x:Key="SegmentedGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Height" Value="27"/>
    <Setter Property="CornerRadius" Value="13.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="SegmentBtn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="12.5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentBtnMono" TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <!-- ══ Implicit control styles (audit T-04): no stock Windows chrome anywhere.
       Same recipe as Input: paper-sunk field, line-strong border, radius 9. ══ -->

  <Style TargetType="TextBox" BasedOn="{StaticResource Input}"/>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="4,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1" CornerRadius="9">
                    <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,11,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Fade" VerticalOffset="4">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="0,4"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                <ScrollViewer>
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource PaperSunkBrush}"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
              <Path x:Name="tick" Data="M3,8 L6.5,11.5 13,4.5" Stroke="{DynamicResource AccentFgBrush}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Visibility="Collapsed" Margin="0"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Ellipse x:Name="dot" Width="15" Height="15" VerticalAlignment="Center"
                     Fill="{DynamicResource PaperSunkBrush}"
                     Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5"/>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="dot" Property="StrokeThickness" Value="4.5"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scrollbars: a quiet thumb over a transparent track. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource LineStrongBrush}" CornerRadius="4" Margin="2,1"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource LineStrongBrush}" CornerRadius="4" Margin="1,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
