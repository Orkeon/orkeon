<!-- Orkeon Studio — control styles. Requires Tokens.(Light|Dark).xaml + Icons.xaml merged first.
     Every brush is DynamicResource so the theme can be swapped at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls">

  <!-- ══ Fonts (see Fonts/FONTS.md). Absolute pack URIs: a './Fonts/' relative form would
       resolve against THIS dictionary's base (/Themes/), where no font exists, and silently
       fall back to the system faces. ══ -->
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Bricolage Grotesque, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">pack://application:,,,/Fonts/#Hanken Grotesk, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas</FontFamily>

  <!-- ══ Typography ══ -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style x:Key="SubTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <!-- Mono uppercase micro-label. WPF has no text-transform: WRITE THE TEXT UPPERCASE. -->
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ══ Card ══ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Recessed well (code blocks, command preview) -->
  <Style x:Key="Well" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineFaintBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="13,10"/>
  </Style>

  <!-- ══ Buttons ══ -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,7"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}"/>
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Solid danger: the confirm half of an in-place «Supprimer cette équipe ?» banner.
       Reached only from an armed confirmation, never from a resting action row. -->
  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="12,0"/>
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 31x31 icon button (title bar: theme, tour) -->
  <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="31"/>
    <Setter Property="Height" Value="31"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
  </Style>
  <!-- 44px-wide window caption button -->
  <Style x:Key="CaptionBtn" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionBtnClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Ghost that announces itself on hover: neutral at rest so a destructive action
       never shouts from a resting row, danger the moment the pointer commits to it. -->
  <Style x:Key="BtnGhostDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ Sidebar nav item (RadioButton, GroupName="Nav") ══ -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="11,8">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsChecked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The draft note under «Créer une équipe» (T-09). Indented past the nav icon so it
       reads as belonging to that entry rather than as a row of its own. -->
  <Style x:Key="DraftNote" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,1,0,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource AccentWeakBrush}" CornerRadius="8"
                  Padding="35,7,11,8">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SkyBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ The conversation panel's own pieces (30/08 mock, ChatThread.dc.html) ══ -->

  <!-- The recap header is a full-width row that toggles, not a button that looks like one. -->
  <Style x:Key="RecapHeader" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" Padding="16,10"
                  BorderBrush="{DynamicResource LineFaintBrush}" BorderThickness="0,0,0,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The precision chips under the pinned brief: 22 high, radius exactly 11. -->
  <Style x:Key="BriefChip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Margin" Value="0,0,5,5"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Text that acts: no chrome at all, underlined on hover. Used for «Modifier» on the
       brief card and «Passer cette question» under the input. -->
  <Style x:Key="LinkBtn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The language badge: mono, 28 high, radius exactly 14 — the pill the mock draws. -->
  <Style x:Key="LangBtn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="14" Padding="10,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One row of the language menu. -->
  <Style x:Key="LangRow" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="8,7">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ Inputs ══ -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InputMono" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ══ Badge: <Border Style="Badge*"><TextBlock .../></Border> ══
       WPF rule (unlike CSS): CornerRadius is NOT clamped to height/2 — an oversized
       value deforms the corners into ogives. Every pill therefore carries a fixed
       Height and CornerRadius = Height / 2, exactly. -->
  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="BadgeBase" TargetType="Border">
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="BadgeNeutral" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkMutedBrush}"/>
  </Style>
  <Style x:Key="BadgeSky" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource SkyBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkBrush}"/>
  </Style>
  <Style x:Key="BadgeOk" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style x:Key="BadgeWarn" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style x:Key="BadgeFail" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style x:Key="BadgeRun" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ══ Tool / mount chip — THE one chip recipe (v3 W-03): mono 11.5, paper-sunk,
       line-faint hairline, pill (Height 22, radius exactly 11 — the h/2 rule above).
       Usage: <Border Style="ToolChip"><TextBlock Style="ToolChipText" .../></Border> ══ -->
  <Style x:Key="ToolChip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineFaintBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="ToolChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Metric chip (tokens, cache, wall time) — same recipe, one size down:
       Height 20, radius exactly 10, mono 11. -->
  <Style x:Key="MetricChip" TargetType="Border" BasedOn="{StaticResource ToolChip}">
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style x:Key="MetricChipText" TargetType="TextBlock" BasedOn="{StaticResource ToolChipText}">
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <!-- Small ACTION chip next to chips («Autoriser un dossier», «Changer les dossiers»):
       surface fill, accent text, real hover/pressed/disabled states — the inline-template
       pills had none (v3 D-02). ARBITRATION (30/08 mock): this one IS a pill — the mock
       gives it min-height 24 / border-radius 12 / padding 0 11, so radius = height/2 holds.
       The «no pill» rule of T-17 targets the VERDICT buttons («Ça me va», «Abandonner»),
       which stay rectangles at radius 10 — not this chip. -->
  <Style x:Key="ChipAction" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Card-header mono meta (slug, file name) sitting on the title's centre line —
       the one recipe for «titre + slug + actions» headers (v3 W-05). -->
  <Style x:Key="CardHeaderMeta" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- ══ Wizard stepper pill (Décrire ▸ Composer ▸ Essayer ▸ Adopter) and the
       selectable chip of the step-1 precisions. Both lived inline in CreateTeamView
       until the 30/08 mock pass; règle transverse 1 says a shared defect is fixed on
       the shared style, so they live here. Geometry is the h/2 rule with a FIXED
       Height — 28/14 — because a Padding-only pill has no height WPF can halve. ══ -->
  <Style x:Key="StepPill" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="13,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SelectableChip" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="14" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Card-header title: the «titre + méta mono + actions» row wants 13/700, one size
       under the big CardTitle that opens a card. Both sit on the same centre line as the
       meta beside them — that alignment is the whole recipe (T-20). -->
  <Style x:Key="CardHeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- The same meta, one size down, for a FILE name rather than a slug (T-21). Deliberately
       a variant: CardHeaderMeta stays at 10, which is what T-20 pins everywhere else. -->
  <Style x:Key="CardHeaderFile" TargetType="TextBlock" BasedOn="{StaticResource CardHeaderMeta}">
    <Setter Property="FontSize" Value="9.5"/>
  </Style>

  <!-- ══ Selectable "pick row" (presets, radio cards) — RadioButton ══ -->
  <Style x:Key="PickRow" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="13,11">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="dot" Width="15" Height="15" StrokeThickness="1.5"
                       Stroke="{DynamicResource LineStrongBrush}" Fill="{DynamicResource PaperSunkBrush}"
                       VerticalAlignment="Center" Margin="0,0,11,0"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter TargetName="dot" Property="StrokeThickness" Value="4.5"/>
              <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ LucideIcon default style ══ -->
  <Style TargetType="{x:Type controls:LucideIcon}">
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <!-- ══ Segmented pill (MODE, EN/FR) — ONE container, flat halves; the active half is
       accent-weak. CornerRadius is bounded to height/2 (the audit's standing WPF rule:
       never a raw 999 on a control). ══ -->
  <Style x:Key="SegmentedGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="SegmentBtn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="12"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentBtnMono" TargetType="Button" BasedOn="{StaticResource SegmentBtn}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <!-- ══ Implicit control styles (audit T-04): no stock Windows chrome anywhere.
       Same recipe as Input: paper-sunk field, line-strong border, radius 9. ══ -->

  <Style TargetType="TextBox" BasedOn="{StaticResource Input}"/>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="4,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentWeakBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1" CornerRadius="9">
                    <!-- The real Lucide chevron rather than three hand-drawn segments, and
                         on the muted ink the mock uses: a chevron drawn twice drifts twice. -->
                    <controls:LucideIcon Kind="chevron-down" Size="13"
                                         Foreground="{DynamicResource InkMutedBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Fade" VerticalOffset="4">
              <!-- Margin leaves room for the shadow: an AllowsTransparency popup clips
                   anything drawn outside its own child bounds. -->
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="0,4" Margin="10,0,10,14"
                      Effect="{DynamicResource ShadowMd}"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                <ScrollViewer>
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource PaperSunkBrush}"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
              <Path x:Name="tick" Data="M3,8 L6.5,11.5 13,4.5" Stroke="{DynamicResource AccentFgBrush}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Visibility="Collapsed" Margin="0"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Ellipse x:Name="dot" Width="15" Height="15" VerticalAlignment="Center"
                     Fill="{DynamicResource PaperSunkBrush}"
                     Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5"/>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="dot" Property="StrokeThickness" Value="4.5"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scrollbars: a quiet thumb over a transparent track. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource LineStrongBrush}" CornerRadius="4" Margin="2,1"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource LineStrongBrush}" CornerRadius="4" Margin="1,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
