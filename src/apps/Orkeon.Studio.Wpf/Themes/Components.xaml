<!-- Orkeon Studio — the shared components of the refonte (2026-10): Alert (R7), Badge (R8),
     PropertyRow (R6), PageHeader (R3). Their code is in Controls/Components.cs; ActionBar (R5)
     draws itself. Merged after Studio.xaml, whose fonts and button styles it uses.
     Every brush is DynamicResource so the theme can be swapped at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Orkeon.Studio.Wpf.Controls"
                    xmlns:services="clr-namespace:Orkeon.Studio.Wpf.Services"
                    xmlns:views="clr-namespace:Orkeon.Studio.Wpf.Views">

  <!-- A converter used INSIDE a theme template is declared by the theme: the theme cannot
       reach the converters App.xaml declares (DesignTokenConformityTests, STUDIO-21). -->
  <views:StringPresentToVisibilityConverter x:Key="AlertDetailsVisibility"/>
  <BooleanToVisibilityConverter x:Key="AlertBoolVisibility"/>

  <!-- ══ Alert: icon · message (+ content, + folded technical details) · actions ══ -->
  <Style TargetType="{x:Type controls:Alert}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource InfoWeakBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Tag" Value="info"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Alert}">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="14,12" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <controls:LucideIcon x:Name="icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="16"
                                   Foreground="{TemplateBinding BorderBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter Margin="0,6,0,0" x:Name="body"/>
                <StackPanel x:Name="details" Margin="0,6,0,0"
                            Visibility="{Binding Details, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AlertDetailsVisibility}}">
                  <ToggleButton x:Name="detailsToggle" HorizontalAlignment="Left" Cursor="Hand" Focusable="True"
                                Foreground="{DynamicResource InkMutedBrush}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                          <controls:LucideIcon x:Name="chev" Kind="chevron-down" Size="14" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                     Text="{Binding [Studio.Common.TechnicalDetails], Source={x:Static services:I18n.Instance}}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chev" Property="Kind" Value="chevron-up"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <Border Style="{StaticResource Well}" Margin="0,6,0,0"
                          Visibility="{Binding IsChecked, ElementName=detailsToggle, Converter={StaticResource AlertBoolVisibility}}">
                    <TextBox Text="{Binding Details, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                             Style="{StaticResource InputMultilineMono}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" MinLines="1"/>
                  </Border>
                </StackPanel>
              </StackPanel>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Actions}" VerticalAlignment="Center"
                                Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="body" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsBanner" Value="True">
              <Setter TargetName="bd" Property="Padding" Value="16,12"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Tag" Value="circle-check"/>
      </Trigger>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Tag" Value="triangle-alert"/>
      </Trigger>
      <Trigger Property="Tone" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Tag" Value="circle-x"/>
      </Trigger>
      <Trigger Property="Tone" Value="Info">
        <Setter Property="Tag" Value="info"/>
      </Trigger>
      <Trigger Property="Tone" Value="Neutral">
        <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
        <Setter Property="Tag" Value="info"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ Badge: a 22 px pill, radius exactly 11 (the h/2 rule of BadgeBase). ══ -->
  <Style TargetType="{x:Type controls:Badge}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Badge}">
          <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="10,0" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Info">
        <Setter Property="Background" Value="{DynamicResource InfoWeakBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ PropertyRow: label (104 px, tertiary ink) · value · 28 px secondary button ══ -->
  <Style TargetType="{x:Type controls:PropertyRow}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PropertyRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource InkFaintBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Action}" VerticalAlignment="Center"
                              Margin="12,0,0,0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ TechBlock (R18): the engine's text as is — mono, selectable, wrapped, on a well. A
       read-only TextBox so it can be selected and copied; past MaxHeight it scrolls inside. ══ -->
  <Style TargetType="{x:Type controls:TechBlock}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="MaxHeight" Value="240"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineFaintBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:TechBlock}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12,8" SnapsToDevicePixels="True">
            <TextBox Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                     Foreground="{TemplateBinding Foreground}" Background="Transparent"
                     BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ Disclosure (R16): the ghost button «label + chevron» over the folded content. The
       chevron points down while closed, up while open; the content is collapsed while closed.
       The button bleeds 8 px to the left so its label lines up with the text above it. ══ -->
  <Style TargetType="{x:Type controls:Disclosure}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Disclosure}">
          <StackPanel>
            <ToggleButton x:Name="toggle" HorizontalAlignment="Left" Height="32" Margin="-8,0,0,0" Cursor="Hand"
                          FocusVisualStyle="{StaticResource FocusRing}" Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="chrome" Background="Transparent" CornerRadius="8" Padding="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                      <controls:LucideIcon x:Name="chev" Kind="chevron-down" Size="16" Margin="6,0,0,0"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="chev" Property="Kind" Value="chevron-up"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="chrome" Property="Background" Value="{DynamicResource PaperSunkBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="body" Margin="0,6,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="body" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ PageHeader: title + one-line subtitle on the left, page actions on the right ══ -->
  <Style TargetType="{x:Type controls:PageHeader}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PageHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
              <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource SubTitle}" Margin="0,4,0,0"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip="{TemplateBinding Subtitle}"/>
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The row of buttons of a page header, an alert or a form footer: 8 px apart. -->
  <Style x:Key="ActionRow" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ══ StepTabs (R14, R13): the vertical classeur of a step with sections. A fixed 220 px
       column of tabs on the left, the pane on the right. The pane slides 1 px under the column,
       so its left border is the column's last pixel: every tab ends on it, at the same left and
       the same width; the active one only opens its right edge (it paints over that pixel), and
       the pane loses its top-left radius. No ring, no shadow on the pane.
       Under the tabs, at a fixed place in the 220 px column: SideContent, the Novice help
       « What this step does » (R21), nothing in Expert.
       Grouped (lot 11, D05): the groups as a horizontal bar above — sentence case in 14/600, the
       count of sections in mono meta, the sand dot of a group waiting; the active group in the
       accent over a 2 px rule. The column then lists the active group's tabs only
       (StepTab.IsOutsideActiveGroup). ══ -->
  <Style TargetType="{x:Type controls:StepTabs}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StepTabs}">
          <DockPanel>
          <Border x:Name="GroupBar" DockPanel.Dock="Top" Margin="0,0,0,16" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource LineBrush}" Visibility="Collapsed">
            <ItemsControl x:Name="PART_GroupBar" Focusable="False" KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="None"
                          ItemsSource="{Binding Groups, RelativeSource={RelativeSource TemplatedParent}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type controls:StepTabGroup}">
                  <Button x:Name="GroupButton" Margin="0,0,24,-1" Height="40" Cursor="Hand"
                          FocusVisualStyle="{StaticResource FocusRing}"
                          Command="{Binding SelectGroupCommand, RelativeSource={RelativeSource AncestorType=controls:StepTabs}}"
                          CommandParameter="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                          <ContentPresenter VerticalAlignment="Center"/>
                          <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel x:Name="GroupLine" Orientation="Horizontal" TextElement.Foreground="{DynamicResource InkMutedBrush}">
                      <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Label}"/>
                      <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource InkFaintBrush}" Text="{Binding Count}"/>
                      <Ellipse x:Name="GroupDot" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                               Fill="{DynamicResource WarningIconBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="GroupLine" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                    <Trigger SourceName="GroupButton" Property="IsMouseOver" Value="True">
                      <Setter TargetName="GroupLine" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding HasDot}" Value="True">
                      <Setter TargetName="GroupDot" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- A group whose sections all hide (the expert-only ones in Novice) leaves the bar. -->
                    <DataTrigger Binding="{Binding Count}" Value="0">
                      <Setter TargetName="GroupButton" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Above the pane, so the active tab's 1 px overlap hides the pane's border. -->
            <StackPanel Grid.Column="0" Panel.ZIndex="1">
              <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
              <!-- R21: the help's fixed place, right under the last tab, in the column's width less a
                   12 px gutter to the pane. Empty in Expert; the Novice help card otherwise. -->
              <ContentPresenter x:Name="SideSlot" Content="{TemplateBinding SideContent}" Margin="0,12,12,0"/>
            </StackPanel>
            <!-- -1 px: the pane's left border sits on the column's last pixel (see the header). -->
            <Border Grid.Column="1" Margin="-1,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="0,14,14,14" Padding="20,18" KeyboardNavigation.TabIndex="2">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </Grid>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="HasGroups" Value="True">
              <Setter TargetName="GroupBar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ StepTab (R13): state mark · title · 12 px state subtitle, 44 px at the least. Every tab
       starts at the column's left edge and ends on the pane's border (the column's last pixel):
       same left, same width, selected or not. Inactive: the surface-2 background, a faint border,
       no right border — the pane's line closes it — and secondary ink; hovered, it turns white
       with the line border, and stays in place. Selected: the pane's background, painted over the
       pane's border, so its right edge opens onto the pane. The keyboard focus draws the accent ring.
       The mark is an icon of its own, never a radio-like ring: done = green circle-check,
       verified = green check, expected / warning = 8 px sand dot (warning also tints the
       subtitle), empty = grey dashed circle (upcoming or optional), working = turning ring.
       The title is 14/600 and wraps to a second line rather than being cut (B06). ══ -->
  <Style TargetType="{x:Type controls:StepTab}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StepTab}">
          <!-- The grouped variant (lot 11): the group's title is in the classeur's bar, not over the tab. -->
          <StackPanel x:Name="TabRoot">
          <Border x:Name="Chrome" MinHeight="44" Margin="0,0,1,6" Padding="12,8,14,8" CornerRadius="10,0,0,10"
                  Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineFaintBrush}"
                  BorderThickness="1,1,0,1" SnapsToDevicePixels="True">
            <DockPanel>
              <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,10,0" VerticalAlignment="Top">
                <controls:LucideIcon x:Name="EmptyMark" Kind="circle-dashed" Size="16" Foreground="{DynamicResource NeutralDotBrush}"/>
                <Ellipse x:Name="ExpectedMark" Width="8" Height="8" Fill="{DynamicResource WarningIconBrush}" Visibility="Collapsed"/>
                <controls:LucideIcon x:Name="DoneMark" Kind="circle-check" Size="16" Foreground="{DynamicResource SuccessBrush}"
                                     Visibility="Collapsed"/>
                <controls:LucideIcon x:Name="VerifiedMark" Kind="check" Size="16" Foreground="{DynamicResource SuccessBrush}"
                                     Visibility="Collapsed"/>
                <controls:LucideIcon x:Name="WorkingMark" Kind="loader-circle" Size="16" Foreground="{DynamicResource AccentBrush}"
                                     RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                  <controls:LucideIcon.RenderTransform>
                    <RotateTransform/>
                  </controls:LucideIcon.RenderTransform>
                  <controls:LucideIcon.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                           From="0" To="360" Duration="0:0:1"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </controls:LucideIcon.Triggers>
                </controls:LucideIcon>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <!-- A string header becomes a TextBlock under this presenter: the implicit style
                     makes it wrap (two lines for the long Settings RAG title), never cut. -->
                <ContentPresenter x:Name="Title" ContentSource="Header" TextElement.FontSize="14"
                                  TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource InkMutedBrush}">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap"/>
                      <Setter Property="LineHeight" Value="19"/>
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock x:Name="Sub" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource InkFaintBrush}"
                           Text="{TemplateBinding Subtitle}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsOutsideActiveGroup" Value="True">
              <Setter TargetName="TabRoot" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="State" Value="Warning">
              <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="ExpectedMark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </Trigger>
            <Trigger Property="State" Value="Verified">
              <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="VerifiedMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="State" Value="Done">
              <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="DoneMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="State" Value="Working">
              <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="WorkingMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="State" Value="Expected">
              <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="ExpectedMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            </MultiTrigger>
            <!-- C15: the same left and the same right end; one more pixel that paints over the
                 pane's border is all the selected tab changes in its geometry. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="1"/>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
              <Setter TargetName="Chrome" Property="Margin" Value="0,0,0,6"/>
              <Setter TargetName="Title" Property="TextElement.Foreground" Value="{DynamicResource InkBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
