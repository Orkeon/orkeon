<!-- Orkeon Studio — dark theme tokens ("deep ocean night", Crew Console dark override).
     Thresholds: text 4.5:1, field borders and components 3:1 (WCAG); disabled states and
     panel borders >= 3:1 for comfort. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- surfaces -->
  <SolidColorBrush x:Key="PaperBrush"       Color="#0F1E2A"/>
  <SolidColorBrush x:Key="PaperSunkBrush"   Color="#0A1620"/>
  <SolidColorBrush x:Key="SurfaceBrush"     Color="#16293B"/>
  <SolidColorBrush x:Key="Surface2Brush"    Color="#1D3445"/>
  <!-- hrm R20: the tinted grounds are lifted so they stay visible on the surface (#16293B). -->
  <SolidColorBrush x:Key="SkyBrush"         Color="#1B3E4A"/>
  <!-- editable fields (T-31): on a dark ground the field is a well deeper than the surface,
       never a white rectangle; the line stays visible against both. -->
  <SolidColorBrush x:Key="FieldBrush"       Color="#091420"/>
  <!-- UX lot 09: 3.50:1 on surface, 4.37:1 on field, 4.20:1 on the scrim. -->
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#5C7F99"/>
  <SolidColorBrush x:Key="FieldShadowBrush" Color="#33000000"/>

  <!-- text -->
  <SolidColorBrush x:Key="InkBrush"         Color="#EAF1F3"/>
  <SolidColorBrush x:Key="InkMutedBrush"    Color="#A9BCC6"/>
  <!-- UX lot 09: faint 5.68:1 on surface, 4.93:1 on surface-2; disabled 3.56:1 on surface, 4.07:1 on paper. -->
  <SolidColorBrush x:Key="InkFaintBrush"    Color="#8FA3B0"/>
  <SolidColorBrush x:Key="InkDisabledBrush" Color="#6B7F8C"/>

  <!-- lines -->
  <SolidColorBrush x:Key="LineBrush"        Color="#243A4C"/>
  <!-- UX lot 09: strong line 2.59:1 on surface, 3.19:1 on paper-sunk, 3.11:1 on the scrim (modal border). -->
  <SolidColorBrush x:Key="LineStrongBrush"  Color="#4A6A80"/>
  <SolidColorBrush x:Key="LineFaintBrush"   Color="#1B303F"/>
  <!-- UX lot 09: 1 px ring around the header mark so its square stays visible on the dark header. -->
  <SolidColorBrush x:Key="LogoRingBrush"    Color="#4A6A80"/>

  <!-- accent: the charter teal (refonte R1, 2026-10). The former ocean blue stays as
       SecondaryBrush, for charts and secondary surfaces only. -->
  <SolidColorBrush x:Key="AccentBrush"       Color="#3DA0AC"/>
  <SolidColorBrush x:Key="AccentHoverBrush"  Color="#54B4BF"/>
  <SolidColorBrush x:Key="AccentActiveBrush" Color="#2E8A95"/>
  <SolidColorBrush x:Key="AccentWeakBrush"   Color="#1B3E4A"/>
  <SolidColorBrush x:Key="AccentInkBrush"    Color="#54B4BF"/>
  <SolidColorBrush x:Key="AccentFgBrush"     Color="#07171C"/>
  <SolidColorBrush x:Key="SecondaryBrush"    Color="#5FA9D4"/>
  <SolidColorBrush x:Key="MarkBrush"         Color="#3DA0AC"/>

  <!-- status (see Tokens.Light.xaml). R20: every Weak ground is light enough to read as a
       tint on the dark surface, every Ink light enough to read on its Weak ground. -->
  <SolidColorBrush x:Key="SuccessBrush"       Color="#54B496"/>
  <SolidColorBrush x:Key="SuccessWeakBrush"   Color="#1A3D33"/>
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="#2E5E4F"/>
  <SolidColorBrush x:Key="SuccessInkBrush"    Color="#7FC9AE"/>
  <SolidColorBrush x:Key="WarningIconBrush"   Color="#DCA646"/>
  <SolidColorBrush x:Key="WarningWeakBrush"   Color="#3D3318"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#63522A"/>
  <SolidColorBrush x:Key="WarningInkBrush"    Color="#E6C079"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="#DD6B5C"/>
  <SolidColorBrush x:Key="DangerFgBrush"      Color="#07171C"/>
  <SolidColorBrush x:Key="DangerWeakBrush"    Color="#42231F"/>
  <SolidColorBrush x:Key="DangerBorderBrush"  Color="#6A3830"/>
  <SolidColorBrush x:Key="DangerInkBrush"     Color="#E0837A"/>
  <SolidColorBrush x:Key="InfoBrush"          Color="#3DA0AC"/>
  <SolidColorBrush x:Key="InfoWeakBrush"      Color="#1B3E4A"/>
  <SolidColorBrush x:Key="InfoBorderBrush"    Color="#2D5D6A"/>
  <SolidColorBrush x:Key="NeutralDotBrush"    Color="#8FA3B0"/> <!-- UX lot 09: 5.68:1 on surface -->
  <SolidColorBrush x:Key="SandWeakBrush"      Color="#3D3318"/>

  <!-- log console (unchanged) -->
  <SolidColorBrush x:Key="ConsoleBgBrush"    Color="#0B1822"/>
  <SolidColorBrush x:Key="ConsoleFgBrush"    Color="#9FB2C0"/>
  <SolidColorBrush x:Key="ConsoleCmdBrush"   Color="#7FBCDF"/>
  <SolidColorBrush x:Key="ConsoleOkBrush"    Color="#7FC9AE"/>
  <SolidColorBrush x:Key="ConsoleErrBrush"   Color="#E0837A"/>
  <SolidColorBrush x:Key="ConsoleWarnBrush"  Color="#E3B964"/>

  <!-- The mark as a raw Color: a gradient stop cannot take a Brush, and the busy
       hairline is a gradient sweep so it stays right at every panel width. -->
  <Color x:Key="MarkColor">#3DA0AC</Color>

  <!-- overlays and illustration plates (identical in both themes, like the console:
       the modal veil and the tour mask are always "deep ocean at 55/62 %", and the
       About/splash plate stays light so the mascot keeps its ground) -->
  <SolidColorBrush x:Key="ScrimBrush"             Color="#8C09141C"/>
  <SolidColorBrush x:Key="TourScrimBrush"         Color="#9E09141C"/>
  <SolidColorBrush x:Key="IllustrationPanelBrush" Color="#EFF3F3"/>

  <!-- ══ Elevation (see Tokens.Light.xaml). On a dark ground the navy tint reads as a
       smudge and the light recipe disappears: pure black, carried deeper. ══ -->
  <DropShadowEffect x:Key="ShadowXs" Color="#000000" Direction="270" ShadowDepth="1"
                    BlurRadius="3" Opacity="0.30" RenderingBias="Quality"/>
  <DropShadowEffect x:Key="ShadowMd" Color="#000000" Direction="270" ShadowDepth="8"
                    BlurRadius="34" Opacity="0.34" RenderingBias="Quality"/>
  <DropShadowEffect x:Key="ShadowLg" Color="#000000" Direction="270" ShadowDepth="14"
                    BlurRadius="64" Opacity="0.55" RenderingBias="Quality"/>

</ResourceDictionary>
