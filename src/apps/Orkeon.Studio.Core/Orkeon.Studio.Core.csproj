<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Library only: no UI, no entry point. The three Studio front-ends
         (WPF + two Terminal.Gui apps) are the only consumers. -->
    <IsPackable>false</IsPackable>

    <!-- Package Metadata -->
    <Authors>Orkeon Contributors</Authors>
    <Description>UI-agnostic core of Orkeon Studio: lossless appsettings.json editing model, LLM presets, VFS mount editing, validation and settings locations.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    SPEC §7: Core is referenced by three self-contained front-ends, so every transitive
    dependency is paid three times on disk. Orkeon.Infrastructure (constants only) and
    Orkeon.Hosting (one path helper) together dragged in ONNX, tree-sitter and the local
    embedding model — ~230 MB per published app. Both were dropped; the handful of constants
    and the ~40 lines of RunnerSettings path logic are duplicated in Core and pinned against
    the originals by ConstantDriftTests in Orkeon.Studio.Core.Tests, which references them.
    Keep this list slim: Domain and Rag.Abstractions have no heavy transitive dependency.
  -->
  <ItemGroup>
    <!-- ADR-009: the virtual roots the runner mounts, read from the satellite instead of
         copied here and pinned pairwise by a drift test. -->
    <!-- ADR-009: provider endpoints, read from the satellite instead of copied here. -->
    <!-- ADR-009: the WIN-01 wording, worded once. -->
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Llm\Orkeon.Constants.Llm.csproj" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.FileSystem\Orkeon.Constants.FileSystem.csproj" />
    <!-- FileSystemMount (mount round-trip), LlmDefaults, [SuppressVfsCompliance]. -->
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <!-- RagProfilePresets — the closed list of RAG profile names offered by the UIs. -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Abstractions\Orkeon.Rag.Abstractions.csproj" />
  </ItemGroup>

</Project>
