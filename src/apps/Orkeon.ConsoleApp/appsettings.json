{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Orkeon": {
    "DefaultMemoryProvider": "InMemory",
    "Execution": {
      "MaxIterations": 20,
      "DefaultTimeout": 60
    },
    "FileSystem": {
      "Mounts": [
        "/tmp/orkeon-console:/tmp:rw"
      ]
    }
  }
}