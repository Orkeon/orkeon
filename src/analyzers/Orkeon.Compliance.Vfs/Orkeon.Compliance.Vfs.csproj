<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageId>Orkeon.Compliance.Vfs</PackageId>
    <Description>Roslyn analyzer that forbids direct System.IO usage in Orkeon framework code. Routes all filesystem access through IFileSystemService.</Description>
    <PackageTags>Orkeon;Roslyn;Analyzer;VFS;Compliance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A Roslyn component declares the OLDEST compiler it must load in, never the newest.
      Referencing the repo's 5.9.0 pin made csc refuse this assembly on any SDK whose
      Roslyn is older (CS9057) — a warning, so the analyzer and the generator went silently
      missing and the build failed 100+ lines later on the partials nobody had generated.
      VersionOverride keeps the floor here without moving the pin every other project uses.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- <ItemGroup> -->
    <!-- <None Remove="bin\Debug\netstandard2.0\\Orkeon.Compliance.Vfs.dll" /> -->
  <!-- </ItemGroup> -->


  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
