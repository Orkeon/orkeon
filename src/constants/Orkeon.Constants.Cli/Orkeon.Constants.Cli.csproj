<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Constants.Cli</PackageId>
    <!-- PUB-25: out of the published set — consumed only by in-repo executables (source reference); re-promote if the Hosting/Cli family ever ships to NuGet.org. -->
    <IsPackable>false</IsPackable>
    <Description>Shared CLI vocabulary for Orkeon: the option names the runners accept and the tooling predicts. Depends on nothing.</Description>
    <PackageTags>AI;Agents;Orkeon;Constants;Cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    ADR-009: a satellite references NO project and NO package. That is what makes it
    referenceable from anywhere, Orkeon.Domain included, without inverting any layer.
    The only ProjectReference it carries is the VFS analyzer, injected into every src
    project by Directory.Build.props as OutputItemType="Analyzer" — build time, never
    shipped. So the promise is exact: no runtime dependency.
  -->

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
