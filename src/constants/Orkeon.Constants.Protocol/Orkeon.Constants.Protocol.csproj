<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Constants.Protocol</PackageId>
    <!-- PUB-25: no package of its own. Orkeon.Application references it (GAP-32: the events of the
         in-process streaming kickoff carry its kinds), so its assembly ships inside the `Orkeon`
         umbrella package, like the other satellites of the core closure. -->
    <IsPackable>false</IsPackable>
    <Description>Shared wire vocabulary for Orkeon: the event kinds a run streams between the runner process and whatever is watching it, and in process to a C# host. Depends on nothing.</Description>
    <PackageTags>AI;Agents;Orkeon;Constants;Protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    ADR-009: a satellite references NO project and NO package. That is what makes it
    referenceable from anywhere, Orkeon.Domain included, without inverting any layer.
    The only ProjectReference it carries is the VFS analyzer, injected into every src
    project by Directory.Build.props as OutputItemType="Analyzer" — build time, never
    shipped. So the promise is exact: no runtime dependency.
  -->

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
