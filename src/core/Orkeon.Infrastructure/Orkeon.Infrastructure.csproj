<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata (package-specific overrides) -->
    <PackageId>Orkeon.Infrastructure</PackageId>
    <Description>Infrastructure layer for Orkeon - LLM providers (OpenAI, Anthropic, Azure, Groq, Ollama), memory stores (Redis, SQLite, InMemory), and 15+ built-in tools.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Infrastructure;OpenAI;Anthropic;Ollama;Redis;SQLite;Tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\nuget\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Orkeon.Application.Tests" />
    <InternalsVisibleTo Include="Orkeon.Tools.EventHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Diagnostics.Process" Alias="SysProcess" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.RateLimiting" />
    <ProjectReference Include="..\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\Orkeon.Application\Orkeon.Application.csproj" />
    <ProjectReference Include="..\..\analysis\Orkeon.Analysis.Abstractions\Orkeon.Analysis.Abstractions.csproj" />
    <ProjectReference Include="..\..\analysis\Orkeon.Analysis\Orkeon.Analysis.csproj" />
    <PackageReference Include="StackExchange.Redis" />

    <!-- Existing packages -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Security pin (NU1903 / CVE-2025-6965): force the patched native SQLite 3.50.3. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Polly" />

    <!-- Serialization packages moved from Domain -->
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="CsvHelper" />

    <!-- Parsing packages moved from Application -->
    <PackageReference Include="Markdig" />

    <!-- PDF document loading -->
    <PackageReference Include="PdfPig" />

    <!-- Arrow IPC payloads for the LanceDB Cloud/Enterprise REST protocol (Memory/LanceDb) -->
    <PackageReference Include="Apache.Arrow" />

    <!-- Microsoft.Extensions.AI -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />

    <!-- Vault providers for secret management -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />

    <!-- Hosting abstractions for IHostedService, IHostApplicationLifetime -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />

    <!-- Configuration abstractions for secret providers -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />

    <!-- Options binding from IConfiguration sections -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

    <!-- HTTP client factory for dependency injection -->
    <PackageReference Include="Microsoft.Extensions.Http" />

    <!-- FileSystem glob matcher (VFS v2.2 exclude patterns) -->
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />

    <!-- Code interpreter (Roslyn scripting) - used by RoslynCodeSecurityAnalyzer for SecureCodeInterpreterTool -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />

    <!-- Enterprise Auth (S3) - JWT validation for Azure AD and OIDC -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-002: Accepted architectural exception — tool abstractions shared kernel (see docs/adr/ADR-002-tool-abstractions-shared-kernel.md) -->
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
  </ItemGroup>

  <!-- R4.5: typed-dictionary wrapper source generator (compile-time only). -->
  <ItemGroup>
    <ProjectReference Include="..\..\generators\Orkeon.Generators\Orkeon.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>