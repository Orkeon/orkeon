<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Cli.TerminalGui</PackageId>
    <!-- PUB-25: NuGet distribution deferred (never a supported channel); its dependencies now live inside the `Orkeon` package, so a standalone nupkg would not be restorable. -->
    <IsPackable>false</IsPackable>
    <Description>Terminal.Gui v2-based split-pane console (REPL + dedicated logs pane) for Orkeon interactive runners.</Description>
    <PackageTags>AI;Agents;Orkeon;Cli;TerminalGui;TUI</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- CS0618: Terminal.Gui v2.1.0 marked the static Application.{Invoke,Run,Shutdown,Driver,...}
         APIs obsolete in favour of an instance-based IApplication model. Migrating to the new
         API is a deliberate v1.1 follow-up; the static API still works. Encapsulated in
         Layout/UiDispatchers.cs and Hosting/TerminalGuiHost.cs. -->
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Cli.TerminalGui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkeon.Cli.Abstractions\Orkeon.Cli.Abstractions.csproj" />
    <!-- The names of the environment variables the text interfaces read (TUI_DRIVER, TUI_DIAG,
         CI, TERM): a zero-dependency satellite (ADR-009), referenced by the two Studio terminal
         applications through this project. -->
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Terminal.Gui's own dependencies, referenced for their central versions alone: central
         management pins direct references only, so the two Studio TUIs, which get them through
         this project and nowhere else, shipped Terminal.Gui's minimums (Markdig 1.3.2, the
         Microsoft.Extensions.Configuration family in 10.0.11) while the CLI, the REPL and the
         host ship the pinned ones. Their own dependencies follow. The check of
         scripts/third-party-notices.py fails on a shipped package below its pin. -->
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
