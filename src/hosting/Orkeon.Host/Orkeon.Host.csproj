<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>orkeon-host</AssemblyName>
    <RootNamespace>Orkeon.Host</RootNamespace>

    <!-- Not a dotnet tool: this one is installed as a daemon (systemd unit, Windows
         service, container image), so it ships through the publish matrix rather than
         through NuGet. GATE-05 owns those entries. -->
    <IsPackable>false</IsPackable>
    <!-- A daemon executable's surface is not a contract (same rationale as src/apps). -->
    <OrkeonFreezePublicApi>false</OrkeonFreezePublicApi>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-009: the settings file name, shared with the runners and the tooling. -->
    <ProjectReference Include="..\..\constants\Orkeon.Constants.FileSystem\Orkeon.Constants.FileSystem.csproj" />
    <ProjectReference Include="..\Orkeon.Hosting\Orkeon.Hosting.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Application\Orkeon.Application.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Infrastructure\Orkeon.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host types are internal to the executable; the test project consumes them
         through a ProjectReference. -->
    <InternalsVisibleTo Include="Orkeon.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- GATE-04: the first external SaaS SDK in the runtime. Referenced by the daemon
         only, and loaded only when a Discord channel is configured — a deployment that
         hosts no chat channel pays the assembly on disk and nothing else. -->
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- WINSVC-02: direct (not merely transitive) because StartupFailureReporting writes
         to the event log before the generic host - and its AddEventLog wiring - exists. -->
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>

</Project>
