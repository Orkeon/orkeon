<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireProjectResource>false</IsAspireProjectResource>

    <!-- PUB-25: packed by the src/packaging/Orkeon.Hosting.Aspire wrapper (nuspec depends on the `Orkeon` umbrella). -->
    <IsPackable>false</IsPackable>
    <Description>.NET Aspire hosting integration for Orkeon: add the orkeon-host service daemon or a single crew run to an AppHost, with the settings, mounts and OTLP export the Aspire dashboard reads.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Aspire;AppHost;Hosting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Orkeon/orkeon</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- An AppHost integration references Aspire.Hosting and nothing from the Orkeon runtime:
       it describes processes to launch, it does not run crews. The only Orkeon reference is
       the constants satellite naming the virtual mount roots (ADR-009). -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\constants\Orkeon.Constants.FileSystem\Orkeon.Constants.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
