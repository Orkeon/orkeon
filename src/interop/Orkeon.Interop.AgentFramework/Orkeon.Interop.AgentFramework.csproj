<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- PUB-25: packed by the src/packaging/Orkeon.Interop.AgentFramework wrapper (nuspec depends on the `Orkeon` umbrella). -->
    <IsPackable>false</IsPackable>
    <Description>Microsoft Agent Framework interop for Orkeon: run an Orkeon crew as an AIAgent, and use an AIAgent as the brain or as a tool of an Orkeon agent.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;AgentFramework;MAF;Interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Orkeon/orkeon</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Application\Orkeon.Application.csproj" />
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Interop.AgentFramework.Tests" />
  </ItemGroup>

</Project>
