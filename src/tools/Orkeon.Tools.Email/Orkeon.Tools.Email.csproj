<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Tools.Email</PackageId>
    <!-- PUB-25: shipped inside the `Orkeon.Tools` umbrella package (src/packaging/Orkeon.Tools) — no standalone nupkg. -->
    <IsPackable>false</IsPackable>
    <Description>E-mail agent tools for Orkeon: IMAP, POP3 and SMTP through MailKit, Outlook.com and Microsoft 365 through Microsoft Graph, with Gmail and Outlook presets, OAuth2 sign-in and per-account rights.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Tools;Email;IMAP;SMTP;POP3;Gmail;Outlook</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Email.Tests" />
    <!-- STUDIO-65: the Studio drift tests hold Core's copy of the keys and the enumeration spellings to the binder. -->
    <InternalsVisibleTo Include="Orkeon.Studio.Core.Tests" />
    <!-- FORGE-10: the forge tests put a recording mailbox provider behind the trial. -->
    <InternalsVisibleTo Include="Orkeon.Scripting.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
    <!-- The prompt-injection detector screens every message an agent reads (ADR-012). -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag\Orkeon.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
    <!-- Security pin (NU1903 / GHSA-846f-f764-76mx): MimeKit asks for a vulnerable Pkcs. See Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- FORGE-10: the fictitious mailbox a forge try starts from. -->
    <EmbeddedResource Include="Trial/Sample/sample-mailbox.json" LogicalName="Orkeon.Tools.Email.Trial.Sample.sample-mailbox.json" />
  </ItemGroup>

</Project>
