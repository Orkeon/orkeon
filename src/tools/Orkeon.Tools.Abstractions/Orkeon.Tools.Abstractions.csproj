<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata (package-specific overrides) -->
    <PackageId>Orkeon.Tools.Abstractions</PackageId>
    <!-- PUB-25: shipped inside the `Orkeon` umbrella package (src/packaging/Orkeon) — no standalone nupkg. -->
    <IsPackable>false</IsPackable>
    <Description>Base classes and abstractions for building Orkeon tools - typed pipeline, validation, rate limiting, and telemetry support.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Tools;Abstractions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Abstractions.Tests" />
    <!-- DRIVE-01: the OAuth client and the sign-in flows are shared by the families that sign in to a cloud account. -->
    <InternalsVisibleTo Include="Orkeon.Tools.Email" />
    <InternalsVisibleTo Include="Orkeon.Tools.Email.Tests" />
    <InternalsVisibleTo Include="Orkeon.Tools.Drive" />
    <InternalsVisibleTo Include="Orkeon.Tools.Drive.Tests" />
    <!-- STUDIO-65: the Studio drift tests read the OAuth settings the e-mail resolver derives. -->
    <InternalsVisibleTo Include="Orkeon.Studio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
