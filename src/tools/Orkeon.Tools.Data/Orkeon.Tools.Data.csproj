<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata -->
    <PackageId>Orkeon.Tools.Data</PackageId>
    <Authors>Orkeon Contributors</Authors>
    <Description>Data processing tools for Orkeon agents (JSON, CSV, PDF, XML, SQLite, MongoDB)</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Tools;Data;JSON;CSV;PDF;XML;SQLite;MongoDB</PackageTags>
    <RepositoryUrl>https://github.com/Orkeon/orkeon</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Data.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Security pin (NU1903 / CVE-2025-6965): force the patched native SQLite 3.50.3. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Neo4j.Driver" />
    <PackageReference Include="Gremlin.Net" />
    <!-- Override vulnerable transitives from MongoDB.Driver 3.8.0 -->
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Snappier" />
  </ItemGroup>
</Project>
