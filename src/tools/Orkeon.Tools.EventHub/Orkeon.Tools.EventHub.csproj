<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Tools.EventHub</PackageId>
    <Authors>Orkeon Contributors</Authors>
    <Description>EventHub agent tools for Orkeon: publish_event, post_message, send_request, reply_to, receive_message, wait_for_event, get_last_value.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Tools;EventHub;Messaging</PackageTags>
    <RepositoryUrl>https://github.com/Orkeon/orkeon</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.EventHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Application\Orkeon.Application.csproj" />
    <ProjectReference Include="..\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
  </ItemGroup>
</Project>
