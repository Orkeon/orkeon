<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Orkeon.Tools.Drive</PackageId>
    <!-- Shipped inside the `Orkeon.Tools` umbrella package (src/packaging/Orkeon.Tools) — no standalone nupkg. -->
    <IsPackable>false</IsPackable>
    <Description>Cloud drive agent tools for Orkeon: Google Drive through the Drive API v3 and OneDrive through Microsoft Graph, over plain HTTP, with OAuth2 sign-in, per-account rights and an optional root folder.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Tools;Drive;GoogleDrive;OneDrive;Graph</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Tools.Drive.Tests" />
    <!-- The Studio drift tests hold Core's copy of the keys and the enumeration spellings to the binder. -->
    <InternalsVisibleTo Include="Orkeon.Studio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" />
    <!-- The prompt-injection detector screens every file an agent reads (ADR-013). -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag\Orkeon.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
