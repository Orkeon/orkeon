<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata (package-specific overrides) -->
    <PackageId>Orkeon.Scripting</PackageId>
    <!-- PUB-25: NuGet distribution deferred (never a supported channel); its dependencies now live inside the `Orkeon` package, so a standalone nupkg would not be restorable. -->
    <IsPackable>false</IsPackable>
    <Description>TypeScript-syntax scripting DSL for Orkeon - Jint-based runtime that lets developers describe agents, crews, FSM and graph orchestrations in `.ork.ts` files without touching C# or YAML.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Scripting;DSL;TypeScript;Jint</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- SCR-21 / GAP-13: concatenate Typings/*.d.ts into one `orkeon.d.ts` BEFORE compiling, and
       embed it (logical name `Orkeon.Scripting.Typings.orkeon.d.ts`): the `orkeon` tool writes it
       next to a project (`orkeon typings`), so a dotnet-tool user gets the typings without a clone.
       Load order: errors.d.ts first (types referenced elsewhere), then the rest alphabetically.
       #288: the files are copied as text, byte for byte, by the inline task below. Lines must not
       travel as MSBuild items: an item identity has its backslashes turned into slashes on Linux,
       which made the `*\/` escape of a doc comment `*//` and closed the comment early.
       The file is rewritten only when its content changes, so incremental builds stay incremental. -->
  <UsingTask TaskName="OrkeonConcatenateTypings"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = new StringBuilder();
        text.Append("// Orkeon Scripting DSL v1.0 - TypeScript declarations\n");
        text.Append("// Generated from src/scripting/Orkeon.Scripting/Typings/*.d.ts\n");
        text.Append("// DO NOT EDIT - regenerate with `orkeon typings` (or `dotnet build src/scripting/Orkeon.Scripting` in a clone)\n");
        foreach (var source in Sources)
        {
            var path = source.GetMetadata("FullPath");
            if (!File.Exists(path))
            {
                Log.LogError("Typings source not found: {0} (the load order of GenerateRollupDts names it).", path);
                return false;
            }
            var content = File.ReadAllText(path);
            text.Append(content);
            if (content.Length > 0 && content[content.Length - 1] != '\n') text.Append('\n');
        }
        var rollup = text.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != rollup)
        {
            File.WriteAllText(OutputFile, rollup, new UTF8Encoding(false));
        }
        else
        {
            // Same content: the output must still become newer than the inputs, or the
            // target's Inputs/Outputs would run it again at every build.
            File.SetLastWriteTimeUtc(OutputFile, DateTime.UtcNow);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <DtsFirst Include="Typings/errors.d.ts" />
    <DtsRest Include="Typings/*.d.ts" Exclude="Typings/errors.d.ts" />
  </ItemGroup>
  <!-- $(IntermediateOutputPath) is set by the SDK targets, after this file is evaluated: the path is
       resolved in a target, which runs before the Inputs/Outputs of its dependants are compared. -->
  <Target Name="ResolveRollupDtsPath">
    <PropertyGroup>
      <_OrkeonRollupDts>$(IntermediateOutputPath)orkeon.d.ts</_OrkeonRollupDts>
    </PropertyGroup>
  </Target>

  <!-- Inputs/Outputs: when no typings file changed, MSBuild skips the target and the inline task is
       neither compiled nor run. The resource is attached by the sibling target below, which has no
       Inputs/Outputs: an item declared inside a skipped target is never created. -->
  <Target Name="GenerateRollupDts"
          DependsOnTargets="ResolveRollupDtsPath"
          Inputs="@(DtsFirst);@(DtsRest)"
          Outputs="$(_OrkeonRollupDts)">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <OrkeonConcatenateTypings Sources="@(DtsFirst);@(DtsRest)" OutputFile="$(_OrkeonRollupDts)" />
  </Target>

  <Target Name="EmbedRollupDts" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateRollupDts">
    <ItemGroup>
      <EmbeddedResource Include="$(_OrkeonRollupDts)" LogicalName="Orkeon.Scripting.Typings.orkeon.d.ts" />
      <FileWrites Include="$(_OrkeonRollupDts)" />
    </ItemGroup>
  </Target>

  <!-- The same file at bin/<config>/<tfm>/dist/orkeon.d.ts, for the repository's own tooling. -->
  <Target Name="CopyRollupDtsToDist" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)orkeon.d.ts"
          DestinationFiles="$(OutputPath)dist/orkeon.d.ts"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Bootstrap the esbuild toolchain so EsbuildTranspiler.FindRepoLocalEsbuild can locate
       a platform-specific binary on a fresh clone. The lockfile is generated on whichever
       OS first ran `npm install`, and npm's optionalDependencies mechanism only activates
       the variant matching THAT host - so a Windows dev pulling a lockfile generated on
       Linux ends up with `@esbuild/linux-x64/` (useless) and no `@esbuild/win32-x64/`.
       To handle that we run two steps:
        1. `npm ci` on a fresh clone - installs strictly what the lockfile resolved.
        2. If the host's expected `@esbuild/{os}-{arch}/{binary}` is still missing,
           force-install that specific variant by name (npm honors it because the package's
           own `os`/`cpu` constraints match the current host).
       Skips when:
        - SkipScriptingNpmInstall=true is passed (CI opt-out);
        - tools/scripting-esbuild/package.json is missing (NuGet consumer of this package).
       Failure to invoke npm is non-fatal: the build still succeeds and EsbuildTranspiler
       falls back to PATH lookup + its own friendly EsbuildNotFoundException at runtime. -->
  <Target Name="EnsureScriptingEsbuildInstalled"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipScriptingNpmInstall)' != 'true'">
    <PropertyGroup>
      <_ScriptingEsbuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\tools\scripting-esbuild'))</_ScriptingEsbuildRoot>
      <_ScriptingEsbuildNodeModules>$(_ScriptingEsbuildRoot)\node_modules</_ScriptingEsbuildNodeModules>
      <_EsbuildVersion>0.25.12</_EsbuildVersion>

      <_EsbuildOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win32</_EsbuildOs>
      <_EsbuildOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">darwin</_EsbuildOs>
      <_EsbuildOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_EsbuildOs>
      <_EsbuildArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x64</_EsbuildArch>
      <_EsbuildArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_EsbuildArch>

      <_EsbuildBinaryName Condition="'$(_EsbuildOs)' == 'win32'">esbuild.exe</_EsbuildBinaryName>
      <_EsbuildBinaryName Condition="'$(_EsbuildOs)' != 'win32'">esbuild</_EsbuildBinaryName>

      <!-- Windows package layout: binary at the package root. Unix: under bin/. -->
      <_EsbuildPlatformBinary Condition="'$(_EsbuildOs)' == 'win32'">$(_ScriptingEsbuildNodeModules)\@esbuild\$(_EsbuildOs)-$(_EsbuildArch)\$(_EsbuildBinaryName)</_EsbuildPlatformBinary>
      <_EsbuildPlatformBinary Condition="'$(_EsbuildOs)' != 'win32'">$(_ScriptingEsbuildNodeModules)/@esbuild/$(_EsbuildOs)-$(_EsbuildArch)/bin/$(_EsbuildBinaryName)</_EsbuildPlatformBinary>
    </PropertyGroup>

    <!-- Step 1: bootstrap node_modules on a fresh clone from the locked dependency graph.
         'npm ci' installs strictly from package-lock.json: it refuses a lockfile that
         diverges from package.json (reproducible builds) and never mutates the lockfile.
         The 'ignore-scripts' flag reduces the install-time script execution surface
         of the @esbuild/* packages. -->
    <Message Importance="High"
             Condition="!Exists('$(_ScriptingEsbuildNodeModules)') AND Exists('$(_ScriptingEsbuildRoot)\package.json')"
             Text="[Orkeon.Scripting] Bootstrapping esbuild toolchain via 'npm ci' under $(_ScriptingEsbuildRoot) (one-time per clone; opt out with -p:SkipScriptingNpmInstall=true)." />
    <Exec Command="npm ci --no-audit --no-fund --silent --ignore-scripts"
          WorkingDirectory="$(_ScriptingEsbuildRoot)"
          Condition="!Exists('$(_ScriptingEsbuildNodeModules)') AND Exists('$(_ScriptingEsbuildRoot)\package.json')"
          ContinueOnError="WarnAndContinue" />

    <!-- Step 2: force the host's @esbuild variant if step 1 produced a foreign one
         (lockfile cross-OS scenario). Idempotent: skips once the binary is present. -->
    <Message Importance="High"
             Condition="'$(_EsbuildOs)' != '' AND '$(_EsbuildArch)' != '' AND Exists('$(_ScriptingEsbuildNodeModules)') AND !Exists('$(_EsbuildPlatformBinary)')"
             Text="[Orkeon.Scripting] Host-specific binary @esbuild/$(_EsbuildOs)-$(_EsbuildArch) missing under tools/scripting-esbuild/node_modules/; force-installing (lockfile resolved a foreign platform)." />
    <Exec Command="npm install --no-save --no-audit --no-fund --silent @esbuild/$(_EsbuildOs)-$(_EsbuildArch)@$(_EsbuildVersion)"
          WorkingDirectory="$(_ScriptingEsbuildRoot)"
          Condition="'$(_EsbuildOs)' != '' AND '$(_EsbuildArch)' != '' AND Exists('$(_ScriptingEsbuildNodeModules)') AND !Exists('$(_EsbuildPlatformBinary)')"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Scripting.Tests" />
    <!-- BuiltInToolTypingsTests renders tools.generated.d.ts from the tools a run registers. -->
    <InternalsVisibleTo Include="Orkeon.Hosting.Tests" />
    <!-- Orkeon.Scripting.Cli ships as the `orkeon` CLI assembly (see its
         <AssemblyName>orkeon</AssemblyName>); InternalsVisibleTo matches the
         assembly name, not the project. -->
    <InternalsVisibleTo Include="orkeon" />
    <!-- The test projects' module initializers set JsEngineFactory.PromiseTimeout. -->
    <InternalsVisibleTo Include="Orkeon.Cli.Commands.Scripting.Tests" />
    <InternalsVisibleTo Include="Orkeon.Scripting.Cli.Tests" />
    <InternalsVisibleTo Include="Orkeon.ConsoleApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Application\Orkeon.Application.csproj" />
    <ProjectReference Include="..\..\core\Orkeon.Infrastructure\Orkeon.Infrastructure.csproj" />
    <!-- RAG-03/C3: first-class `rag.*` binding (RagNamespaceBinding) over the RAG
         subsystem contracts. Abstractions only — pipeline implementations are wired
         by the host (AddOrkeonRag). -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Abstractions\Orkeon.Rag.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
