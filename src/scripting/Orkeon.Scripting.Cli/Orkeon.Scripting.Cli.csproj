<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orkeon.Scripting.Cli</RootNamespace>
    <AssemblyName>orkeon</AssemblyName>
    <PackageId>Orkeon.Scripting.Cli</PackageId>
    <Description>Command-line entrypoint for Orkeon crews: `orkeon run &lt;crew.ork.ts | crew.yaml&gt;` — runs both the Scripting DSL (.ork.ts, Jint + esbuild) and YAML crew definitions from a single pre-compiled tool.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Scripting;CLI</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <!-- A net10.0 tool must start on a machine whose only runtime is .NET 11 (GA on
         2026-11-10): without Major roll-forward the host refuses to run it and the user
         sees "You must install .NET to run this application". -->
    <RollForward>Major</RollForward>
    <ToolCommandName>orkeon</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-009: the .orkeon state directory, shared with Studio and the index cache. -->
    <!-- ADR-009: the run event stream's vocabulary, shared with whatever watches the run. -->
    <!-- ADR-009: the run option grammar, shared with the tooling that predicts it. -->
    <!-- ADR-009: the Llm configuration section, shared with the REPL and the runner host. -->
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Cli\Orkeon.Constants.Cli.csproj" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Protocol\Orkeon.Constants.Protocol.csproj" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.FileSystem\Orkeon.Constants.FileSystem.csproj" />
    <ProjectReference Include="..\Orkeon.Scripting\Orkeon.Scripting.csproj" />
    <!-- Shared runner host bootstrap (settings, mounts, LLM wiring) — extracted to
         src/hosting so the packable tool no longer ships sample code (R1.5 / ORG-001). -->
    <ProjectReference Include="..\..\hosting\Orkeon.Hosting\Orkeon.Hosting.csproj" />
    <!-- RAG-03/C3: `orkeon rag ingest | search` verbs — subsystem DI (AddOrkeonRag)
         and agent tools (AddOrkeonRagTools, shared report formatting). -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag\Orkeon.Rag.csproj" />
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Rag\Orkeon.Tools.Rag.csproj" />
    <!-- RAG-04/C4: ONNX cross-encoder reranker for the balanced/quality profiles
         (`orkeon rag eval` compare mode: fast,balanced,quality). The .Model companion
         embeds the ms-marco-MiniLM-L-6-v2 int8 weights: offline guaranteed,
         zero download in CI. -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Onnx\Orkeon.Rag.Onnx.csproj" />
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Onnx.Model\Orkeon.Rag.Onnx.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Scripting.Cli.Tests" />
    <InternalsVisibleTo Include="Orkeon.Scripting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- FORGE-03: the assistant pack, embedded so `orkeon forge` needs no file on disk;
         extracted into the session directory at run time (overridable with `-\-pack`). -->
    <EmbeddedResource Include="Commands\Forge\Packs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>


  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- This tool package redistributes third-party model weights: the BGE-micro-v2
         embeddings model (MIT) under tools/net10.0/any/LocalEmbeddingsModel/, and the
         ms-marco-MiniLM-L-6-v2 cross-encoder (Apache-2.0) embedded in
         Orkeon.Rag.Onnx.Model.dll. Their attribution obligations attach to the
         artifact, not to the repository, so the notices ship inside the nupkg. -->
    <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>


  <!-- PUB-24 P1: the tool package used to weigh 262.5 MB — above the nuget.org limit
       (250 MB) — because Microsoft.ML.OnnxRuntime ships iOS (.xcframework.zip) and
       Android (.aar) natives that a dotnet CLI tool can never load. Strip them from
       the package payload; desktop RIDs (win/linux/osx) stay untouched. -->
  <Target Name="OrkeonTrimMobileNativesFromToolPackage" AfterTargets="PackTool">
    <ItemGroup>
      <_OrkeonMobileNative Include="@(TfmSpecificPackageFile)"
                           Condition="$([System.String]::Copy('%(TfmSpecificPackageFile.Identity)').Contains('/runtimes/ios'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.Identity)').Contains('/runtimes/android'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.PackagePath)').Contains('runtimes/ios'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.PackagePath)').Contains('runtimes/android'))" />
      <TfmSpecificPackageFile Remove="@(_OrkeonMobileNative)" />
    </ItemGroup>
    <Message Importance="high" Text="OrkeonTrim: removed @(_OrkeonMobileNative-&gt;Count()) mobile native file(s) from the tool package" />
  </Target>

</Project>
