<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orkeon.Scripting.Cli</RootNamespace>
    <AssemblyName>orkeon</AssemblyName>
    <PackageId>Orkeon.Scripting.Cli</PackageId>
    <Description>Command-line entrypoint for Orkeon crews: `orkeon run &lt;crew.ork.ts | crew.yaml&gt;` — runs both the Scripting DSL (.ork.ts, Jint + esbuild) and YAML crew definitions from a single pre-compiled tool.</Description>
    <PackageTags>AI;Agents;LLM;Orkeon;Scripting;CLI</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orkeon</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkeon.Scripting\Orkeon.Scripting.csproj" />
    <!-- Shared runner host bootstrap (settings, mounts, LLM wiring) — extracted to
         src/hosting so the packable tool no longer ships sample code (R1.5 / ORG-001). -->
    <ProjectReference Include="..\..\hosting\Orkeon.Hosting\Orkeon.Hosting.csproj" />
    <!-- RAG-03/C3: `orkeon rag ingest | search` verbs — subsystem DI (AddOrkeonRag)
         and agent tools (AddOrkeonRagTools, shared report formatting). -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag\Orkeon.Rag.csproj" />
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Rag\Orkeon.Tools.Rag.csproj" />
    <!-- RAG-04/C4: ONNX cross-encoder reranker for the balanced/quality profiles
         (`orkeon rag eval` compare mode: fast,balanced,quality). The .Model companion
         embeds the ms-marco-MiniLM-L-6-v2 int8 weights: offline guaranteed,
         zero download in CI. -->
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Onnx\Orkeon.Rag.Onnx.csproj" />
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Onnx.Model\Orkeon.Rag.Onnx.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkeon.Scripting.Cli.Tests" />
    <InternalsVisibleTo Include="Orkeon.Scripting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
