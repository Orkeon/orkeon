<Project Sdk="Microsoft.NET.Sdk">

  <!-- PUB-25: the `Orkeon` umbrella package. The 39-project source layout (Clean
       Architecture, VFS analyzer, per-assembly PublicAPI freeze) is untouched — this
       project only changes how the framework is DISTRIBUTED: one nupkg carrying the
       eleven assemblies of the core closure, so `dotnet add package Orkeon` is a
       complete install. The embedded projects are IsPackable=false.

       Mechanics: ProjectReference PrivateAssets="all" keeps them out of the nuspec
       dependency list; the OrkeonEmbedClosureAssemblies target packs their DLL+XML
       into lib/. Because PrivateAssets="all" also stops their external PackageReferences
       from flowing into the nuspec, the union of those references is re-declared below —
       scripts/check-package-closure.py fails the publish workflow if the two drift. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Orkeon</PackageId>
    <Description>Build and orchestrate AI agent teams in .NET — the complete Orkeon framework in one package: agents, crews and six orchestration modes, 14 LLM providers, 6 memory stores, staged RAG pipeline, and semantic codebase analysis.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OrkeonFreezePublicApi>false</OrkeonFreezePublicApi>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);OrkeonEmbedClosureAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The embedded closure: every assembly the core trio needs, nothing more.
       Verified 2026-09-01 by walking the ProjectReference graph. -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\Orkeon.Domain\Orkeon.Domain.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\core\Orkeon.Application\Orkeon.Application.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\core\Orkeon.Infrastructure\Orkeon.Infrastructure.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Llm\Orkeon.Constants.Llm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.FileSystem\Orkeon.Constants.FileSystem.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\constants\Orkeon.Constants.Configuration\Orkeon.Constants.Configuration.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Abstractions\Orkeon.Tools.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\analysis\Orkeon.Analysis.Abstractions\Orkeon.Analysis.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\analysis\Orkeon.Analysis\Orkeon.Analysis.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\rag\Orkeon.Rag.Abstractions\Orkeon.Rag.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\rag\Orkeon.Rag\Orkeon.Rag.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Union of the embedded assemblies' external dependencies (versions come from
       Directory.Packages.props). Kept in sync by scripts/check-package-closure.py. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Polly" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="TreeSitter.DotNet" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <Target Name="OrkeonEmbedClosureAssemblies" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <_OrkeonEmbedded Include="@(ReferenceCopyLocalPaths)"
                       Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And ('%(ReferenceCopyLocalPaths.Extension)' == '.dll' Or '%(ReferenceCopyLocalPaths.Extension)' == '.xml')" />
      <TfmSpecificPackageFile Include="@(_OrkeonEmbedded)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
