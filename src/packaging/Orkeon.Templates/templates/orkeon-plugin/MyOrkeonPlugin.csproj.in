<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the host already carries the framework, a plugin must not ship a second copy. -->
    <PackageReference Include="Orkeon" Version="$(OrkeonVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest sits next to the plugin assembly: the host reads it, and refuses a tool it does not declare. -->
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
