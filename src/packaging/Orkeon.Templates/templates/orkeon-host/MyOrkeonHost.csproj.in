<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-process crew runner (ICrewScriptRunner), with the framework and the tools it needs. -->
    <PackageReference Include="Orkeon.Scripting" Version="$(OrkeonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="crew.ork.ts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
