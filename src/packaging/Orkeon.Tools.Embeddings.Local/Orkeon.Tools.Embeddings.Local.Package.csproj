<Project Sdk="Microsoft.NET.Sdk">

  <!-- PUB-25 wrapper: packs the Orkeon.Tools.Embeddings.Local assembly with a nuspec
       dependency on the `Orkeon` umbrella. Kept out of the umbrella itself because it
       pins SmartComponents.LocalEmbeddings, a pre-release of an archived upstream —
       embedding it would poison the stable line (NU5104). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Opt-in local on-device embeddings for Orkeon (SmartComponents BGE-micro-v2 ONNX, 384 dims, CPU, no API key).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OrkeonIconFamily>tools</OrkeonIconFamily>
    <OrkeonFreezePublicApi>false</OrkeonFreezePublicApi>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);OrkeonEmbedWrappedAssembly</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\tools\Orkeon.Tools.Embeddings.Local\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Orkeon.Tools.Embeddings.Local\Orkeon.Tools.Embeddings.Local.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Orkeon\Orkeon.csproj" />
  </ItemGroup>

  <!-- Externals of the wrapped assembly that `Orkeon` does not already carry. -->
  <ItemGroup>
    <PackageReference Include="SmartComponents.LocalEmbeddings" />
  </ItemGroup>

  <Target Name="OrkeonEmbedWrappedAssembly" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <_OrkeonWrapped Include="@(ReferenceCopyLocalPaths)"
                      Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
                                 And ('%(ReferenceCopyLocalPaths.Extension)' == '.dll' Or '%(ReferenceCopyLocalPaths.Extension)' == '.xml')
                                 And '%(ReferenceCopyLocalPaths.Filename)' == 'Orkeon.Tools.Embeddings.Local'" />
      <TfmSpecificPackageFile Include="@(_OrkeonWrapped)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

  <!-- The public PackageId equals the wrapped assembly's name, which is also the real
       project's restore name — two projects may not share a restore identity in one
       solution, so the id is applied at pack time only. -->
  <!-- SmartComponents' contentFiles (the BGE-micro-v2 weights, ~17 MB) flow into this
       project's Content, so pack would copy them into this LIBRARY package. This target
       strips them. Behaviour unchanged — only the justification below is corrected.

       The reason is DE-DUPLICATION, not a redistribution ban. This comment used to claim
       that redistributing those weights was "something this repository deliberately does
       not do" (Go/NoGo 2026-08, blocker 1). That is not what the repository does. The
       weights ARE redistributed by the executable artefacts: the `orkeon` and
       `orkeon-repl` dotnet tool packages carry them at
       tools/net10.0/any/LocalEmbeddingsModel/default/model.onnx, and the platform
       installers built from the CLI carry them under libexec/orkeon/LocalEmbeddingsModel/,
       because Orkeon.Hosting references Orkeon.Tools.Embeddings.Local and the upstream
       content files follow into the publish output. That is fine: both the wrapper and
       the model are MIT, and THIRD-PARTY-NOTICES.md sections 1-2 carry the notices.

       What stays true for THIS package: anyone restoring Orkeon.Tools.Embeddings.Local
       already receives the weights transitively from the SmartComponents dependency, so a
       second copy here would double a 17 MB download for nothing. Strip them. -->
  <Target Name="OrkeonStripUpstreamContentFromPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)"
                     Condition="$([System.String]::Copy('%(_PackageFiles.Identity)').Contains('smartcomponents'))" />
    </ItemGroup>
  </Target>

  <Target Name="OrkeonWrapperPackageIdentity" BeforeTargets="_GetAbsoluteOutputPathsForPack;_GetOutputItemsFromPack;GenerateNuspec">
    <PropertyGroup>
      <PackageId>Orkeon.Tools.Embeddings.Local</PackageId>
    </PropertyGroup>
  </Target>

</Project>
