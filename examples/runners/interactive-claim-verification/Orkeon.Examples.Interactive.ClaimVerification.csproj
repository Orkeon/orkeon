<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orkeon.Examples.Interactive.ClaimVerification</RootNamespace>
    <!-- Published as a dotnet tool so experiments/ can run the interactive REPL
         in packages mode (no source clone). Version must be explicit: the
         examples/ tree does not inherit src/Directory.Build.props (same
         pattern as _shared/Orkeon.Examples.Shared.csproj). -->
    <PackageId>Orkeon.Runners.ClaimVerification</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orkeon-claim-verify</ToolCommandName>
    <Description>Interactive claim-verification REPL runner for Orkeon (dotnet tool).</Description>
    <Authors>Orkeon Contributors</Authors>
    <VersionPrefix>0.9.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <!-- CS0618: Terminal.Gui v2.1.0 deprecated the static Application.* APIs.
         AddClaimCommand/AddClaimDialog use them deliberately — see the matching
         NoWarn in Orkeon.Cli.TerminalGui.csproj and Orkeon.Examples.Shared.csproj. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../_shared/Orkeon.Examples.Shared.csproj" />
    <ProjectReference Include="../../../src/cli/Orkeon.Cli/Orkeon.Cli.csproj" />
    <ProjectReference Include="../../../src/cli/Orkeon.Cli.Abstractions/Orkeon.Cli.Abstractions.csproj" />
    <ProjectReference Include="../../../src/cli/Orkeon.Cli.TerminalGui/Orkeon.Cli.TerminalGui.csproj" />
  </ItemGroup>
</Project>
