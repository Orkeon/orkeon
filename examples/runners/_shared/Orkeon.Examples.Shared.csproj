<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orkeon.Examples.Shared</RootNamespace>
    <PackageId>Orkeon.Runners.Shared</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Shared host/bootstrap for Orkeon runners.</Description>
    <!-- Align the shipped runner lib with the framework version: the examples tree
         does not inherit src/Directory.Build.props (which carries the version). -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc.2</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runner* host/bootstrap infrastructure now lives in src/hosting (R1.5);
         examples consume it through this reference. -->
    <ProjectReference Include="../../../src/hosting/Orkeon.Hosting/Orkeon.Hosting.csproj" />
    <ProjectReference Include="../../../src/core/Orkeon.Domain/Orkeon.Domain.csproj" />
    <ProjectReference Include="../../../src/core/Orkeon.Application/Orkeon.Application.csproj" />
    <ProjectReference Include="../../../src/core/Orkeon.Infrastructure/Orkeon.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
</Project>
