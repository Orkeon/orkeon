{
  "Llm": {
    "Model": "gpt-4o",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "${OPENAI_API_KEY}",
    "Temperature": 0.7,
    "MaxTokens": 4096,
    "TimeoutSeconds": 30
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 10,
    "GlobalRequestsPerMinute": 60,
    "ProviderRequestsPerMinute": 30,
    "AgentRequestsPerMinute": 20,
    "QueueLimit": 32
  }
}
