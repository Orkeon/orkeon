{
  "Llm": {
    "Model": "deepseek-chat",
    "ApiKeyEnvVar": "DEEPSEEK_API_KEY"
  },

  "Orkeon": {
    "CrewFactory": { "StrictTools": true },

    "Host": {
      "RunTimeout": "00:15:00",

      "Crews": [
        {
          "Name": "file-desk",
          "Path": "./crew/crew.yaml",
          "Description": "Works on the files of the conversation.",
          "Mounts": [ "./data/output:/output:rw" ]
        }
      ],

      "Files": {
        "Enabled": true,
        "Root": "data/conversations",
        "MaxFileBytes": 10485760,
        "MaxFilesPerMessage": 5,
        "MaxConversationBytes": 52428800,
        "MaxTotalBytes": 1073741824,
        "Retention": "7.00:00:00",
        "AllowedExtensions": [ "txt", "md", "csv", "pdf", "docx", "xlsx", "png", "jpg", "jpeg" ]
      },

      "Discord": {
        "Enabled": true,
        "TokenEnvironmentVariable": "ORKEON_DISCORD_TOKEN",
        "AllowedUserIds": [],
        "GuildIds": []
      },

      "Teams": {
        "Enabled": false,
        "AppId": "11111111-2222-3333-4444-555555555555",
        "TenantId": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
        "SecretEnvironmentVariable": "ORKEON_TEAMS_APP_SECRET",
        "AllowedUserIds": [],
        "Prefix": "http://localhost:3978/",
        "SharePointNames": [ "contoso" ],
        "CertificatePathEnvironmentVariable": "ORKEON_TEAMS_CERTIFICATE_PATH"
      }
    }
  }
}
