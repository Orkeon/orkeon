{
  "Llm": {
    "Provider": "deepseek",
    "Model": "deepseek-chat",
    "ApiKeyEnvironmentVariable": "DEEPSEEK_API_KEY"
  },

  "Orkeon": {
    "CrewFactory": { "StrictTools": true },

    "FileSystem": {
      "Mounts": [
        { "Physical": "/srv/orkeon/knowledge", "Virtual": "/workspace", "Rights": "Read" },
        { "Physical": "/var/lib/orkeon/output", "Virtual": "/output", "Rights": "Read,Write,Create" }
      ]
    },

    "Host": {
      "RunTimeout": "00:30:00",
      "ShutdownGracePeriod": "00:00:20",

      "Crews": [
        {
          "Name": "support",
          "Path": "/srv/orkeon/crews/support",
          "Profile": {
            "Interactive": false,
            "Persistent": false,
            "Chat": true,
            "MaxConcurrentRuns": 4
          }
        }
      ],

      "Discord": {
        "Enabled": true,
        "TokenEnvironmentVariable": "ORKEON_DISCORD_TOKEN",
        "AllowedUserIds": [],
        "ProgressInterval": "00:00:02"
      }
    }
  }
}
