{
  "Llm": {
    "Model": "deepseek-chat",
    "ApiKeyEnvVar": "DEEPSEEK_API_KEY"
  },

  "Orkeon": {
    "CrewFactory": { "StrictTools": true },

    "FileSystem": {
      "Mounts": [
        "/srv/orkeon/knowledge:/workspace:ro",
        "/var/lib/orkeon/output:/output:rw"
      ]
    },

    "Host": {
      "RunTimeout": "00:30:00",
      "ShutdownGracePeriod": "00:00:20",

      "Crews": [
        {
          "Name": "support",
          "Path": "/srv/orkeon/crews/support",
          "Description": "Answers customer support questions from the knowledge base.",
          "Profile": {
            "MaxConcurrentRuns": 4
          }
        }
      ],

      "A2A": {
        "Enabled": true,
        "Host": "http://localhost",
        "Port": 5002,
        "Crews": ["support"]
      },

      "Discord": {
        "Enabled": true,
        "TokenEnvironmentVariable": "ORKEON_DISCORD_TOKEN",
        "AllowedUserIds": [],
        "ProgressInterval": "00:00:02",
        "GuildIds": []
      }
    }
  }
}
