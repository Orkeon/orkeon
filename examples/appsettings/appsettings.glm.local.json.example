{
  "_comment": "Settings template — Z.AI GLM (OpenAI-compatible endpoint). Copy this file WITHOUT the .example suffix (-> appsettings.glm.local.json), then set your key in the environment: ApiKeyEnvVar names the variable that holds it (ZAI_API_KEY), which every run reads — a terminal, a scheduled team, the REPL — and the key itself never goes in the file (ORKEON_Llm__ApiKey, when set, wins). The factory auto-detects ZaiLlmProvider (host api.z.ai / model glm-*): native thinking passthrough + context-cache metrics.",
  "_docs": "https://docs.z.ai/api-reference/introduction",
  "_models": [
    "glm-5.2 — 1M ctx, 128K max output, thinking (reasoning_content) — https://docs.z.ai/guides/llm/glm-5.2"
  ],
  "Llm": {
    "Model": "glm-5.2",
    "BaseUrl": "https://api.z.ai/api/paas/v4",
    "ApiKeyEnvVar": "ZAI_API_KEY",
    "Temperature": 0.2,
    "TimeoutSeconds": 600
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "LlmLogging": {
    "FullEmbeddingLog": false
  }
}
