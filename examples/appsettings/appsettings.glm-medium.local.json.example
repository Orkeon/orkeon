{
  "_comment": "Settings template — Z.AI GLM-5.2 with 'medium' reasoning effort (Llm.Thinking.Effort). NB: this is NOT a distinct model, it is glm-5.2 with a reduced thinking budget. Copy this file WITHOUT the .example suffix (-> appsettings.glm-medium.local.json), then fill in your key. The ${ZAI_API_KEY} placeholder is NOT expanded automatically: replace it, or override via ORKEON_Llm__ApiKey=...",
  "_docs": "https://docs.z.ai/api-reference/introduction",
  "_models": [
    "glm-5.2 — 1M ctx, 128K max output, thinking (reasoning_content) — https://docs.z.ai/guides/llm/glm-5.2"
  ],
  "Llm": {
    "Model": "glm-5.2",
    "BaseUrl": "https://api.z.ai/api/paas/v4",
    "ApiKey": "${ZAI_API_KEY}",
    "Temperature": 0.2,
    "MaxTokens": 131072,
    "TimeoutSeconds": 600,
    "Thinking": {
      "Effort": "medium"
    }
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "LlmLogging": {
    "FullEmbeddingLog": false
  }
}
