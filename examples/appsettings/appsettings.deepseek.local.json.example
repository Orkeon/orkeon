{
  "_comment": "Settings template — DeepSeek Flash (V4.1). Copy this file WITHOUT the .example suffix (-> appsettings.deepseek.local.json), then fill in your key. The ${DEEPSEEK_API_KEY} placeholder is NOT expanded automatically: replace it with the plain key, or leave it and override at runtime via the ORKEON_Llm__ApiKey=sk-... environment variable. The factory auto-detects DeepSeekLlmProvider from the api.deepseek.com host.",
  "_models": [
    "deepseek-flash    — V4.1 Flash: 1M ctx, 384K max output, thinking on by default, native vision (deepseek-v4-flash / deepseek-v4-flash-vision-exp name retired models still routed here; deepseek-chat / deepseek-reasoner retired 2026-07-24)",
    "deepseek-v4-pro   — 1M ctx, advanced reasoning"
  ],
  "Llm": {
    "Model": "deepseek-flash",
    "BaseUrl": "https://api.deepseek.com",
    "ApiKey": "${DEEPSEEK_API_KEY}",
    "Temperature": 0.2,
    "TimeoutSeconds": 600
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "LlmLogging": {
    "FullEmbeddingLog": false
  }
}
