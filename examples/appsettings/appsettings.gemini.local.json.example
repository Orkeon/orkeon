{
  "_comment": "Settings template — Google Gemini (OpenAI-compatible endpoint). Copy this file WITHOUT the .example suffix (-> appsettings.gemini.local.json), then set your key in the environment: ApiKeyEnvVar names the variable that holds it (GEMINI_API_KEY), which every run reads — a terminal, a scheduled team, the REPL — and the key itself never goes in the file (ORKEON_Llm__ApiKey, when set, wins). The factory auto-detects GeminiLlmProvider from the generativelanguage.googleapis.com host.",
  "_models": [
    "gemini-3.7-flash — primary chat model of the OpenAI-compatibility surface (default)",
    "gemini-2.5-flash-image — image generation (out of Orkeon chat scope)"
  ],
  "Llm": {
    "Model": "gemini-3.7-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "ApiKeyEnvVar": "GEMINI_API_KEY",
    "Temperature": 0.2,
    "TimeoutSeconds": 600
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "LlmLogging": {
    "FullEmbeddingLog": false
  }
}
