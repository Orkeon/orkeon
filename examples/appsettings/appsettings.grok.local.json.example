{
  "_comment": "Settings template - Grok / x.AI (OpenAI-compatible endpoint). Copy this file WITHOUT the .example suffix (-> appsettings.grok.local.json), then set your key in the environment: ApiKeyEnvVar names the variable that holds it (XAI_API_KEY), which every run reads — a terminal, a scheduled team, the REPL — and the key itself never goes in the file (ORKEON_Llm__ApiKey, when set, wins). The factory auto-detects GrokLlmProvider from the api.x.ai host, and from the xai- key prefix.",
  "_models": [
    "grok-4.6 - current chat flagship (default; verified live 2026-08-30, 12/12 campaign)",
    "grok-4.5, grok-4.3 - previous chat generations"
  ],
  "Llm": {
    "Model": "grok-4.6",
    "BaseUrl": "https://api.x.ai/v1",
    "ApiKeyEnvVar": "XAI_API_KEY",
    "Temperature": 0.2,
    "TimeoutSeconds": 600
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "LlmLogging": {
    "FullEmbeddingLog": false
  }
}
