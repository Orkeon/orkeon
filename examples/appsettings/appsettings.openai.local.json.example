{
  "_comment": "Settings template — OpenAI. Copy this file WITHOUT the .example suffix (-> appsettings.openai.local.json), then fill in your key. The ${OPENAI_API_KEY} placeholder is NOT expanded automatically: replace it with the plain key (sk-...), or override at runtime via ORKEON_Llm__ApiKey=sk-... The factory auto-detects OpenAIProvider from the api.openai.com host.",
  "_models": [
    "gpt-4o        — flagship multimodal",
    "gpt-4o-mini   — cost-optimized"
  ],
  "Llm": {
    "Model": "gpt-4o",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "${OPENAI_API_KEY}",
    "Temperature": 0.7,
    "MaxTokens": 4096,
    "TimeoutSeconds": 30
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 10,
    "GlobalRequestsPerMinute": 60,
    "ProviderRequestsPerMinute": 30,
    "AgentRequestsPerMinute": 20,
    "QueueLimit": 32
  }
}
