{
  "_comment": "Settings template — OpenAI. Copy this file WITHOUT the .example suffix (-> appsettings.openai.local.json), then set your key in the environment: ApiKeyEnvVar names the variable that holds it (OPENAI_API_KEY), which every run reads — a terminal, a scheduled team, the REPL — and the key itself never goes in the file (ORKEON_Llm__ApiKey, when set, wins). The factory auto-detects OpenAIProvider from the api.openai.com host.",
  "_models": [
    "gpt-4o        — flagship multimodal",
    "gpt-4o-mini   — cost-optimized"
  ],
  "Llm": {
    "Model": "gpt-4o",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKeyEnvVar": "OPENAI_API_KEY",
    "Temperature": 0.7,
    "MaxTokens": 4096,
    "TimeoutSeconds": 30
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 10,
    "GlobalRequestsPerMinute": 60,
    "ProviderRequestsPerMinute": 30,
    "AgentRequestsPerMinute": 20,
    "QueueLimit": 32
  }
}
