#!/bin/sh
# Orkeon launcher for {{APP}} — generated by scripts/package-installers.sh.
# Resolves its real location through install symlinks, points the scripting
# toolchain at the bundled esbuild, then execs the apphost.
prg="$0"
while [ -h "$prg" ]; do
  link=$(readlink "$prg")
  case "$link" in
    /*) prg="$link" ;;
    *)  prg="$(dirname "$prg")/$link" ;;
  esac
done
here=$(cd "$(dirname "$prg")" && pwd)
root=$(dirname "$here")
if [ -z "${ORKEON_ESBUILD_PATH:-}" ] && [ -x "$root/libexec/esbuild-bin/esbuild" ]; then
  ORKEON_ESBUILD_PATH="$root/libexec/esbuild-bin/esbuild"
  export ORKEON_ESBUILD_PATH
fi
exec "$root/libexec/{{APP}}/{{APPHOST}}" "$@"
