<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions.AI">
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <!-- Arrow IPC encode/decode for the LanceDB Cloud/Enterprise REST protocol (R4.11).
         Data payloads (insert/merge_insert/create) and query responses are Arrow IPC,
         not JSON — see docs.lancedb.com/api-reference/rest. Apache-2.0, notice in
         THIRD-PARTY-NOTICES.md. -->
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Security pin (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q, NU1903): Microsoft.Data.Sqlite
         pulls the vulnerable native SQLitePCLRaw.lib.e_sqlite3 2.1.11 (bundles SQLite < 3.50.2)
         transitively. Override ONLY the native lib to 3.50.3 (SQLite 3.50.3, patched); the
         managed SQLitePCLRaw.core/provider stay 2.1.11 — the SQLite C ABI is stable. Forced via
         an explicit PackageReference in the 3 projects that root Microsoft.Data.Sqlite
         (Infrastructure, Tools.Data, Tools.Data.Tests). -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="MySqlConnector" Version="2.6.1" />
    <PackageVersion Include="MongoDB.Driver" Version="3.10.0" />
    <PackageVersion Include="Neo4j.Driver" Version="6.2.1" />
    <PackageVersion Include="Gremlin.Net" Version="3.8.1" />
    <!-- 2026-06: defensive pins, no longer corrective. MongoDB.Driver 3.9.0 (above)
         already requires SharpCompress >= 0.48.1 and Snappier >= 1.3.1, both past the
         patched thresholds of NU1902 (GHSA-6c8g-7p36-r338) / NU1903 (GHSA-pggp-6c3x-2xmx).
         Kept, with the direct PackageReference in Orkeon.Tools.Data, as an
         anti-regression floor on those transitive ranges. -->
    <PackageVersion Include="SharpCompress" Version="0.50.0" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.13.0" />
  </ItemGroup>
  <ItemGroup Label="Serialization">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>
  <ItemGroup Label="Document">
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <!-- R1.4: AngleSharp (MIT) replaces Fizzler.Systems.HtmlAgilityPack (LGPL-3.0)
         as the CSS selector engine of ScrapeElementTool. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.6.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.5" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="CLI">
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>
  <ItemGroup Label="Identifiers">
    <PackageVersion Include="Ulid" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup Label="Analysis">
    <PackageVersion Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup Label="Embeddings">
    <PackageVersion Include="SmartComponents.LocalEmbeddings" Version="0.1.0-preview10148" />
  </ItemGroup>
  <ItemGroup Label="Reranking">
    <!-- ONNX cross-encoder reranker (Orkeon.Rag.Onnx, RAG-04/C3). Native runtime
         confined to that opt-in package — same isolation as SmartComponents above. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup Label="TUI">
    <!-- 2026-06: the former 2.0.1 freeze (TUI-18, anti-2.1.0) is lifted — the codebase
         now targets the redesigned 2.1+ API (Terminal.Gui.App/Views/ViewBase). -->
    <PackageVersion Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>
  <ItemGroup Label="Scripting">
    <PackageVersion Include="Jint" Version="4.13.0" />
  </ItemGroup>
  <ItemGroup Label="Trading">
    <!-- 6.0.0-beta2 kept deliberately (maintainer decision, QCM 2026-06-11): the Trading example tracks the 6.x prerelease. -->
    <PackageVersion Include="MathNet.Numerics" Version="6.0.0-beta2" />
    <PackageVersion Include="YahooFinanceApi" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
  </ItemGroup>
</Project>