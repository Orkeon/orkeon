# The Orkeon service host, as a systemd unit (GATE-05).
#
# Install:
#   sudo cp orkeon-host.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orkeon-host
#
# Two things this file does NOT do, on purpose. It does not carry a bot token or an API key —
# those are named by environment variable in the configuration and provided by the drop-in
# below, so a unit file can be read, copied and committed without leaking anything. And it does
# not schedule anything: rc.2 ships no scheduler, so a crew that should run every morning still
# needs the artifact `orkeon forge promote --schedule` produces.

[Unit]
Description=Orkeon service host
Documentation=https://github.com/orkeon/orkeon/blob/main/docs/architecture/service-host.md
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify because the host calls UseSystemd(): it tells systemd it is up once the crews are
# loaded, not when the process starts. Without it systemd would consider a host that failed to
# read its configuration "started" for as long as it took to exit.
Type=notify

ExecStart=/opt/orkeon/orkeon-host --settings /etc/orkeon/appsettings.json
WorkingDirectory=/var/lib/orkeon

# Restart on failure, not always: a host that stops because it has no crew configured is
# telling the operator something, and restarting it in a loop would bury the message.
Restart=on-failure
RestartSec=10s
# Exit 78 (EX_CONFIG) is the host refusing its configuration — a missing crew path, an empty
# allow list, an unset token variable. Restarting on that loops every ten seconds and buries
# the one message the operator needs to read; a crash (exit 1) still restarts.
RestartPreventExitStatus=78

# Longer than the host's own ShutdownGracePeriod (20s by default), so runs in flight get their
# grace period before systemd loses patience. Raising one without the other makes the setting
# that stays behind meaningless.
TimeoutStopSec=45s

# No WatchdogSec, deliberately. Microsoft.Extensions.Hosting.Systemd sends READY=1 and
# STOPPING=1 and nothing else — it has no WATCHDOG=1 keepalive. A watchdog armed here would
# declare the host hung on its first missed (never-sent) ping and kill it every interval,
# taking the runs in flight with it, forever.

User=orkeon
Group=orkeon

# Secrets by reference: put ORKEON_DISCORD_TOKEN=… and the LLM keys in a file readable only by
# the service user. The unit itself stays free of them.
EnvironmentFile=-/etc/orkeon/orkeon-host.env

# A daemon running someone else's prompts through tools should reach as little as possible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orkeon
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
