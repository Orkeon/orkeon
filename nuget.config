<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet feed pinning: nuget.org is the ONLY package source.
  <clear/> discards any machine/user-level feeds, and the source mapping below
  prevents dependency confusion (a package can only ever be resolved from the
  feed it is mapped to). If you need a private feed locally, add it in a
  user-level nuget.config - never in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
