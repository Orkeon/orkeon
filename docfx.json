{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/core/**/*.csproj", "src/tools/Orkeon.Tools.Abstractions/*.csproj"],
          "src": "."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["docs/toc.yml", "docs/*.md", "docs/**/*.md"] },
      { "files": ["*.md", "toc.yml"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "template": ["default", "modern"],
    "postProcessors": [],
    "noLangKeyword": false
  }
}
