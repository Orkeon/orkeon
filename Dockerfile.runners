# Orkeon runners — container image (ghcr.io/orkeon/orkeon-runners)
#
# Bundles every Orkeon executable together with the example crew definitions, so
# any bundled crew can be run with nothing but Docker and an LLM endpoint. All
# apps are framework-dependent inside the image (the .NET runtime ships in the
# base image). Which executable runs is chosen by the ORKEON_RUNNER env var:
#
#   orkeon (default) | repl | shell
#
# Build:
#   docker build -f Dockerfile.runners -t orkeon-runners .
#
# --- The /workspace convention (start here) -----------------------------------
# Mount your project at /workspace and reference everything from there — no
# extra flags needed:
#   docker run --rm -v "$PWD:/workspace" ghcr.io/orkeon/orkeon-runners \
#     run /workspace/crews/my-crew/config.yaml \
#     --settings /workspace/appsettings/appsettings.local.json \
#     --mount /workspace/data:/data:ro /workspace/output:/output:rw
# Three image conveniences make this Just Work:
#   1. ORKEON_ALLOW_EXTERNAL_MOUNTS=1 is baked in, so configs/mounts outside the
#      cwd (/app) need no --allow-external-mounts.
#   2. The entrypoint adopts the uid:gid that owns /workspace before running, so
#      the crew can write to your bind mount and the files it creates belong to
#      you on the host — no --user, no chmod (details at the dispatcher below).
#   3. /workspace exists (and is writable) even when nothing is mounted.
# For an interactive zsh inside the image (starts in /workspace):
#   docker run -it --rm -e ORKEON_RUNNER=shell -v "$PWD:/workspace" \
#     ghcr.io/orkeon/orkeon-runners
#
# --- Default runner: the `orkeon` CLI ----------------------------------------
# `orkeon run <crew.yaml | crew.ork.ts>` runs both YAML crews and .ork.ts
# Scripting-DSL crews from a single pre-compiled tool. Run a bundled example
# (results written to a mounted host directory, LLM settings from a mounted
# appsettings file):
#   docker run --rm \
#     -v "$PWD/out:/output" \
#     -v "$PWD/appsettings.local.json:/app/appsettings.local.json:ro" \
#     ghcr.io/orkeon/orkeon-runners \
#     run examples/01-enterprise/01-research-assistant/config.yaml \
#     --settings /app/appsettings.local.json
#
# Run a .ork.ts script instead (esbuild is bundled in the image, so scripts
# transpile with no extra setup):
#   docker run --rm \
#     -v "$PWD/my.ork.ts:/script/my.ork.ts:ro" \
#     ghcr.io/orkeon/orkeon-runners run /script/my.ork.ts
#
# --- Selecting another runner ------------------------------------------------
# The REPL is a Terminal.Gui app that reads from stdin — it REQUIRES an
# interactive TTY, so run it with `docker run -it`:
#   docker run -it --rm -e ORKEON_RUNNER=repl ghcr.io/orkeon/orkeon-runners
# NOTE (terminfo): the runtime:10.0 base image is Debian-slim and ships a minimal
# terminfo database. Terminal.Gui apps generally cope (they fall back to a basic
# profile), but exotic $TERM values may render degraded. If a richer terminal is
# needed, pass `-e TERM=xterm-256color` or install `ncurses-term` in a derived
# image rather than bloating this base image.
#
# --- Bundled examples: the orkeon-example helper ------------------------------
# The image ships 105 example crews under /app/examples plus a helper that makes
# running them a one-liner from the interactive shell (or via docker run):
#   orkeon-example list                 browse them
#   orkeon-example run 1                run one by number
#   orkeon-example show 42              print an example's README
#   orkeon-example settings             show which LLM settings apply and why
# Interactive session (recommended first contact):
#   docker run -it --rm -e ORKEON_RUNNER=shell -v "$PWD/out:/output" \
#     ghcr.io/orkeon/orkeon-runners
#   orkeon-example run 1
#
# --- Settings profiles ---------------------------------------------------------
# The baked default (/app/examples/appsettings/appsettings.json, overwritten at
# build time from docker/profiles/host-dmr.json) targets Docker Model Runner on
# the HOST via host.docker.internal:12434 — `docker model pull
# ai/granite-4.0-h-tiny` on the host and every bundled example runs with zero
# flags. Ready-made alternatives live in /etc/orkeon/profiles and are selected
# with -e ORKEON_LLM_PROFILE=<name>:
#   host-dmr     Docker Model Runner on the host (the default)
#   host-ollama  Ollama on the host (http://host.docker.internal:11434)
#   openai       OpenAI cloud — pair with -e ORKEON_Llm__ApiKey=sk-...
#   local        embedded model (local-llm image variant only, see below)
# ORKEON_Llm__* env vars override any settings file (e.g. -e ORKEON_Llm__Model=…).
#
# --- Optional: embed a local model (--target local-llm) ------------------------
# Build a variant that needs NO host-side model server and no API key: llama.cpp's
# llama-server + one GGUF baked in, served on 127.0.0.1:12434 with the same URL
# shape as Docker Model Runner, so the default settings just work. Recipes at the
# local-llm stage at the bottom of this file (Granite 4.0 h-tiny / Gemma 4).
#
# --- Docker volume  ->  Orkeon VFS mount -------------------------------------
#   Runners expose a virtual filesystem gated by rights. To let a crew read/write
#   host files, bind-mount the host dir with `-v host:container`, then hand the
#   in-container path to the runner as a VFS mount with
#   --mount <container-path>:<virtual-path>:<rights>. Example — expose host
#   ./data read-only at the virtual path /data, and collect output from /output:
#     docker run --rm \
#       -v "$PWD/data:/data:ro" -v "$PWD/out:/output" \
#       ghcr.io/orkeon/orkeon-runners \
#       run examples/.../config.yaml \
#       --mount /data:/data:ro /output:/output:rw
#   Rights are ro (read-only) | rw (read-write) | rwnd (read-write, no delete);
#   for several mounts pass all specs to a single --mount, space-separated.

# ---- Stage 1: build — publish every app (framework-dependent) ----------------
# global.json pins SDK 10.0.300 (rollForward latestFeature); the GA sdk:10.0 tag
# ships 10.0.3xx. This matters: Orkeon.Domain runs a source generator
# (Orkeon.Generators) whose partial-method output only matches under that SDK
# band — an older preview SDK leaves them unimplemented (CS8795).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central build/version/package config inherited by both src/ and examples/,
# plus the SDK pin so the container resolves the same toolchain as the host.
COPY global.json Directory.Build.props Directory.Packages.props ./

# Full framework + examples sources. The runners' project graph spans src/core,
# src/hosting, src/scripting and the examples tree,
# so the whole tree is copied rather than an enumerated per-csproj list (kept
# robust as references evolve). .dockerignore strips bin/obj/.git/artifacts/
# node_modules and non-README *.md from the context.
COPY src/ src/
COPY examples/ examples/

# Framework-dependent publish (--self-contained false: the runtime ships in the
# final base image). Pinned to linux-x64: a portable/RID-agnostic publish drags
# in every platform's native assets (onnxruntime, tree-sitter grammars, SQLite,
# ...) for all of win/linux/osx, ballooning the image. RID-scoping prunes those
# to just this image's arch. (For a multi-arch image, drive the RID from
# $TARGETARCH.) SkipScriptingNpmInstall skips the esbuild npm bootstrap (we fetch
# the binary directly below); ErrorOnDuplicatePublishOutputFiles tolerates the
# shared transitive assets several runners pull in.
#
# Default runner: the `orkeon` CLI (src/scripting/Orkeon.Scripting.Cli,
# AssemblyName `orkeon`) — runs both `orkeon run crew.yaml` and
# `orkeon run script.ork.ts`.
RUN dotnet publish src/scripting/Orkeon.Scripting.Cli/Orkeon.Scripting.Cli.csproj \
      -c Release -r linux-x64 --self-contained false \
      -p:SkipScriptingNpmInstall=true \
      -p:ErrorOnDuplicatePublishOutputFiles=false \
      -o /app/runners/orkeon --nologo
# REPL console app (src/apps/Orkeon.ConsoleApp).
RUN dotnet publish src/apps/Orkeon.ConsoleApp/Orkeon.ConsoleApp.csproj \
      -c Release -r linux-x64 --self-contained false \
      -p:SkipScriptingNpmInstall=true \
      -p:ErrorOnDuplicatePublishOutputFiles=false \
      -o /app/runners/repl --nologo

# esbuild binary — required at runtime by `orkeon run script.ork.ts` (the .ork.ts
# transpile path; the YAML path never touches it). The transpiler resolves the
# binary via, in order: the EsbuildPath option, the ORKEON_ESBUILD_PATH env var,
# a bundled `esbuild-bin/esbuild` next to the app, a PATH lookup, then repo-local
# candidates (EsbuildTranspiler.cs). We fetch the Go-built binary straight from
# the npm registry (@esbuild/linux-x64) — the SDK image has curl+tar but no npm —
# mirroring scripts/package-installers.sh, and expose it below via
# ORKEON_ESBUILD_PATH so every app finds it regardless of its base directory.
# The version is read from the lockfile (single source of truth), with the same
# 0.25.12 fallback the packaging script uses. The downloaded tarball is verified
# against the sha512 integrity pinned in the lockfile (coreutils only — the SDK
# image has no npm) before anything inside it is trusted.
COPY tools/scripting-esbuild/package-lock.json ./esbuild-lock.json
RUN ESBUILD_VERSION="$(grep -A1 '"node_modules/esbuild"' esbuild-lock.json \
      | sed -n 's/.*"version": "\([^"]*\)".*/\1/p' | head -1)" \
    && ESBUILD_VERSION="${ESBUILD_VERSION:-0.25.12}" \
    && echo "Fetching @esbuild/linux-x64@${ESBUILD_VERSION}" \
    && curl -fsSL "https://registry.npmjs.org/@esbuild/linux-x64/-/linux-x64-${ESBUILD_VERSION}.tgz" \
         -o /tmp/esbuild.tgz \
    && EXPECTED_B64="$(grep -A5 '"node_modules/@esbuild/linux-x64"' esbuild-lock.json \
         | sed -n 's/.*"integrity": "sha512-\([^"]*\)".*/\1/p' | head -1)" \
    && test -n "$EXPECTED_B64" \
    && EXPECTED_HEX="$(printf '%s' "$EXPECTED_B64" | base64 -d | od -An -v -tx1 | tr -d ' \n')" \
    && ACTUAL_HEX="$(sha512sum /tmp/esbuild.tgz | cut -d' ' -f1)" \
    && { [ "$ACTUAL_HEX" = "$EXPECTED_HEX" ] \
         || { echo "Integrity mismatch for @esbuild/linux-x64@${ESBUILD_VERSION}" >&2; exit 1; }; } \
    && mkdir -p /app/esbuild-bin \
    && tar -xzf /tmp/esbuild.tgz -C /tmp \
    && cp /tmp/package/bin/esbuild /app/esbuild-bin/esbuild \
    && chmod +x /app/esbuild-bin/esbuild \
    && rm -rf /tmp/esbuild.tgz /tmp/package

# Make the payload world-readable/traversable HERE, in the build stage: some
# NuGet content lands with perms that deny the final image's non-root user
# (uid 1654) — e.g. the local-embeddings model.onnx — which EACCES-crashes DI at
# startup. Doing it here (not after COPY --from) keeps the extra layer inside the
# discarded build stage; `COPY --from` preserves these mode bits into the final
# image with no added layer.
RUN chmod -R a+rX /app/runners /app/esbuild-bin

# ---- Stage 2: runtime --------------------------------------------------------
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

# zsh: interactive shell for `ORKEON_RUNNER=shell` sessions. gosu: lets the
# root entrypoint drop to the bind-mount owner's uid (see the dispatcher below).
# curl: the orkeon-example preflight check + the local-llm variant's health wait.
RUN apt-get update \
    && apt-get install -y --no-install-recommends zsh gosu curl \
    && rm -rf /var/lib/apt/lists/*

# Command wrappers on PATH — the same command names the release archives
# install (orkeon, orkeon-repl, …), so the interactive shell
# and any `docker exec` can invoke runners directly instead of spelling out
# `dotnet /app/runners/<x>/<y>.dll`.
RUN set -e; \
    for pair in "orkeon:orkeon/orkeon.dll" \
                "orkeon-repl:repl/Orkeon.ConsoleApp.dll"; do \
      name="${pair%%:*}"; dll="${pair#*:}"; \
      printf '%s\n' '#!/bin/sh' "exec dotnet /app/runners/$dll \"\$@\"" > "/usr/local/bin/$name"; \
      chmod +x "/usr/local/bin/$name"; \
    done

# Baked zsh config: ZDOTDIR points every uid (the entrypoint may drop to an
# arbitrary mount-owner uid with no home) at a read-only rc, which both
# suppresses the zsh-newuser-install first-run wizard and gives the shell a
# usable prompt/completion. The compdump goes to /tmp — ZDOTDIR itself is not
# writable by the dropped uid. The banner (suppressible via ORKEON_NO_BANNER=1)
# opens with the Orkeon mascot (docker/orkeon-banner.txt — a copy of
# backstage/marketing/assets/media/mascot/orkeon_banner_80-2.txt, duplicated
# here because backstage/ is not part of the published tree), then orients
# first-time users: commands, paths, a typical run.
COPY docker/orkeon-banner.txt /etc/orkeon/banner.txt
RUN mkdir -p /etc/orkeon/zsh && cat /etc/orkeon/banner.txt > /etc/orkeon/motd && printf '%b\n' \
  '' \
  '\033[36m──────────────────────────────────────────────────────────────────────────\033[0m' \
  '  \033[1mOrkeon\033[0m — interactive shell' \
  '  \033[2msource & docs\033[0m  https://github.com/Orkeon/orkeon' \
  '  \033[2mimage\033[0m          ghcr.io/orkeon/orkeon-runners' \
  '\033[36m──────────────────────────────────────────────────────────────────────────\033[0m' \
  '' \
  '  \033[1;36mTry it now\033[0m \033[2m(copy-paste)\033[0m' \
  '    orkeon-example list                     browse the 105 bundled examples' \
  '    orkeon-example run 1                    run #1 — research assistant' \
  '    orkeon run /app/examples/scripting/01-hello-world.ork.ts   \033[2mno LLM needed\033[0m' \
  '    \033[2mfirst time? on your host:\033[0m docker model pull ai/granite-4.0-h-tiny' \
  '' \
  '  \033[1;36mCommands\033[0m' \
  '    orkeon run <crew.yaml | script.ork.ts>  run a crew — the main CLI' \
  '    orkeon run <config> --validate          dry-run: config + tool check' \
  '    orkeon run <config> --list-tools        print the tool registry' \
  '    orkeon --help                           every flag explained' \
  '    orkeon-repl                             full interactive REPL console' \
  '' \
  '  \033[1;36mPaths\033[0m' \
  '    /workspace              your project (bind mount — you are here)' \
  '    /app/examples           bundled examples — browse: orkeon-example list' \
  '    /etc/orkeon/profiles    LLM profiles — select: ORKEON_LLM_PROFILE=<name>' \
  '' \
  '  \033[1;36mTypical run\033[0m' \
  '    orkeon run /workspace/crews/my-crew/config.yaml --settings /workspace/appsettings.local.json --mount /workspace/data:/data:ro /workspace/output:/output:rw' \
  '    \033[2madd\033[0m --llm-log-path /workspace/output/llm-logs \033[2mto log every LLM exchange (.jsonl)\033[0m' \
  '' \
  '  \033[1;36mCopy/paste in the TUI runners\033[0m \033[2m(repl)\033[0m' \
  '    copy: Ctrl+C on a selection reaches your host clipboard (OSC 52)' \
  '    paste from host: Ctrl+Shift+V (terminal-side paste)' \
  '' \
  '\033[36m──────────────────────────────────────────────────────────────────────────\033[0m' \
  '  \033[2mORKEON_NO_BANNER=1 hides this banner\033[0m · https://github.com/Orkeon/orkeon' \
  '\033[36m──────────────────────────────────────────────────────────────────────────\033[0m' \
  >> /etc/orkeon/motd \
  && printf '%s\n' \
  'autoload -Uz compinit && compinit -u -d /tmp/.zcompdump' \
  'PROMPT="%F{cyan}orkeon%f %~ %# "' \
  'alias ll="ls -la"' \
  'HISTFILE=/tmp/.zsh_history SAVEHIST=1000 HISTSIZE=1000' \
  '[ -z "$ORKEON_NO_BANNER" ] && cat /etc/orkeon/motd' \
  > /etc/orkeon/zsh/.zshrc
ENV ZDOTDIR=/etc/orkeon/zsh

# Shim orkeon.sh embarqué : permet aux run*.sh des expériences de fonctionner
# quand SEULE l'expérience est montée (le helper central experiments/scripts/
# orkeon.sh n'est alors pas visible). Même API de fonctions, mode cli
# uniquement — le CLI `orkeon` et les wrappers sont déjà sur le PATH, esbuild
# est embarqué, donc les ensure_* sont des no-ops.
RUN printf '%s\n' \
  '# shim orkeon.sh (image orkeon-runners) — mode cli uniquement' \
  'ORKEON_MODE=cli' \
  'orkeon_parse_mode() {' \
  '  ORKEON_ARGS=()' \
  '  while [ "$#" -gt 0 ]; do' \
  '    case "$1" in' \
  '      --mode|-M) [ "${2:-cli}" != "cli" ] && echo "[orkeon] shim conteneur : --mode ${2} ignore (mode cli force)" >&2; shift 2 ;;' \
  '      --mode=*)  shift ;;' \
  '      *)         ORKEON_ARGS+=("$1"); shift ;;' \
  '    esac' \
  '  done' \
  '  return 0' \
  '}' \
  'orkeon_banner() { echo "=== orkeon mode : cli (shim conteneur, bin=$(command -v orkeon)) ==="; }' \
  'orkeon_ensure_dotnet()   { return 0; }' \
  'orkeon_ensure_esbuild()  { return 0; }' \
  'orkeon_ensure_pkg_auth() { return 0; }' \
  'orkeon_run_yaml() {' \
  '  local config="" rest=()' \
  '  while [ "$#" -gt 0 ]; do' \
  '    case "$1" in' \
  '      --config|-c) config="$2"; shift 2 ;;' \
  '      *)           rest+=("$1"); shift ;;' \
  '    esac' \
  '  done' \
  '  orkeon run "$config" "${rest[@]}"' \
  '}' \
  'orkeon_run_ts() { local s="$1"; shift; orkeon run "$s" "$@"; }' \
  'orkeon_run_tool() { local cmd="$1"; shift 2; "$cmd" "$@"; }' \
  > /etc/orkeon/orkeon.sh

# The container boundary IS the sandbox: every path a crew can reach is already
# confined by Docker, so the CLI's cwd guard (--allow-external-mounts) would be
# redundant friction here. Bake the env opt-in so `run /workspace/...` works out
# of the box; pass -e ORKEON_ALLOW_EXTERNAL_MOUNTS=0 to restore the guard.
ENV ORKEON_ALLOW_EXTERNAL_MOUNTS=1

# Published apps, one directory per runner (see the dispatcher below).
COPY --from=build /app/runners ./runners
# Bundled esbuild binary, exposed to every app via ORKEON_ESBUILD_PATH.
COPY --from=build /app/esbuild-bin ./esbuild-bin
ENV ORKEON_ESBUILD_PATH=/app/esbuild-bin/esbuild

# Example crew definitions (config.yaml + README) and the shared appsettings.
# Only the numbered categories plus appsettings/ are shipped — others/, _legacy/
# and the runner/source projects are intentionally left out. .dockerignore has
# already dropped bin/obj and non-README *.md.
COPY examples/01-enterprise         examples/01-enterprise
COPY examples/02-science-research   examples/02-science-research
COPY examples/03-finance-trading    examples/03-finance-trading
COPY examples/04-health-wellness    examples/04-health-wellness
COPY examples/05-education          examples/05-education
COPY examples/06-engineering-devops examples/06-engineering-devops
COPY examples/07-creative-media     examples/07-creative-media
COPY examples/08-iot-smart-systems  examples/08-iot-smart-systems
COPY examples/09-experimental       examples/09-experimental
COPY examples/appsettings           examples/appsettings

# Bundled scripting demos — the zero-dependency first touch. The deliberately
# empty settings baked next to them shadow the appsettings/ walk-up, so no LLM
# provider is registered and the demos run on the UndefinedLlm echo fallback:
# no key, no model server, no network.
COPY examples/scripting                   examples/scripting
COPY docker/profiles/scripting-empty.json examples/scripting/appsettings.json

# Ready-made LLM settings profiles (select with ORKEON_LLM_PROFILE=<name>, read
# by the orkeon-example helper). host-dmr.json also OVERWRITES the baked copy of
# the examples' default settings: the committed file targets localhost:12434
# (right for source runs on the host) which is unreachable from inside a
# container — host.docker.internal is the container-appropriate default. The
# git file examples/appsettings/appsettings.json itself is untouched.
COPY docker/profiles/              /etc/orkeon/profiles/
COPY docker/profiles/host-dmr.json examples/appsettings/appsettings.json

# Example browser/runner: orkeon-example list|show|run|settings (see the file
# header in docker/orkeon-example for the full UX).
COPY docker/orkeon-example /usr/local/bin/orkeon-example

# Entry dispatcher: the `orkeon` CLI by default, or the runner named by
# ORKEON_RUNNER (`shell` opens an interactive zsh, starting in /workspace). All
# `docker run` args after the image name are forwarded to the selected
# executable verbatim. Maintained as a real file (docker/orkeon-entrypoint.sh)
# now that it also hosts the embedded local-LLM startup — see that file for the
# full story: runner dispatch, llama-server launch (local-llm variant only),
# and the gosu privilege drop to the /workspace bind-mount owner's uid.
# chmod +x here rather than trusting context mode bits: exec bits can be lost
# through Windows checkouts of the repo.
COPY docker/orkeon-entrypoint.sh /usr/local/bin/orkeon-entrypoint
RUN chmod +x /usr/local/bin/orkeon-entrypoint /usr/local/bin/orkeon-example

# Conventional roots: /workspace is where users bind-mount their project
# (`-v $PWD:/workspace`), /output is where crews write. World-writable so that
# whatever uid the entrypoint drops to can still write when nothing is mounted
# over them. Payload read perms are handled in the build stage (see chmod above)
# so no extra layer lands here.
RUN mkdir -p /output /workspace && chmod 0777 /output /workspace

ENTRYPOINT ["orkeon-entrypoint"]

# ---- Stage 3 (optional): local-llm — embed a model in the image ---------------
# Build-your-own variant that needs NO host-side model server and no API key:
# llama.cpp's llama-server plus one GGUF are baked in and served on
# 127.0.0.1:12434 with the /engines/llama.cpp prefix — the exact URL shape of
# the Docker Model Runner profile the examples default to, so the baked settings
# work with ZERO configuration. Weights are downloaded at build time from the
# URL you pass; these variants are built locally and never published (no model
# weight redistribution — mind each model's license before pushing such a tag).
#
# Granite 4.0 h-tiny (Apache 2.0, ~4.2 GB GGUF → ~6 GB image):
#   docker build -f Dockerfile.runners --target local-llm \
#     --build-arg LOCAL_MODEL_URL=https://huggingface.co/ibm-granite/granite-4.0-h-tiny-GGUF/resolve/main/granite-4.0-h-tiny-Q4_K_M.gguf \
#     -t orkeon-runners:granite .
#
# Gemma 4 E4B with a 128K context window (Gemma license — keep the image local):
#   docker build -f Dockerfile.runners --target local-llm \
#     --build-arg LOCAL_MODEL_URL=https://huggingface.co/unsloth/gemma-4-E4B-it-qat-GGUF/resolve/main/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf \
#     --build-arg LOCAL_MODEL_NAME=ai/gemma4 \
#     --build-arg LOCAL_MODEL_CTX=131072 \
#     -t orkeon-runners:gemma4 .
#
# Then (CPU inference — give the container memory, expect ~5-15 tok/s):
#   docker run -it --rm -m 8g -e ORKEON_RUNNER=shell orkeon-runners:granite
#   orkeon-example run 1
# The entrypoint starts the server before dispatch and waits for the model to
# load (30-90 s); -e ORKEON_LOCAL_LLM=0 skips it. Tunables:
# ORKEON_LOCAL_LLM_CTX (context size — baked default LOCAL_MODEL_CTX, overridable
# per run: -e ORKEON_LOCAL_LLM_CTX=131072; a 128K KV cache needs several extra GB
# of RAM, raise -m accordingly).
#
# llama-server comes from the official GitHub release tarball (the upstream
# GHCR server-b* image tags stopped at b5350, which predates --api-prefix).
# The ubuntu-x64 build matches this image's Ubuntu 24.04 base — verified by
# running --version and probing --api-prefix during the build.
FROM runtime AS local-llm
ARG LLAMA_CPP_BUILD=b9972
ARG LOCAL_MODEL_URL
ARG LOCAL_MODEL_NAME=ai/granite-4.0-h-tiny
ARG LOCAL_MODEL_SHA256=
# Default llama-server context size for this variant (tokens). Baked as the
# ORKEON_LOCAL_LLM_CTX default; still overridable at `docker run -e`.
ARG LOCAL_MODEL_CTX=8192
# libgomp1: OpenMP runtime llama-server links against (the only lib the
# ubuntu-x64 release build needs beyond what the base already ships).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
# Server binary + its shared libs (libllama/libggml*), kept out of /app/runners.
# The sanity checks prove the binary runs on THIS base image and still supports
# --api-prefix (the entrypoint depends on it) — failures surface at build time
# instead of at first container start.
RUN curl -fL --retry 3 --retry-delay 5 -o /tmp/llama.tgz \
      "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_CPP_BUILD}/llama-${LLAMA_CPP_BUILD}-bin-ubuntu-x64.tar.gz" \
    && mkdir -p /app/local-llm \
    && tar -xzf /tmp/llama.tgz -C /tmp \
    && cp "/tmp/llama-${LLAMA_CPP_BUILD}/llama-server" "/tmp/llama-${LLAMA_CPP_BUILD}/"*.so* /app/local-llm/ \
    && rm -rf /tmp/llama.tgz "/tmp/llama-${LLAMA_CPP_BUILD}" \
    && LD_LIBRARY_PATH=/app/local-llm /app/local-llm/llama-server --version \
    && LD_LIBRARY_PATH=/app/local-llm /app/local-llm/llama-server --help | grep -q -- --api-prefix
# Download the weights at build time (URL is mandatory for this target; sha256
# optional but recommended for reproducible builds).
RUN [ -n "$LOCAL_MODEL_URL" ] \
      || { echo "ERROR: --build-arg LOCAL_MODEL_URL=<gguf url> is required for --target local-llm" >&2; exit 1; } \
    && curl -fL --retry 3 --retry-delay 5 -o /app/local-llm/model.gguf "$LOCAL_MODEL_URL" \
    && { [ -z "$LOCAL_MODEL_SHA256" ] \
         || echo "$LOCAL_MODEL_SHA256  /app/local-llm/model.gguf" | sha256sum -c; } \
    && chmod -R a+rX /app/local-llm
ENV ORKEON_LOCAL_LLM_ALIAS=$LOCAL_MODEL_NAME
ENV ORKEON_LOCAL_LLM_CTX=$LOCAL_MODEL_CTX
# In this variant the embedded server IS localhost:12434 — materialize the
# `local` profile from its template, make it the baked default settings, and
# announce the model in the shell banner.
RUN sed -e "s|__BASEURL__|http://127.0.0.1:12434/engines/llama.cpp/v1|" \
        -e "s|__MODEL__|$LOCAL_MODEL_NAME|" \
        /etc/orkeon/profiles/local.json.tpl > /etc/orkeon/profiles/local.json \
    && cp /etc/orkeon/profiles/local.json /app/examples/appsettings/appsettings.json \
    && printf 'Local model\n  %s — serving on localhost:12434 (ORKEON_LOCAL_LLM=0 disables)\n' \
         "$LOCAL_MODEL_NAME" >> /etc/orkeon/motd

# ---- Final stage: the default image ------------------------------------------
# Kept last so a flag-less `docker build -f Dockerfile.runners .` still produces
# the plain runtime image (no embedded model).
FROM runtime
