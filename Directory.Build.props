<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exclure les artefacts de l'autre OS pour éviter les doublons CS0579/CS0757 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-linux/**;obj/**</DefaultItemExcludes>
    <!-- PUB-18 (P5 of the 2026-06-15 zero-warning campaign): the FULL analyzer set
         is on, permanently. Every family is either clean or explicitly arbitrated
         in .editorconfig (the ledger); the 2026-08-18 inventory found 4 stragglers
         solution-wide, all fixed the same day. CI builds with -warnaserror, so the
         whole repo is ratcheted at zero warnings under the complete rule set. -->
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>
  <!-- Build-only: replaces the SDK's csc with the pinned Roslyn so the repo's own analyzer and
       source generator, which reference Microsoft.CodeAnalysis 5.9.0, can be loaded by the
       compiler that runs them. Repo-wide because every project loads them, and a project left
       on the SDK compiler would silently lose both.

       Conditioned on central package management, because this file is inherited by the
       `experiments/` submodule, whose own Directory.Packages.props turns CPM OFF on purpose.
       A versionless PackageReference with no central version is NU1015, and it broke restore
       there outright; giving it a version here instead would be NU1008 in this repo, where CPM
       is on. The condition is the only form that is correct on both sides. Experiments carry no
       Orkeon analyzer, so the SDK compiler is the right one for them. -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj-linux/</BaseIntermediateOutputPath>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages</RestorePackagesPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <!-- R1.5/ORG-008: no global RID pin in Release — libraries must pack portable
         (AnyCPU) packages. Executables that need a platform-specific build pass the
         RID explicitly at publish time: `dotnet publish -c Release -r linux-x64`. -->
    <!--<PublishReadyToRun>true</PublishReadyToRun>-->
    <!--<PublishAot>true</PublishAot>-->
    <!-- PUB-24 P1: emit embedded portable PDBs in Release. DebugSymbols=false used to
         disable emission entirely (DebugType=embedded was inert), shipping non-debuggable
         packages: no step-into, no line numbers in stack traces, and the SDK's implicit
         SourceLink had nothing to attach to. Embedded PDBs ride inside each DLL — no
         extra artifact, deterministic builds keep their Reproducible entry. -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
