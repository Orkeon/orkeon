<Project>
  <!-- NuGet lock files (owner decision D12): every project of Orkeon.sln and of the examples
       records its resolved dependency graph in packages.lock.json, committed next to it.
       Locked mode is on in CI (the CI variable GitHub Actions sets): a restore that would
       resolve differently from the committed graph fails instead of drifting, so the packages
       are built from the graph that was reviewed. Locally the restore stays unlocked and
       rewrites the lock file when a package changes: commit it with the change.
       A lane that restores a graph the lock file does not describe opts out by passing
       -p:RestoreLockedMode=false (the .NET 11 SDK lane of ci.yml). The lock file records the
       RID-less net10.0 graph; a restore with -r or another TargetFramework is a different graph.
       Conditioned on central package management for the same reason as the compiler toolset
       of Directory.Build.props: nested checkouts mounted under this one are not locked by this
       repository. It lives in this .targets file because Directory.Packages.props, which sets
       that property, is imported after Directory.Build.props: here the condition sees it.
       A restore with a RuntimeIdentifier (the per-RID publishes of package-installers.sh/.ps1
       and of the Dockerfiles) resolves a graph the committed file does not hold: it writes its
       own lock file under the intermediate folder and is not locked, so it never rewrites the
       committed packages.lock.json that a later locked restore of the same job reads (the SBOM
       step of release.yml after the installers, NU1004 otherwise). -->
  <PropertyGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'packages.$(RuntimeIdentifier).lock.json'))</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">false</RestoreLockedMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <RestorePackagesWithLockFile Condition="'$(RestorePackagesWithLockFile)' == ''">true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- Native libraries of the current runtime only (2026-10-22).

       A build without a RuntimeIdentifier copies every native asset of every
       package for every runtime it ships (`runtimes/<rid>/native/`): with
       TreeSitter.DotNet and ONNX Runtime that is 36 runtime folders, ~920 MB
       and ~300 files per test project, 46 GB for the test tree in Debug and
       Release, 26 GB per built worktree, and most of a build's time on a slow
       mount. The host only ever probes the folders of the machine's own RID and
       of its fallbacks (`linux-x64` → `linux` → `unix` → `any`), so the rest is
       dead weight.

       This target drops the foreign runtimes from the copy list right after the
       package assets are resolved. The output path, the restore and the assets
       file are untouched; `dotnet pack` copies nothing local and
       `dotnet publish -r <rid>` resolves a RID-specific graph where this item
       is empty, so both are unaffected. A build that must stay portable across
       machines opts out with `-p:OrkeonAllRuntimes=true`.

       A dotnet tool is the exception: `dotnet pack` of a `PackAsTool` project
       publishes it RID-less into `tools/<tfm>/any/`, from this same copy list, so
       the trim would ship the natives of the packing machine alone (`linux-x64`
       and `unix` from publish.yml's ubuntu runner) and the tool would fail on
       Windows and macOS. A tool project is left untrimmed while `dotnet pack` runs
       (`_IsPacking`, which the pack command sets); its plain builds stay trimmed. -->
  <Target Name="OrkeonTrimForeignRuntimes"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(OrkeonAllRuntimes)' != 'true' and '$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''
                     and !('$(PackAsTool)' == 'true' and '$(_IsPacking)' == 'true')">
    <PropertyGroup>
      <_OrkeonRid>$(NETCoreSdkRuntimeIdentifier)</_OrkeonRid>
      <_OrkeonRidFamily>$(_OrkeonRid)</_OrkeonRidFamily>
      <_OrkeonRidFamily Condition="$(_OrkeonRid.IndexOf('-')) &gt; 0">$(_OrkeonRid.Substring(0, $(_OrkeonRid.IndexOf('-'))))</_OrkeonRidFamily>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != '$(_OrkeonRid)'
                   and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != '$(_OrkeonRidFamily)'
                   and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != 'unix'
                   and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != 'any'" />
    </ItemGroup>
  </Target>

  <!-- PUB-24 P1: a dotnet tool package (orkeon, orkeon-repl) used to weigh 262.5 MB —
       above the nuget.org limit (250 MB) — because Microsoft.ML.OnnxRuntime ships iOS
       (.xcframework.zip) and Android (.aar) natives that a dotnet CLI tool can never load.
       Strip them from every tool package payload; desktop RIDs (win/linux/osx) stay. -->
  <Target Name="OrkeonTrimMobileNativesFromToolPackage" AfterTargets="PackTool" Condition="'$(PackAsTool)' == 'true'">
    <ItemGroup>
      <_OrkeonMobileNative Include="@(TfmSpecificPackageFile)"
                           Condition="$([System.String]::Copy('%(TfmSpecificPackageFile.Identity)').Contains('/runtimes/ios'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.Identity)').Contains('/runtimes/android'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.PackagePath)').Contains('runtimes/ios'))
                                      Or $([System.String]::Copy('%(TfmSpecificPackageFile.PackagePath)').Contains('runtimes/android'))" />
      <TfmSpecificPackageFile Remove="@(_OrkeonMobileNative)" />
    </ItemGroup>
    <Message Importance="high" Text="OrkeonTrim: removed @(_OrkeonMobileNative-&gt;Count()) mobile native file(s) from the tool package" />
  </Target>

</Project>
